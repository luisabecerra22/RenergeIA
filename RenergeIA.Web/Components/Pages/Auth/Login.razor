@page "/login"
@layout LoginLayout
@using Microsoft.AspNetCore.Identity
@using RenergeIA.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

@if (HttpContextAccessor.HttpContext is { } ctx && ctx.User.Identity?.IsAuthenticated == true)
{
    Navigation.NavigateTo("/", replace: true);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>RenergeIA — Iniciar sesión</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
        body { background: linear-gradient(160deg, #111921 0%, #183963 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: rgba(255,255,255,0.06); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.12); border-radius: 16px; padding: 2.5rem; width: 100%; max-width: 420px; }
        .login-card h1 { color: #6ABF4B; font-size: 2rem; font-weight: 700; letter-spacing: -0.5px; }
        .login-card p.subtitle { color: rgba(255,255,255,0.6); font-size: 0.9rem; }
        .form-control { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fff; }
        .form-control:focus { background: rgba(255,255,255,0.12); border-color: #6ABF4B; color: #fff; box-shadow: 0 0 0 0.2rem rgba(106,191,75,0.25); }
        .form-control::placeholder { color: rgba(255,255,255,0.4); }
        .form-label { color: rgba(255,255,255,0.8); font-size: 0.85rem; }
        .btn-login { background: #6ABF4B; border: none; font-weight: 600; padding: 0.6rem; color: #fff; }
        .btn-login:hover { background: #57a33d; }
        .alert-danger { background: rgba(220,53,69,0.15); border-color: rgba(220,53,69,0.3); color: #ff6b6b; font-size: 0.875rem; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <h1>RenergeIA</h1>
            <p class="subtitle">Plataforma de gestión de proyectos EPC fotovoltaicos</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }

        <form method="post" @formname="login-form">
            <AntiforgeryToken />
            <div class="mb-3">
                <label class="form-label" for="email">Correo electrónico</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="usuario@renergeia.com" value="@_email" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Contraseña</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" />
                <label class="form-check-label text-white-50" for="rememberMe">Recordarme</label>
            </div>
            <button type="submit" class="btn btn-login btn-primary w-100">Ingresar</button>
        </form>
    </div>
</body>
</html>

@code {
    private string? ErrorMessage;
    private string _email = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var ctx = HttpContextAccessor.HttpContext;
        if (ctx is null) return;

        if (ctx.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        if (!HttpMethods.IsPost(ctx.Request.Method)) return;

        var form = ctx.Request.Form;
        _email = form["email"].ToString();
        var password = form["password"].ToString();
        var rememberMe = form["rememberMe"].ToString() == "on";

        var result = await SignInManager.PasswordSignInAsync(_email, password, rememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
            Navigation.NavigateTo("/", replace: true);
        else
            ErrorMessage = "Correo o contraseña incorrectos. Intenta de nuevo.";
    }
}
