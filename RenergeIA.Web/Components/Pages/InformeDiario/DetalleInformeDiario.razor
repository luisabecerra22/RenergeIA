@page "/proyectos/{ProyectoId:int}/informes/{InformeId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@inject InformeDiarioService InformeSvc
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Informe Diario — RenergeIA</PageTitle>

<style>
    .fila-padre { background: #f0f4f8 !important; }
    .fila-padre td { font-weight: 700; color: #183963; }
    .fila-nivel-1 td:first-child { padding-left: 8px !important; }
    .fila-nivel-2 td:first-child { padding-left: 20px !important; }
    .fila-nivel-3 td:first-child { padding-left: 36px !important; }
    .fila-nivel-4 td:first-child { padding-left: 52px !important; }
    .print-header { display: none; }
    .print-footer { display: none; }
    .print-info-grid { display: none; }

    @@media print {
        @@page { size: landscape; margin: 10mm; }
        .no-print { display: none !important; }
        .print-header { display: flex !important; }
        .print-footer { display: block !important; }
        .print-info-grid { display: grid !important; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 12px; }
        .print-info-item { padding: 6px 10px; border: 1px solid #e0e0e0; border-radius: 6px; font-size: 9pt; }
        .print-info-item .label { color: #888; font-size: 8pt; text-transform: uppercase; }
        .print-info-item .value { font-weight: 700; color: #183963; font-size: 10pt; }
        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; font-size: 8pt; }
        .page { padding: 0 !important; }
        main { padding: 0 !important; }
        .card { box-shadow: none !important; border: none !important; }
        .card-header { background: white !important; border-bottom: 2px solid #183963 !important; padding: 6px 0 !important; }
        .table-responsive { overflow: visible !important; }
        .table { font-size: 7.5pt !important; width: 100% !important; }
        .table th { background: #183963 !important; color: white !important; font-size: 7pt !important; padding: 4px 2px !important; white-space: nowrap; }
        .table td { padding: 3px 2px !important; border-color: #e0e0e0 !important; }
        .badge { font-size: 7pt !important; padding: 2px 4px !important; }
        tr { page-break-inside: avoid; }
        col.col-personal, col.col-horas { width: 40px !important; }
        col.col-actividad { width: auto !important; }
        col.col-duracion { width: 35px !important; }
        .info-cards { display: none !important; }
    }

    /* Columnas redimensionables */
    .table-resizable th {
        overflow: hidden;
        resize: horizontal;
        min-width: 40px;
    }
</style>

@if (_informe is null)
{
    <p>Cargando...</p>
}
else
{
    <!-- Encabezado impresión -->
    <div class="print-header align-items-center justify-content-between mb-2 pb-2" style="border-bottom:3px solid #183963">
        <div class="d-flex align-items-center gap-3">
            <img src="images/logo-renergeia.png.png" alt="Renergeia" style="height:38px" />
            <div>
                <h4 class="mb-0 fw-bold" style="color:#183963;font-size:14pt">Informe Diario de Obra N° @_informe.NumeroCertificado</h4>
                <small style="color:#666">@_proyecto?.Nombre</small>
            </div>
        </div>
        <div class="text-end">
            <div style="font-size:8pt;color:#888">Fecha del informe</div>
            <div class="fw-bold" style="color:#183963;font-size:12pt">@_informe.Fecha.ToString("dd/MM/yyyy")</div>
        </div>
    </div>

    <div class="print-info-grid">
        <div class="print-info-item">
            <div class="label">Personal en sitio</div>
            <div class="value">@_informe.PersonalTotal</div>
        </div>
        <div class="print-info-item">
            <div class="label">Resumen de actividades</div>
            <div class="value" style="font-size:8pt;font-weight:400">@(string.IsNullOrWhiteSpace(_informe.ResumenActividades) ? "—" : _informe.ResumenActividades)</div>
        </div>
        <div class="print-info-item">
            <div class="label">Observaciones</div>
            <div class="value" style="font-size:8pt;font-weight:400">@(string.IsNullOrWhiteSpace(_informe.Observaciones) ? "—" : _informe.Observaciones)</div>
        </div>
    </div>

    <!-- Encabezado pantalla -->
    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap no-print">
        <a href="/proyectos/@ProyectoId/informes" class="btn btn-sm btn-outline-secondary">&larr; Volver</a>
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1 class="h3 mb-0 fw-bold" style="color:#183963">Informe del @_informe.Fecha.ToString("dd 'de' MMMM 'de' yyyy")</h1>
                <span class="badge @BadgeEstado(_informe.Estado) fs-6">@EnumDisplay.Mostrar(_informe.Estado)</span>
            </div>
            <small class="text-muted">
                @_proyecto?.Nombre
                @if (!string.IsNullOrEmpty(_informe.NumeroCertificado))
                { <span> — Informe N° @_informe.NumeroCertificado</span> }
            </small>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="ExportarPDF">
                <i class="bi-file-earmark-pdf me-1"></i>Exportar PDF
            </button>
            @if (_informe.Estado == EstadoInforme.Borrador)
            {
                <a href="/proyectos/@ProyectoId/informes/@InformeId/editar"
                   class="btn btn-outline-primary btn-sm">Editar</a>
                <button class="btn btn-warning btn-sm" @onclick="EnviarARevisionAsync">
                    Enviar a Revisión
                </button>
            }
            @if (_informe.Estado == EstadoInforme.EnRevision)
            {
                <button class="btn btn-success btn-sm" @onclick="AprobarAsync">Aprobar</button>
                <button class="btn btn-danger btn-sm"
                        @onclick="() => _mostrarRechazo = !_mostrarRechazo">Rechazar</button>
            }
            @if (_informe.Estado == EstadoInforme.Rechazado)
            {
                <button class="btn btn-outline-secondary btn-sm"
                        @onclick="VolverABorradorAsync">Volver a Borrador</button>
            }
        </div>
    </div>

    <!-- Panel de rechazo -->
    @if (_mostrarRechazo)
    {
        <div class="card border-danger shadow-sm mb-4 no-print">
            <div class="card-header bg-danger text-white"><strong>Rechazar informe</strong></div>
            <div class="card-body">
                <label class="form-label">Motivo del rechazo</label>
                <textarea class="form-control mb-3" rows="2" @bind="_motivoRechazo"
                          placeholder="Describe el motivo del rechazo..."></textarea>
                <div class="d-flex gap-2">
                    <button class="btn btn-danger btn-sm" @onclick="RechazarAsync">Confirmar rechazo</button>
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="() => _mostrarRechazo = false">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @if (_informe.Estado == EstadoInforme.Rechazado && !string.IsNullOrEmpty(_informe.MotivoRechazo))
    {
        <div class="alert alert-danger no-print">
            <strong>Motivo de rechazo:</strong> @_informe.MotivoRechazo
        </div>
    }

    <!-- Información general + resumen -->
    <div class="row g-3 mb-4 info-cards">
        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Información general</strong></div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-5">Fecha</dt>
                        <dd class="col-7">@_informe.Fecha.ToString("dd/MM/yyyy")</dd>
                        <dt class="col-5">N° Informe</dt>
                        <dd class="col-7">@(_informe.NumeroCertificado ?? "—")</dd>
                        <dt class="col-5">Personal total</dt>
                        <dd class="col-7">@_informe.PersonalTotal personas</dd>
                        <dt class="col-5">Versión</dt>
                        <dd class="col-7">v@(_informe.Version)</dd>
                        <dt class="col-5">Creado por</dt>
                        <dd class="col-7">@_informe.CreadoPor</dd>
                        @if (_informe.RevisadoPor is not null)
                        {
                            <dt class="col-5">Revisado por</dt>
                            <dd class="col-7">@_informe.RevisadoPor</dd>
                            <dt class="col-5">Fecha revisión</dt>
                            <dd class="col-7">@_informe.FechaRevision?.ToString("dd/MM/yyyy")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Resumen del día</strong></div>
                <div class="card-body small">
                    @if (!string.IsNullOrEmpty(_informe.ResumenActividades))
                    { <p><strong>Actividades:</strong> @_informe.ResumenActividades</p> }
                    @if (!string.IsNullOrEmpty(_informe.Observaciones))
                    { <p><strong>Observaciones:</strong> @_informe.Observaciones</p> }
                    @if (!string.IsNullOrEmpty(_informe.ComentariosGenerales))
                    { <p class="mb-0"><strong>Comentarios:</strong> @_informe.ComentariosGenerales</p> }
                    @if (string.IsNullOrEmpty(_informe.ResumenActividades) &&
                         string.IsNullOrEmpty(_informe.Observaciones) &&
                         string.IsNullOrEmpty(_informe.ComentariosGenerales))
                    { <p class="text-muted mb-0">Sin resumen registrado.</p> }
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de avances con jerarquía WBS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong>Avances del Día (@_filasHoja.Count actividades)</strong>
            <div class="d-flex gap-2 flex-wrap no-print">
                <span class="badge bg-success">@_conteoAdelantado Adelantados</span>
                <span class="badge bg-primary">@_conteoAlDia Al Día</span>
                <span class="badge bg-warning text-dark">@_conteoAtrasado Atrasados</span>
                <span class="badge bg-danger">@_conteoCritico Críticos</span>
            </div>
        </div>
        <div class="card-body p-2">
            <div class="table-responsive">
                <table class="table table-bordered table-sm table-resizable align-middle mb-0" style="font-size:0.82rem;table-layout:fixed">
                    <colgroup>
                        <col style="width:90px" />
                        <col class="col-actividad" style="width:auto" />
                        <col style="width:100px" />
                        <col style="width:75px" />
                        <col style="width:75px" />
                        <col class="col-duracion" style="width:45px" />
                        <col style="width:85px" />
                        <col style="width:85px" />
                        <col style="width:85px" />
                        <col class="col-personal" style="width:50px" />
                        <col class="col-horas" style="width:50px" />
                        <col style="width:40px" />
                    </colgroup>
                    <thead class="table-dark" style="position:sticky;top:0;z-index:1">
                        <tr>
                            <th>Código WBS</th>
                            <th>Actividad</th>
                            <th class="text-center">Disciplina</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th class="text-center">Dur.</th>
                            <th class="text-center">Prog. %</th>
                            <th class="text-center">Real %</th>
                            <th class="text-center">Desv.</th>
                            <th class="text-center">Pers.</th>
                            <th class="text-center">Hrs.</th>
                            <th class="text-center">Est.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in _filas)
                        {
                            var nivelClass = $"fila-nivel-{Math.Min(fila.Nivel, 4)}";
                            <tr class="@nivelClass @(fila.EsPadre ? "fila-padre" : "")">
                                <td class="font-monospace small">@fila.CodigoWBS</td>
                                <td>
                                    @if (fila.EsPadre)
                                    { <i class="bi-folder2 me-1" style="color:#6ABF4B"></i> }
                                    @fila.Nombre
                                    @if (fila.EsCritica)
                                    { <span class="badge bg-danger ms-1" style="font-size:.6rem">CR</span> }
                                </td>
                                <td class="text-center">
                                    @if (fila.Disciplina.HasValue)
                                    { <span class="badge bg-secondary" style="font-size:.68rem">@EnumDisplay.Mostrar(fila.Disciplina.Value)</span> }
                                </td>
                                <td class="text-muted small">@fila.FechaInicio.ToString("dd/MM/yy")</td>
                                <td class="text-muted small">@fila.FechaFin.ToString("dd/MM/yy")</td>
                                <td class="text-center text-muted small">@fila.DuracionDias d</td>
                                <td class="text-center">
                                    <span class="badge bg-primary" style="font-size:0.75rem">@fila.AvanceProgramado.ToString("F2")%</span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold" style="color:@(fila.EsPadre ? "#183963" : "inherit")">
                                        @fila.AvanceReal.ToString("F2")%
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @BadgeDesv(fila.Desviacion)" style="font-size:0.75rem">
                                        @(fila.Desviacion >= 0 ? "+" : "")@fila.Desviacion.ToString("F2")%
                                    </span>
                                </td>
                                <td class="text-center text-muted">@(fila.EsPadre ? "—" : (fila.PersonalEnSitio?.ToString() ?? "0"))</td>
                                <td class="text-center text-muted">@(fila.EsPadre ? "—" : (fila.HorasTrabajadas?.ToString("F1") ?? "0"))</td>
                                <td class="text-center">
                                    <span style="font-size:1.1rem;color:@ColorEstado(fila.Desviacion)"
                                          title="@NombreEstado(fila.Desviacion)">●</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer impresión -->
    <div class="print-footer mt-3 pt-2 text-center" style="border-top:2px solid #e0e0e0">
        <small style="color:#999;font-size:7pt">Renergeia LLC — Sistema de Gestión EPC &bull; Documento confidencial &bull; Generado el @DateTime.Today.ToString("dd/MM/yyyy")</small>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    [Parameter] public int InformeId { get; set; }
    [SupplyParameterFromQuery(Name = "print")] public string? AutoPrint { get; set; }

    private bool _printed;
    private Proyecto? _proyecto;
    private InformeDiario? _informe;
    private List<FilaDetalle> _filas = [];
    private bool _mostrarRechazo;
    private string _motivoRechazo = "";

    private List<FilaDetalle> _filasHoja => _filas.Where(f => !f.EsPadre).ToList();
    private int _conteoAdelantado => _filasHoja.Count(f => f.Desviacion >= 5);
    private int _conteoAlDia      => _filasHoja.Count(f => f.Desviacion is >= 0 and < 5);
    private int _conteoAtrasado   => _filasHoja.Count(f => f.Desviacion < 0 && f.Desviacion >= -15);
    private int _conteoCritico    => _filasHoja.Count(f => f.Desviacion < -15);

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        _informe = await Db.InformesDiarios
            .Include(i => i.RegistrosAvance)
                .ThenInclude(r => r.ActividadWBS)
            .FirstOrDefaultAsync(i => i.Id == InformeId && i.ProyectoId == ProyectoId);

        if (_informe is null)
        {
            Navigation.NavigateTo($"/proyectos/{ProyectoId}/informes");
            return;
        }

        var versionVigente = await Db.CronogramasVersion
            .FirstOrDefaultAsync(v => v.ProyectoId == ProyectoId && v.EsVigente);

        var actividades = (await Db.ActividadesWBS
            .Where(a => a.ProyectoId == ProyectoId && a.Activo
                     && (versionVigente == null || a.CronogramaVersionId == versionVigente.Id))
            .ToListAsync())
            .OrderBy(a => WbsSortKey(a.CodigoWBS))
            .ToList();

        var codigosSet = actividades.Select(a => a.CodigoWBS).ToHashSet();
        var registroMap = _informe.RegistrosAvance.ToDictionary(r => r.ActividadWBSId);

        foreach (var act in actividades)
        {
            var esPadre = codigosSet.Any(c => c != act.CodigoWBS && c.StartsWith(act.CodigoWBS + "."));
            var nivel = act.CodigoWBS.Count(c => c == '.') + 1;

            var fila = new FilaDetalle
            {
                CodigoWBS   = act.CodigoWBS,
                Nombre      = act.Nombre,
                Disciplina  = act.Disciplina,
                FechaInicio = act.FechaInicioPlaneada,
                FechaFin    = act.FechaFinPlaneada,
                EsCritica   = act.EsCritica,
                EsPadre     = esPadre,
                Nivel       = nivel,
                AvanceProgramado = InformeSvc.CalcularAvanceEsperado(
                    act.FechaInicioPlaneada, act.FechaFinPlaneada, _informe.Fecha)
            };

            if (registroMap.TryGetValue(act.Id, out var reg))
            {
                fila.AvanceReal      = reg.PorcentajeAvance;
                fila.PersonalEnSitio = reg.PersonalEnSitio;
                fila.HorasTrabajadas = reg.HorasTrabajadas;
            }

            _filas.Add(fila);
        }

        foreach (var padre in _filas.Where(f => f.EsPadre).OrderByDescending(f => f.Nivel))
        {
            var hijos = _filas.Where(f =>
                f.CodigoWBS != padre.CodigoWBS &&
                f.CodigoWBS.StartsWith(padre.CodigoWBS + ".") &&
                !f.EsPadre).ToList();

            if (hijos.Any())
            {
                padre.AvanceReal = Math.Round(hijos.Average(h => h.AvanceReal), 2);
                padre.AvanceProgramado = Math.Round(hijos.Average(h => h.AvanceProgramado), 2);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoPrint == "1" && !_printed)
        {
            _printed = true;
            await Task.Delay(500);
            await JS.InvokeVoidAsync("window.print");
        }
    }

    private async Task ExportarPDF() => await JS.InvokeVoidAsync("window.print");

    private async Task EnviarARevisionAsync()
    {
        if (_informe is null) return;
        _informe.Estado = EstadoInforme.EnRevision;
        _informe.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    private async Task AprobarAsync()
    {
        if (_informe is null) return;
        var authState = await AuthState.GetAuthenticationStateAsync();
        _informe.Estado = EstadoInforme.Aprobado;
        _informe.RevisadoPor = authState.User.Identity?.Name;
        _informe.FechaRevision = DateTime.UtcNow;
        _informe.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    private async Task RechazarAsync()
    {
        if (_informe is null || string.IsNullOrWhiteSpace(_motivoRechazo)) return;
        var authState = await AuthState.GetAuthenticationStateAsync();
        _informe.Estado = EstadoInforme.Rechazado;
        _informe.MotivoRechazo = _motivoRechazo;
        _informe.RevisadoPor = authState.User.Identity?.Name;
        _informe.FechaRevision = DateTime.UtcNow;
        _informe.FechaModificacion = DateTime.UtcNow;
        _mostrarRechazo = false;
        await Db.SaveChangesAsync();
    }

    private async Task VolverABorradorAsync()
    {
        if (_informe is null) return;
        _informe.Estado = EstadoInforme.Borrador;
        _informe.MotivoRechazo = null;
        _informe.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    private static string WbsSortKey(string codigo) =>
        string.Join(".", codigo.Split('.').Select(p => p.PadLeft(4, '0')));

    private static string BadgeEstado(EstadoInforme e) => e switch
    {
        EstadoInforme.Borrador   => "bg-secondary",
        EstadoInforme.EnRevision => "bg-warning text-dark",
        EstadoInforme.Aprobado   => "bg-success",
        EstadoInforme.Rechazado  => "bg-danger",
        _                        => "bg-secondary"
    };

    private static string BadgeDesv(decimal desv) =>
        desv >= 0 ? "bg-success" : desv >= -5 ? "bg-warning text-dark" : "bg-danger";

    private static string ColorEstado(decimal desv) =>
        desv >= 5 ? "#198754" : desv >= 0 ? "#0d6efd" : desv >= -15 ? "#fd7e14" : "#dc3545";

    private static string NombreEstado(decimal desv) =>
        desv >= 5 ? "Adelantado" : desv >= 0 ? "Al Día" : desv >= -15 ? "Atrasado" : "Crítico";

    private sealed class FilaDetalle
    {
        public string CodigoWBS { get; set; } = "";
        public string Nombre { get; set; } = "";
        public Disciplina? Disciplina { get; set; }
        public DateTime FechaInicio { get; set; }
        public DateTime FechaFin { get; set; }
        public bool EsCritica { get; set; }
        public bool EsPadre { get; set; }
        public int Nivel { get; set; } = 1;
        public decimal AvanceProgramado { get; set; }
        public decimal AvanceReal { get; set; }
        public int? PersonalEnSitio { get; set; }
        public decimal? HorasTrabajadas { get; set; }
        public decimal Desviacion => AvanceReal - AvanceProgramado;
        public int DuracionDias => Math.Max(1, (int)(FechaFin - FechaInicio).TotalDays + 1);
    }
}
