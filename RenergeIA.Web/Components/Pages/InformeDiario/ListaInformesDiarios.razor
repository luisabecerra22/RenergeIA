@page "/proyectos/{ProyectoId:int}/informes"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation

<PageTitle>Informes Diarios — RenergeIA</PageTitle>

@if (_proyecto is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-4">
        <a href="/proyectos/@ProyectoId" class="btn btn-sm btn-outline-secondary">&larr; Volver</a>
        <div>
            <h1 class="h3 mb-0">Informes Diarios</h1>
            <small class="text-muted">@_proyecto.Nombre</small>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <select class="form-select form-select-sm" style="width:auto" @bind="_filtroEstado">
            <option value="">Todos los estados</option>
            <option value="Borrador">Borrador</option>
            <option value="EnRevision">En Revisión</option>
            <option value="Aprobado">Aprobado</option>
            <option value="Rechazado">Rechazado</option>
        </select>
        <a href="/proyectos/@ProyectoId/informes/crear" class="btn btn-primary">+ Nuevo informe</a>
    </div>

    @if (!InformesFiltrados.Any())
    {
        <div class="card shadow-sm text-center py-5">
            <p class="text-muted mb-3">No hay informes diarios registrados para este proyecto.</p>
            <div>
                <a href="/proyectos/@ProyectoId/informes/crear" class="btn btn-primary">Crear primer informe</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>N° Informe</th>
                            <th>Actividades</th>
                            <th>Personal</th>
                            <th>Estado</th>
                            <th>Creado por</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inf in InformesFiltrados)
                        {
                            <tr>
                                <td>@inf.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@(inf.NumeroCertificado ?? "—")</td>
                                <td><span class="badge bg-light text-dark border">@inf.RegistrosAvance.Count</span></td>
                                <td>@inf.PersonalTotal</td>
                                <td>
                                    <span class="badge @BadgeEstado(inf.Estado)">
                                        @EnumDisplay.Mostrar(inf.Estado)
                                    </span>
                                </td>
                                <td>@inf.CreadoPor</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end flex-wrap">
                                        <a href="/proyectos/@ProyectoId/informes/@inf.Id"
                                           class="btn btn-sm btn-outline-secondary">Ver</a>
                                        @if (inf.Estado == EstadoInforme.Borrador)
                                        {
                                            <a href="/proyectos/@ProyectoId/informes/@inf.Id/editar"
                                               class="btn btn-sm btn-outline-primary">Editar</a>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => ConfirmarEliminar(inf.Id)">Eliminar</button>
                                        }
                                    </div>
                                    @if (_eliminarId == inf.Id)
                                    {
                                        <div class="alert alert-danger mt-1 py-1 px-2 d-flex align-items-center gap-2"
                                             style="font-size:0.82rem">
                                            <span>¿Confirmar eliminación?</span>
                                            <button class="btn btn-danger btn-sm"
                                                    @onclick="() => EliminarAsync(inf.Id)">Sí, eliminar</button>
                                            <button class="btn btn-outline-secondary btn-sm"
                                                    @onclick="() => _eliminarId = null">Cancelar</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<InformeDiario> _informes = [];
    private string _filtroEstado = "";
    private int? _eliminarId;

    private IEnumerable<InformeDiario> InformesFiltrados =>
        _informes.Where(i => string.IsNullOrEmpty(_filtroEstado) || i.Estado.ToString() == _filtroEstado);

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _informes = await Db.InformesDiarios
            .Include(i => i.RegistrosAvance)
            .Where(i => i.ProyectoId == ProyectoId)
            .OrderByDescending(i => i.Fecha)
            .ToListAsync();
    }

    private void ConfirmarEliminar(int id) => _eliminarId = _eliminarId == id ? null : id;

    private async Task EliminarAsync(int id)
    {
        var inf = _informes.FirstOrDefault(i => i.Id == id);
        if (inf is null || inf.Estado != EstadoInforme.Borrador) return;
        Db.InformesDiarios.Remove(inf);
        await Db.SaveChangesAsync();
        _eliminarId = null;
        await CargarAsync();
    }

    private static string BadgeEstado(EstadoInforme e) => e switch
    {
        EstadoInforme.Borrador   => "bg-secondary",
        EstadoInforme.EnRevision => "bg-warning text-dark",
        EstadoInforme.Aprobado   => "bg-success",
        EstadoInforme.Rechazado  => "bg-danger",
        _                        => "bg-secondary"
    };
}
