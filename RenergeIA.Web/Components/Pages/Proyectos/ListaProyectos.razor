@page "/proyectos"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation

<PageTitle>Proyectos — RenergeIA</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Proyectos</h1>
    <div class="d-flex gap-2">
        <a href="/proyectos/papelera" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-trash3 me-1"></i>Papelera
            @if (_cantidadEliminados > 0)
            {
                <span class="badge bg-danger ms-1">@_cantidadEliminados</span>
            }
        </a>
        <a href="/proyectos/nuevo" class="btn btn-primary">+ Nuevo proyecto</a>
    </div>
</div>

@if (_proyectos is null)
{
    <p>Cargando...</p>
}
else if (!_proyectos.Any())
{
    <div class="alert alert-info">No hay proyectos registrados. Crea el primero.</div>
}
else
{
    <div class="row g-3">
        @foreach (var p in _proyectos)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary">@p.Codigo</span>
                            <span class="badge @BadgeClass(p.Estado)">@EnumDisplay.Mostrar(p.Estado)</span>
                        </div>
                        <h5 class="card-title">@p.Nombre</h5>
                        <p class="card-text text-muted small">@p.Cliente</p>
                        <p class="card-text small">
                            <strong>Ubicación:</strong> @p.Ubicacion, @p.Pais<br />
                            <strong>Capacidad:</strong> @p.CapacidadKWp kWp
                        </p>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a href="/proyectos/@p.Id" class="btn btn-sm btn-outline-primary flex-fill">Ver detalle</a>
                        <a href="/proyectos/@p.Id/editar" class="btn btn-sm btn-outline-secondary" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        @if (_confirmarId == p.Id)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => EnviarPapeleraAsync(p)">
                                <i class="bi bi-check-lg"></i> Sí
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmarId = null">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" title="Enviar a papelera"
                                    @onclick="() => _confirmarId = p.Id">
                                <i class="bi bi-trash3"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Proyecto>? _proyectos;
    private int? _confirmarId;
    private int _cantidadEliminados;

    protected override async Task OnInitializedAsync()
    {
        _proyectos = await Db.Proyectos.OrderByDescending(p => p.FechaCreacion).ToListAsync();
        _cantidadEliminados = await Db.Proyectos.IgnoreQueryFilters()
            .CountAsync(p => p.Eliminado);
    }

    private async Task EnviarPapeleraAsync(Proyecto p)
    {
        p.Eliminado = true;
        p.FechaEliminacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _proyectos!.Remove(p);
        _cantidadEliminados++;
        _confirmarId = null;
    }

    private static string BadgeClass(EstadoProyecto estado) => estado switch
    {
        EstadoProyecto.Planificacion => "bg-secondary",
        EstadoProyecto.EnEjecucion   => "bg-success",
        EstadoProyecto.Suspendido    => "bg-warning text-dark",
        EstadoProyecto.Completado    => "bg-primary",
        EstadoProyecto.Cancelado     => "bg-danger",
        _ => "bg-secondary"
    };
}
