@page "/proyectos/{ProyectoId:int}/no-conformidades"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Helpers

<PageTitle>No Conformidades — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
        <a href="/proyectos/@ProyectoId" class="btn btn-sm btn-outline-secondary">&larr; Volver</a>
        <h1 class="h3 mb-0 flex-grow-1">No Conformidades — @_proyecto.Nombre</h1>
        <button class="btn btn-primary" @onclick="MostrarFormulario">+ Nueva NC</button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm text-center p-3 border-start border-4 border-secondary">
                <div class="text-muted small fw-semibold">TOTAL</div>
                <div class="fw-bold fs-4">@_ncs.Count</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm text-center p-3 border-start border-4 border-danger">
                <div class="text-muted small fw-semibold">CRÍTICAS</div>
                <div class="fw-bold fs-4 text-danger">@_ncs.Count(n => n.Severidad == SeveridadNoConformidad.Critica)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm text-center p-3 border-start border-4 border-warning">
                <div class="text-muted small fw-semibold">ABIERTAS</div>
                <div class="fw-bold fs-4 text-warning">@_ncs.Count(n => n.Estado == EstadoNoConformidad.Abierta)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm text-center p-3 border-start border-4 border-success">
                <div class="text-muted small fw-semibold">CERRADAS</div>
                <div class="fw-bold fs-4 text-success">@_ncs.Count(n => n.Estado == EstadoNoConformidad.Cerrada)</div>
            </div>
        </div>
    </div>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <strong>@(_editandoId.HasValue ? "Editar No Conformidad" : "Nueva No Conformidad")</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Número *</label>
                            <InputText class="form-control" @bind-Value="_form.Numero" placeholder="NC-001" />
                            <ValidationMessage For="() => _form.Numero" />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Título *</label>
                            <InputText class="form-control" @bind-Value="_form.Titulo" placeholder="Título de la no conformidad" />
                            <ValidationMessage For="() => _form.Titulo" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Categoría</label>
                            <InputSelect class="form-select" @bind-Value="_form.Categoria">
                                <option value="">— Seleccionar —</option>
                                @foreach (var c in _categorias)
                                {
                                    <option value="@c">@c</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Severidad</label>
                            <InputSelect class="form-select" @bind-Value="_form.Severidad">
                                @foreach (var s in Enum.GetValues<SeveridadNoConformidad>())
                                {
                                    <option value="@s">@EnumDisplay.Mostrar(s)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <InputSelect class="form-select" @bind-Value="_form.Estado">
                                @foreach (var e in Enum.GetValues<EstadoNoConformidad>())
                                {
                                    <option value="@e">@EnumDisplay.Mostrar(e)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Detección *</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaDeteccion" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción *</label>
                            <InputTextArea class="form-control" @bind-Value="_form.Descripcion" rows="3" placeholder="Descripción detallada de la no conformidad..." />
                            <ValidationMessage For="() => _form.Descripcion" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Detectado Por *</label>
                            <InputText class="form-control" @bind-Value="_form.DetectadoPor" />
                            <ValidationMessage For="() => _form.DetectadoPor" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ubicación</label>
                            <InputText class="form-control" @bind-Value="_form.Ubicacion" placeholder="Sector / área de la obra" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha Cierre</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaCierre" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger mt-3 py-2">@_error</div>
                    }
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (!_ncs.Any())
    {
        <div class="card shadow-sm text-center py-5">
            <p class="text-muted mb-3">No hay no conformidades registradas para este proyecto.</p>
            <button class="btn btn-primary" @onclick="MostrarFormulario">+ Registrar primera NC</button>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px">#</th>
                            <th>Título</th>
                            <th>Categoría</th>
                            <th>Severidad</th>
                            <th>Estado</th>
                            <th>Detectado Por</th>
                            <th>F. Detección</th>
                            <th style="width:160px">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var n in _ncs.OrderByDescending(x => x.FechaCreacion))
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@n.Numero</span></td>
                                <td>
                                    <div class="fw-semibold">@n.Titulo</div>
                                    <small class="text-muted">@(n.Ubicacion ?? "")</small>
                                </td>
                                <td><span class="text-muted small">@(n.Categoria ?? "—")</span></td>
                                <td><span class="badge @BadgeSeveridad(n.Severidad)">@EnumDisplay.Mostrar(n.Severidad)</span></td>
                                <td><span class="badge @BadgeEstadoNC(n.Estado)">@EnumDisplay.Mostrar(n.Estado)</span></td>
                                <td class="small">@n.DetectadoPor</td>
                                <td class="small">@n.FechaDeteccion.ToShortDateString()</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarNC(n)">Editar</button>
                                        @if (_confirmandoEliminar == n.Id)
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarAsync(n.Id)">Confirmar</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmandoEliminar = null">×</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmandoEliminar = n.Id">Eliminar</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<NoConformidad> _ncs = [];
    private bool _mostrarFormulario;
    private int? _editandoId;
    private int? _confirmandoEliminar;
    private string? _error;

    private readonly string[] _categorias = ["Calidad", "Seguridad", "Ambiental", "Técnica", "Documental"];

    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _ncs = await Db.NoConformidades
            .Where(n => n.ProyectoId == ProyectoId)
            .ToListAsync();
    }

    private void MostrarFormulario()
    {
        _form = new FormModel { FechaDeteccion = DateTime.Today };
        _editandoId = null;
        _mostrarFormulario = true;
        _error = null;
    }

    private void EditarNC(NoConformidad n)
    {
        _form = new FormModel
        {
            Numero        = n.Numero,
            Titulo        = n.Titulo,
            Descripcion   = n.Descripcion,
            Categoria     = n.Categoria,
            Severidad     = n.Severidad,
            Estado        = n.Estado,
            FechaDeteccion = n.FechaDeteccion,
            FechaCierre   = n.FechaCierre,
            DetectadoPor  = n.DetectadoPor,
            Ubicacion     = n.Ubicacion
        };
        _editandoId = n.Id;
        _mostrarFormulario = true;
        _error = null;
    }

    private void CancelarFormulario()
    {
        _mostrarFormulario = false;
        _editandoId = null;
        _error = null;
    }

    private async Task GuardarAsync()
    {
        _error = null;
        if (_editandoId.HasValue)
        {
            var n = await Db.NoConformidades.FindAsync(_editandoId.Value);
            if (n is null) return;
            MapearForm(n);
            n.FechaModificacion = DateTime.UtcNow;
        }
        else
        {
            var n = new NoConformidad { ProyectoId = ProyectoId };
            MapearForm(n);
            Db.NoConformidades.Add(n);
        }
        await Db.SaveChangesAsync();
        await CargarAsync();
        CancelarFormulario();
    }

    private void MapearForm(NoConformidad n)
    {
        n.Numero         = _form.Numero;
        n.Titulo         = _form.Titulo;
        n.Descripcion    = _form.Descripcion;
        n.Categoria      = _form.Categoria;
        n.Severidad      = _form.Severidad;
        n.Estado         = _form.Estado;
        n.FechaDeteccion = _form.FechaDeteccion;
        n.FechaCierre    = _form.FechaCierre;
        n.DetectadoPor   = _form.DetectadoPor;
        n.Ubicacion      = _form.Ubicacion;
    }

    private async Task EliminarAsync(int id)
    {
        var n = await Db.NoConformidades.FindAsync(id);
        if (n is null) return;
        Db.NoConformidades.Remove(n);
        await Db.SaveChangesAsync();
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private static string BadgeSeveridad(SeveridadNoConformidad s) => s switch
    {
        SeveridadNoConformidad.Baja    => "bg-primary",
        SeveridadNoConformidad.Media   => "bg-warning text-dark",
        SeveridadNoConformidad.Alta    => "bg-orange text-white",
        SeveridadNoConformidad.Critica => "bg-danger",
        _                              => "bg-secondary"
    };

    private static string BadgeEstadoNC(EstadoNoConformidad e) => e switch
    {
        EstadoNoConformidad.Abierta          => "bg-danger",
        EstadoNoConformidad.EnRevision       => "bg-warning text-dark",
        EstadoNoConformidad.EnImplementacion => "bg-primary",
        EstadoNoConformidad.Cerrada          => "bg-success",
        EstadoNoConformidad.Cancelada        => "bg-secondary",
        _                                    => "bg-secondary"
    };

    private sealed class FormModel
    {
        [Required(ErrorMessage = "El número es obligatorio")]
        public string Numero { get; set; } = string.Empty;

        [Required(ErrorMessage = "El título es obligatorio")]
        public string Titulo { get; set; } = string.Empty;

        [Required(ErrorMessage = "La descripción es obligatoria")]
        public string Descripcion { get; set; } = string.Empty;

        [Required(ErrorMessage = "El campo 'Detectado Por' es obligatorio")]
        public string DetectadoPor { get; set; } = string.Empty;

        public string? Categoria { get; set; }
        public SeveridadNoConformidad Severidad { get; set; } = SeveridadNoConformidad.Media;
        public EstadoNoConformidad Estado { get; set; } = EstadoNoConformidad.Abierta;
        public DateTime FechaDeteccion { get; set; } = DateTime.Today;
        public DateTime? FechaCierre { get; set; }
        public string? Ubicacion { get; set; }
    }
}
