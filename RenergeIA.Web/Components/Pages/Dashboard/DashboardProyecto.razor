@page "/proyectos/{ProyectoId:int}/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@inject InformeDiarioService InformeSvc
@inject IJSRuntime JS

<PageTitle>Dashboard — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

<style>
    .kpi-card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        transition: transform .15s, box-shadow .15s;
    }
    .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,.1) !important; }
    .kpi-icon {
        width: 44px; height: 44px; border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.2rem; color: white;
    }
    .kpi-value { font-size: 2rem; font-weight: 800; line-height: 1.1; }
    .kpi-label { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; color: #8892a0; }
    .kpi-sub { font-size: .78rem; color: #a0a8b4; }
    .kpi-bar { height: 4px; border-radius: 2px; background: #f0f2f5; margin-top: 12px; }
    .kpi-bar-fill { height: 100%; border-radius: 2px; }
    .dash-header { border-bottom: 2px solid #f0f2f5; padding-bottom: 1rem; margin-bottom: 1.5rem; }
    .estado-badge { padding: .4rem 1rem; border-radius: 8px; font-weight: 700; font-size: .85rem; }
</style>

@if (_proyecto is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap dash-header">
        <a href="/proyectos/@ProyectoId" class="btn btn-sm btn-outline-secondary">&larr; Volver</a>
        <div class="flex-grow-1">
            <h1 class="h3 mb-0 fw-bold" style="color:#183963">Dashboard</h1>
            <small class="text-muted">@_proyecto.Nombre &bull; @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
        </div>
        @if (_dash.TieneDatos)
        {
            <span class="estado-badge" style="background:@(ColorSPI())22;color:@ColorSPI()">@_dash.EstadoGeneral</span>
        }
    </div>

    @if (!_dash.TieneDatos)
    {
        <div class="card shadow-sm text-center py-5 border-0" style="border-radius:14px">
            <p class="text-muted mb-3">No hay actividades WBS configuradas para este proyecto.</p>
            <a href="/proyectos/@ProyectoId/wbs" class="btn btn-primary">Ir a WBS</a>
        </div>
    }
    else
    {
        <!-- KPIs fila 1: avance -->
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
                <div class="card kpi-card shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-label">AVANCE PROGRAMADO</span>
                            <span class="kpi-icon" style="background:#183963"><i class="bi-calendar-check"></i></span>
                        </div>
                        <div class="kpi-value" style="color:#183963">
                            @_dash.AvanceProgramadoTotal.ToString("F1")%
                        </div>
                        <div class="kpi-sub">al día de hoy</div>
                        <div class="kpi-bar"><div class="kpi-bar-fill" style="width:@(Math.Min((double)_dash.AvanceProgramadoTotal,100))%;background:#183963"></div></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card kpi-card shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-label">AVANCE REAL</span>
                            <span class="kpi-icon" style="background:@ColorDesv(_dash.DesviacionTotal)"><i class="bi-graph-up-arrow"></i></span>
                        </div>
                        <div class="kpi-value" style="color:@ColorDesv(_dash.DesviacionTotal)">
                            @_dash.AvanceRealTotal.ToString("F1")%
                        </div>
                        <div class="kpi-sub">acumulado</div>
                        <div class="kpi-bar"><div class="kpi-bar-fill" style="width:@(Math.Min((double)_dash.AvanceRealTotal,100))%;background:@ColorDesv(_dash.DesviacionTotal)"></div></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card kpi-card shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-label">DESVIACIÓN</span>
                            <span class="kpi-icon" style="background:@ColorDesv(_dash.DesviacionTotal)"><i class="bi-arrow-left-right"></i></span>
                        </div>
                        <div class="kpi-value" style="color:@ColorDesv(_dash.DesviacionTotal)">
                            @(_dash.DesviacionTotal >= 0 ? "+" : "")@_dash.DesviacionTotal.ToString("F1")%
                        </div>
                        <div class="kpi-sub">real vs programado</div>
                        <div class="kpi-bar"><div class="kpi-bar-fill" style="width:@(Math.Min(Math.Abs((double)_dash.DesviacionTotal) * 3, 100))%;background:@ColorDesv(_dash.DesviacionTotal)"></div></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card kpi-card shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-label">SPI GLOBAL</span>
                            <span class="kpi-icon" style="background:@ColorSPI()"><i class="bi-speedometer2"></i></span>
                        </div>
                        <div class="kpi-value" style="color:@ColorSPI()">
                            @_dash.SPIGlobal.ToString("F2")
                        </div>
                        <div class="kpi-sub">
                            @(_dash.SPIGlobal >= 1m ? "Al día o adelantado" : _dash.SPIGlobal >= 0.9m ? "Leve atraso" : "Atraso significativo")
                        </div>
                        <div class="kpi-bar"><div class="kpi-bar-fill" style="width:@(Math.Min((double)_dash.SPIGlobal * 100, 100))%;background:@ColorSPI()"></div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPIs fila 2: actividades -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card kpi-card shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-label">ACT. ATRASADAS</span>
                            <span class="kpi-icon" style="background:#fd7e14"><i class="bi-clock-history"></i></span>
                        </div>
                        <div class="kpi-value" style="color:@(_dash.Atrasadas > 0 ? "#fd7e14" : "#6ABF4B")">
                            @_dash.Atrasadas
                        </div>
                        <div class="kpi-sub">de @_dash.TotalActividades total</div>
                        <div class="kpi-bar"><div class="kpi-bar-fill" style="width:@(_dash.TotalActividades > 0 ? _dash.Atrasadas * 100 / _dash.TotalActividades : 0)%;background:#fd7e14"></div></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card kpi-card shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-label">ACT. CRÍTICAS</span>
                            <span class="kpi-icon" style="background:#dc3545"><i class="bi-exclamation-triangle"></i></span>
                        </div>
                        <div class="kpi-value" style="color:@(_dash.Criticas > 0 ? "#dc3545" : "#6ABF4B")">
                            @_dash.Criticas
                        </div>
                        <div class="kpi-sub">desviación &lt; -15%</div>
                        <div class="kpi-bar"><div class="kpi-bar-fill" style="width:@(_dash.TotalActividades > 0 ? _dash.Criticas * 100 / _dash.TotalActividades : 0)%;background:#dc3545"></div></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card kpi-card shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-label">ACT. FINALIZADAS</span>
                            <span class="kpi-icon" style="background:#6ABF4B"><i class="bi-check-circle"></i></span>
                        </div>
                        <div class="kpi-value" style="color:#6ABF4B">@_dash.Finalizadas</div>
                        <div class="kpi-sub">avance &ge; 100%</div>
                        <div class="kpi-bar"><div class="kpi-bar-fill" style="width:@(_dash.TotalActividades > 0 ? _dash.Finalizadas * 100 / _dash.TotalActividades : 0)%;background:#6ABF4B"></div></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card kpi-card shadow-sm h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="kpi-label">ESTADO GENERAL</span>
                            <span class="kpi-icon" style="background:@ColorSPI()"><i class="bi-activity"></i></span>
                        </div>
                        <div class="kpi-value" style="color:@ColorSPI();font-size:1.5rem">
                            @_dash.EstadoGeneral
                        </div>
                        <div class="kpi-sub">@_dash.EnLinea en línea &bull; @_dash.NoIniciadas sin iniciar</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Curva S -->
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <strong>Curva S — Avance real vs planificado</strong>
                    <button class="btn btn-sm d-flex align-items-center gap-1"
                            style="background:#183963;color:white;border:none;font-size:0.72rem;padding:3px 10px;border-radius:6px"
                            disabled="@_actualizandoCurvaS"
                            @onclick="ActualizarCurvaSAsync"
                            title="Recalcular Curva S desde cronograma e informes">
                        @if (_actualizandoCurvaS)
                        {
                            <span class="spinner-border spinner-border-sm" style="width:12px;height:12px"></span>
                        }
                        else
                        {
                            <i class="bi-arrow-clockwise"></i>
                        }
                        Actualizar
                    </button>
                    @if (_curvaActualizada)
                    {
                        <span style="color:#6ABF4B;font-size:0.72rem;font-weight:600">Actualizada</span>
                    }
                </div>
                <small class="text-muted">Línea base del cronograma vs avance de informes diarios</small>
            </div>
            <div class="card-body">
                @if (_dash.CurvaS.Fechas.Count == 0)
                {
                    <div class="text-center py-4">
                        <p class="text-muted mb-2">No hay actividades con fechas programadas.</p>
                    </div>
                }
                else
                {
                    <canvas id="curvaSChart" style="max-height:360px"></canvas>

                    <!-- Barra comparativa: Ejecutado vs Planeado a corte de hoy -->
                    <div class="mt-4 pt-3" style="border-top:1px solid #f0f2f5">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold" style="font-size:0.85rem;color:#183963">
                                Corte a hoy — @DateTime.Now.ToString("dd/MM/yyyy")
                            </span>
                            <div class="d-flex gap-4" style="font-size:0.78rem">
                                <span><span style="display:inline-block;width:12px;height:12px;border-radius:2px;background:#6ABF4B;margin-right:4px"></span>
                                    Avance Ejecutado</span>
                                <span><span style="display:inline-block;width:12px;height:12px;border-radius:2px;background:#183963;margin-right:4px"></span>
                                    Avance Planeado</span>
                            </div>
                        </div>
                        <!-- Barra Ejecutado -->
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div style="flex:1;height:28px;background:#f0f2f5;border-radius:6px;position:relative;overflow:hidden">
                                <div style="height:100%;background:#6ABF4B;border-radius:6px;width:@(_dash.CurvaS.EjecutadoHoy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;transition:width 0.5s"></div>
                            </div>
                            <span class="fw-bold" style="color:#6ABF4B;font-size:0.95rem;min-width:60px;text-align:right">
                                @_dash.CurvaS.EjecutadoHoy.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%
                            </span>
                        </div>
                        <!-- Barra Planeado -->
                        <div class="d-flex align-items-center gap-2">
                            <div style="flex:1;height:28px;background:#f0f2f5;border-radius:6px;position:relative;overflow:hidden">
                                <div style="height:100%;background:#183963;border-radius:6px;width:@(_dash.CurvaS.PlanificadoHoy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;transition:width 0.5s"></div>
                            </div>
                            <span class="fw-bold" style="color:#183963;font-size:0.95rem;min-width:60px;text-align:right">
                                @_dash.CurvaS.PlanificadoHoy.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Disciplinas + Donut -->
        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header"><strong>Avance por disciplina — Real vs Programado</strong></div>
                    <div class="card-body">
                        @if (!_dash.PorDisciplina.Any())
                        {
                            <p class="text-muted text-center py-4">
                                No hay actividades con disciplina asignada.
                            </p>
                        }
                        else
                        {
                            <canvas id="disciplinasChart" style="max-height:280px"></canvas>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header"><strong>Estado de actividades</strong></div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <canvas id="estadoChart" style="max-height:260px"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top actividades atrasadas -->
        @if (_dash.TopAtrasadas.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Actividades más atrasadas</strong>
                    <small class="text-muted">Top @_dash.TopAtrasadas.Count por desviación</small>
                </div>
                <div class="card-body">
                    <canvas id="atrasadasChart"
                            style="min-height:@(_dash.TopAtrasadas.Count * 36 + 50)px;max-height:480px">
                    </canvas>
                </div>
            </div>
        }

        <!-- Tabla actividades críticas y atrasadas -->
        @if (_dash.ActividadesCriticas.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Plan de acción — Actividades críticas y atrasadas</strong>
                    <span class="badge bg-danger">@_dash.ActividadesCriticas.Count actividades</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Actividad</th>
                                <th class="text-center">Disciplina</th>
                                <th class="text-end">Prog.</th>
                                <th class="text-end">Real</th>
                                <th class="text-end">Desv.</th>
                                <th class="text-center">Estado</th>
                                <th>Recomendación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in _dash.ActividadesCriticas)
                            {
                                <tr>
                                    <td class="font-monospace small text-muted">@a.Codigo</td>
                                    <td>
                                        <span class="@(a.EsCritica ? "fw-bold" : "")">@a.Nombre</span>
                                        @if (a.EsCritica)
                                        {
                                            <span class="badge bg-danger ms-1" style="font-size:.65rem">CR</span>
                                        }
                                    </td>
                                    <td class="text-center text-muted small">
                                        @if (a.Disciplina.HasValue)
                                        { @EnumDisplay.Mostrar(a.Disciplina.Value) }
                                        else { <span>—</span> }
                                    </td>
                                    <td class="text-end text-muted">@a.AvanceProgramado.ToString("F1")%</td>
                                    <td class="text-end fw-bold">@a.AvanceReal.ToString("F1")%</td>
                                    <td class="text-end fw-bold @(a.Desviacion < -15 ? "text-danger" : "text-warning")">
                                        @a.Desviacion.ToString("F1")%
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @BadgeActividad(a.Estado)">
                                            @NombreEstado(a.Estado)
                                        </span>
                                    </td>
                                    <td class="small text-muted" style="max-width:260px">
                                        @a.Recomendacion
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Tabla detalle por disciplina -->
        @if (_dash.PorDisciplina.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header"><strong>Detalle por disciplina</strong></div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Disciplina</th>
                                <th class="text-end">Programado</th>
                                <th class="text-end">Real</th>
                                <th class="text-end">Desviación</th>
                                <th class="text-end">Atrasadas</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _dash.PorDisciplina)
                            {
                                <tr>
                                    <td>@EnumDisplay.Mostrar(d.Disciplina)</td>
                                    <td class="text-end text-muted">@d.AvanceProgramado.ToString("F1")%</td>
                                    <td class="text-end fw-bold">@d.AvanceReal.ToString("F1")%</td>
                                    <td class="text-end fw-bold @(d.Desviacion >= 0 ? "text-success" : d.Desviacion >= -5 ? "text-warning" : "text-danger")">
                                        @(d.Desviacion >= 0 ? "+" : "")@d.Desviacion.ToString("F1")%
                                    </td>
                                    <td class="text-end @(d.Atrasadas > 0 ? "text-danger fw-bold" : "text-muted")">
                                        @d.Atrasadas
                                    </td>
                                    <td class="text-end text-muted">@d.Total</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private DashboardCompleto _dash = new();
    private bool _chartsRendered;
    private bool _actualizandoCurvaS;
    private bool _curvaActualizada;

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        _dash = await InformeSvc.ObtenerDashboardCompletoAsync(ProyectoId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_dash.TieneDatos || _chartsRendered) return;
        _chartsRendered = true;

        if (_dash.CurvaS.Fechas.Count > 0)
            await JS.InvokeVoidAsync("renderCurvaS",
                "curvaSChart",
                _dash.CurvaS.Fechas,
                _dash.CurvaS.AvancePlanificado,
                _dash.CurvaS.AvanceReal);

        if (_dash.PorDisciplina.Any())
        {
            var labels = _dash.PorDisciplina.Select(d => EnumDisplay.Mostrar(d.Disciplina)).ToList();
            var reales = _dash.PorDisciplina.Select(d => (double)d.AvanceReal).ToList();
            var progs  = _dash.PorDisciplina.Select(d => (double)d.AvanceProgramado).ToList();
            await JS.InvokeVoidAsync("renderBarChart",
                "disciplinasChart", labels, reales, progs,
                "Avance Real (%)", "Programado (%)");
        }

        var estadoLabels = new[] { "En Línea", "Atrasadas", "Críticas", "Finalizadas", "Sin iniciar" };
        var estadoData   = new[] { _dash.EnLinea, _dash.Atrasadas, _dash.Criticas, _dash.Finalizadas, _dash.NoIniciadas };
        var estadoColors = new[] { "#6ABF4B", "#ffc107", "#dc3545", "#183963", "#adb5bd" };
        await JS.InvokeVoidAsync("renderDoughnutChart", "estadoChart", estadoLabels, estadoData, estadoColors);

        if (_dash.TopAtrasadas.Any())
        {
            var labels = _dash.TopAtrasadas
                .Select(a => a.Nombre.Length > 38 ? a.Nombre[..38] + "…" : a.Nombre)
                .ToList();
            var data = _dash.TopAtrasadas.Select(a => (double)a.Desviacion).ToList();
            await JS.InvokeVoidAsync("renderHorizontalBarChart", "atrasadasChart", labels, data, "Desviación (%)");
        }
    }

    private async Task ActualizarCurvaSAsync()
    {
        _actualizandoCurvaS = true;
        _curvaActualizada = false;
        StateHasChanged();

        _dash = await InformeSvc.ObtenerDashboardCompletoAsync(ProyectoId);

        // Destroy existing chart and re-render
        await JS.InvokeVoidAsync("destroyChart", "curvaSChart");

        if (_dash.CurvaS.Fechas.Count > 0)
            await JS.InvokeVoidAsync("renderCurvaS",
                "curvaSChart",
                _dash.CurvaS.Fechas,
                _dash.CurvaS.AvancePlanificado,
                _dash.CurvaS.AvanceReal);

        _actualizandoCurvaS = false;
        _curvaActualizada = true;
        StateHasChanged();

        await Task.Delay(3000);
        _curvaActualizada = false;
        StateHasChanged();
    }

    private string ColorDesv(decimal desv) =>
        desv >= 0 ? "#6ABF4B" : desv >= -5 ? "#fd7e14" : "#dc3545";

    private string BordeReal() =>
        _dash.AvanceRealTotal >= _dash.AvanceProgramadoTotal ? "border-success" : "border-danger";

    private string BordeDesv() =>
        _dash.DesviacionTotal >= 0 ? "border-success" : _dash.DesviacionTotal >= -5 ? "border-warning" : "border-danger";

    private string BordeSPI() =>
        _dash.SPIGlobal >= 1m ? "border-success" : _dash.SPIGlobal >= 0.9m ? "border-warning" : "border-danger";

    private string ColorSPI() =>
        _dash.SPIGlobal >= 1m ? "#6ABF4B" : _dash.SPIGlobal >= 0.9m ? "#fd7e14" : "#dc3545";

    private static string BadgeEstado(string estado) => estado switch
    {
        "Al Día"      => "bg-success",
        "Leve Atraso" => "bg-warning text-dark",
        "Atrasado"    => "bg-warning text-dark",
        "Crítico"     => "bg-danger",
        _             => "bg-secondary"
    };

    private static string BadgeActividad(EstadoDashboard estado) => estado switch
    {
        EstadoDashboard.Critica    => "bg-danger",
        EstadoDashboard.Atrasada   => "bg-warning text-dark",
        EstadoDashboard.Finalizada => "bg-primary",
        EstadoDashboard.NoIniciada => "bg-secondary",
        _                          => "bg-success"
    };

    private static string NombreEstado(EstadoDashboard estado) => estado switch
    {
        EstadoDashboard.Critica    => "Crítica",
        EstadoDashboard.Atrasada   => "Atrasada",
        EstadoDashboard.Finalizada => "Finalizada",
        EstadoDashboard.NoIniciada => "Sin iniciar",
        _                          => "En línea"
    };
}
