@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject PortafolioService PortafolioSvc
@inject IJSRuntime JS
@using System.Globalization

<PageTitle>Centro de Control — RenergeIA</PageTitle>

<style>
    .cc-label { color:#111921;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em }
    .cc-valor { font-size:2rem;font-weight:700;color:#111921;line-height:1.1 }
    .cc-sub { color:#5f6b7a;font-size:0.76rem;margin-top:4px }
    .cc-head { background:#183963;border-radius:7px 7px 0 0;border:none }
    .cc-head span { color:white;font-size:0.82rem;letter-spacing:0.04em;font-weight:700 }
    .cc-pill { display:inline-block;border-radius:12px;padding:3px 10px;font-size:0.7rem;font-weight:600;white-space:nowrap }
    .cc-ayuda { cursor:pointer;color:#183963 }
    .cc-exp { font-size:0.74rem;background:#eef3f9;color:#183963;border-radius:6px;padding:6px 8px;margin-top:6px;line-height:1.45 }
    .cc-leyenda { display:flex;flex-wrap:wrap;gap:12px;font-size:0.72rem;color:#5f6b7a;margin-bottom:6px }
    .cc-leyenda i { display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:4px;vertical-align:-1px }
    .cc-fila { cursor:pointer }
</style>

@if (_cargando)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:60vh">
        <div class="text-center">
            <div class="spinner-border" role="status" style="width:3rem;height:3rem;color:#183963"></div>
            <p class="mt-3 fw-semibold" style="color:#183963">Calculando indicadores del portafolio...</p>
        </div>
    </div>
}
else if (_vm is null)
{
    <div class="alert" role="alert" style="background:#fff3cd;border:1px solid #ffc107;color:#856404;border-radius:8px;padding:1rem 1.25rem">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        No se pudieron calcular los indicadores del portafolio: @_error. Intenta recargar la página.
    </div>
}
else if (_vm.Proyectos.Count == 0)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:60vh">
        <div class="card shadow-sm text-center p-5" style="max-width:480px;width:100%;border-radius:12px;border-top:4px solid #183963">
            <i class="bi bi-folder-x" style="font-size:4rem;color:#D9D9D6"></i>
            <h3 class="mt-3" style="color:#183963">Sin proyectos registrados</h3>
            <p class="text-muted">Crea tu primer proyecto para iniciar el seguimiento del portafolio EPC fotovoltaico.</p>
            <a href="/proyectos/nuevo" class="btn btn-primary mt-2"><i class="bi bi-plus-lg me-2"></i>Crear Proyecto</a>
        </div>
    </div>
}
else
{
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="mb-1" style="color:#183963;font-size:1.6rem">Centro de Control RenergeIA</h1>
            <p class="mb-0" style="color:#111921;font-size:0.88rem">Estado de todos los proyectos EPC fotovoltaicos</p>
        </div>
        <span style="color:#111921;font-size:0.78rem">
            <i class="bi bi-clock me-1"></i>Corte: @_vm.FechaCorte.ToString("dd/MM/yyyy") · calculado @_vm.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")
        </span>
    </div>
    <div class="mb-3" style="border-bottom:2px solid #D9D9D6"></div>

    <!-- Filtros -->
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3 p-2" style="background:#f4f6f8;border-radius:8px">
        <i class="bi bi-funnel" style="color:#5f6b7a"></i>
        <select class="form-select form-select-sm" style="width:auto" value="@_filtro" @onchange="CambiarFiltro">
            <option value="">Todos los estados</option>
            @foreach (var e in Estados)
            {
                <option value="@e">@e</option>
            }
        </select>
        @if (string.IsNullOrEmpty(_filtro))
        {
            <span class="cc-sub mt-0">Sin filtros activos</span>
        }
        else
        {
            <span class="cc-sub mt-0">Filtro activo: <strong>@_filtro</strong> · <a href="javascript:void(0)" @onclick="QuitarFiltro">quitar</a></span>
        }
    </div>

    <!-- Tarjetas -->
    <div class="row g-3 mb-3">
        <div class="col-xl col-md-4 col-sm-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid #183963;border-radius:8px">
                <div class="card-body p-3">
                    <div class="cc-label mb-2">Proyectos</div>
                    <div class="cc-valor">@_vm.Proyectos.Count</div>
                    <div class="cc-sub">@Cuenta(p => p.EnEjecucion) en ejecución · @Cuenta("Por iniciar") por iniciar · @Cuenta("Sin información") sin información</div>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid #6ABF4B;border-radius:8px">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between"><span class="cc-label mb-2">Avance general</span>
                        <i class="bi bi-question-circle cc-ayuda" @onclick="() => _ayudaAvance = !_ayudaAvance" title="¿Cómo se calcula?"></i></div>
                    @if (_incluidos.Count == 0)
                    {
                        <div class="cc-valor" style="color:#6c757d;font-size:1.3rem">Sin información</div>
                        <div class="cc-sub">Ningún proyecto en ejecución tiene cronograma</div>
                    }
                    else
                    {
                        <div class="cc-valor" style="color:#4e9a35">@Pct(_avanceReal)</div>
                        <div class="cc-sub">programado @Pct(_avanceProg) · brecha <span style="color:@ColorBrecha(_avanceReal - _avanceProg);font-weight:600">@PP(_avanceReal - _avanceProg)</span></div>
                    }
                    @if (_ayudaAvance)
                    {
                        <div class="cc-exp">Promedio de @string.Join(", ", _incluidos.Select(p => p.Nombre)) @(_porPresupuesto ? "ponderado por presupuesto (un proyecto grande pesa más)" : "con el mismo peso, porque no todos tienen presupuesto cargado"). Brecha = real − programado, en puntos porcentuales (p.p.).</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid @(_tarde.Count > 0 ? "#dc3545" : "#6ABF4B");border-radius:8px">
                <div class="card-body p-3">
                    <div class="cc-label mb-2">Fechas límite</div>
                    <div class="cc-valor" style="color:@(_tarde.Count > 0 ? "#dc3545" : "#111921")">@_tarde.Count <span style="font-size:0.85rem;font-weight:600">terminarían tarde</span></div>
                    <div class="cc-sub">
                        @(_tarde.Count > 0 ? string.Join(" · ", _tarde.Select(p => $"{p.Nombre} +{p.RetrasoDias} d")) : "Todos dentro de la fecha contractual")
                        <br />@_cerca.Count con entrega en menos de 6 meses
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl col-md-6 col-sm-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid @(_sobrecosto > 0 ? "#dc3545" : "#6ABF4B");border-radius:8px">
                <div class="card-body p-3">
                    <div class="cc-label mb-2">Desviación del presupuesto</div>
                    @if (_conCostos.Count == 0)
                    {
                        <div class="cc-valor" style="color:#6c757d;font-size:1.3rem">Sin información</div>
                        <div class="cc-sub">Ningún proyecto tiene presupuesto cargado</div>
                    }
                    else
                    {
                        <div class="cc-valor" style="color:@(_sobrecosto > 0 ? "#dc3545" : "#4e9a35")">@(_sobrecosto > 0 ? "+" : "")@Millones(_sobrecosto)</div>
                        <div class="cc-sub">@(_presupuestoTotal > 0 ? (_sobrecosto / _presupuestoTotal * 100).ToString("0.0", Es) : "0") % sobre @Millones(_presupuestoTotal) · @_conCostos.Count proyecto@(_conCostos.Count == 1 ? "" : "s") con presupuesto</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl col-md-6 col-sm-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid @(_vencidas > 0 ? "#dc3545" : "#ffc107");border-radius:8px">
                <div class="card-body p-3">
                    <div class="cc-label mb-2">Bloqueos abiertos</div>
                    <div class="cc-valor" style="color:@(_vencidas > 0 ? "#dc3545" : "#111921")">@_abiertas</div>
                    <div class="cc-sub">@_vencidas con fecha compromiso vencida · restricciones abiertas o en gestión</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficas -->
    <div class="row g-3 mb-3">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100" style="border-radius:8px;border:1px solid #D9D9D6">
                <div class="card-header py-2 px-3 cc-head"><span><i class="bi bi-pie-chart-fill me-2"></i>ESTADO DE SALUD DEL PORTAFOLIO</span></div>
                <div class="card-body p-3">
                    <div style="position:relative;height:220px">
                        <canvas id="portDona" role="img" aria-label="Cantidad de proyectos por estado"></canvas>
                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none">
                            <div style="font-size:1.8rem;font-weight:700;color:#111921">@_vm.Proyectos.Count</div>
                            <div class="cc-sub mt-0">proyectos</div>
                        </div>
                    </div>
                    <div class="cc-leyenda justify-content-center mt-2 mb-0">
                        @foreach (var e in Estados)
                        {
                            <a href="javascript:void(0)" style="color:#5f6b7a;text-decoration:none" @onclick="() => Filtrar(e)"><i style="background:@ColorEstado(e)"></i>@e @Cuenta(e)</a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card shadow-sm h-100" style="border-radius:8px;border:1px solid #D9D9D6">
                <div class="card-header py-2 px-3 cc-head"><span><i class="bi bi-cash-stack me-2"></i>PRESUPUESTO APROBADO VS COSTO ESTIMADO AL CIERRE</span></div>
                <div class="card-body p-3">
                    @if (!Filtrados.Any(p => p.TieneCostos))
                    {
                        <p class="text-muted mb-0" style="font-size:0.85rem">Ningún proyecto@(string.IsNullOrEmpty(_filtro) ? "" : " de este filtro") tiene presupuesto cargado.</p>
                    }
                    else
                    {
                        <div class="cc-leyenda">
                            <span><i style="background:#B4B2A9"></i>Presupuesto aprobado</span>
                            <span><i style="background:#183963"></i>Ejecutado a la fecha</span>
                            <span><i style="background:#6ABF4B"></i>Al cierre dentro del presupuesto</span>
                            <span><i style="background:#E24B4A"></i>Al cierre con sobrecosto</span>
                        </div>
                        <div style="position:relative;height:220px"><canvas id="portPresupuesto" role="img" aria-label="Presupuesto, ejecutado y costo al cierre por proyecto"></canvas></div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3" style="border-radius:8px;border:1px solid #D9D9D6">
        <div class="card-header py-2 px-3 cc-head"><span><i class="bi bi-bar-chart-steps me-2"></i>AVANCE REAL VS PROGRAMADO POR PROYECTO</span></div>
        <div class="card-body p-3">
            @if (!Filtrados.Any(p => p.TieneCronograma))
            {
                <p class="text-muted mb-0" style="font-size:0.85rem">Ningún proyecto@(string.IsNullOrEmpty(_filtro) ? "" : " de este filtro") tiene cronograma cargado.</p>
            }
            else
            {
                <div class="cc-leyenda">
                    <span><i style="background:#D3D1C7"></i>Programado a hoy</span>
                    <span><i style="background:#6ABF4B"></i>Real saludable</span>
                    <span><i style="background:#ffc107"></i>Real en riesgo</span>
                    <span><i style="background:#dc3545"></i>Real crítico</span>
                    <span class="ms-auto">Clic en una barra para abrir el proyecto</span>
                </div>
                <div style="position:relative;height:@(Math.Max(160, Filtrados.Count(p => p.TieneCronograma) * 44 + 50))px"><canvas id="portAvance" role="img" aria-label="Avance real y programado por proyecto"></canvas></div>
            }
        </div>
    </div>

    <!-- Tabla -->
    <div class="card shadow-sm mb-3" style="border-radius:8px;border:1px solid #D9D9D6">
        <div class="card-header py-2 px-3 cc-head">
            <span><i class="bi bi-list-stars me-2"></i>PROYECTOS
                <span class="badge ms-2" style="background:rgba(255,255,255,0.2);font-size:0.72rem;border-radius:10px">@Filtrados.Count</span></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="font-size:0.82rem">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:170px;padding:10px 14px">Proyecto</th>
                            <th>Estado</th>
                            <th>Dato</th>
                            <th style="text-align:right">Prog.</th>
                            <th style="text-align:right">Real</th>
                            <th style="text-align:right">Brecha</th>
                            <th>Fecha contractual</th>
                            <th>Plazo</th>
                            <th style="text-align:right">Costo al cierre</th>
                            <th style="min-width:180px">Principal bloqueo</th>
                            <th>Último dato</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Filtrados)
                        {
                            <tr class="cc-fila" @onclick="() => Abrir(p)" title="Abrir dashboard de @p.Nombre">
                                <td style="padding:9px 14px">
                                    <div class="fw-semibold" style="color:#183963">@p.Nombre</div>
                                    <div style="font-size:0.72rem;color:#5f6b7a">@p.Codigo@(p.CapacidadKWp >= 1000 ? $" · {(p.CapacidadKWp / 1000m).ToString("0.0", Es)} MWp" : p.CapacidadKWp > 0 ? $" · {p.CapacidadKWp.ToString("N1", Es)} kWp" : "")</div>
                                </td>
                                <td><span class="cc-pill" style="@EstiloEstado(p.Estado)" title="@p.Motivo">@p.Estado</span></td>
                                <td><span class="cc-pill" style="@EstiloDato(p.CalidadDato)">@p.CalidadDato</span></td>
                                @if (!p.TieneCronograma)
                                {
                                    <td style="text-align:right">—</td><td style="text-align:right">—</td><td style="text-align:right;color:#6c757d">Sin inf.</td>
                                }
                                else
                                {
                                    <td style="text-align:right">@Pct(p.AvanceProgramado)</td>
                                    <td style="text-align:right">@Pct(p.AvanceReal)</td>
                                    <td style="text-align:right;font-weight:600;color:@(p.Estado == "Por iniciar" ? "#6c757d" : ColorBrecha(p.Brecha))">@(p.Estado == "Por iniciar" ? "—" : PP(p.Brecha))</td>
                                }
                                <td>@(p.FechaContractual?.ToString("dd/MM/yy") ?? "—")</td>
                                <td>
                                    @if (p.RetrasoDias is null)
                                    {
                                        <span style="color:#6c757d">Sin inf.</span>
                                    }
                                    else if (p.RetrasoDias > 0)
                                    {
                                        <span style="color:#dc3545;font-weight:600">+@p.RetrasoDias d</span>
                                        <div style="font-size:0.7rem;color:#5f6b7a">@p.FechaProyectada?.ToString("dd/MM/yy")</div>
                                    }
                                    else
                                    {
                                        <span>A tiempo</span>
                                    }
                                </td>
                                <td style="text-align:right">
                                    @if (!p.TieneCostos)
                                    {
                                        <span style="color:#6c757d">Sin inf.</span>
                                    }
                                    else
                                    {
                                        <span style="color:@(p.Sobrecosto > 0 ? "#dc3545" : "#111921")">@Millones(p.EstimadoCierre)</span>
                                        @if (p.Sobrecosto > 0)
                                        {
                                            <div style="font-size:0.7rem;color:#dc3545">+@Millones(p.Sobrecosto)</div>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (p.PrincipalBloqueo is null)
                                    {
                                        <span style="color:#6c757d">—</span>
                                    }
                                    else
                                    {
                                        <div>@Recortar(p.PrincipalBloqueo, 70)</div>
                                        <div style="font-size:0.7rem;color:@(p.BloqueoDiasVencido > 0 ? "#dc3545" : "#5f6b7a")">
                                            @(p.ResponsableBloqueo ?? "Sin responsable")@(p.BloqueoDiasVencido > 0 ? $" · vencido hace {p.BloqueoDiasVencido} d" : "")
                                        </div>
                                    }
                                </td>
                                <td style="font-size:0.76rem">@(p.UltimoDatoAvance?.ToString("dd/MM/yy") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Resumen ejecutivo -->
    <div class="card shadow-sm mb-3" style="border-radius:8px;border:1px solid #D9D9D6">
        <div class="card-header py-2 px-3 cc-head"><span><i class="bi bi-file-text-fill me-2"></i>RESUMEN EJECUTIVO</span></div>
        <div class="card-body p-3" style="font-size:0.88rem;line-height:1.7;color:#111921">
            @foreach (var p in _vm.Proyectos.Where(p => p.Estado is "Crítico" or "En riesgo").OrderBy(p => p.Estado == "Crítico" ? 0 : 1).ThenBy(p => p.Brecha))
            {
                <div class="mb-2">
                    <i class="bi @(p.Estado == "Crítico" ? "bi-exclamation-octagon-fill" : "bi-exclamation-triangle-fill") me-1" style="color:@(p.Estado == "Crítico" ? "#dc3545" : "#d39e00")"></i>
                    <a href="@p.UrlDashboard" style="color:#183963;font-weight:600">@p.Nombre</a> está <strong>@p.Estado.ToLower()</strong>: @p.Motivo.
                    Avance real @Pct(p.AvanceReal) frente a @Pct(p.AvanceProgramado) programado@(p.TieneCostos && p.Sobrecosto > 0 ? $"; sobrecosto estimado de {Millones(p.Sobrecosto)}" : !p.TieneCostos && p.Ejecutado + p.Comprometido > 0 ? $"; tiene {Millones(p.Ejecutado + p.Comprometido)} pagados o comprometidos sin presupuesto cargado" : "").
                    @if (p.PrincipalBloqueo is not null)
                    {
                        <span>Bloqueo registrado@(string.IsNullOrWhiteSpace(p.BloqueoNumero) ? "" : $" ({p.BloqueoNumero})"): @Recortar(p.PrincipalBloqueo, 140)@(p.BloqueoDiasVencido > 0 ? $", vencido hace {p.BloqueoDiasVencido} días" : "").</span>
                        @if (!string.IsNullOrWhiteSpace(p.PlanBloqueo))
                        {
                            <span> Plan registrado: @Recortar(p.PlanBloqueo, 140).</span>
                        }
                    }
                    else
                    {
                        <span style="color:#5f6b7a"> No hay restricciones abiertas que expliquen la desviación: registrarlas en el proyecto.</span>
                    }
                </div>
            }
            @{ var sanos = _vm.Proyectos.Where(p => p.Estado == "Saludable").ToList(); }
            @if (sanos.Count > 0)
            {
                <div class="mb-2"><i class="bi bi-check-circle-fill me-1" style="color:#6ABF4B"></i>@string.Join(", ", sanos.Select(p => p.Nombre)) avanza@(sanos.Count > 1 ? "n" : "") dentro de las tolerancias.@(sanos.Any(p => p.CalidadDato != "Actualizado") ? $" Ojo: {string.Join(", ", sanos.Where(p => p.CalidadDato != "Actualizado").Select(p => p.Nombre))} sin datos de avance de los últimos {PortafolioService.DiasDatoActualizado} días." : "")</div>
            }
            @foreach (var p in _vm.Proyectos.Where(p => p.Estado == "Por iniciar"))
            {
                <div class="mb-2"><i class="bi bi-calendar-event me-1" style="color:#183963"></i>@p.Nombre: @p.Motivo.</div>
            }
            @foreach (var p in _vm.Proyectos.Where(p => p.Estado == "Sin información"))
            {
                <div class="mb-2" style="color:#5f6b7a"><i class="bi bi-database-x me-1"></i>@p.Nombre @p.Motivo; no entra en los indicadores generales.</div>
            }
        </div>
    </div>

    <div class="cc-sub mb-4">
        <i class="bi bi-info-circle me-1"></i>Criterios (propuestos, pendientes de aprobación): <strong>crítico</strong> si el cronograma vigente termina más de 30 días después de la fecha contractual, la brecha es de −10 p.p. o peor, o hay un bloqueo vencido con brecha de −3 p.p. o peor;
        <strong>en riesgo</strong> si termina después de la fecha contractual o la brecha es de −3 p.p. o peor. Dato <strong>desactualizado</strong>: sin avance registrado en más de @PortafolioService.DiasDatoActualizado días.
        Costo al cierre = presupuesto + lo que el ejecutado y el comprometido de cada código superan su presupuesto. Montos en millones de pesos (USD a la TRM del proyecto).
    </div>
}

@code {
    private static readonly CultureInfo Es = new("es-CO");
    private static readonly string[] Estados = ["Saludable", "En riesgo", "Crítico", "Por iniciar", "Sin información"];

    private PortafolioVM? _vm;
    private bool _cargando = true;
    private string? _error;
    private string _filtro = "";
    private bool _ayudaAvance;
    private bool _dibujar;
    private DotNetObjectReference<Home>? _ref;

    private List<IndicadoresProyecto> _incluidos = [], _tarde = [], _cerca = [], _conCostos = [];
    private bool _porPresupuesto;
    private decimal _avanceReal, _avanceProg, _sobrecosto, _presupuestoTotal;
    private int _abiertas, _vencidas;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _vm = await PortafolioSvc.ObtenerAsync();
            Totales();
            _dibujar = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _cargando = false;
    }

    private void Totales()
    {
        if (_vm is null) return;
        var hoy = _vm.FechaCorte;
        _incluidos = _vm.Proyectos.Where(p => p.EnEjecucion && p.TieneCronograma).ToList();
        _porPresupuesto = _incluidos.Count > 0 && _incluidos.All(p => p.Presupuesto > 0);
        decimal Peso(IndicadoresProyecto p) => _porPresupuesto ? p.Presupuesto : 1m;
        var suma = _incluidos.Sum(Peso);
        _avanceReal = suma > 0 ? Math.Round(_incluidos.Sum(p => p.AvanceReal * Peso(p)) / suma, 1) : 0;
        _avanceProg = suma > 0 ? Math.Round(_incluidos.Sum(p => p.AvanceProgramado * Peso(p)) / suma, 1) : 0;
        _tarde = _vm.Proyectos.Where(p => p.RetrasoDias > 0).OrderByDescending(p => p.RetrasoDias).ToList();
        _cerca = _vm.Proyectos.Where(p => p.FechaContractual is { } f && f >= hoy && (f - hoy).TotalDays <= 183 && p.Estado != "Sin información").ToList();
        _conCostos = _vm.Proyectos.Where(p => p.TieneCostos).ToList();
        _sobrecosto = _conCostos.Sum(p => p.Sobrecosto);
        _presupuestoTotal = _conCostos.Sum(p => p.Presupuesto);
        _abiertas = _vm.Proyectos.Sum(p => p.RestriccionesAbiertas);
        _vencidas = _vm.Proyectos.Sum(p => p.RestriccionesVencidas);
    }

    private List<IndicadoresProyecto> Filtrados =>
        _vm?.Proyectos.Where(p => string.IsNullOrEmpty(_filtro) || p.Estado == _filtro)
            .OrderBy(p => Array.IndexOf(["Crítico", "En riesgo", "Saludable", "Por iniciar", "Sin información"], p.Estado))
            .ThenBy(p => p.Brecha).ToList() ?? [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dibujar || _vm is null) return;
        _dibujar = false;
        _ref ??= DotNetObjectReference.Create(this);
        var lista = Filtrados;
        var conCostos = lista.Where(p => p.TieneCostos).ToList();
        var conCrono = lista.Where(p => p.TieneCronograma).ToList();
        await JS.InvokeVoidAsync("renderPortafolio", _ref,
            new
            {
                labels = Estados,
                data = Estados.Select(e => _vm.Proyectos.Count(p => p.Estado == e)).ToArray(),
                colors = Estados.Select(ColorEstado).ToArray()
            },
            new
            {
                labels = conCostos.Select(p => p.Nombre).ToArray(),
                presupuesto = conCostos.Select(p => Math.Round(p.Presupuesto)).ToArray(),
                ejecutado = conCostos.Select(p => Math.Round(p.Ejecutado)).ToArray(),
                cierre = conCostos.Select(p => Math.Round(p.EstimadoCierre)).ToArray(),
                sobrecosto = conCostos.Select(p => p.Sobrecosto > 0).ToArray(),
                urls = conCostos.Select(p => p.UrlDashboard).ToArray()
            },
            new
            {
                labels = conCrono.Select(p => p.Nombre).ToArray(),
                programado = conCrono.Select(p => p.AvanceProgramado).ToArray(),
                real = conCrono.Select(p => p.AvanceReal).ToArray(),
                colores = conCrono.Select(p => ColorEstado(p.Estado)).ToArray(),
                textos = conCrono.Select(p => p.Estado == "Por iniciar" ? $"Por iniciar · {p.Motivo}" : $"Brecha {PP(p.Brecha)} · {p.Estado}").ToArray(),
                urls = conCrono.Select(p => p.UrlDashboard).ToArray()
            });
    }

    [JSInvokable]
    public Task FiltrarEstado(string estado) { Filtrar(estado); StateHasChanged(); return Task.CompletedTask; }

    private void Filtrar(string estado) { _filtro = _filtro == estado ? "" : estado; _dibujar = true; }
    private void QuitarFiltro() { _filtro = ""; _dibujar = true; }
    private void CambiarFiltro(ChangeEventArgs e) { _filtro = e.Value?.ToString() ?? ""; _dibujar = true; }
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private void Abrir(IndicadoresProyecto p) => Nav.NavigateTo(p.UrlDashboard);

    private int Cuenta(string estado) => _vm?.Proyectos.Count(p => p.Estado == estado) ?? 0;
    private int Cuenta(Func<IndicadoresProyecto, bool> f) => _vm?.Proyectos.Count(f) ?? 0;

    private static string Pct(decimal v) => v.ToString("0.0", Es) + " %";
    private static string PP(decimal v) => (v > 0 ? "+" : "") + v.ToString("0.0", Es) + " p.p.";
    private static string Millones(decimal v) => "$" + Math.Round(v / 1_000_000m).ToString("N0", Es) + " M";
    private static string Recortar(string s, int n) => s.Length > n ? s[..n].TrimEnd() + "…" : s;
    private static string ColorBrecha(decimal b) => b <= -10 ? "#dc3545" : b <= -3 ? "#d39e00" : "#4e9a35";

    private static string ColorEstado(string e) => e switch
    {
        "Saludable" => "#6ABF4B",
        "En riesgo" => "#ffc107",
        "Crítico" => "#dc3545",
        "Por iniciar" => "#7FA3CF",
        _ => "#adb5bd"
    };

    private static string EstiloEstado(string e) => e switch
    {
        "Saludable" => "background:#e6f4e0;color:#3d7a28",
        "En riesgo" => "background:#fff3cd;color:#856404",
        "Crítico" => "background:#f8d7da;color:#a52834",
        "Por iniciar" => "background:#e3ecf7;color:#183963",
        _ => "background:#eceeef;color:#5f6b7a"
    };

    private static string EstiloDato(string d) => d switch
    {
        "Actualizado" => "background:#e6f4e0;color:#3d7a28",
        "Desactualizado" => "background:#fff3cd;color:#856404",
        _ => "background:#eceeef;color:#5f6b7a"
    };

    public void Dispose() => _ref?.Dispose();
}
