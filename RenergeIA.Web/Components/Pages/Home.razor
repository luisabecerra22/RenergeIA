@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject HomeDashboardService HomeSvc

<PageTitle>Centro de Control — RenergeIA</PageTitle>

@if (_cargando)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:60vh">
        <div class="text-center">
            <div class="spinner-border" role="status" style="width:3rem;height:3rem;color:#183963"></div>
            <p class="mt-3 fw-semibold" style="color:#183963">Cargando datos del portafolio...</p>
        </div>
    </div>
}
else if (_vm is null)
{
    <div class="alert" role="alert"
         style="background:#fff3cd;border:1px solid #ffc107;color:#856404;border-radius:8px;padding:1rem 1.25rem">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        No se pudo cargar el resumen ejecutivo. Intenta recargar la página.
    </div>
}
else if (_vm.TotalProyectos == 0)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:60vh">
        <div class="card shadow-sm text-center p-5"
             style="max-width:480px;width:100%;border-radius:12px;border-top:4px solid #183963">
            <i class="bi bi-folder-x" style="font-size:4rem;color:#D9D9D6"></i>
            <h3 class="mt-3" style="color:#183963">Sin proyectos registrados</h3>
            <p class="text-muted">Crea tu primer proyecto para iniciar el seguimiento del portafolio EPC fotovoltaico.</p>
            <a href="/proyectos/nuevo" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-2"></i>Crear Proyecto
            </a>
        </div>
    </div>
}
else
{
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="mb-1" style="color:#183963;font-size:1.6rem">Centro de Control RenergeIA</h1>
            <p class="mb-0" style="color:#111921;font-size:0.88rem">Resumen ejecutivo de proyectos EPC fotovoltaicos</p>
        </div>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span style="color:#111921;font-size:0.78rem">
                <i class="bi bi-clock me-1"></i>Actualizado: @_vm.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")
            </span>
            <span class="badge px-3 py-2"
                  style="background:@BadgeBg;color:@BadgeFg;font-size:0.82rem;border-radius:20px;letter-spacing:0.03em">
                <i class="bi @BadgeIcon me-1"></i>@BadgeText
            </span>
        </div>
    </div>
    <div class="mb-4" style="border-bottom:2px solid #D9D9D6"></div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid #183963;border-radius:8px">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span style="color:#111921;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em">Proyectos Activos</span>
                        <div style="background:#183963;border-radius:8px;width:34px;height:34px;display:flex;align-items:center;justify-content:center">
                            <i class="bi bi-briefcase-fill" style="color:white;font-size:0.9rem"></i>
                        </div>
                    </div>
                    <div style="font-size:2.2rem;font-weight:700;color:#111921;line-height:1.1">@_vm.TotalProyectosActivos</div>
                    <div style="color:#111921;font-size:0.78rem;margin-top:4px">
                        de @_vm.TotalProyectos proyecto@(_vm.TotalProyectos != 1 ? "s" : "") en el portafolio
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid @SpiColor;border-radius:8px">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span style="color:#111921;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em">Avance Global Real</span>
                        <div style="background:@SpiColor;border-radius:8px;width:34px;height:34px;display:flex;align-items:center;justify-content:center">
                            <i class="bi bi-bar-chart-fill" style="color:white;font-size:0.9rem"></i>
                        </div>
                    </div>
                    <div style="font-size:2.2rem;font-weight:700;color:#111921;line-height:1.1">@_vm.AvanceGlobalReal.ToString("F1")%</div>
                    <div style="color:#111921;font-size:0.78rem;margin-top:4px">Programado: @_vm.AvanceGlobalProgramado.ToString("F1")%</div>
                    <div class="progress mt-2" style="height:4px;background:#D9D9D6">
                        <div class="progress-bar" role="progressbar"
                             style="width:@Bar(_vm.AvanceGlobalReal)%;background:@SpiColor"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid @SpiColor;border-radius:8px">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span style="color:#111921;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em">SPI Global Promedio</span>
                        <div style="background:@SpiColor;border-radius:8px;width:34px;height:34px;display:flex;align-items:center;justify-content:center">
                            <i class="bi bi-speedometer2" style="color:white;font-size:0.9rem"></i>
                        </div>
                    </div>
                    <div style="font-size:2.2rem;font-weight:700;color:@SpiColor;line-height:1.1">
                        @(_vm.SpiGlobalPromedio > 0 ? _vm.SpiGlobalPromedio.ToString("F2") : "—")
                    </div>
                    <div style="color:#111921;font-size:0.78rem;margin-top:4px">@SpiTexto</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid @AtrasoColor;border-radius:8px">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span style="color:#111921;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em">Actividades Atrasadas</span>
                        <div style="background:@AtrasoColor;border-radius:8px;width:34px;height:34px;display:flex;align-items:center;justify-content:center">
                            <i class="bi bi-clock-history" style="color:white;font-size:0.9rem"></i>
                        </div>
                    </div>
                    <div style="font-size:2.2rem;font-weight:700;color:#111921;line-height:1.1">@_vm.TotalActividadesAtrasadas</div>
                    <div style="color:#111921;font-size:0.78rem;margin-top:4px">En proyectos activos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var card in EstadoCards)
        {
            <div class="col-xl-3 col-md-6">
                <div class="card shadow-sm text-center py-4 px-3"
                     style="border-top:4px solid @card.Color;border-radius:8px">
                    <div class="d-flex align-items-center justify-content-center gap-3 mb-2 flex-wrap">
                        <i class="bi @card.Icono"
                           style="font-size:3rem;color:@card.Color;line-height:1;flex-shrink:0"></i>
                        <div style="font-size:3rem;font-weight:700;color:@card.Color;line-height:1">@card.Cantidad</div>
                    </div>
                    <div style="font-size:0.78rem;font-weight:700;color:#111921;text-transform:uppercase;letter-spacing:0.06em;margin-top:4px">
                        @card.Titulo
                    </div>
                    <div style="font-size:0.72rem;color:#111921;margin-top:3px">@Pct(card.Cantidad)% del total activo</div>
                </div>
            </div>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card shadow-sm" style="border-radius:8px;border:1px solid #D9D9D6">
                <div class="card-header py-2 px-4" style="background:#183963;border-radius:7px 7px 0 0;border:none">
                    <span class="fw-bold" style="color:white;font-size:0.82rem;letter-spacing:0.04em">
                        <i class="bi bi-file-text-fill me-2"></i>RESUMEN EJECUTIVO
                    </span>
                </div>
                <div class="card-body p-4">
                    <p style="color:#111921;font-size:0.92rem;line-height:1.8;margin-bottom:1.25rem">@_vm.ResumenEjecutivoTexto</p>
                    <div class="row g-0 pt-3" style="border-top:1px solid #D9D9D6">
                        <div class="col-4 text-center">
                            <div style="font-size:1.1rem;font-weight:700;color:#183963">@_vm.AvanceGlobalReal.ToString("F1")%</div>
                            <div style="font-size:0.7rem;color:#111921">Avance Real</div>
                            <div class="progress mt-1" style="height:3px;background:#D9D9D6">
                                <div class="progress-bar" style="width:@Bar(_vm.AvanceGlobalReal)%;background:#183963"></div>
                            </div>
                        </div>
                        <div class="col-4 text-center" style="border-left:1px solid #D9D9D6;border-right:1px solid #D9D9D6">
                            <div style="font-size:1.1rem;font-weight:700;color:#111921">@_vm.AvanceGlobalProgramado.ToString("F1")%</div>
                            <div style="font-size:0.7rem;color:#111921">Programado</div>
                            <div class="progress mt-1" style="height:3px;background:#D9D9D6">
                                <div class="progress-bar" style="width:@Bar(_vm.AvanceGlobalProgramado)%;background:#adb5bd"></div>
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div style="font-size:1.1rem;font-weight:700;color:@DesvColor">@DesvPref@_vm.DesviacionGlobal.ToString("F1")%</div>
                            <div style="font-size:0.7rem;color:#111921">Desviación</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_vm.ProyectosAtencion.Any())
    {
        <div class="card shadow-sm mb-4" style="border-radius:8px;border:1px solid #D9D9D6">
            <div class="card-header py-2 px-4" style="background:#183963;border-radius:7px 7px 0 0;border:none">
                <span class="fw-bold" style="color:white;font-size:0.82rem;letter-spacing:0.04em">
                    <i class="bi bi-list-stars me-2"></i>PROYECTOS EN SEGUIMIENTO
                    <span class="badge ms-2" style="background:rgba(255,255,255,0.2);font-size:0.72rem;border-radius:10px">
                        @_vm.ProyectosAtencion.Count
                    </span>
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:0.84rem">
                        <thead class="table-light">
                            <tr>
                                <th style="min-width:200px;padding:10px 16px">Proyecto</th>
                                <th style="min-width:100px;text-align:center">Estado</th>
                                <th style="min-width:130px">Avance Prog.</th>
                                <th style="min-width:130px">Avance Real</th>
                                <th style="min-width:90px;text-align:center">Desviación</th>
                                <th style="min-width:70px;text-align:center">SPI</th>
                                <th style="min-width:80px;text-align:center">Atrasadas</th>
                                <th style="min-width:110px;text-align:center">Último Registro</th>
                                <th style="min-width:120px;text-align:center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _vm.ProyectosAtencion)
                            {
                                <tr style="@RowBg(p)">
                                    <td style="padding:10px 16px;vertical-align:middle">
                                        <div class="fw-semibold" style="color:#183963">@p.Nombre</div>
                                        <div style="font-size:0.75rem;color:#111921">@p.Codigo</div>
                                    </td>
                                    <td style="text-align:center;vertical-align:middle">
                                        <span class="badge" style="background:@ClsBg(p);color:@ClsFg(p);border-radius:12px;padding:4px 10px;font-size:0.7rem">
                                            @ClsLabel(p)
                                        </span>
                                    </td>
                                    <td style="vertical-align:middle">
                                        <div style="font-size:0.8rem;margin-bottom:3px">@p.AvanceProgramado.ToString("F1")%</div>
                                        <div class="progress" style="height:4px;background:#e9ecef">
                                            <div class="progress-bar" style="width:@Bar(p.AvanceProgramado)%;background:#adb5bd"></div>
                                        </div>
                                    </td>
                                    <td style="vertical-align:middle">
                                        <div style="font-size:0.8rem;margin-bottom:3px">@p.AvanceReal.ToString("F1")%</div>
                                        <div class="progress" style="height:4px;background:#e9ecef">
                                            <div class="progress-bar" style="width:@Bar(p.AvanceReal)%;background:#183963"></div>
                                        </div>
                                    </td>
                                    <td style="text-align:center;vertical-align:middle;font-weight:600;color:@DesvColorP(p)">
                                        @DesvPrefP(p)@p.Desviacion.ToString("F1")%
                                    </td>
                                    <td style="text-align:center;vertical-align:middle">
                                        <span style="font-weight:700;font-size:0.9rem;color:@SpiColorP(p)">@SpiTextoP(p)</span>
                                    </td>
                                    <td style="text-align:center;vertical-align:middle">
                                        @if (p.ActividadesAtrasadas > 0)
                                        {
                                            <span class="badge" style="background:#dc3545;color:white;border-radius:12px;min-width:28px">
                                                @p.ActividadesAtrasadas
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#6ABF4B;font-weight:600">0</span>
                                        }
                                    </td>
                                    <td style="text-align:center;vertical-align:middle;color:#111921;font-size:0.78rem">
                                        @(p.UltimoInforme.HasValue ? p.UltimoInforme.Value.ToString("dd/MM/yyyy") : "Sin registros")
                                    </td>
                                    <td style="text-align:center;vertical-align:middle">
                                        <a href="@p.UrlDashboard" class="btn btn-sm"
                                           style="background:#183963;color:white;border-radius:6px;font-size:0.76rem;padding:4px 10px;border:none">
                                            <i class="bi bi-arrow-right-circle me-1"></i>Dashboard
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    private HomeDashboardVM? _vm;
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        _vm = await HomeSvc.ObtenerAsync();
        _cargando = false;
    }

    private string BadgeBg => _vm?.EstadoGeneral switch
    {
        "Saludable" => "#6ABF4B",
        "EnRiesgo"  => "#ffc107",
        "Critico"   => "#dc3545",
        _           => "#6c757d"
    } ?? "#6c757d";

    private string BadgeFg => _vm?.EstadoGeneral == "EnRiesgo" ? "#111921" : "white";

    private string BadgeText => _vm?.EstadoGeneral switch
    {
        "Saludable" => "Saludable",
        "EnRiesgo"  => "En Riesgo",
        "Critico"   => "Crítico",
        _           => "Sin datos"
    } ?? "Sin datos";

    private string BadgeIcon => _vm?.EstadoGeneral switch
    {
        "Saludable" => "bi-check-circle-fill",
        "EnRiesgo"  => "bi-exclamation-triangle-fill",
        "Critico"   => "bi-x-octagon-fill",
        _           => "bi-dash-circle-fill"
    } ?? "bi-dash-circle-fill";

    private string SpiColor => _vm?.SpiGlobalPromedio >= 0.95m ? "#6ABF4B"
        : _vm?.SpiGlobalPromedio >= 0.85m ? "#ffc107"
        : _vm?.SpiGlobalPromedio  > 0m    ? "#dc3545"
        : "#6c757d";

    private string SpiTexto => _vm?.SpiGlobalPromedio >= 0.95m ? "En línea con el programa"
        : _vm?.SpiGlobalPromedio >= 0.85m ? "Leve retraso — atención"
        : _vm?.SpiGlobalPromedio  > 0m    ? "Atraso significativo"
        : "Sin datos disponibles";

    private string DesvColor => _vm?.DesviacionGlobal >= 0 ? "#6ABF4B" : "#dc3545";
    private string DesvPref  => _vm?.DesviacionGlobal >= 0 ? "+" : "";
    private string AtrasoColor => _vm?.TotalActividadesAtrasadas == 0 ? "#6ABF4B" : "#dc3545";

    private (string Titulo, int Cantidad, string Color, string Icono)[] EstadoCards =>
    [
        ("Saludables", _vm?.TotalProyectosSaludables ?? 0, "#6ABF4B", "bi-check-circle-fill"),
        ("En Riesgo",  _vm?.TotalProyectosEnRiesgo   ?? 0, "#ffc107", "bi-exclamation-triangle-fill"),
        ("Críticos",   _vm?.TotalProyectosCriticos   ?? 0, "#dc3545", "bi-x-octagon-fill"),
        ("Sin datos",  _vm?.TotalProyectosSinDatos   ?? 0, "#6c757d", "bi-dash-circle-fill"),
    ];

    private int Pct(int cantidad) =>
        _vm?.TotalProyectosActivos > 0
            ? (int)Math.Round((decimal)cantidad / _vm.TotalProyectosActivos * 100, 0)
            : 0;

    private static int Bar(decimal value) => (int)Math.Min(100, Math.Max(0, value));

    private static string RowBg(ProyectoAtencionVM p) => p.Clasificacion switch
    {
        "Critico"  => "background:rgba(220,53,69,0.04)",
        "EnRiesgo" => "background:rgba(255,193,7,0.05)",
        _          => ""
    };

    private static string ClsBg(ProyectoAtencionVM p) => p.Clasificacion switch
    {
        "Critico"   => "#dc3545",
        "EnRiesgo"  => "#ffc107",
        "Saludable" => "#6ABF4B",
        _           => "#6c757d"
    };

    private static string ClsFg(ProyectoAtencionVM p) =>
        p.Clasificacion == "EnRiesgo" ? "#111921" : "white";

    private static string ClsLabel(ProyectoAtencionVM p) => p.Clasificacion switch
    {
        "Critico"   => "Crítico",
        "EnRiesgo"  => "En Riesgo",
        "Saludable" => "Saludable",
        _           => "Sin datos"
    };

    private static string DesvColorP(ProyectoAtencionVM p) => p.Desviacion >= 0 ? "#6ABF4B" : "#dc3545";
    private static string DesvPrefP(ProyectoAtencionVM p)  => p.Desviacion >= 0 ? "+" : "";

    private static string SpiColorP(ProyectoAtencionVM p) =>
        p.Clasificacion == "SinDatos" ? "#6c757d"
        : p.SPI >= 0.95m ? "#6ABF4B"
        : p.SPI >= 0.85m ? "#ffc107"
        : "#dc3545";

    private static string SpiTextoP(ProyectoAtencionVM p) =>
        p.Clasificacion == "SinDatos" ? "—" : p.SPI.ToString("F2");
}
