@page "/proyectos/{ProyectoId:int}/equipos/nuevo"
@page "/proyectos/{ProyectoId:int}/equipos/{EquipoId:int}/editar"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation

<PageTitle>@(_esNuevo ? "Agregar Equipo" : "Editar Equipo") — RenergeIA</PageTitle>

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/proyectos/@ProyectoId/equipos" class="btn btn-sm btn-outline-secondary">&larr; Volver</a>
    <h1 class="h3 mb-0">@(_esNuevo ? "Agregar equipo al proyecto" : "Editar equipo")</h1>
</div>

@if (_form is not null)
{
    <div class="card shadow-sm" style="max-width: 680px;">
        <div class="card-body">
            <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Código *</label>
                        <InputText class="form-control" @bind-Value="_form.Codigo" />
                        <ValidationMessage For="() => _form.Codigo" class="text-danger small" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nombre *</label>
                        <InputText class="form-control" @bind-Value="_form.Nombre" />
                        <ValidationMessage For="() => _form.Nombre" class="text-danger small" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tipo de equipo</label>
                        <InputSelect class="form-select" @bind-Value="_form.TipoEquipo">
                            @foreach (var t in Enum.GetValues<TipoEquipo>())
                            {
                                <option value="@t">@EnumDisplay.Mostrar(t)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Marca</label>
                        <InputText class="form-control" @bind-Value="_form.Marca" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Modelo</label>
                        <InputText class="form-control" @bind-Value="_form.Modelo" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Número de serie</label>
                        <InputText class="form-control" @bind-Value="_form.NumeroSerie" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Propietario</label>
                        <InputText class="form-control" @bind-Value="_form.Propietario" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha de ingreso</label>
                        <InputDate class="form-control" @bind-Value="_form.FechaIngreso" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fecha de salida</label>
                        <InputDate class="form-control" @bind-Value="_form.FechaSalida" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_form.Activo" id="activo" />
                            <label class="form-check-label" for="activo">Equipo activo en el proyecto</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        @(_esNuevo ? "Agregar" : "Guardar cambios")
                    </button>
                    <a href="/proyectos/@ProyectoId/equipos" class="btn btn-outline-secondary">Cancelar</a>
                </div>

                @if (!_esNuevo && _confirmarEliminar)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-3 mt-3 py-2">
                        <span>¿Eliminar este equipo del proyecto?</span>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="EliminarAsync">Sí, eliminar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="() => _confirmarEliminar = false">Cancelar</button>
                    </div>
                }
                else if (!_esNuevo)
                {
                    <button type="button" class="btn btn-outline-danger mt-3 btn-sm"
                            @onclick="() => _confirmarEliminar = true">Eliminar equipo</button>
                }
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    [Parameter] public int? EquipoId { get; set; }

    private bool _esNuevo => EquipoId is null;
    private FormModel? _form;
    private bool _confirmarEliminar;

    protected override async Task OnInitializedAsync()
    {
        if (_esNuevo)
        {
            _form = new FormModel { FechaIngreso = DateTime.Today };
        }
        else
        {
            var equipo = await Db.Equipos.FindAsync(EquipoId!.Value);
            if (equipo is null) { Navigation.NavigateTo($"/proyectos/{ProyectoId}/equipos"); return; }

            _form = new FormModel
            {
                Codigo = equipo.Codigo,
                Nombre = equipo.Nombre,
                TipoEquipo = equipo.TipoEquipo,
                Marca = equipo.Marca,
                Modelo = equipo.Modelo,
                NumeroSerie = equipo.NumeroSerie,
                Propietario = equipo.Propietario,
                FechaIngreso = equipo.FechaIngreso,
                FechaSalida = equipo.FechaSalida,
                Activo = equipo.Activo
            };
        }
    }

    private async Task GuardarAsync()
    {
        if (_form is null) return;

        if (_esNuevo)
        {
            var nuevo = new Equipo
            {
                ProyectoId = ProyectoId,
                Codigo = _form.Codigo,
                Nombre = _form.Nombre,
                TipoEquipo = _form.TipoEquipo,
                Marca = _form.Marca,
                Modelo = _form.Modelo,
                NumeroSerie = _form.NumeroSerie,
                Propietario = _form.Propietario,
                FechaIngreso = _form.FechaIngreso,
                FechaSalida = _form.FechaSalida,
                Activo = _form.Activo
            };
            Db.Equipos.Add(nuevo);
        }
        else
        {
            var equipo = await Db.Equipos.FindAsync(EquipoId!.Value);
            if (equipo is null) return;

            equipo.Codigo = _form.Codigo;
            equipo.Nombre = _form.Nombre;
            equipo.TipoEquipo = _form.TipoEquipo;
            equipo.Marca = _form.Marca;
            equipo.Modelo = _form.Modelo;
            equipo.NumeroSerie = _form.NumeroSerie;
            equipo.Propietario = _form.Propietario;
            equipo.FechaIngreso = _form.FechaIngreso;
            equipo.FechaSalida = _form.FechaSalida;
            equipo.Activo = _form.Activo;
            equipo.FechaModificacion = DateTime.UtcNow;
        }

        await Db.SaveChangesAsync();
        Navigation.NavigateTo($"/proyectos/{ProyectoId}/equipos");
    }

    private async Task EliminarAsync()
    {
        var equipo = await Db.Equipos.FindAsync(EquipoId!.Value);
        if (equipo is null) return;
        Db.Equipos.Remove(equipo);
        await Db.SaveChangesAsync();
        Navigation.NavigateTo($"/proyectos/{ProyectoId}/equipos");
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "El código es obligatorio")]
        [MaxLength(20, ErrorMessage = "Máximo 20 caracteres")]
        public string Codigo { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombre { get; set; } = string.Empty;

        public TipoEquipo TipoEquipo { get; set; } = TipoEquipo.Vehiculo;
        public string? Marca { get; set; }
        public string? Modelo { get; set; }
        public string? NumeroSerie { get; set; }
        public string? Propietario { get; set; }
        public DateTime? FechaIngreso { get; set; }
        public DateTime? FechaSalida { get; set; }
        public bool Activo { get; set; } = true;
    }
}
