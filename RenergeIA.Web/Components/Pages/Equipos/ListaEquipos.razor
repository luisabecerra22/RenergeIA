@page "/proyectos/{ProyectoId:int}/equipos"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation

<PageTitle>Equipos — RenergeIA</PageTitle>

@if (_proyecto is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-1">
        <a href="/proyectos/@ProyectoId" class="btn btn-sm btn-outline-secondary">&larr; Volver</a>
        <h1 class="h3 mb-0">Equipos — @_proyecto.Nombre</h1>
    </div>
    <p class="text-muted small mb-3">Maquinaria, vehículos y herramientas vinculados al proyecto.</p>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex gap-2 flex-wrap">
            <input class="form-control form-control-sm" style="width:220px" placeholder="Buscar código, nombre..."
                   @bind="_busqueda" @bind:event="oninput" />
            <select class="form-select form-select-sm" style="width:190px" @bind="_filtroTipo">
                <option value="">Todos los tipos</option>
                @foreach (var t in Enum.GetValues<TipoEquipo>())
                {
                    <option value="@t">@EnumDisplay.Mostrar(t)</option>
                }
            </select>
            <select class="form-select form-select-sm" style="width:140px" @bind="_filtroActivo">
                <option value="true">Solo activos</option>
                <option value="false">Solo inactivos</option>
                <option value="">Todos</option>
            </select>
        </div>
        <a href="/proyectos/@ProyectoId/equipos/nuevo" class="btn btn-primary btn-sm">+ Agregar equipo</a>
    </div>

    @if (!EquiposFiltrados.Any())
    {
        <div class="alert alert-info">No hay equipos que coincidan con los filtros.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Marca / Modelo</th>
                        <th>Propietario</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in EquiposFiltrados)
                    {
                        <tr>
                            <td><strong>@e.Codigo</strong></td>
                            <td>@e.Nombre</td>
                            <td>
                                <span class="badge @TipoBadge(e.TipoEquipo)">
                                    @EnumDisplay.Mostrar(e.TipoEquipo)
                                </span>
                            </td>
                            <td>
                                @(string.Join(" / ", new[] { e.Marca, e.Modelo }
                                    .Where(x => !string.IsNullOrEmpty(x))))
                            </td>
                            <td>@(e.Propietario ?? "—")</td>
                            <td>
                                @if (e.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td>
                                <a href="/proyectos/@ProyectoId/equipos/@e.Id/editar"
                                   class="btn btn-sm btn-outline-primary">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<Equipo> _equipos = [];
    private string _busqueda = string.Empty;
    private string _filtroTipo = string.Empty;
    private string _filtroActivo = "true";

    private IEnumerable<Equipo> EquiposFiltrados => _equipos
        .Where(e =>
            (string.IsNullOrEmpty(_busqueda) ||
             $"{e.Codigo} {e.Nombre} {e.Marca} {e.Modelo} {e.Propietario}"
                 .Contains(_busqueda, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_filtroTipo) || e.TipoEquipo.ToString() == _filtroTipo) &&
            (string.IsNullOrEmpty(_filtroActivo) || e.Activo.ToString().ToLower() == _filtroActivo)
        );

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }

        _equipos = await Db.Equipos
            .Where(e => e.ProyectoId == ProyectoId)
            .OrderBy(e => e.Codigo)
            .ToListAsync();
    }

    private static string TipoBadge(TipoEquipo tipo) => tipo switch
    {
        TipoEquipo.Vehiculo         => "bg-primary",
        TipoEquipo.MaquinariaPesada => "bg-danger",
        TipoEquipo.HerramientaMenor => "bg-warning text-dark",
        TipoEquipo.EquipoMedicion   => "bg-info text-dark",
        TipoEquipo.EquipoSeguridad  => "bg-success",
        TipoEquipo.Otro             => "bg-secondary",
        _                           => "bg-light text-dark"
    };
}
