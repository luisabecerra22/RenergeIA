@inject RenergeIADbContext Db
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore
@using RenergeIA.Core.Enums
@using RenergeIA.Web.Services
@using ClosedXML.Excel
@using System.ComponentModel.DataAnnotations

<!-- KPIs (solo órdenes de compra) -->
<SeccionDash Titulo="Resumen de Órdenes de Compra" Icono="bi-file-earmark-text">
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3 mb-3">
        @TarjetaDual("Total aprobado", "Valor aprobado de las OC", "bi-currency-dollar", "#fff", "linear-gradient(135deg,#183963 0%,#1e4d7a 100%)", Ocs.Sum(c => EnCOP(c, c.Valor)), null, true)
        @TarjetaDual("Facturado", "Suma de facturas (antes de retenciones)", "bi-receipt", "#183963", "linear-gradient(135deg,#f0f4ff 0%,#dce3f0 100%)", Ocs.Sum(c => EnCOP(c, c.ValorFactura)), null, false)
        @TarjetaDual("Pagado", "Facturas pagadas (verde)", "bi-check-circle", "#5aa83e", "linear-gradient(135deg,#e8f5e2 0%,#d4edcc 100%)", Ocs.Sum(c => EnCOP(c, Pagado(c))), null, false)
        @TarjetaDual("Pendiente por pagar", "Facturado sin pagar + aprobado sin facturar", "bi-hourglass-split", "#c69500", "linear-gradient(135deg,#fff8e1 0%,#ffecb3 100%)", Ocs.Sum(c => EnCOP(c, Pendiente(c))), Ocs.Sum(c => EnCOP(c, SinFacturar(c))), false)
        <div class="col">
            <div class="card border-0 shadow-sm text-center p-3 h-100" style="background:linear-gradient(135deg,#f0f4ff 0%,#dce3f0 100%);border-radius:14px">
                <i class="bi-stack mb-1" style="font-size:1.4rem;color:#183963"></i>
                <div class="fw-bold fs-4" style="color:#183963">@Ocs.Count()</div>
                <div class="small text-muted">Total Órdenes de Compra</div>
                @if (Ocs.Count(Sobrepasada) > 0)
                {
                    <div class="fw-semibold" style="font-size:0.7rem;color:#dc3545">⚠ @Ocs.Count(Sobrepasada) sobrepasadas</div>
                }
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm text-center p-3 h-100" style="background:linear-gradient(135deg,#fff3e0 0%,#ffe0b2 100%);border-radius:14px">
                <i class="bi-arrow-repeat mb-1" style="font-size:1.4rem;color:#fd7e14"></i>
                <div class="fw-bold fs-4" style="color:#fd7e14">@Ocs.Count(EnProceso)</div>
                <div class="small text-muted">En Proceso</div>
                <div class="text-muted" style="font-size:0.62rem">Sin consecutivo (XXX)</div>
            </div>
        </div>
    </div>
</SeccionDash>

<!-- Acciones -->
<div class="d-flex justify-content-end align-items-center gap-2 mb-3 flex-wrap">
    @if (_proyecto?.FechaCorteTesoreria is not null)
    {
        <span class="badge me-auto" style="background:#D9D9D6;color:#111921" title="@_proyecto.ArchivoTesoreria">
            Tesorería cargada · corte @_proyecto.FechaCorteTesoreria.Value.ToString("dd/MM/yyyy")
        </span>
    }
    @if (Ocs.Any())
    {
        <button class="btn btn-sm @(_filtroAplicado is not null ? "" : "btn-outline-secondary")" title="Filtrar órdenes de compra"
                style="@(_filtroAplicado is not null ? "background:#6ABF4B;color:#fff;border:none" : "")"
                @onclick="() => _mostrarFiltros = !_mostrarFiltros">
            <i class="bi-funnel me-1"></i>Filtros
        </button>
    }
    @if (_compromisos.Any())
    {
        <button class="btn btn-sm btn-outline-success" title="Exportar a Excel (.xlsx)" @onclick="ExportarExcelAsync">
            <i class="bi-download me-1"></i>Exportar Excel
        </button>
    }
    <ImportarTesoreria ProyectoId="ProyectoId" OnImportado="OnTesoreriaImportadaAsync" />
    <button class="btn btn-sm fw-semibold" style="background:#183963;color:#fff;border:none" @onclick="NuevaOC">
        <i class="bi-plus-lg me-1"></i>Nueva Orden de Compra
    </button>
</div>

<!-- Panel de filtros -->
@if (_mostrarFiltros)
{
    <div class="card mb-3" style="border:1px solid #183963">
        <div class="card-header py-1 fw-semibold small text-white" style="background:#183963">
            <i class="bi-funnel me-1"></i>Filtrar órdenes de compra
        </div>
        <div class="card-body py-2">
            <div class="row g-2">
                <div class="col-md-2">
                    <label class="form-label small mb-0">Código / rubro</label>
                    <input class="form-control form-control-sm" @bind="_filtro.Rubro" placeholder="Ej: CGSV" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0"># Orden compra</label>
                    <input class="form-control form-control-sm" @bind="_filtro.OC" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Proveedor</label>
                    <input class="form-control form-control-sm" @bind="_filtro.Proveedor" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Descripción</label>
                    <input class="form-control form-control-sm" @bind="_filtro.Descripcion" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0"># Factura / documento</label>
                    <input class="form-control form-control-sm" @bind="_filtro.Factura" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Estado</label>
                    <select class="form-select form-select-sm" @bind="_filtro.Estado">
                        <option value="">— Todos —</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Pagada">Pagada</option>
                        <option value="EnProceso">En proceso</option>
                        <option value="Sobrepasada">Sobrepasada</option>
                        <option value="SinCodigo">Con facturas sin código</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Fecha factura desde</label>
                    <input type="date" class="form-control form-control-sm" @bind="_filtro.FechaDesde" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Fecha factura hasta</label>
                    <input type="date" class="form-control form-control-sm" @bind="_filtro.FechaHasta" />
                </div>
                <div class="col d-flex align-items-end gap-2">
                    <button class="btn btn-sm fw-semibold" style="background:#6ABF4B;color:#fff;border:none" @onclick="AplicarFiltros">
                        <i class="bi-check-lg me-1"></i>Aplicar filtros
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LimpiarFiltros">Limpiar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Formulario OC manual -->
@if (_mostrarFormulario)
{
    <div class="card mb-4" style="border:1px solid #183963">
        <div class="card-header text-white fw-semibold" style="background:#183963">
            @(_editandoId is null ? "Registrar orden de compra manual" : "Editar orden de compra manual")
        </div>
        <div class="card-body">
            <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />
                <div class="row g-2">
                    <div class="col-md-1">
                        <label class="form-label small">Moneda</label>
                        <select class="form-select form-select-sm" @bind="_form.Moneda">
                            <option value="COP">COP</option>
                            <option value="USD">USD</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Código rubro (presupuesto)</label>
                        <select class="form-select form-select-sm" @bind="_form.PartidaId">
                            <option value="">— Seleccionar rubro —</option>
                            @foreach (var p in _partidas)
                            {
                                <option value="@p.Id">@p.Codigo — @p.Descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small"># Orden de compra *</label>
                        <InputText class="form-control form-control-sm" @bind-Value="_form.Codigo" placeholder="CO_2026_001 o XXX" />
                        <ValidationMessage For="() => _form.Codigo" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Proveedor *</label>
                        <InputText class="form-control form-control-sm" @bind-Value="_form.Proveedor" />
                        <ValidationMessage For="() => _form.Proveedor" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Descripción del servicio</label>
                        <InputText class="form-control form-control-sm" @bind-Value="_form.DescripcionServicio" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Valor aprobado OC *</label>
                        <InputNumber class="form-control form-control-sm" @bind-Value="_form.Valor" />
                        <ValidationMessage For="() => _form.Valor" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small"># Factura</label>
                        <InputText class="form-control form-control-sm" @bind-Value="_form.NumeroFactura" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Fecha factura</label>
                        <InputDate class="form-control form-control-sm" @bind-Value="_form.FechaFactura" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Facturado</label>
                        <InputNumber class="form-control form-control-sm" @bind-Value="_form.ValorFactura" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Pagado</label>
                        <InputNumber class="form-control form-control-sm" @bind-Value="_form.ValorPagado" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Fecha OC</label>
                        <InputDate class="form-control form-control-sm" @bind-Value="_form.Fecha" />
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-sm" style="background:#6ABF4B;color:#fff;border:none">💾 Guardar</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_mensaje))
{
    <div class="alert @(_mensajeError ? "alert-danger" : "alert-success") alert-dismissible py-2 mb-3">
        @_mensaje
        <button class="btn-close btn-sm" @onclick="() => _mensaje = null"></button>
    </div>
}

@if (Ocs.Sum(c => c.Hitos.Count(h => h.Codigo is null)) > 0)
{
    <div class="alert alert-warning py-2 mb-3 small">
        <strong>⚠ @Ocs.Sum(c => c.Hitos.Count(h => h.Codigo is null)) facturas sin código asignado.</strong>
        Abre el detalle de las OC marcadas con <span class="badge bg-danger">sin código</span> y asígnales su código manualmente.
    </div>
}

<datalist id="codigos-rubro">
    @foreach (var cod in _codigosListado)
    {
        <option value="@cod"></option>
    }
</datalist>

<!-- Tabla de órdenes de compra -->
@if (!_compromisos.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <i class="bi-file-earmark-text display-4 mb-3" style="color:#dde3ed"></i>
        <p class="text-muted small">No hay órdenes de compra. Impórtalas con <strong>Importar Tesorería</strong> o regístralas manualmente.</p>
    </div>
}
else
{
    var listaFiltrada = Filtrados().OrderBy(c => EnProceso(c)).ThenBy(c => c.Codigo).ToList();

    @if (_filtroAplicado is not null)
    {
        <div class="mb-2 small text-muted">
            <i class="bi-funnel-fill me-1" style="color:#6ABF4B"></i>
            Mostrando <strong>@listaFiltrada.Count</strong> de @Ocs.Count() órdenes de compra
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead style="font-size:.7rem;border-bottom:2px solid #183963">
                    <tr>
                        <th style="width:28px"></th>
                        <th style="color:#183963">MONEDA</th>
                        <th style="color:#183963"># ORDEN COMPRA</th>
                        <th style="color:#183963">PROVEEDOR</th>
                        <th style="color:#183963">DESCRIPCIÓN</th>
                        <th style="color:#183963">CÓDIGOS</th>
                        <th class="text-end" style="color:#183963">APROBADO</th>
                        <th class="text-end" style="color:#183963">FACTURADO</th>
                        <th class="text-end" style="color:#183963">PAGADO</th>
                        <th class="text-end" style="color:#183963">SALDO POR PAGAR</th>
                        <th style="color:#183963">ESTADO</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in listaFiltrada)
                    {
                        var abierta = _abiertas.Contains(c.Id);
                        var sinCodigo = c.Hitos.Count(h => h.Codigo is null);
                        <tr style="border-bottom:1px solid #f0f3f8;cursor:pointer;@(Pagada(c) ? "background:#eaf6e4" : "")"
                            @onclick="() => AlternarDetalle(c.Id)">
                            <td class="text-center" style="color:#183963"><i class="@(abierta ? "bi-chevron-down" : "bi-chevron-right")"></i></td>
                            <td><span class="badge" style="background:@(c.Moneda == "USD" ? "#6ABF4B" : "#183963");font-size:.65rem">@c.Moneda</span></td>
                            <td class="fw-semibold" style="white-space:nowrap;color:@(EnProceso(c) ? "#fd7e14" : "#183963")" @onclick:stopPropagation="true">
                                @if (EnProceso(c) && c.Origen == "Tesoreria")
                                {
                                    <div class="d-flex align-items-center gap-1">
                                        <input class="form-control form-control-sm py-0" style="width:130px;font-size:.72rem;border-color:#fd7e14"
                                               placeholder="@c.Codigo"
                                               value="@_ocEdit.GetValueOrDefault(c.Id)"
                                               @onchange='e => _ocEdit[c.Id] = e.Value?.ToString() ?? ""' />
                                        <button class="btn btn-sm py-0 px-1" style="background:#fd7e14;color:#fff;border:none;font-size:.68rem"
                                                title="Asignar el número real de la orden de compra (queda recordado)"
                                                @onclick="() => AsignarNumeroOCAsync(c)">Asignar</button>
                                    </div>
                                }
                                else
                                {
                                    <span>@c.Codigo</span>
                                }
                                @if (c.Origen == "Manual")
                                {
                                    <span class="badge ms-1" style="background:#D9D9D6;color:#111921;font-size:.6rem">Manual</span>
                                }
                            </td>
                            <td>@c.Proveedor</td>
                            <td class="text-muted" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@c.DescripcionServicio">@(c.DescripcionServicio ?? "—")</td>
                            <td style="white-space:nowrap">
                                @foreach (var cod in CodigosDe(c))
                                {
                                    <span class="badge me-1" style="background:#183963;font-size:.6rem" title="@RubroTitulo(cod)">@cod</span>
                                }
                                @if (sinCodigo > 0)
                                {
                                    <span class="badge bg-danger" style="font-size:.6rem">⚠ @sinCodigo sin código</span>
                                }
                            </td>
                            <td class="text-end">@Fmt(c, c.Valor)</td>
                            <td class="text-end fw-semibold" style="color:@(Sobrepasada(c) ? "#dc3545" : "#183963")">@Fmt(c, c.ValorFactura)</td>
                            <td class="text-end" style="color:#5aa83e">@Fmt(c, Pagado(c))</td>
                            <td class="text-end fw-semibold" style="color:@(Pendiente(c) > 0 ? "#c69500" : "#6ABF4B")">
                                @Fmt(c, Pendiente(c))
                                @if (SinFacturar(c) > 0)
                                {
                                    <div style="font-size:.6rem;color:#6c757d">@Fmt(c, SinFacturar(c)) sin facturar</div>
                                }
                            </td>
                            <td style="white-space:nowrap">
                                @if (EnProceso(c))
                                {
                                    <span class="badge rounded-pill" style="background:#fd7e14;font-size:.62rem">En proceso</span>
                                }
                                else if (Pagada(c))
                                {
                                    <span class="badge rounded-pill" style="background:#6ABF4B;font-size:.62rem">✓ Pagada</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill" style="background:#ffc107;color:#212529;font-size:.62rem">Pendiente</span>
                                }
                                @if (Sobrepasada(c))
                                {
                                    <span class="badge rounded-pill bg-danger ms-1" style="font-size:.62rem"
                                          title="Facturado @Fmt(c, c.ValorFactura) supera el aprobado @Fmt(c, c.Valor)">⚠ Sobrepasada</span>
                                }
                            </td>
                            <td class="pe-2 text-end" style="white-space:nowrap" @onclick:stopPropagation="true">
                                @if (c.Origen == "Manual")
                                {
                                    @if (_confirmandoEliminar == c.Id)
                                    {
                                        <button class="btn btn-danger btn-sm py-0 px-1" title="Confirmar eliminación" @onclick="() => EliminarAsync(c.Id)">✓</button>
                                        <button class="btn btn-outline-secondary btn-sm py-0 px-1" title="Cancelar" @onclick="() => _confirmandoEliminar = null">×</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm py-0 px-1 me-1" title="Editar" style="border:1px solid #183963;color:#183963"
                                                @onclick="() => IniciarEdicion(c)"><i class="bi-pencil"></i></button>
                                        <button class="btn btn-outline-danger btn-sm py-0 px-1" title="Eliminar" @onclick="() => _confirmandoEliminar = c.Id">✕</button>
                                    }
                                }
                            </td>
                        </tr>
                        @if (abierta)
                        {
                            <tr>
                                <td colspan="12" class="p-0" style="background:#f8faff">
                                    @if (c.Hitos.Count == 0)
                                    {
                                        <div class="px-4 py-2 small text-muted">
                                            @if (c.Origen == "Manual")
                                            {
                                                <span># Factura: <strong>@(c.NumeroFactura ?? "—")</strong> · Fecha: <strong>@(c.FechaFactura?.ToString("dd/MM/yyyy") ?? "—")</strong>
                                                    · Rubro: <strong>@(c.Partida?.Codigo ?? "—")</strong></span>
                                            }
                                            else
                                            {
                                                <span>Esta orden de compra no tiene facturas registradas en tesorería.</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        @TablaHitos(c, true)
                                    }
                                </td>
                            </tr>
                        }
                    }
                    <tr class="fw-bold">
                        <td colspan="6" class="ps-3 py-2" style="background:#183963;color:white"><span style="letter-spacing:1px">TOTAL (COP)</span></td>
                        <td class="text-end py-2" style="background:#183963;color:white">@FormatCOP(listaFiltrada.Sum(c => EnCOP(c, c.Valor)))</td>
                        <td class="text-end py-2" style="background:#183963;color:white">@FormatCOP(listaFiltrada.Sum(c => EnCOP(c, c.ValorFactura)))</td>
                        <td class="text-end py-2" style="background:#183963;color:white">@FormatCOP(listaFiltrada.Sum(c => EnCOP(c, Pagado(c))))</td>
                        <td class="text-end py-2" style="background:#183963;color:white">@FormatCOP(listaFiltrada.Sum(c => EnCOP(c, Pendiente(c))))</td>
                        <td colspan="2" style="background:#183963"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @foreach (var (grupo, titulo, nota) in _secciones)
    {
        var bloques = _compromisos.Where(c => c.Grupo == grupo).OrderBy(c => c.Moneda).ToList();
        if (bloques.Count == 0 || bloques.All(b => b.Hitos.Count == 0)) { continue; }
        var sinRubro = bloques.Sum(b => b.Hitos.Count(h => h.Codigo is null));
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header d-flex align-items-center gap-2 flex-wrap py-2" style="background:#183963;color:#fff">
                <strong>@titulo</strong>
                @foreach (var b in bloques)
                {
                    <span class="badge" style="background:rgba(255,255,255,.18);font-size:.72rem">
                        @b.Moneda: @Fmt(b, b.Hitos.Sum(h => h.Importe)) · pagado @Fmt(b, b.Hitos.Where(h => h.Pagado).Sum(h => h.Importe))
                    </span>
                }
                @if (sinRubro > 0)
                {
                    <span class="badge bg-danger ms-auto" style="font-size:.7rem">
                        ⚠ @sinRubro @(grupo == "Impuestos" ? "sin rubro y sin orden de compra" : "sin rubro")
                    </span>
                }
            </div>
            @if (!string.IsNullOrEmpty(nota))
            {
                <div class="px-3 pt-2 small text-muted fst-italic">@nota</div>
            }
            @foreach (var b in bloques.Where(b => b.Hitos.Count > 0))
            {
                @TablaHitos(b, false)
            }
        </div>
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private List<CompromisoCosto> _compromisos = [];
    private List<Partida> _partidas = [];
    private List<string> _codigosListado = [];
    private Proyecto? _proyecto;

    private bool _mostrarFormulario;
    private string? _mensaje;
    private bool _mensajeError;
    private int? _confirmandoEliminar;
    private CompromisoForm _form = new();
    private int? _editandoId;
    private bool _mostrarFiltros;
    private FiltroModel _filtro = new();
    private FiltroModel? _filtroAplicado;

    private readonly HashSet<int> _abiertas = [];
    private readonly Dictionary<int, string> _ocEdit = [];
    private readonly Dictionary<int, string> _codigoEdit = [];

    private static readonly (string Grupo, string Titulo, string? Nota)[] _secciones =
    [
        ("Salarios", "Salarios y mano de obra", "Vista informativa del comportamiento de la nómina en el tiempo — pendiente de revisar y complementar."),
        ("Impuestos", "Pagos de impuestos", null),
        ("Proyectado", "Proyectado (sin OC)", "Costos futuros proyectados que aún no tienen orden de compra."),
    ];

    private decimal TRM => _proyecto is { TasaCambioCOPUSD: > 0 } ? _proyecto.TasaCambioCOPUSD : 4000m;
    private IEnumerable<CompromisoCosto> Ocs => _compromisos.Where(c => c.Grupo == "OC");

    private decimal EnCOP(CompromisoCosto c, decimal v) => c.Moneda == "USD" ? v * TRM : v;
    private static decimal Pagado(CompromisoCosto c) => c.ValorPagado;
    private static decimal SinFacturar(CompromisoCosto c) => Math.Max(c.Valor - c.ValorFactura, 0);
    private static decimal Pendiente(CompromisoCosto c) => Math.Max(c.ValorFactura - c.ValorPagado, 0) + SinFacturar(c);
    private static bool Sobrepasada(CompromisoCosto c) => c.Valor > 0 && c.ValorFactura > c.Valor + 0.5m;
    private static bool EnProceso(CompromisoCosto c) =>
        string.IsNullOrWhiteSpace(c.Codigo) || c.Codigo.Contains("XXX", StringComparison.OrdinalIgnoreCase);
    private static bool Pagada(CompromisoCosto c) =>
        !EnProceso(c) && Pendiente(c) <= 0 && (c.ValorFactura > 0 || c.Valor > 0);

    private static IEnumerable<string> CodigosDe(CompromisoCosto c)
    {
        var codigos = c.Hitos.Where(h => h.Codigo is not null).Select(h => h.Codigo!).Distinct().OrderBy(x => x).ToList();
        if (codigos.Count == 0 && c.Partida is not null) codigos.Add(c.Partida.Codigo);
        return codigos;
    }

    private static string RubroTitulo(string codigo) =>
        CodificacionSeeder.MapaCodigoARubro.TryGetValue(codigo, out var r) && !r.Equals(codigo, StringComparison.OrdinalIgnoreCase)
            ? $"{codigo} → rubro {r}" : codigo;

    private static readonly System.Globalization.CultureInfo _co = new("es-CO");
    private static string FormatCOP(decimal v) => "$" + v.ToString("N0", _co);
    private static string FormatUSD(decimal v) => "US$ " + v.ToString("N0", _co);
    private static string Fmt(CompromisoCosto c, decimal v) => (c.Moneda == "USD" ? "US$ " : "$") + v.ToString("N0", _co);

    private RenderFragment TarjetaDual(string titulo, string sub, string icono, string color, string fondo, decimal cop, decimal? sinFacturar, bool oscuro) =>
        @<div class="col">
