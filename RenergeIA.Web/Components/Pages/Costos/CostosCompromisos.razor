    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        _compromisos = await Db.CompromisoCostos
            .Include(c => c.Partida)
            .Include(c => c.Hitos)
            .Where(c => c.ProyectoId == ProyectoId)
            .ToListAsync();

        _partidas = await Db.Partidas.AsNoTracking()
            .Where(p => p.ProyectoId == ProyectoId && !p.EsPrincipal)
            .OrderBy(p => p.Codigo)
            .ToListAsync();
        _codigosListado = _partidas.Where(p => !p.Codigo.Contains('-')).Select(p => p.Codigo.ToUpperInvariant()).Distinct().OrderBy(x => x).ToList();
    }

    private void AlternarDetalle(int id)
    {
        if (!_abiertas.Remove(id)) _abiertas.Add(id);
    }

    private async Task OnTesoreriaImportadaAsync(TesoreriaImportService.Resultado r)
    {
        _abiertas.Clear();
        _ocEdit.Clear();
        _codigoEdit.Clear();
        await CargarAsync();

        var resumen = $"Tesorería importada: {r.OcsNuevas} órdenes de compra nuevas, {r.OcsActualizadas} actualizadas. Flujo de Caja actualizado ({r.ValoresFlujo} valores).";
        if (r.OcsEnProcesoSinAsignar > 0) resumen += $" {r.OcsEnProcesoSinAsignar} OC sin consecutivo (asígnales el número).";
        if (r.FacturasSinCodigo > 0) resumen += $" ⚠ Se encontraron {r.FacturasSinCodigo} facturas sin código asignado — asígnalas manualmente.";
        if (r.LineasSinRubro > 0) resumen += $" ⚠ {r.LineasSinRubro} líneas de salarios/impuestos/proyectado sin rubro.";
        if (r.NoMapeados.Count > 0) resumen += $" ⚠ {r.NoMapeados.Count} subcódigos sin equivalencia no entraron al Flujo de Caja ({string.Join(", ", r.NoMapeados.Select(x => x.Key))}) — clasifícalos en Flujo de Caja.";
        _mensaje = resumen;
        _mensajeError = r.FacturasSinCodigo > 0 || r.NoMapeados.Count > 0;
    }

    private async Task AsignarCodigoHitoAsync(CompromisoCosto c, HitoCompromiso h)
    {
        var codigo = _codigoEdit.GetValueOrDefault(h.Id)?.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(codigo))
        {
            _mensaje = "Escribe o selecciona un código antes de asignarlo.";
            _mensajeError = true;
            return;
        }
        if (!_codigosListado.Contains(codigo) && !CodificacionSeeder.MapaCodigoARubro.ContainsKey(codigo))
        {
            _mensaje = $"El código '{codigo}' no existe en el listado de códigos del presupuesto ni en la codificación. Revisa que esté bien escrito.";
            _mensajeError = true;
            return;
        }

        h.Codigo = codigo;
        h.CodigoManual = true;
        if (c.ClaveTesoreria is not null)
        {
            var clave = TesoreriaImportService.ClaveHito(c.ClaveTesoreria, h.Periodo, h.Documento, h.Descripcion);
            await GuardarAsignacionAsync("CodigoHito", clave, codigo);
        }
        await Db.SaveChangesAsync();
        _codigoEdit.Remove(h.Id);
        _mensaje = $"Código {codigo} asignado a \"{h.Descripcion}\". Quedó recordado para las próximas importaciones.";
        _mensajeError = false;
    }

    private async Task AsignarNumeroOCAsync(CompromisoCosto c)
    {
        var numero = _ocEdit.GetValueOrDefault(c.Id)?.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(numero) || numero.Contains("XXX"))
        {
            _mensaje = "Escribe el número real de la orden de compra (por ejemplo CO_2026_150).";
            _mensajeError = true;
            return;
        }
        if (Ocs.Any(o => o.Id != c.Id && string.Equals(o.Codigo, numero, StringComparison.OrdinalIgnoreCase)))
        {
            _mensaje = $"La orden de compra {numero} ya existe en la lista. Revisa el número.";
            _mensajeError = true;
            return;
        }

        c.Codigo = numero;
        c.Estado = Pagada(c) ? EstadoCompromiso.Pagado : EstadoCompromiso.Pendiente;
        if (c.ClaveTesoreria is not null) await GuardarAsignacionAsync("NumeroOC", c.ClaveTesoreria, numero);
        await Db.SaveChangesAsync();
        _ocEdit.Remove(c.Id);
        _mensaje = $"Número {numero} asignado a la OC de {c.Proveedor}. Quedó recordado para las próximas importaciones.";
        _mensajeError = false;
    }

    private async Task GuardarAsignacionAsync(string tipo, string clave, string valor)
    {
        var existente = await Db.AsignacionesTesoreria.FirstOrDefaultAsync(a =>
            a.ProyectoId == ProyectoId && a.Tipo == tipo && a.Clave == clave);
        if (existente is null)
            Db.AsignacionesTesoreria.Add(new AsignacionTesoreria { ProyectoId = ProyectoId, Tipo = tipo, Clave = clave, Valor = valor });
        else
            existente.Valor = valor;
    }

    // ── OC manual ───────────────────────────────────────────────────────────

    private async Task GuardarAsync()
    {
        var numFact = string.IsNullOrWhiteSpace(_form.NumeroFactura) ? null : _form.NumeroFactura.Trim();
        if (numFact is not null && _compromisos.Any(c => c.Id != (_editandoId ?? 0)
            && string.Equals(c.NumeroFactura, numFact, StringComparison.OrdinalIgnoreCase)))
        {
            _mensaje = $"El número de factura '{numFact}' ya está registrado en otra orden de compra. Los números de factura no se pueden repetir.";
            _mensajeError = true;
            return;
        }

        CompromisoCosto entidad;
        if (_editandoId is int idEdicion)
            entidad = _compromisos.First(c => c.Id == idEdicion);
        else
        {
            entidad = new CompromisoCosto { ProyectoId = ProyectoId, Origen = "Manual", Grupo = "OC" };
            Db.CompromisoCostos.Add(entidad);
        }

        entidad.Codigo              = _form.Codigo.Trim();
        entidad.Moneda              = _form.Moneda;
        entidad.Proveedor           = _form.Proveedor;
        entidad.PartidaId           = _form.PartidaId == 0 ? null : _form.PartidaId;
        entidad.Valor               = _form.Valor;
        entidad.Fecha               = _form.Fecha;
        entidad.DescripcionServicio = string.IsNullOrWhiteSpace(_form.DescripcionServicio) ? null : _form.DescripcionServicio;
        entidad.NumeroFactura       = numFact;
        entidad.FechaFactura        = _form.FechaFactura == default ? null : _form.FechaFactura;
        entidad.ValorFactura        = _form.ValorFactura;
        entidad.ValorPagado         = Math.Min(_form.ValorPagado, _form.ValorFactura);
        entidad.SaldoPorPagar       = Pendiente(entidad);
        entidad.Estado              = EnProceso(entidad) ? EstadoCompromiso.EnProceso
                                    : Pagada(entidad) ? EstadoCompromiso.Pagado : EstadoCompromiso.Pendiente;

        await Db.SaveChangesAsync();
        _mensaje = _editandoId is null ? "Orden de compra registrada correctamente." : "Orden de compra actualizada correctamente.";
        _mensajeError = false;
        _form = new CompromisoForm();
        _editandoId = null;
        _mostrarFormulario = false;
        await CargarAsync();
    }

    private void NuevaOC()
    {
        if (_mostrarFormulario && _editandoId is null) { _mostrarFormulario = false; return; }
        _editandoId = null;
        _form = new CompromisoForm();
        _mostrarFormulario = true;
    }

    private void IniciarEdicion(CompromisoCosto c)
    {
        _editandoId = c.Id;
        _form = new CompromisoForm
        {
            Codigo              = c.Codigo,
            Moneda              = c.Moneda,
            Proveedor           = c.Proveedor,
            PartidaId           = c.PartidaId,
            Valor               = c.Valor,
            Fecha               = c.Fecha,
            DescripcionServicio = c.DescripcionServicio,
            NumeroFactura       = c.NumeroFactura,
            FechaFactura        = c.FechaFactura ?? default,
            ValorFactura        = c.ValorFactura,
            ValorPagado         = c.ValorPagado
        };
        _mostrarFormulario = true;
    }

    private void CancelarFormulario()
    {
        _mostrarFormulario = false;
        _editandoId = null;
        _form = new CompromisoForm();
    }

    private async Task EliminarAsync(int id)
    {
        var c = await Db.CompromisoCostos.FindAsync(id);
        if (c is null) return;
        Db.CompromisoCostos.Remove(c);
        await Db.SaveChangesAsync();
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    // ── Filtros ─────────────────────────────────────────────────────────────

    private void AplicarFiltros() => _filtroAplicado = _filtro.Clone();

    private void LimpiarFiltros()
    {
        _filtro = new FiltroModel();
        _filtroAplicado = null;
    }

    private IEnumerable<CompromisoCosto> Filtrados()
    {
        var f = _filtroAplicado;
        IEnumerable<CompromisoCosto> q = Ocs;
        if (f is null) return q;

        bool Contiene(string? texto, string? buscado) =>
            !string.IsNullOrEmpty(texto) && texto.Contains(buscado!.Trim(), StringComparison.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(f.Rubro))
            q = q.Where(c => CodigosDe(c).Any(cod => Contiene(cod, f.Rubro)));
        if (!string.IsNullOrWhiteSpace(f.OC))
            q = q.Where(c => Contiene(c.Codigo, f.OC));
        if (!string.IsNullOrWhiteSpace(f.Proveedor))
            q = q.Where(c => Contiene(c.Proveedor, f.Proveedor));
        if (!string.IsNullOrWhiteSpace(f.Descripcion))
            q = q.Where(c => Contiene(c.DescripcionServicio, f.Descripcion) || c.Hitos.Any(h => Contiene(h.Descripcion, f.Descripcion)));
        if (!string.IsNullOrWhiteSpace(f.Factura))
            q = q.Where(c => Contiene(c.NumeroFactura, f.Factura) || c.Hitos.Any(h => Contiene(h.Documento, f.Factura)));
        if (f.FechaDesde.HasValue)
            q = q.Where(c => (c.FechaFactura >= f.FechaDesde) || c.Hitos.Any(h => h.Fecha >= f.FechaDesde));
        if (f.FechaHasta.HasValue)
            q = q.Where(c => (c.FechaFactura <= f.FechaHasta) || c.Hitos.Any(h => h.Fecha <= f.FechaHasta));
        q = f.Estado switch
        {
            "Pendiente"   => q.Where(c => !Pagada(c) && !EnProceso(c)),
            "Pagada"      => q.Where(Pagada),
            "EnProceso"   => q.Where(EnProceso),
            "Sobrepasada" => q.Where(Sobrepasada),
            "SinCodigo"   => q.Where(c => c.Hitos.Any(h => h.Codigo is null)),
            _             => q
        };
        return q;
    }

    // ── Exportar ────────────────────────────────────────────────────────────

    private async Task ExportarExcelAsync()
    {
        using var workbook = new XLWorkbook();
        var ws = workbook.Worksheets.Add("Órdenes de Compra");

        string[] encabezados = ["Moneda", "# Orden Compra", "Proveedor", "Descripción", "Código", "Documento", "Detalle / Descripción hito",
            "Fecha", "Subtotal", "IVA", "Importe", "Ret. Fuente", "Ret. ICA", "Total a pagar", "Estado",
            "Aprobado", "Facturado", "Pagado", "Saldo por pagar"];
        for (int i = 0; i < encabezados.Length; i++)
        {
            var celda = ws.Cell(1, i + 1);
            celda.Value = encabezados[i];
            celda.Style.Font.Bold = true;
            celda.Style.Font.FontColor = XLColor.White;
            celda.Style.Fill.BackgroundColor = XLColor.FromHtml("#183963");
        }

        int fila = 2;
        void Hito(CompromisoCosto c, HitoCompromiso h)
        {
            ws.Cell(fila, 1).Value = c.Moneda;
            ws.Cell(fila, 2).Value = c.Codigo;
            ws.Cell(fila, 5).Value = h.Codigo ?? "SIN CÓDIGO";
            ws.Cell(fila, 6).Value = h.Documento ?? h.Detalle ?? "";
            ws.Cell(fila, 7).Value = string.IsNullOrEmpty(h.Periodo) ? h.Descripcion : $"{h.Periodo} — {h.Descripcion}";
            if (h.Fecha.HasValue) { ws.Cell(fila, 8).Value = h.Fecha.Value; ws.Cell(fila, 8).Style.DateFormat.Format = "dd/MM/yyyy"; }
            ws.Cell(fila, 9).Value = h.Subtotal;
            ws.Cell(fila, 10).Value = h.Iva;
            ws.Cell(fila, 11).Value = h.Importe;
            ws.Cell(fila, 12).Value = h.RetFuente;
            ws.Cell(fila, 13).Value = h.RetIca;
            ws.Cell(fila, 14).Value = h.TotalPagar;
            ws.Cell(fila, 15).Value = h.Pagado ? "Pagado" : c.Grupo == "Proyectado" ? "Proyectado" : "Pendiente";
            if (h.Pagado) ws.Range(fila, 5, fila, 15).Style.Fill.BackgroundColor = XLColor.FromHtml("#eaf6e4");
            if (h.Codigo is null) ws.Cell(fila, 5).Style.Font.FontColor = XLColor.Red;
            fila++;
        }

        foreach (var c in Filtrados().OrderBy(c => EnProceso(c)).ThenBy(c => c.Codigo))
        {
            ws.Cell(fila, 1).Value = c.Moneda;
            ws.Cell(fila, 2).Value = c.Codigo;
            ws.Cell(fila, 3).Value = c.Proveedor;
            ws.Cell(fila, 4).Value = c.DescripcionServicio ?? "";
            ws.Cell(fila, 15).Value = EnProceso(c) ? "En proceso" : Pagada(c) ? "Pagada" : "Pendiente";
            if (Sobrepasada(c)) ws.Cell(fila, 15).Value = $"{ws.Cell(fila, 15).GetString()} · SOBREPASADA";
            ws.Cell(fila, 16).Value = c.Valor;
            ws.Cell(fila, 17).Value = c.ValorFactura;
            ws.Cell(fila, 18).Value = Pagado(c);
            ws.Cell(fila, 19).Value = Pendiente(c);
            var r = ws.Range(fila, 1, fila, 19);
            r.Style.Font.Bold = true;
            r.Style.Fill.BackgroundColor = XLColor.FromHtml("#D9D9D6");
            fila++;
            foreach (var h in c.Hitos.OrderBy(h => h.Orden)) Hito(c, h);
        }

        foreach (var (grupo, titulo, _) in _secciones)
        {
            var bloques = _compromisos.Where(c => c.Grupo == grupo && c.Hitos.Count > 0).ToList();
            if (bloques.Count == 0) continue;
            fila++;
            ws.Cell(fila, 1).Value = titulo.ToUpperInvariant();
            var rt = ws.Range(fila, 1, fila, 19);
            rt.Style.Font.Bold = true;
            rt.Style.Font.FontColor = XLColor.White;
            rt.Style.Fill.BackgroundColor = XLColor.FromHtml("#183963");
            fila++;
            foreach (var b in bloques)
                foreach (var h in b.Hitos.OrderBy(h => h.Orden)) Hito(b, h);
        }

        foreach (var col in new[] { 9, 10, 11, 12, 13, 14, 16, 17, 18, 19 })
            ws.Column(col).Style.NumberFormat.Format = "#,##0";
        ws.Columns().AdjustToContents();

        using var ms = new System.IO.MemoryStream();
        workbook.SaveAs(ms);
        var nombre = $"Compromisos_{(_proyecto?.Nombre ?? "Proyecto").Replace(" ", "_")}_{DateTime.Today:yyyyMMdd}.xlsx";
        await JS.InvokeVoidAsync("downloadFile", nombre, Convert.ToBase64String(ms.ToArray()),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private sealed class FiltroModel
    {
        public string? Rubro { get; set; }
        public string? OC { get; set; }
        public string? Proveedor { get; set; }
        public string? Descripcion { get; set; }
        public string? Factura { get; set; }
        public DateTime? FechaDesde { get; set; }
        public DateTime? FechaHasta { get; set; }
        public string Estado { get; set; } = "";
        public FiltroModel Clone() => (FiltroModel)MemberwiseClone();
    }

