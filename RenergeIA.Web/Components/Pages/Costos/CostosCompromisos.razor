    private RenderFragment TablaHitos(CompromisoCosto c, bool esOc) =>
        @<div class="table-responsive px-3 py-2">
            <table class="table table-sm mb-0" style="font-size:.72rem;background:#fff">
                <thead style="border-bottom:1px solid #183963">
                    <tr style="color:#183963">
                        <th>CÓDIGO</th>
                        <th>@(esOc ? "DOCUMENTO" : "DETALLE")</th>
                        <th>DESCRIPCIÓN</th>
                        <th>FECHA</th>
                        @if (esOc)
                        {
                            <th class="text-end">SUBTOTAL</th>
                            <th class="text-end">IVA</th>
                        }
                        <th class="text-end">IMPORTE</th>
                        @if (esOc)
                        {
                            <th class="text-end">RET. FUENTE</th>
                            <th class="text-end">RET. ICA</th>
                        }
                        <th class="text-end">TOTAL A PAGAR</th>
                        <th>ESTADO</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grupoPeriodo in c.Hitos.OrderBy(h => h.Orden).GroupBy(h => h.Periodo))
                    {
                        @if (!string.IsNullOrEmpty(grupoPeriodo.Key))
                        {
                            <tr style="background:#eef1f6">
                                <td colspan="@(esOc ? 11 : 7)" class="fw-semibold" style="color:#183963">
                                    @grupoPeriodo.Key
                                    <span class="text-muted fw-normal ms-2">@Fmt(c, grupoPeriodo.Sum(h => h.Importe))</span>
                                </td>
                            </tr>
                        }
                        @foreach (var h in grupoPeriodo)
                        {
                            <tr style="@(h.Pagado ? "background:#eaf6e4" : "")">
                                <td style="white-space:nowrap">
                                    @if (h.Codigo is null || _codigoEdit.ContainsKey(h.Id))
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            <input class="form-control form-control-sm py-0" list="codigos-rubro"
                                                   style="width:90px;font-size:.7rem;border-color:#dc3545"
                                                   placeholder="Código"
                                                   value="@_codigoEdit.GetValueOrDefault(h.Id)"
                                                   @onchange='e => _codigoEdit[h.Id] = e.Value?.ToString() ?? ""' />
                                            <button class="btn btn-sm py-0 px-1" style="background:#183963;color:#fff;border:none;font-size:.65rem"
                                                    title="Asignar código (queda recordado para próximas importaciones)"
                                                    @onclick="() => AsignarCodigoHitoAsync(c, h)">✓</button>
                                            @if (h.Codigo is not null)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size:.65rem"
