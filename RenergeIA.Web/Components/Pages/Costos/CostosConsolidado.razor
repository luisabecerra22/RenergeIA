<script suppress-error="BL9992">
    window.renderFlujoChart = function (labels, ingresos, pagos, caja, cierreActual) {
        var canvas = document.getElementById('flujoChart');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (window._flujoChartInstance) window._flujoChartInstance.destroy();

        var datasets = [
            { label: 'Ingresos', data: ingresos, type: 'bar', backgroundColor: 'rgba(24,57,99,0.85)', borderColor: '#183963', borderWidth: 1, order: 2, yAxisID: 'y' },
            { label: 'Pagos', data: pagos, type: 'bar', backgroundColor: 'rgba(255,127,14,0.85)', borderColor: '#ff7f0e', borderWidth: 1, order: 2, yAxisID: 'y' },
            { label: 'Caja', data: caja, type: 'line', borderColor: '#6ABF4B', backgroundColor: 'rgba(106,191,75,0.1)', borderWidth: 2.5, pointRadius: 0, fill: false, tension: 0.3, order: 1, yAxisID: 'y' }
        ];

        window._flujoChartInstance = new Chart(ctx, {
            data: { labels: labels, datasets: datasets },
            options: {
                responsive: true, maintainAspectRatio: false, animation: { duration: 600 },
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    title: { display: true, text: 'Flujo de caja — Cierre semana ' + cierreActual, font: { size: 13, weight: 'bold' }, color: '#183963' },
                    legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 10, font: { size: 11 } } },
                    tooltip: { callbacks: { label: function(c) { return c.dataset.label + ': ' + (c.parsed.y||0).toLocaleString('es-CO'); } } }
                },
                scales: {
                    x: { ticks: { maxRotation: 60, font: { size: 9 } }, grid: { display: false } },
                    y: { position: 'left', ticks: { callback: function(v) { return v < 0 ? '(' + Math.abs(v).toLocaleString('es-CO') + ')' : v.toLocaleString('es-CO'); }, font: { size: 9 } }, grid: { color: '#eee' } }
                }
            }
        });

        setTimeout(function () {
            var img = document.getElementById('flujoChartImg');
            if (img && canvas) img.src = canvas.toDataURL('image/png');
        }, 800);
    };
</script>
