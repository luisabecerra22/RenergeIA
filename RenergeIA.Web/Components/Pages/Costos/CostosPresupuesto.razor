@inject RenergeIADbContext Db
@inject CostoService CostoSvc
@using RenergeIA.Web.Services
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using ClosedXML.Excel

@if (_proyecto is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="d-flex justify-content-end gap-2 mb-3">
        <div class="btn-group btn-group-sm me-2" role="group" title="Filtrar actividades por moneda">
            <button class="btn @(_moneda == "COP" ? "" : "btn-outline-secondary")"
                    style="@(_moneda == "COP" ? "background:#183963;color:#fff;border:none" : "")"
                    @onclick='() => CambiarVistaMoneda("COP")'>Solo COP</button>
            <button class="btn @(_moneda == "USD" ? "" : "btn-outline-secondary")"
                    style="@(_moneda == "USD" ? "background:#183963;color:#fff;border:none" : "")"
                    @onclick='() => CambiarVistaMoneda("USD")'>Solo USD</button>
            <button class="btn @(_moneda == "AMBAS" ? "" : "btn-outline-secondary")"
                    style="@(_moneda == "AMBAS" ? "background:#183963;color:#fff;border:none" : "")"
                    @onclick='() => CambiarVistaMoneda("AMBAS")'>Ambas (en COP)</button>
        </div>
        @if (_moneda != "COP" && _proyecto is not null)
        {
            <div class="d-flex align-items-center gap-1 me-2">
                <label class="form-label mb-0 small text-muted">TRM $</label>
                <input type="number" class="form-control form-control-sm text-center" style="width:90px"
                       value="@_proyecto.TasaCambioCOPUSD"
                       @onchange="CambiarTasaCambio" min="1" step="1" />
            </div>
        }
        @if (_hayCAmbios)
        {
            <button class="btn btn-sm fw-semibold"
                    style="background:#6ABF4B;color:#fff;border:none"
                    @onclick="GuardarCambiosPartidasAsync">
                💾 Guardar cambios
            </button>
        }
        <label class="btn btn-sm btn-outline-primary mb-0" title="Importar presupuesto desde Excel (.xlsx)">
            <i class="bi-upload me-1"></i>Importar Excel
            <InputFile OnChange="ImportarExcelAsync" accept=".xlsx,.xls" style="display:none" />
        </label>
        <label class="btn btn-sm mb-0" style="background:#183963;color:#fff;border:none"
               title="Importar la Codificación del proyecto (.xlsx): crea el presupuesto por rubros con disciplinas como categorías (hojas COD COP/USD y PPTO COP/USD)">
            <i class="bi-diagram-3 me-1"></i>Importar Codificación
            <InputFile OnChange="LeerCodificacionAsync" accept=".xlsx,.xls" style="display:none" />
        </label>
        @if (_partidas.Any())
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="ConfirmarPlantilla">↻ Recargar plantilla</button>
        }
        else
        {
            <button class="btn btn-sm"
                    style="background:#6ABF4B;color:#fff;border:none"
                    @onclick="CargarPlantillaAsync">📋 Cargar plantilla EPC</button>
        }
    </div>

    @if (_codifPendiente is not null)
    {
        var nCop = _codifPendiente.Count(r => r.Moneda == "COP");
        var nUsd = _codifPendiente.Count(r => r.Moneda == "USD");
        <div class="alert alert-warning d-flex align-items-center gap-3 mb-4 py-2 flex-wrap">
            <span>
                <strong>Codificación leída:</strong> @nCop rubros COP y @nUsd rubros USD en
                @_codifPendiente.Select(r => r.Disciplina).Distinct().Count() disciplinas.
                <strong>¡Atención!</strong> Esto reemplazará todas las partidas actuales del presupuesto
                (y los pagos del flujo de caja asociados).
            </span>
            <button class="btn btn-warning btn-sm" @onclick="ConfirmarCodificacionAsync">Confirmar e importar</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _codifPendiente = null">Cancelar</button>
        </div>
    }

    @if (_confirmandoPlantilla)
    {
        <div class="alert alert-warning d-flex align-items-center gap-3 mb-4 py-2">
            <span><strong>¡Atención!</strong> Esto reemplazará todas las partidas y sus costos.</span>
            <button class="btn btn-warning btn-sm" @onclick="CargarPlantillaAsync">Confirmar</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoPlantilla = false">Cancelar</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_mensajeGuardado))
    {
        <div class="alert @(_mensajeEsError ? "alert-danger" : "alert-success") alert-dismissible py-2 mb-3">
            @_mensajeGuardado
            <button type="button" class="btn-close btn-sm" @onclick="() => _mensajeGuardado = null"></button>
        </div>
    }

    @if (_cargando)
    {
        <div class="text-center py-5">
            <span class="spinner-border" style="color:#183963"></span>
            <p class="mt-2 text-muted">Cargando plantilla...</p>
        </div>
    }
    else if (!_partidas.Any())
    {
        <div class="card text-center py-5" style="border:1px solid #D9D9D6">
            <p class="text-muted mb-3">No hay partidas. Cargue la plantilla estándar EPC fotovoltaico.</p>
            <div>
                <button class="btn"
                        style="background:#6ABF4B;color:#fff;border:none"
                        @onclick="CargarPlantillaAsync">📋 Cargar plantilla estándar EPC</button>
            </div>
        </div>
    }
    else
    {
        <SeccionDash Titulo="Resumen de Presupuesto" Icono="bi-currency-dollar">
            <div class="row row-cols-2 row-cols-md-4 g-3 mb-3">
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100" style="background:linear-gradient(135deg,#183963 0%,#1e4d7a 100%);color:#fff;border-radius:14px">
                        <i class="bi-wallet2 mb-1" style="font-size:1.5rem;opacity:0.8"></i>
                        <div class="fw-bold fs-5">@(_moneda == "USD" ? FormatUSD(_totalPresupUSD) : FormatCOP(_totalPresupCOP))</div>
                        <div class="small" style="opacity:0.7">@(_moneda == "USD" ? FormatCOP(_totalPresupCOP) : FormatUSD(_totalPresupUSD))</div>
                        <div class="small" style="opacity:0.8">Total Presupuestado @EtiquetaVista</div>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100" style="background:@(_totalEjecCOP > _totalPresupCOP ? "linear-gradient(135deg,#dc3545 0%,#c82333 100%)" : "linear-gradient(135deg,#6ABF4B 0%,#5aa83e 100%)");color:#fff;border-radius:14px">
                        <i class="bi-receipt mb-1" style="font-size:1.5rem;opacity:0.8"></i>
                        <div class="fw-bold fs-5">@(_moneda == "USD" ? FormatUSD(_totalEjecUSD) : FormatCOP(_totalEjecCOP))</div>
                        <div class="small" style="opacity:0.7">@(_moneda == "USD" ? FormatCOP(_totalEjecCOP) : FormatUSD(_totalEjecUSD))</div>
                        <div class="small" style="opacity:0.8">Total Ejecutado @EtiquetaVista</div>
                    </div>
                </div>
                <div class="col">
                    @{
                        var difCOP = _totalPresupCOP - _totalEjecCOP;
                        var difUSD = _totalPresupUSD - _totalEjecUSD;
                    }
                    <div class="card border-0 shadow-sm text-center p-3 h-100" style="background:@(difCOP >= 0 ? "linear-gradient(135deg,#e8f5e2 0%,#d4edcc 100%)" : "linear-gradient(135deg,#fde8e8 0%,#f8d0d0 100%)");border-radius:14px">
                        <i class="bi-arrow-left-right mb-1" style="font-size:1.5rem;color:@(difCOP >= 0 ? "#6ABF4B" : "#dc3545")"></i>
                        <div class="fw-bold fs-5" style="color:@(difCOP >= 0 ? "#6ABF4B" : "#dc3545")">@(_moneda == "USD" ? FormatUSD(difUSD) : FormatCOP(difCOP))</div>
                        <div class="small text-muted">@(_moneda == "USD" ? FormatCOP(difCOP) : FormatUSD(difUSD))</div>
                        <div class="small text-muted">Diferencia @EtiquetaVista</div>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100" style="background:linear-gradient(135deg,#f0f4ff 0%,#dce3f0 100%);border-radius:14px">
                        <i class="bi-percent mb-1" style="font-size:1.5rem;color:#183963"></i>
                        <div class="fw-bold fs-5" style="color:@(_pctEjecucion > 100 ? "#dc3545" : "#183963")">@_pctEjecucion.ToString("F1")%</div>
                        <div class="small text-muted">% Ejecutado</div>
                    </div>
                </div>
            </div>
        </SeccionDash>

        <div class="card mb-4" style="border:1px solid #D9D9D6">
            <div class="card-header text-white fw-semibold" style="background:#183963">
                Costos por Categoría
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background:#183963;color:white">
                        <tr>
                            <th class="text-center">Categoría</th>
                            <th class="text-center">Presup. COP</th>
                            <th class="text-center">Presup. USD</th>
                            <th class="text-center">Ejec. COP</th>
                            <th class="text-center">Ejec. USD</th>
                            <th class="text-center" style="min-width:160px">% Costo Ejecutado</th>
                            <th class="text-center">Actividades</th>
                            <th class="text-center">Alerta</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in _resumenCategorias)
                        {
                            var (aTexto, aBg, aFg) = AlertaCosto(cat.PresupCOP, cat.ComprometidoCOP, cat.EjecCOP);
                            <tr style="border-bottom:1px solid #D9D9D6">
                                <td class="text-center">
                                    <span class="badge" style="background:#183963;font-size:0.78rem">@cat.Nombre</span>
                                </td>
                                <td class="text-center small" style="color:#183963">@FormatCOP(cat.PresupCOP)</td>
                                <td class="text-center small" style="color:#183963">@FormatUSD(cat.PresupUSD)</td>
                                <td class="text-center small"
                                    style="color:@(cat.EjecCOP > cat.PresupCOP ? "#dc3545" : "#111921");
                                           font-weight:@(cat.EjecCOP > cat.PresupCOP ? "bold" : "normal")">
                                    @FormatCOP(cat.EjecCOP)
                                </td>
                                <td class="text-center small"
                                    style="color:@(cat.EjecUSD > cat.PresupUSD ? "#dc3545" : "#111921");
                                           font-weight:@(cat.EjecUSD > cat.PresupUSD ? "bold" : "normal")">
                                    @FormatUSD(cat.EjecUSD)
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:7px;background:#D9D9D6">
                                            <div class="progress-bar"
                                                 style="width:@(Math.Min(cat.PctEjecucion, 100m).ToString("F6", System.Globalization.CultureInfo.InvariantCulture))%;background:#6ABF4B"></div>
                                        </div>
                                        <small style="width:60px;text-align:right;white-space:nowrap;color:#183963">@FormatPct(cat.PctEjecucion)</small>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill" style="background:#183963">@cat.NumPartidas</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge" style="background:@aBg;color:@aFg;font-size:0.72rem;white-space:nowrap">
                                        @aTexto
                                    </span>
                                </td>
                            </tr>
                        }
                        <tr class="fw-bold" style="background:#111921;color:white">
                            <td class="text-center">TOTAL</td>
                            <td class="text-center">@FormatCOP(_totalPresupCOP)</td>
                            <td class="text-center">@FormatUSD(_totalPresupUSD)</td>
                            <td class="text-center"
                                style="color:@(_totalEjecCOP > _totalPresupCOP ? "#ff6b6b" : "white")">
                                @FormatCOP(_totalEjecCOP)
                            </td>
                            <td class="text-center"
                                style="color:@(_totalEjecUSD > _totalPresupUSD ? "#ff6b6b" : "white")">
                                @FormatUSD(_totalEjecUSD)
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:7px;background:rgba(255,255,255,0.2)">
                                        <div class="progress-bar"
                                             style="width:@(Math.Min(_pctEjecucion, 100m).ToString("F6", System.Globalization.CultureInfo.InvariantCulture))%;background:#6ABF4B"></div>
                                    </div>
                                    <small style="width:60px;text-align:right;white-space:nowrap">@FormatPct(_pctEjecucion)</small>
                                </div>
                            </td>
                            <td class="text-center">@SubsVista.Count</td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mb-4" style="border:1px solid #D9D9D6;overflow:hidden">
            <div class="card-header text-white d-flex justify-content-between align-items-center"
                 style="background:#183963">
                <div class="d-flex align-items-center gap-2">
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn"
                                style="@(_vistaActiva == "presupuesto" ? "background:#6ABF4B;color:#fff;border:none" : "background:transparent;color:#fff;border:1px solid rgba(255,255,255,0.5)")"
                                @onclick="MostrarPresupuestoAsync">
                            Actividades Presupuestadas
                        </button>
                        <button class="btn"
                                style="@(_vistaActiva == "pagos" ? "background:#6ABF4B;color:#fff;border:none" : "background:transparent;color:#fff;border:1px solid rgba(255,255,255,0.5)")"
                                @onclick='() => _vistaActiva = "pagos"'>
                            Flujo de Caja
                        </button>
                    </div>
                </div>
                @if (_vistaActiva == "presupuesto" && _hayCAmbios)
                {
                    <button class="btn btn-sm fw-semibold"
                            style="background:#6ABF4B;color:#fff;border:none"
                            @onclick="GuardarCambiosPartidasAsync">
                        💾 Guardar cambios
                    </button>
                }
            </div>

            @if (_vistaActiva == "pagos")
            {
                <div class="card-body p-3">
                    <CostosPagos ProyectoId="ProyectoId" />
                </div>
            }
            else
            {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" style="table-layout:fixed;width:100%">
                    <colgroup>
                        <col style="width:42px" />
                        <col style="width:82px" />
                        <col style="width:190px" />
                        <col style="width:110px" />
                        <col style="width:110px" />
                        <col style="width:65px" />
                        <col style="width:110px" />
                        <col style="width:110px" />
                        <col style="width:110px" />
                        <col style="width:80px" />
                        <col style="width:50px" />
                    </colgroup>
                    <thead style="background:#183963;color:white">
                        <tr>
                            <th class="text-center">#</th>
                            <th class="text-center">Código</th>
                            <th class="text-center">Descripción</th>
                            <th class="text-center">Presupuesto</th>
                            <th class="text-center" title="Suma del Flujo de Caja hasta la semana anterior a la actual">Ejecutado</th>
                            <th class="text-center">% Ejec.</th>
                            <th class="text-center">Comprometido</th>
                            <th class="text-center">Pendiente Ejec.</th>
                            <th class="text-center">Alerta</th>
                            <th class="text-center">Moneda</th>
                            <th class="text-center"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in PartidasOrdenadas())
                        {
                            if (p.EsPrincipal)
                            {
                                var hijos           = HijosVista(p.Id);
                                var presupCap       = hijos.Sum(PresVista);
                                var ejecutadoCap    = hijos.Sum(EjecVista);
                                var comprometidoCap = hijos.Sum(CompVista);
                                var pendienteCap    = presupCap - comprometidoCap - ejecutadoCap;
                                var pctCap          = presupCap > 0 ? Math.Round(ejecutadoCap / presupCap * 100, 1) : 0m;
                                var (aTexto, aBg, aFg) = AlertaCosto(presupCap, comprometidoCap, ejecutadoCap);
                                <tr style="background:#D9D9D6">
                                    <td class="text-center fw-bold" style="color:#111921">@p.Numero</td>
                                    <td class="text-center">
                                        <span class="badge" style="background:#183963;font-size:0.68rem">@p.Codigo</span>
                                    </td>
                                    <td class="fw-bold text-uppercase"
                                        style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#111921"
                                        title="@p.Descripcion">@p.Descripcion</td>
                                    <td class="text-center fw-bold" style="color:#183963">@FmtVista(presupCap)</td>
                                    <td class="text-center fw-bold"
                                        style="color:@(ejecutadoCap > presupCap ? "#dc3545" : "#6ABF4B")">
                                        @FmtVista(ejecutadoCap)
                                    </td>
                                    <td class="text-center fw-bold" style="color:#183963">@pctCap.ToString("F0")%</td>
                                    <td class="text-center fw-bold" style="color:#6c757d">@FmtVista(comprometidoCap)</td>
                                    <td class="text-center fw-bold" style="color:@(pendienteCap < 0 ? "#dc3545" : "#183963")">@FmtVista(pendienteCap)</td>
                                    <td class="text-center">
                                        <span class="badge" style="background:@aBg;color:@aFg;font-size:0.68rem;white-space:nowrap">@aTexto</span>
                                    </td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            }
                            else
                            {
                                var presup         = p.MontoPresupuestado;
                                var ejecutado      = p.ValorEjecutado;
                                var comprometido   = ComprometidoMO(p);
                                var pendiente      = presup - comprometido - ejecutado;
                                var pct            = presup > 0 ? Math.Round(ejecutado / presup * 100, 1) : 0m;
                                var sobreEjecucion = ejecutado > presup && presup > 0;
                                var esCOP          = p.MonedaOriginal == "COP";
                                var prefijo        = esCOP ? "$" : "US$ ";
                                var (aTexto, aBg, aFg) = AlertaCosto(presup, comprometido, ejecutado);

                                <tr style="border-bottom:1px solid #D9D9D6">
                                    <td class="text-center small" style="color:#6c757d">@p.Numero</td>
                                    <td class="text-center">
                                        <small class="fw-semibold" style="color:#183963">@p.Codigo</small>
                                    </td>
                                    <td class="ps-3"
                                        style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#111921"
                                        title="@p.Descripcion">@p.Descripcion</td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center fw-semibold"
                                               style="color:#183963"
                                               value="@presup.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                               @onchange="e => CambiarPresupuesto(p, e.Value?.ToString())"
                                               min="0" step="0.01" />
                                    </td>
                                    <td class="text-center small fw-semibold"
                                        style="color:@(sobreEjecucion ? "#dc3545" : ejecutado > 0 ? "#183963" : "#adb5bd")"
                                        title="Suma del Flujo de Caja de este código desde el inicio hasta la semana anterior (corte @CostoService.InicioSemanaActual().AddDays(-7).ToString("dd/MM/yyyy"))">
                                        @(ejecutado > 0 ? $"{prefijo}{ejecutado.ToString("N2", _culturesCO)}" : "—")
                                    </td>
                                    <td class="text-center small"
                                        style="color:@(sobreEjecucion ? "#dc3545" : pct > 0 ? "#6ABF4B" : "#6c757d");
                                               font-weight:@(sobreEjecucion ? "bold" : "normal")">
                                        @pct.ToString("F0")%
                                    </td>
                                    <td class="text-center small fw-semibold" style="color:#6c757d"
                                        title="Flujo de Caja de este código desde la semana en curso en adelante (por pagar)">
                                        @(comprometido > 0 ? $"{prefijo}{comprometido.ToString("N2", _culturesCO)}" : "—")
                                    </td>
                                    <td class="text-center small fw-semibold" style="color:@(pendiente < 0 ? "#dc3545" : "#183963")">
                                        @prefijo@pendiente.ToString("N2", _culturesCO)
                                    </td>
                                    <td class="text-center">
                                        <span class="badge"
                                              style="background:@aBg;color:@aFg;font-size:0.68rem;white-space:nowrap">@aTexto</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button class="btn @(esCOP ? "" : "btn-outline-secondary") py-0 px-1"
                                                    style="font-size:0.6rem;@(esCOP ? "background:#183963;color:#fff;border-color:#183963" : "")"
                                                    @onclick="@(() => CambiarMoneda(p, "COP"))">COP</button>
                                            <button class="btn @(!esCOP ? "" : "btn-outline-secondary") py-0 px-1"
                                                    style="font-size:0.6rem;@(!esCOP ? "background:#183963;color:#fff;border-color:#183963" : "")"
                                                    @onclick="@(() => CambiarMoneda(p, "USD"))">USD</button>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn"
                                                style="font-size:0.65rem;padding:2px 5px;line-height:1.2;border:1px solid #183963;color:#183963"
                                                @onclick="() => AbrirCostos(p)"
                                                title="Ver costos reales">💰</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            }
        </div>

        @if (_partidaSeleccionada is not null)
        {
            <div class="card mt-2" style="border:1px solid #183963">
                <div class="card-header text-white d-flex justify-content-between align-items-center"
                     style="background:#183963">
                    <strong>Costos reales — @_partidaSeleccionada.Codigo: @_partidaSeleccionada.Descripcion</strong>
                    <button class="btn-close btn-close-white btn-sm" @onclick="() => _partidaSeleccionada = null"></button>
                </div>
                <div class="card-body">
                    <h6 class="mb-3" style="color:#183963">Registrar nuevo costo</h6>
                    <EditForm Model="_formCosto" OnValidSubmit="GuardarCostoAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-2">
                            <div class="col-md-2">
                                <label class="form-label small">Fecha *</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="_formCosto.Fecha" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Descripción *</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_formCosto.Descripcion" />
                                <ValidationMessage For="() => _formCosto.Descripcion" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Tipo</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_formCosto.TipoCosto">
                                    <option value="Material">Material</option>
                                    <option value="Mano de obra">Mano de obra</option>
                                    <option value="Equipo">Equipo</option>
                                    <option value="Subcontrato">Subcontrato</option>
                                    <option value="Otro">Otro</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-1">
                                <label class="form-label small">Cantidad</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_formCosto.Cantidad" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Precio Unitario COP</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_formCosto.PrecioUnitario" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Factura / Proveedor</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_formCosto.NumeroFactura" placeholder="FAC-001" />
                            </div>
                            <div class="col-12 d-flex gap-2 align-items-center">
                                <button type="submit" class="btn btn-sm"
                                        style="background:#183963;color:white;border:none">+ Agregar</button>
                                <span class="text-muted small">Monto: <strong>@FormatCOP(_formCosto.Cantidad * _formCosto.PrecioUnitario)</strong></span>
                            </div>
                        </div>
                    </EditForm>

                    @if (_partidaSeleccionada.CostosReales.Any())
                    {
                        <hr />
                        <h6 class="mb-2" style="color:#183963">Historial de costos</h6>
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead style="background:#183963;color:white">
                                    <tr>
                                        <th>Fecha</th><th>Descripción</th><th>Tipo</th>
                                        <th class="text-end">Cant.</th><th class="text-end">P. Unit.</th>
                                        <th class="text-end">Monto COP</th><th>Factura</th><th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in _partidaSeleccionada.CostosReales.OrderByDescending(x => x.Fecha))
                                    {
                                        <tr style="border-bottom:1px solid #D9D9D6">
                                            <td class="small">@c.Fecha.ToShortDateString()</td>
                                            <td>@c.Descripcion</td>
                                            <td><span class="badge" style="background:#D9D9D6;color:#111921">@c.TipoCosto</span></td>
                                            <td class="text-end small">@c.Cantidad.ToString("N2")</td>
                                            <td class="text-end small">@FormatCOP(c.PrecioUnitario)</td>
                                            <td class="text-end fw-semibold" style="color:#183963">@FormatCOP(c.Cantidad * c.PrecioUnitario)</td>
                                            <td class="small text-muted">@(c.NumeroFactura ?? "—")</td>
                                            <td>
                                                @if (_confirmandoEliminarCosto == c.Id)
                                                {
                                                    <button class="btn btn-danger btn-sm" @onclick="() => EliminarCostoAsync(c.Id)">✓</button>
                                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminarCosto = null">×</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminarCosto = c.Id">✕</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<Partida> _partidas = [];
    private List<Partida> _subPartidas = [];
    private Dictionary<int, Partida> _padresDict = [];
    private List<CategoriaResumen> _resumenCategorias = [];

    private bool _cargando;
    private bool _confirmandoPlantilla;
    private List<CodificacionParser.RubroCodificacion>? _codifPendiente;
    private bool _hayCAmbios;
    private string? _mensajeGuardado;
    private bool _mensajeEsError;

    private Partida? _partidaSeleccionada;
    private int? _confirmandoEliminarCosto;

    private decimal _totalPresupCOP;
    private decimal _totalPresupUSD;
    private decimal _totalEjecCOP;
    private decimal _totalEjecUSD;
    private decimal _pctEjecucion;

    private CostoFormModel _formCosto = new();
    private string _moneda = "AMBAS";
    private string _vistaActiva = "presupuesto";

    private async Task MostrarPresupuestoAsync()
    {
        if (_vistaActiva == "presupuesto") return;
        _vistaActiva = "presupuesto";
        await CargarAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        await CostoSvc.SincronizarEjecutadoDesdeFlujoAsync(ProyectoId);
        _partidas    = await CostoSvc.ObtenerPartidasConCostosAsync(ProyectoId);
        _subPartidas = _partidas.Where(p => !p.EsPrincipal).OrderBy(p => OrdenNumero(p.Numero)).ToList();
        _padresDict  = _partidas.Where(p => p.EsPrincipal).ToDictionary(p => p.Id);

        CalcularTotales();
        CalcularResumenCategorias();
        _hayCAmbios = false;
    }

    private decimal TRM => _proyecto is { TasaCambioCOPUSD: > 0 } ? _proyecto.TasaCambioCOPUSD : 4000m;

    private decimal ACOP(Partida p) => p.MonedaOriginal == "USD" ? p.MontoPresupuestado * TRM : p.MontoPresupuestado;
    private decimal AUSD(Partida p) => p.MonedaOriginal == "COP" ? p.MontoPresupuestado / TRM : p.MontoPresupuestado;
    private decimal EjecACOP(Partida p) => p.MonedaOriginal == "USD" ? p.ValorEjecutado * TRM : p.ValorEjecutado;
    private decimal EjecAUSD(Partida p) => p.MonedaOriginal == "COP" ? p.ValorEjecutado / TRM : p.ValorEjecutado;
    // Comprometido = flujo de caja desde la semana en curso en adelante (por pagar), en moneda de la partida
    private decimal ComprometidoMO(Partida p) => p.MontoComprometido;
    private decimal CompACOP(Partida p) => p.MonedaOriginal == "USD" ? p.MontoComprometido * TRM : p.MontoComprometido;

    // Vista por moneda: "COP" = solo actividades en pesos, "USD" = solo en dólares,
    // "AMBAS" = todas, consolidadas en COP (las USD se convierten con la TRM del proyecto)
    private bool EnVista(Partida p) => _moneda == "AMBAS" || p.MonedaOriginal == _moneda;
    private List<Partida> SubsVista => _subPartidas.Where(EnVista).ToList();
    private List<Partida> HijosVista(int padreId) =>
        _subPartidas.Where(s => s.PadreId == padreId && EnVista(s)).OrderBy(s => OrdenNumero(s.Numero)).ToList();

    private decimal PresVista(Partida p) => _moneda == "AMBAS" ? ACOP(p) : p.MontoPresupuestado;
    private decimal EjecVista(Partida p) => _moneda == "AMBAS" ? EjecACOP(p) : p.ValorEjecutado;
    private decimal CompVista(Partida p) => _moneda == "AMBAS" ? CompACOP(p) : ComprometidoMO(p);
    private string FmtVista(decimal v) => _moneda == "USD" ? FormatUSD(v) : FormatCOP(v);
    private string EtiquetaVista => _moneda switch { "COP" => "(solo COP)", "USD" => "(solo USD)", _ => "(COP + USD)" };

    private void CambiarVistaMoneda(string vista)
    {
        _moneda = vista;
        CalcularTotales();
        CalcularResumenCategorias();
    }

    private void CalcularTotales()
    {
        var subs = SubsVista;
        _totalPresupCOP = subs.Sum(ACOP);
        _totalPresupUSD = subs.Sum(AUSD);
        _totalEjecCOP   = subs.Sum(EjecACOP);
        _totalEjecUSD   = subs.Sum(EjecAUSD);
        _pctEjecucion   = _totalPresupCOP > 0
            ? _totalEjecCOP / _totalPresupCOP * 100 : 0;
    }

    private void CalcularResumenCategorias()
    {
        _resumenCategorias = _partidas
            .Where(p => p.EsPrincipal)
            .OrderBy(p => OrdenNumero(p.Numero))
            .Select(principal =>
            {
                var hijos        = HijosVista(principal.Id);
                var presupCOP    = hijos.Sum(ACOP);
                var presupUSD    = hijos.Sum(AUSD);
                var ejecCOP      = hijos.Sum(EjecACOP);
                var ejecUSD      = hijos.Sum(EjecAUSD);
                var comprometidoCOP = hijos.Sum(CompACOP);
                var pct          = presupCOP > 0 ? ejecCOP / presupCOP * 100 : 0m;
                return new CategoriaResumen(
                    principal.Descripcion, principal.Codigo,
                    presupCOP, presupUSD, ejecCOP, ejecUSD, comprometidoCOP, pct, hijos.Count);
            })
            .ToList();
    }

    private IEnumerable<Partida> PartidasOrdenadas()
    {
        foreach (var principal in _partidas.Where(p => p.EsPrincipal).OrderBy(p => OrdenNumero(p.Numero)))
        {
            var hijos = HijosVista(principal.Id);
            if (hijos.Count == 0 && _moneda != "AMBAS") continue;
            yield return principal;
            foreach (var hijo in hijos)
                yield return hijo;
        }
    }

    private void CambiarPresupuesto(Partida p, string? valor)
    {
        if (decimal.TryParse(valor, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var montoMostrado))
        {
            if (p.CantidadPresupuestada <= 0) p.CantidadPresupuestada = 1;
            p.PrecioUnitario = Math.Max(montoMostrado, 0) / p.CantidadPresupuestada;
            CalcularTotales(); CalcularResumenCategorias();
            _hayCAmbios = true;
        }
    }

    private string FormatMontoMixto(decimal montoCOP) =>
        "$" + montoCOP.ToString("N0", _culturesCO);

    private string FormatUSD(decimal v) => "US$ " + v.ToString("N2", _culturesCO);


    private void CambiarMoneda(Partida p, string moneda)
    {
        if (p.MonedaOriginal == moneda) return;
        if (moneda == "USD" && p.MonedaOriginal == "COP")
        {
            p.PrecioUnitario = p.PrecioUnitario / TRM;
            p.ValorEjecutado = p.ValorEjecutado / TRM;
            p.MontoComprometido = p.MontoComprometido / TRM;
        }
        else if (moneda == "COP" && p.MonedaOriginal == "USD")
        {
            p.PrecioUnitario = p.PrecioUnitario * TRM;
            p.ValorEjecutado = p.ValorEjecutado * TRM;
            p.MontoComprometido = p.MontoComprometido * TRM;
        }
        p.MonedaOriginal = moneda;
        CalcularTotales(); CalcularResumenCategorias();
        _hayCAmbios = true;
    }

    private async Task CambiarTasaCambio(ChangeEventArgs e)
    {
        if (_proyecto is null) return;
        if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var trm) && trm > 0)
        {
            _proyecto.TasaCambioCOPUSD = trm;
            Db.Proyectos.Update(_proyecto);
            await Db.SaveChangesAsync();
        }
    }

    private async Task GuardarCambiosPartidasAsync()
    {
        foreach (var p in _subPartidas)
            Db.Partidas.Update(p);
        await Db.SaveChangesAsync();
        MostrarMensaje("Cambios guardados correctamente.", false);
        await CargarAsync();
    }

    // ── Importar presupuesto desde Excel (.xlsx) ────────────────────────────

    private async Task ImportarExcelAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            using var ms = new System.IO.MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            using var workbook = new XLWorkbook(ms);
            var ws = workbook.Worksheets.First();
            var lastRow = ws.LastRowUsed()?.RowNumber() ?? 0;
            var lastCol = ws.LastColumnUsed()?.ColumnNumber() ?? 0;
            if (lastRow < 2) { MostrarMensaje("El archivo no tiene filas de datos.", true); return; }

            int headerRow = 0;
            int colCodigo = 0, colPresup = 0, colEjec = 0, colComprometido = 0;
            for (int r = 1; r <= Math.Min(10, lastRow) && headerRow == 0; r++)
            {
                for (int c = 1; c <= lastCol; c++)
                {
                    var texto = NormalizarTexto(ws.Cell(r, c).GetString());
                    if (texto.Contains("codigo")) colCodigo = c;
                    else if (texto.Contains("comprometido")) colComprometido = c;
                    else if (texto.Contains("presup")) colPresup = c;
                    else if (texto.Contains("ejec")) colEjec = c;
                }
                if (colCodigo > 0 && colPresup > 0) headerRow = r;
                else { colCodigo = colPresup = colEjec = colComprometido = 0; }
            }

            if (headerRow == 0)
            {
                MostrarMensaje("No se encontraron columnas 'Código' y 'Presupuesto' en las primeras filas del archivo.", true);
                return;
            }

            int actualizados = 0, noEncontrados = 0;
            for (int row = headerRow + 1; row <= lastRow; row++)
            {
                var codigo = ws.Cell(row, colCodigo).GetString().Trim();
                if (string.IsNullOrEmpty(codigo)) continue;

                var partida = _subPartidas.FirstOrDefault(p => string.Equals(p.Codigo, codigo, StringComparison.OrdinalIgnoreCase));
                if (partida is null) { noEncontrados++; continue; }

                var presup = LeerMonto(ws.Cell(row, colPresup));
                if (presup is null) continue;

                if (partida.CantidadPresupuestada <= 0) partida.CantidadPresupuestada = 1;
                partida.PrecioUnitario = Math.Max(presup.Value, 0) / partida.CantidadPresupuestada;

                actualizados++;
            }

            if (actualizados == 0)
            {
                MostrarMensaje("No se actualizó ninguna partida. Verifica que los códigos coincidan con los de la plantilla cargada.", true);
                return;
            }

            foreach (var p in _subPartidas) Db.Partidas.Update(p);
            await Db.SaveChangesAsync();
            await CargarAsync();

            var resumen = $"{actualizados} partidas actualizadas desde Excel.";
            if (noEncontrados > 0) resumen += $" {noEncontrados} códigos del archivo no coinciden con ninguna partida.";
            MostrarMensaje(resumen, false);
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al importar: {ex.Message}", true);
        }
    }

    private static decimal? LeerMonto(IXLCell celda)
    {
        if (celda.IsEmpty()) return null;
        if (celda.DataType == XLDataType.Number) return (decimal)celda.GetDouble();

        var texto = celda.GetString().Trim();
        if (string.IsNullOrEmpty(texto)) return null;
        texto = texto.Replace("$", "").Replace(" ", "").Trim();

        if (decimal.TryParse(texto, System.Globalization.NumberStyles.Any, _culturesCO, out var vCO))
            return vCO;
        if (decimal.TryParse(texto, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var vInv))
            return vInv;
        return null;
    }

    private static string NormalizarTexto(string texto) =>
        texto.ToLowerInvariant()
             .Replace("á", "a").Replace("é", "e").Replace("í", "i").Replace("ó", "o").Replace("ú", "u")
             .Trim();

    private void MostrarMensaje(string mensaje, bool esError)
    {
        _mensajeGuardado = mensaje;
        _mensajeEsError = esError;
    }

    private void ConfirmarPlantilla() => _confirmandoPlantilla = true;

    private async Task CargarPlantillaAsync()
    {
        _cargando = true; _confirmandoPlantilla = false;
        StateHasChanged();
        await CostoSvc.CargarPlantillaEstandarAsync(ProyectoId);
        await CargarAsync();
        _cargando = false;
    }

    private async Task LeerCodificacionAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var ms = new System.IO.MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            using var workbook = new XLWorkbook(ms);
            var rubros = CodificacionParser.Parse(workbook);
            if (rubros.Count == 0)
            {
                _mensajeGuardado = "No se encontraron rubros. Verifica que el archivo tenga las hojas COD COP/USD y PPTO COP/USD.";
                _mensajeEsError = true;
                _codifPendiente = null;
                return;
            }
            _codifPendiente = rubros;
            _mensajeGuardado = null;
        }
        catch (Exception ex)
        {
            _mensajeGuardado = $"Error al leer la Codificación: {ex.Message}";
            _mensajeEsError = true;
        }
    }

    private async Task ConfirmarCodificacionAsync()
    {
        if (_codifPendiente is null) return;
        _cargando = true;
        StateHasChanged();
        try
        {
            await CostoSvc.CargarDesdeCodificacionAsync(ProyectoId, _codifPendiente);
            var nCop = _codifPendiente.Count(r => r.Moneda == "COP");
            var nUsd = _codifPendiente.Count(r => r.Moneda == "USD");
            _mensajeGuardado = $"Presupuesto cargado desde la Codificación: {nCop} rubros COP y {nUsd} rubros USD.";
            _mensajeEsError = false;
            _codifPendiente = null;
            await CargarAsync();
        }
        catch (Exception ex)
        {
            _mensajeGuardado = $"Error al importar la Codificación: {ex.Message}";
            _mensajeEsError = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void AbrirCostos(Partida p)
    {
        _partidaSeleccionada      = p;
        _formCosto                = new CostoFormModel { Fecha = DateTime.Today };
        _confirmandoEliminarCosto = null;
    }

    private async Task GuardarCostoAsync()
    {
        if (_partidaSeleccionada is null) return;
        Db.CostosReales.Add(new CostoReal
        {
            PartidaId      = _partidaSeleccionada.Id,
            Fecha          = _formCosto.Fecha,
            Descripcion    = _formCosto.Descripcion,
            TipoCosto      = _formCosto.TipoCosto,
            Cantidad       = _formCosto.Cantidad,
            PrecioUnitario = _formCosto.PrecioUnitario,
            NumeroFactura  = _formCosto.NumeroFactura,
            RegistradoPor  = "Sistema"
        });
        await Db.SaveChangesAsync();
        var idSel = _partidaSeleccionada.Id;
        await CargarAsync();
        _partidaSeleccionada = _subPartidas.FirstOrDefault(p => p.Id == idSel);
        _formCosto = new CostoFormModel { Fecha = DateTime.Today };
    }

    private async Task EliminarCostoAsync(int id)
    {
        var c = await Db.CostosReales.FindAsync(id);
        if (c is null) return;
        Db.CostosReales.Remove(c);
        await Db.SaveChangesAsync();
        _confirmandoEliminarCosto = null;
        var idSel = _partidaSeleccionada?.Id;
        await CargarAsync();
        _partidaSeleccionada = idSel.HasValue ? _subPartidas.FirstOrDefault(p => p.Id == idSel) : null;
    }

    private static (string Texto, string Bg, string Fg) AlertaCosto(decimal presupuesto, decimal comprometido, decimal ejecutado)
    {
        if (presupuesto == 0) return ("Sin presupuesto", "#D9D9D6", "#111921");
        var consumido = comprometido + ejecutado;
        if (consumido == 0) return ("Sin ejecución", "#D9D9D6", "#111921");
        var pct = consumido / presupuesto * 100;
        if (pct < 70)   return ("Dentro del presupuesto", "#6ABF4B", "#fff");
        if (pct < 85)   return ("En riesgo",               "#fd7e14", "#fff");
        if (pct <= 100) return ("Cercano al límite",       "#ffc107", "#212529");
        return ("Sobrecosto", "#dc3545", "#fff");
    }

    private static readonly System.Globalization.CultureInfo _culturesCO =
        new System.Globalization.CultureInfo("es-CO");

    private static string FormatCOP(decimal v) => "$" + v.ToString("N0", _culturesCO);

    private static string FormatPct(decimal pct) =>
        pct < 1m ? pct.ToString("F4") + "%" : pct.ToString("F1") + "%";

    private static double ParseNumero(string? num)
    {
        if (string.IsNullOrEmpty(num)) return 0;
        return double.TryParse(num, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
    }

    // Orden numérico por segmentos: "1.10" va después de "1.9" (no después de "1.1")
    private static (int, int) OrdenNumero(string? num)
    {
        if (string.IsNullOrEmpty(num)) return (0, 0);
        var partes = num.Split('.');
        int.TryParse(partes[0], out var mayor);
        var menor = 0;
        if (partes.Length > 1) int.TryParse(partes[1], out menor);
        return (mayor, menor);
    }

    private record CategoriaResumen(
        string Nombre, string Codigo,
        decimal PresupCOP, decimal PresupUSD, decimal EjecCOP, decimal EjecUSD,
        decimal ComprometidoCOP, decimal PctEjecucion, int NumPartidas);

    private sealed class CostoFormModel
    {
        [Required(ErrorMessage = "La descripción es obligatoria")]
        public string Descripcion { get; set; } = string.Empty;
        public DateTime Fecha { get; set; } = DateTime.Today;
        public string TipoCosto { get; set; } = "Material";
        public decimal Cantidad { get; set; } = 1;
        public decimal PrecioUnitario { get; set; }
        public string? NumeroFactura { get; set; }
    }
}
