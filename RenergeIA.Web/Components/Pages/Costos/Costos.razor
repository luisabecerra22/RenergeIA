@page "/proyectos/{ProyectoId:int}/costos"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db

<PageTitle>Costos — @(_nombreProyecto ?? "Proyecto")</PageTitle>

@if (_nombreProyecto is null)
{
    <p class="p-4 text-muted">Cargando...</p>
}
else
{
    <div class="px-3 py-3 mb-3 rounded-3 text-white" style="background:#183963">
        <div class="d-flex align-items-center gap-3">
            <a href="/proyectos/@ProyectoId" class="btn btn-sm btn-outline-light">&larr; Volver</a>
            <div>
                <div class="small opacity-75">Módulo de Costos</div>
                <h1 class="h4 mb-0 fw-bold">@_nombreProyecto</h1>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4 flex-wrap px-1">
        @foreach (var tab in _tabs)
        {
            var activa = _tabActivo == tab.Key;
            <button class="btn d-flex align-items-center gap-2 fw-semibold"
                    style="@(activa
                        ? "background:#183963;color:#fff;border:none;border-radius:10px;padding:8px 18px"
                        : "background:#fff;color:#183963;border:1px solid #D9D9D6;border-radius:10px;padding:8px 18px")"
                    @onclick="() => _tabActivo = tab.Key">
                <i class="@tab.Icono"></i>
                <span>@tab.Label</span>
            </button>
        }
    </div>

    @if (_tabActivo == "presupuesto")
    {
        <CostosPresupuesto ProyectoId="ProyectoId" />
    }
    else if (_tabActivo == "ejecutado")
    {
        <CostosEjecutado ProyectoId="ProyectoId" />
    }
    else if (_tabActivo == "compromisos")
    {
        <CostosCompromisos ProyectoId="ProyectoId" />
    }
    else if (_tabActivo == "dashboard")
    {
        <CostosDashboard ProyectoId="ProyectoId" />
    }
    else if (_tabActivo == "comparativo")
    {
        <CostosComparativo ProyectoId="ProyectoId" />
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private string? _nombreProyecto;
    private string _tabActivo = "presupuesto";

    private record TabInfo(string Key, string Label, string Icono);

    private static readonly TabInfo[] _tabs =
    [
        new("presupuesto",  "Presupuesto",      "bi-table"),
        new("ejecutado",    "Real / Ejecutado",  "bi-receipt"),
        new("compromisos",  "Compromisos",       "bi-file-earmark-text"),
        new("dashboard",    "Dashboard",         "bi-bar-chart-line"),
        new("comparativo",  "Comparativo",       "bi-arrows-angle-expand"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var proy = await Db.Proyectos.FindAsync(ProyectoId);
        _nombreProyecto = proy?.Nombre ?? "Proyecto";
    }
}
