@page "/proyectos/{ProyectoId:int}/wbs"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject IHttpClientFactory HttpFactory
@inject IConfiguration Config

<PageTitle>WBS — RenergeIA</PageTitle>

@if (_proyecto is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-1">
        <a href="/proyectos/@ProyectoId" class="btn btn-sm btn-outline-secondary">&larr; Volver</a>
        <h1 class="h3 mb-0">WBS / Actividades — @_proyecto.Nombre</h1>
    </div>
    <p class="text-muted small mb-3">Estructura de desglose de trabajo del proyecto.</p>

    @if (_actividades.Count == 0 && !_versiones.Any())
    {
        <div class="card shadow-sm p-4 text-center" style="max-width:800px;margin:3rem auto">
            <h5 class="mb-1">No hay actividades aún</h5>
            <p class="text-muted small mb-4">Puedes cargar la plantilla estándar tipo EPC fotovoltaico, importar un cronograma existente o crear actividades manualmente.</p>
            <div class="d-flex gap-2 justify-content-center align-items-center">
                <button class="btn btn-success btn-sm" @onclick="CargarPlantillaAsync" disabled="@_cargando">
                    @if (_cargando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Cargar plantilla EPC
                </button>
                <label class="btn btn-outline-success btn-sm mb-0" style="cursor:pointer">
                    <i class="bi bi-file-earmark-excel me-1"></i>Cronograma Excel
                    <InputFile OnChange="OnExcelSeleccionado" accept=".xlsx,.xls" style="display:none" />
                </label>
                <label class="btn btn-outline-secondary btn-sm mb-0" style="cursor:pointer">
                    <i class="bi bi-file-earmark-pdf me-1"></i>Cronograma PDF
                    <InputFile OnChange="OnPdfSeleccionado" accept=".pdf" style="display:none" />
                </label>
                <a href="/proyectos/@ProyectoId/wbs/nueva" class="btn btn-outline-primary btn-sm">+ Nueva actividad</a>
            </div>
        </div>
    }
    else
    {
        <!-- Selector de versión de cronograma -->
        @if (_versiones.Any())
        {
            <div class="d-flex align-items-center gap-2 mb-3 px-3 py-2 rounded"
                 style="background:#f8f9fa;border:1px solid #dee2e6">
                <span class="text-muted small fw-semibold" style="white-space:nowrap">Cronograma:</span>
                <select class="form-select form-select-sm" style="max-width:300px"
                        value="@_versionSeleccionadaId"
                        @onchange="OnVersionChange">
                    @foreach (var v in _versiones.OrderByDescending(x => x.NumeroVersion))
                    {
                        <option value="@v.Id">@v.Nombre @(v.EsVigente ? "★" : "")</option>
                    }
                </select>
                @if (_esVersionVigente)
                {
                    <span class="badge" style="background:#6ABF4B;color:white;font-size:0.72rem;white-space:nowrap">● Vigente</span>
                }
                else
                {
                    <span class="badge bg-secondary" style="font-size:0.72rem;white-space:nowrap">○ Histórica</span>
                }
                @if (!string.IsNullOrEmpty(_versionSeleccionada?.MotivoReprogramacion))
                {
                    <span class="text-muted small" style="font-style:italic;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:300px"
                          title="@_versionSeleccionada.MotivoReprogramacion">
                        — @_versionSeleccionada.MotivoReprogramacion
                    </span>
                }
            </div>
        }

        @if (!_esVersionVigente)
        {
            <div class="alert alert-secondary d-flex align-items-center gap-2 py-2 mb-3" style="font-size:0.87rem">
                <span>🔒</span>
                <span>Esta es una versión histórica del cronograma. <strong>Solo consulta</strong> — no se pueden modificar fechas ni avances.</span>
            </div>
        }

        <!-- Tarjetas de resumen -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card text-center shadow-sm">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold" style="color:#183963">@_actividades.Count(a => a.Activo)</div>
                        <div class="small text-muted">Activas</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center shadow-sm">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold" style="color:#6ABF4B">@_actividades.Count(a => a.Activo && EstadoOperativo(a) == "Finalizada")</div>
                        <div class="small text-muted">Completadas</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center shadow-sm">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold" style="color:#183963">@_actividades.Count(a => a.Activo && EstadoOperativo(a) == "EnProgreso")</div>
                        <div class="small text-muted">En progreso</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card text-center shadow-sm">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold" style="color:#dc3545">@_actividades.Count(a => a.Activo && (EstadoOperativo(a) == "Atrasada" || EstadoOperativo(a) == "Critica"))</div>
                        <div class="small text-muted">Con problemas</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Barra de herramientas -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">

            <!-- Tabs ACTIVAS / INACTIVAS -->
            <div style="display:flex;background:#f0f0f0;border-radius:8px;padding:3px;gap:3px">
                <button @onclick="() => _vistaActivas = true"
                        style="border:none;border-radius:6px;padding:5px 18px;font-size:0.8rem;font-weight:700;cursor:pointer;transition:all 0.15s;
                               background:@(_vistaActivas ? "#6ABF4B" : "transparent");
                               color:@(_vistaActivas ? "white" : "#6c757d")">
                    ● Activas (@_actividades.Count(x => x.Activo))
                </button>
                <button @onclick="() => _vistaActivas = false"
                        style="border:none;border-radius:6px;padding:5px 18px;font-size:0.8rem;font-weight:700;cursor:pointer;transition:all 0.15s;
                               background:@(!_vistaActivas ? "#dc3545" : "transparent");
                               color:@(!_vistaActivas ? "white" : "#6c757d")">
                    ○ Inactivas (@_actividades.Count(x => !x.Activo))
                </button>
            </div>

            <!-- Botones de acción (solo versión vigente) -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (_esVersionVigente)
                {
                    @if (_cambiosGuardados)
                    {
                        <span style="color:#6ABF4B;font-size:0.8rem;font-weight:600">✓ Cambios guardados</span>
                    }
                    <button class="btn btn-sm" disabled="@_guardandoCambios"
                            style="background:#6ABF4B;color:white;border:none"
                            @onclick="GuardarTodosAsync">
                        @if (_guardandoCambios) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Guardar cambios
                    </button>
                    <button class="btn btn-sm btn-outline-warning"
                            @onclick="() => { _mostrarModalReprogramacion = true; _motivoReprogramacion = string.Empty; _errorReprogramacion = null; }">
                        + Crear reprogramación
                    </button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmarReinicio = true">
                        <i class="bi-arrow-counterclockwise me-1"></i>Reiniciar plantilla
                    </button>
                    <a href="/proyectos/@ProyectoId/wbs/nueva" class="btn btn-sm"
                       style="background:#183963;color:white;border:none">+ Nueva actividad</a>
                }
            </div>
        </div>

        <!-- Tabla WBS -->
        <div class="table-responsive">
            <table id="wbs-table" class="table table-sm table-hover align-middle mb-0"
                   style="font-size:0.81rem;table-layout:fixed">
                <thead>
                    <tr style="background:#183963;color:white;font-size:0.77rem;letter-spacing:0.02em">
                        <th style="width:380px;text-align:left;padding:9px 12px;overflow:hidden;white-space:nowrap">Actividad</th>
                        <th style="width:80px;text-align:center;padding:9px 6px;overflow:hidden">Av. Planificado</th>
                        <th style="width:100px;text-align:center;padding:9px 6px;overflow:hidden">Av. Real</th>
                        <th style="width:82px;text-align:center;padding:9px 4px;overflow:hidden">Desviación</th>
                        <th style="width:118px;text-align:center;padding:9px 4px;overflow:hidden">Inicio Plan.</th>
                        <th style="width:118px;text-align:center;padding:9px 4px;overflow:hidden">Fin Plan.</th>
                        <th style="width:130px;text-align:center;padding:9px 4px;overflow:hidden">Disciplina</th>
                        <th style="width:108px;text-align:center;padding:9px 4px;overflow:hidden">Estado</th>
                        <th style="width:130px;text-align:center;padding:9px 4px;overflow:hidden">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in ActividadesMostradas)
                    {
                        <tr style="border-bottom:1px solid #f0f0f0">

                            <!-- Actividad (sangría según nivel) -->
                            <td style="padding-left:@((a.NivelWBS - 1) * 20 + 10)px;padding-top:6px;padding-bottom:6px">
                                @if (a.NivelWBS == 1)
                                {
                                    <strong style="color:#183963">@a.CodigoWBS — @a.Nombre</strong>
                                }
                                else if (a.NivelWBS == 2)
                                {
                                    <span class="fw-semibold">@a.CodigoWBS — @a.Nombre</span>
                                }
                                else
                                {
                                    <span style="color:#444">@a.CodigoWBS — @a.Nombre</span>
                                }
                            </td>

                            <!-- Avance Planificado -->
                            <td style="text-align:center;padding:4px 6px">
                                <span style="color:#000;font-size:0.81rem;font-weight:700">@AvancePlan(a).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%</span>
                            </td>

                            <!-- Avance Real -->
                            <td style="text-align:center;padding:4px 6px">
                                @if (_esVersionVigente && EsHoja(a))
                                {
                                    <input type="number" min="0" max="100" step="0.1"
                                           class="form-control form-control-sm text-center"
                                           style="font-size:0.78rem;padding:2px 4px;border-color:#dee2e6;width:76px;margin:0 auto;color:#183963;font-weight:700"
                                           value="@a.AvanceReal.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                           @onchange="e => GuardarAvanceRealAsync(a, e)" />
                                }
                                else
                                {
                                    <span style="color:#183963;font-size:0.78rem;font-weight:700"
                                          title="@(!EsHoja(a) ? "Promedio automático de subactividades" : "")">
                                        @a.AvanceReal.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%
                                        @if (!EsHoja(a)) { <i class="bi bi-arrow-up-short" style="color:#6c757d;font-size:0.65rem" title="Promedio de hijos"></i> }
                                    </span>
                                }
                            </td>

                            <!-- Desviación -->
                            <td style="text-align:center">
                                <span style="font-weight:700;font-size:0.79rem;color:@DesvColor(a)">@DesvTexto(a)</span>
                            </td>

                            <!-- Inicio Plan. -->
                            <td style="text-align:center;padding:3px 4px">
                                <input type="date"
                                       class="form-control form-control-sm text-center"
                                       style="font-size:0.73rem;padding:2px 3px;border-color:#dee2e6;min-width:102px"
                                       value="@FechaVal(a.FechaInicioPlaneada)"
                                       disabled="@(!_esVersionVigente)"
                                       @onchange="e => GuardarFechaInicioAsync(a, e)" />
                            </td>

                            <!-- Fin Plan. -->
                            <td style="text-align:center;padding:3px 4px">
                                <input type="date"
                                       class="form-control form-control-sm text-center"
                                       style="font-size:0.73rem;padding:2px 3px;border-color:#dee2e6;min-width:102px"
                                       value="@FechaVal(a.FechaFinPlaneada)"
                                       disabled="@(!_esVersionVigente)"
                                       @onchange="e => GuardarFechaFinAsync(a, e)" />
                            </td>

                            <!-- Disciplina -->
                            <td style="text-align:center;padding:3px 4px">
                                @if (_esVersionVigente)
                                {
                                    <select class="form-select form-select-sm"
                                            style="font-size:0.68rem;padding:1px 3px;border-color:#dee2e6;min-width:100px"
                                            value="@(a.Disciplina?.ToString() ?? "")"
                                            @onchange="e => GuardarDisciplinaAsync(a, e)">
                                        <option value="">—</option>
                                        @foreach (var d in Enum.GetValues<Disciplina>())
                                        {
                                            <option value="@d">@EnumDisplay.Mostrar(d)</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <span style="font-size:0.7rem">@(a.Disciplina.HasValue ? EnumDisplay.Mostrar(a.Disciplina.Value) : "—")</span>
                                }
                            </td>

                            <!-- Estado -->
                            <td style="text-align:center">
                                <span class="badge"
                                      style="background:@BadgeFondo(a);color:@BadgeLetra(a);font-size:0.66rem;border-radius:10px;padding:3px 7px;white-space:nowrap">
                                    @BadgeTexto(a)
                                </span>
                            </td>

                            <!-- Acciones -->
                            <td style="text-align:center">
                                <div class="d-flex gap-1 justify-content-center align-items-center">
                                    @if (_esVersionVigente)
                                    {
                                        <div class="d-flex flex-column" style="gap:1px">
                                            <button class="btn btn-sm"
                                                    title="Subir"
                                                    disabled="@(!PuedeMoverArriba(a) || _reordenando)"
                                                    style="font-size:0.6rem;padding:0 4px;line-height:1.1;color:#183963;border:1px solid #dee2e6"
                                                    @onclick="() => MoverArribaAsync(a)">
                                                ▲
                                            </button>
                                            <button class="btn btn-sm"
                                                    title="Bajar"
                                                    disabled="@(!PuedeMoverAbajo(a) || _reordenando)"
                                                    style="font-size:0.6rem;padding:0 4px;line-height:1.1;color:#183963;border:1px solid #dee2e6"
                                                    @onclick="() => MoverAbajoAsync(a)">
                                                ▼
                                            </button>
                                        </div>
                                        <a href="/proyectos/@ProyectoId/wbs/@a.Id/editar"
                                           class="btn btn-sm btn-outline-primary"
                                           style="font-size:0.68rem;padding:2px 8px">Editar</a>
                                        <button class="btn btn-sm"
                                                title="@(a.Activo ? "Desactivar" : "Activar")"
                                                style="font-size:0.68rem;padding:2px 6px;@(a.Activo ? "color:#6c757d;border:1px solid #dee2e6" : "color:#6ABF4B;border:1px solid #6ABF4B")"
                                                @onclick="() => ToggleActivoAsync(a)">
                                            @(a.Activo ? "⏸" : "▶")
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<!-- Modal: Crear reprogramación -->
@if (_mostrarModalReprogramacion)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered" style="max-width:500px">
            <div class="modal-content shadow-lg">
                <div class="modal-header" style="background:#183963;color:white">
                    <h5 class="modal-title" style="font-size:1rem">+ Crear Reprogramación del Cronograma</h5>
                    <button type="button" class="btn-close btn-close-white"
                            @onclick="() => _mostrarModalReprogramacion = false"
                            disabled="@_creandoReprogramacion"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning py-2 small mb-3">
                        <strong>¿Deseas continuar?</strong> Se creará una nueva versión del cronograma copiando
                        <em>@_versionVigente?.Nombre</em>. La versión actual quedará como <strong>Histórica</strong>.
                    </div>
                    <label class="form-label fw-semibold">
                        Motivo de reprogramación <span class="text-danger">*</span>
                    </label>
                    <textarea class="form-control" rows="3"
                              placeholder="Ej: Ajuste de alcance por condiciones climáticas adversas..."
                              @bind="_motivoReprogramacion"
                              disabled="@_creandoReprogramacion"></textarea>
                    @if (_errorReprogramacion is not null)
                    {
                        <div class="text-danger small mt-2">@_errorReprogramacion</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="() => _mostrarModalReprogramacion = false"
                            disabled="@_creandoReprogramacion">
                        Cancelar
                    </button>
                    <button class="btn btn-warning btn-sm" disabled="@_creandoReprogramacion"
                            @onclick="CrearReprogramacionAsync">
                        @if (_creandoReprogramacion)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Creando...</span>
                        }
                        else
                        {
                            <span>Crear reprogramación</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Confirmar reinicio de plantilla -->
@if (_confirmarReinicio)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered" style="max-width:480px">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" style="font-size:1rem"><i class="bi-exclamation-triangle me-2"></i>Reiniciar Plantilla</h5>
                    <button type="button" class="btn-close btn-close-white"
                            @onclick="() => _confirmarReinicio = false"
                            disabled="@_ejecutandoReinicio"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger py-2 small mb-3">
                        <strong>Esta acción eliminará TODAS las actividades</strong> de la versión actual del cronograma
                        y volverá a la pantalla inicial donde podrás cargar la plantilla EPC nuevamente o crear actividades desde cero.
                    </div>
                    <p class="small text-muted mb-0">
                        Se eliminarán <strong>@_actividades.Count actividades</strong> de
                        <em>@_versionSeleccionada?.Nombre</em>. Esta acción no se puede deshacer.
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="() => _confirmarReinicio = false"
                            disabled="@_ejecutandoReinicio">
                        Cancelar
                    </button>
                    <button class="btn btn-danger btn-sm" disabled="@_ejecutandoReinicio"
                            @onclick="ReiniciarPlantillaAsync">
                        @if (_ejecutandoReinicio)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Eliminando...</span>
                        }
                        else
                        {
                            <span><i class="bi-trash me-1"></i>Sí, reiniciar todo</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Procesando PDF -->
@if (_procesandoPdf)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered" style="max-width:400px">
            <div class="modal-content shadow-lg text-center p-4">
                <div class="spinner-border text-primary mb-3" style="width:3rem;height:3rem;margin:0 auto"></div>
                <h5 class="mb-1">Analizando cronograma...</h5>
                <p class="text-muted small mb-0">
                    @if (_fuenteImport == "PDF")
                    {
                        <span>Extrayendo actividades del PDF con IA. Esto puede tardar unos segundos.</span>
                    }
                    else
                    {
                        <span>Leyendo actividades del Excel...</span>
                    }
                </p>
            </div>
        </div>
    </div>
}

<!-- Modal: Vista previa actividades del PDF -->
@if (_mostrarModalPdf)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content shadow-lg">
                <div class="modal-header" style="background:#183963;color:white">
                    <h5 class="modal-title" style="font-size:1rem">
                        <i class="bi @(_fuenteImport == "PDF" ? "bi-file-earmark-pdf" : "bi-file-earmark-excel") me-2"></i>
                        Actividades detectadas en el @_fuenteImport
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                            @onclick="() => _mostrarModalPdf = false"
                            disabled="@_guardandoPdf"></button>
                </div>
                <div class="modal-body" style="max-height:60vh;overflow-y:auto">
                    @if (_errorPdf is not null)
                    {
                        <div class="alert alert-danger py-2 small">@_errorPdf</div>
                    }
                    else if (!_actividadesPdf.Any())
                    {
                        <div class="alert alert-warning py-2 small">No se detectaron actividades en el PDF.</div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2 small mb-3">
                            Se detectaron <strong>@_actividadesPdf.Count actividades</strong>. Revisa que la estructura sea correcta antes de importar.
                        </div>
                        <table class="table table-sm table-bordered" style="font-size:0.8rem">
                            <thead style="background:#f8f9fa">
                                <tr>
                                    <th style="width:80px">Código</th>
                                    <th>Actividad</th>
                                    <th style="width:60px;text-align:center">Nivel</th>
                                    <th style="width:80px;text-align:center">Duración (días)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in _actividadesPdf)
                                {
                                    <tr>
                                        <td><code>@a.Codigo</code></td>
                                        <td style="padding-left:@((a.Nivel - 1) * 16 + 6)px">@a.Nombre</td>
                                        <td style="text-align:center">@a.Nivel</td>
                                        <td style="text-align:center">@a.Duracion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="() => _mostrarModalPdf = false"
                            disabled="@_guardandoPdf">
                        Cancelar
                    </button>
                    @if (_actividadesPdf.Any() && _errorPdf is null)
                    {
                        <button class="btn btn-sm" style="background:#6ABF4B;color:white;border:none"
                                disabled="@_guardandoPdf"
                                @onclick="ImportarActividadesPdfAsync">
                            @if (_guardandoPdf)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Importando...</span>
                            }
                            else
                            {
                                <span>Importar @_actividadesPdf.Count actividades</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<ActividadWBS> _actividades = [];
    private List<CronogramaVersion> _versiones = [];
    private CronogramaVersion? _versionSeleccionada;
    private CronogramaVersion? _versionVigente;
    private int _versionSeleccionadaId;
    private bool _esVersionVigente => _versionSeleccionada?.EsVigente == true;

    private bool _vistaActivas = true;
    private bool _cargando;
    private bool _guardandoCambios;
    private bool _cambiosGuardados;
    private bool _mostrarModalReprogramacion;
    private string _motivoReprogramacion = string.Empty;
    private bool _creandoReprogramacion;
    private string? _errorReprogramacion;
    private bool _confirmarReinicio;
    private bool _ejecutandoReinicio;

    // PDF/Excel import
    private bool _procesandoPdf;
    private bool _mostrarModalPdf;
    private bool _guardandoPdf;
    private string? _errorPdf;
    private List<ActividadPdfPreview> _actividadesPdf = [];
    private string _fuenteImport = "PDF"; // "PDF" o "Excel"

    private record ActividadPdfPreview(string Codigo, string Nombre, int Nivel, string? CodigoPadre, int Duracion);

    // IDs de actividades que tienen al menos un hijo (nodos padre)
    private HashSet<int> _conHijos = [];

    private static readonly DateTime _sinFecha = DateTime.MinValue;

    private IEnumerable<ActividadWBS> ActividadesMostradas =>
        _actividades
            .Where(a => _vistaActivas ? a.Activo : !a.Activo)
            .OrderBy(a => WbsSortKey(a.CodigoWBS));

    // ── Ciclo de vida ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await InicializarVersionesAsync();
        await CargarActividadesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_actividades.Count > 0)
            await JS.InvokeVoidAsync("wbsResize.init", "wbs-table");
    }

    // ── Versiones ─────────────────────────────────────────────────────────────

    private async Task InicializarVersionesAsync()
    {
        _versiones = await Db.CronogramasVersion
            .Where(v => v.ProyectoId == ProyectoId)
            .OrderBy(v => v.NumeroVersion)
            .ToListAsync();

        // Auto-crear "Actividades Inicial" para proyectos existentes sin versión
        if (!_versiones.Any())
        {
            var hayActividades = await Db.ActividadesWBS.AnyAsync(a => a.ProyectoId == ProyectoId);
            if (hayActividades)
            {
                var inicial = new CronogramaVersion
                {
                    ProyectoId    = ProyectoId,
                    Nombre        = "Actividades Inicial",
                    NumeroVersion = 0,
                    EsVigente     = true,
                    CreadoPor     = "Sistema"
                };
                Db.CronogramasVersion.Add(inicial);
                await Db.SaveChangesAsync();

                await Db.ActividadesWBS
                    .Where(a => a.ProyectoId == ProyectoId && a.CronogramaVersionId == null)
                    .ExecuteUpdateAsync(s => s.SetProperty(a => a.CronogramaVersionId, inicial.Id));

                _versiones = [inicial];
            }
        }

        _versionVigente      = _versiones.FirstOrDefault(v => v.EsVigente);
        _versionSeleccionada = _versionVigente ?? _versiones.LastOrDefault();
        _versionSeleccionadaId = _versionSeleccionada?.Id ?? 0;
    }

    private async Task OnVersionChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id)) return;
        _versionSeleccionadaId = id;
        _versionSeleccionada   = _versiones.FirstOrDefault(v => v.Id == id);
        await CargarActividadesAsync();
    }

    // ── Actividades ───────────────────────────────────────────────────────────

    private async Task CargarActividadesAsync()
    {
        if (_versionSeleccionada is null && !_versiones.Any())
        {
            _actividades = [];
            return;
        }

        var query = Db.ActividadesWBS.Where(a => a.ProyectoId == ProyectoId);
        if (_versionSeleccionada is not null)
            query = query.Where(a => a.CronogramaVersionId == _versionSeleccionada.Id);
        else
            query = query.Where(a => a.CronogramaVersionId == null);

        _actividades = await query.ToListAsync();
        ReconstruirMapaHijos();
        if (_esVersionVigente)
            await RecalcularYGuardarPadresAsync();
    }

    // ── Árbol de padres/hijos ─────────────────────────────────────────────────

    private void ReconstruirMapaHijos()
    {
        _conHijos = _actividades
            .Where(a => a.ActividadPadreId.HasValue)
            .Select(a => a.ActividadPadreId!.Value)
            .ToHashSet();
    }

    private bool EsHoja(ActividadWBS a) => !_conHijos.Contains(a.Id);

    // Recalcula AvanceReal de todos los nodos padre bottom-up y guarda si hubo cambios
    private async Task RecalcularYGuardarPadresAsync()
    {
        var padres = _actividades
            .Where(a => _conHijos.Contains(a.Id))
            .OrderByDescending(a => a.NivelWBS)
            .ToList();

        bool huboCambios = false;
        foreach (var padre in padres)
        {
            var hijos = _actividades.Where(h => h.ActividadPadreId == padre.Id && h.Activo).ToList();
            if (!hijos.Any()) continue;
            var nuevoAvance = Math.Round(hijos.Average(h => h.AvanceReal), 1);
            if (padre.AvanceReal != nuevoAvance)
            {
                padre.AvanceReal = nuevoAvance;
                padre.FechaModificacion = DateTime.UtcNow;
                huboCambios = true;
            }
        }
        if (huboCambios)
            await Db.SaveChangesAsync();
    }

    // Propaga el cambio de avance hacia arriba en el árbol (bottom-up recursivo)
    private async Task RecalcularPadresAsync(ActividadWBS hijo)
    {
        if (hijo.ActividadPadreId is null) return;
        var padre = _actividades.FirstOrDefault(p => p.Id == hijo.ActividadPadreId.Value);
        if (padre is null) return;

        var hijosActivos = _actividades.Where(h => h.ActividadPadreId == padre.Id && h.Activo).ToList();
        if (!hijosActivos.Any()) return;

        padre.AvanceReal = Math.Round(hijosActivos.Average(h => h.AvanceReal), 1);
        padre.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await RecalcularPadresAsync(padre);
    }

    // ── Guardar todos los cambios ─────────────────────────────────────────────

    private async Task GuardarTodosAsync()
    {
        _guardandoCambios = true;
        _cambiosGuardados = false;
        await Db.SaveChangesAsync();
        _guardandoCambios = false;
        _cambiosGuardados = true;
        StateHasChanged();
        await Task.Delay(3000);
        _cambiosGuardados = false;
    }

    // ── Avance Real ───────────────────────────────────────────────────────────

    private async Task GuardarAvanceRealAsync(ActividadWBS a, ChangeEventArgs e)
    {
        if (!_esVersionVigente || !EsHoja(a)) return;
        if (!decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var valor)) return;
        valor = Math.Clamp(Math.Round(valor, 1), 0m, 100m);
        a.AvanceReal = valor;
        a.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await RecalcularPadresAsync(a);
    }

    // ── Disciplina ───────────────────────────────────────────────────────────

    private async Task GuardarDisciplinaAsync(ActividadWBS a, ChangeEventArgs e)
    {
        if (!_esVersionVigente) return;
        var val = e.Value?.ToString();
        a.Disciplina = string.IsNullOrEmpty(val) ? null : Enum.Parse<Disciplina>(val);
        a.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    // ── Fechas ────────────────────────────────────────────────────────────────

    private async Task GuardarFechaInicioAsync(ActividadWBS a, ChangeEventArgs e)
    {
        if (!_esVersionVigente) return;
        if (!DateTime.TryParse(e.Value?.ToString(), out var nueva)) return;
        if (a.FechaFinPlaneada != _sinFecha && nueva > a.FechaFinPlaneada) return;
        a.FechaInicioPlaneada  = nueva;
        a.FechaModificacion    = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    private async Task GuardarFechaFinAsync(ActividadWBS a, ChangeEventArgs e)
    {
        if (!_esVersionVigente) return;
        if (!DateTime.TryParse(e.Value?.ToString(), out var nueva)) return;
        if (a.FechaInicioPlaneada != _sinFecha && nueva < a.FechaInicioPlaneada) return;
        a.FechaFinPlaneada  = nueva;
        a.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    // ── Toggle activo ─────────────────────────────────────────────────────────

    private async Task ToggleActivoAsync(ActividadWBS actividad)
    {
        if (!_esVersionVigente) return;
        actividad.Activo = !actividad.Activo;
        actividad.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
    }

    // ── Reordenar actividades ────────────────────────────────────────────────

    private bool _reordenando;

    private List<ActividadWBS> ObtenerHermanos(ActividadWBS a) =>
        _actividades
            .Where(x => x.ActividadPadreId == a.ActividadPadreId && x.Activo)
            .OrderBy(x => WbsSortKey(x.CodigoWBS))
            .ToList();

    private bool PuedeMoverArriba(ActividadWBS a)
    {
        var hermanos = ObtenerHermanos(a);
        return hermanos.Count > 1 && hermanos[0].Id != a.Id;
    }

    private bool PuedeMoverAbajo(ActividadWBS a)
    {
        var hermanos = ObtenerHermanos(a);
        return hermanos.Count > 1 && hermanos[^1].Id != a.Id;
    }

    private async Task MoverArribaAsync(ActividadWBS a)
    {
        var hermanos = ObtenerHermanos(a);
        var idx = hermanos.FindIndex(x => x.Id == a.Id);
        if (idx <= 0) return;
        await IntercambiarYRenumerarAsync(hermanos, idx, idx - 1);
    }

    private async Task MoverAbajoAsync(ActividadWBS a)
    {
        var hermanos = ObtenerHermanos(a);
        var idx = hermanos.FindIndex(x => x.Id == a.Id);
        if (idx < 0 || idx >= hermanos.Count - 1) return;
        await IntercambiarYRenumerarAsync(hermanos, idx, idx + 1);
    }

    private async Task IntercambiarYRenumerarAsync(List<ActividadWBS> hermanos, int idxA, int idxB)
    {
        _reordenando = true;
        StateHasChanged();

        // Swap positions in list
        (hermanos[idxA], hermanos[idxB]) = (hermanos[idxB], hermanos[idxA]);

        // Determine prefix (parent code)
        var prefijo = "";
        var primerCodigo = hermanos[0].CodigoWBS;
        var partes = primerCodigo.Split('.');
        if (partes.Length > 1)
            prefijo = string.Join(".", partes[..^1]) + ".";

        // Renumber all siblings sequentially
        for (int i = 0; i < hermanos.Count; i++)
        {
            var nuevoCodigo = prefijo + (i + 1);
            var codigoAnterior = hermanos[i].CodigoWBS;
            if (codigoAnterior != nuevoCodigo)
            {
                RenumerarRecursivo(hermanos[i], codigoAnterior, nuevoCodigo);
            }
        }

        await Db.SaveChangesAsync();
        _reordenando = false;
    }

    private void RenumerarRecursivo(ActividadWBS actividad, string codigoAnterior, string nuevoCodigo)
    {
        actividad.CodigoWBS = nuevoCodigo;
        actividad.FechaModificacion = DateTime.UtcNow;

        // Update NivelWBS based on new code
        actividad.NivelWBS = nuevoCodigo.Split('.').Length;

        // Update all descendants
        var hijos = _actividades
            .Where(h => h.ActividadPadreId == actividad.Id)
            .OrderBy(h => WbsSortKey(h.CodigoWBS))
            .ToList();

        for (int i = 0; i < hijos.Count; i++)
        {
            var codigoHijoAnterior = hijos[i].CodigoWBS;
            var nuevoCodigoHijo = nuevoCodigo + "." + (i + 1);
            if (codigoHijoAnterior != nuevoCodigoHijo)
                RenumerarRecursivo(hijos[i], codigoHijoAnterior, nuevoCodigoHijo);
        }
    }

    // ── Crear reprogramación ──────────────────────────────────────────────────

    private async Task CrearReprogramacionAsync()
    {
        _errorReprogramacion = null;
        if (string.IsNullOrWhiteSpace(_motivoReprogramacion))
        {
            _errorReprogramacion = "El motivo de reprogramación es obligatorio.";
            return;
        }
        if (_versionVigente is null)
        {
            _errorReprogramacion = "No existe versión vigente del cronograma.";
            return;
        }

        _creandoReprogramacion = true;
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var usuario   = authState.User.Identity?.Name ?? "Sistema";

            var sigNumero = _versiones.Max(v => v.NumeroVersion) + 1;
            var nombre    = sigNumero == 1
                ? "Actividades Reprogramación 1"
                : $"Actividades Reprogramación {sigNumero}";

            // 1. Crear nueva versión y marcar la anterior como histórica
            _versionVigente.EsVigente = false;

            var nuevaVersion = new CronogramaVersion
            {
                ProyectoId           = ProyectoId,
                Nombre               = nombre,
                NumeroVersion        = sigNumero,
                EsVigente            = true,
                MotivoReprogramacion = _motivoReprogramacion.Trim(),
                CreadoPor            = usuario
            };
            Db.CronogramasVersion.Add(nuevaVersion);
            await Db.SaveChangesAsync();

            // 2. Duplicar actividades (1ª pasada: sin padre, para obtener IDs)
            var actividadesOrigen = await Db.ActividadesWBS
                .Where(a => a.ProyectoId == ProyectoId && a.CronogramaVersionId == _versionVigente.Id)
                .ToListAsync();

            var mapOldNew = new Dictionary<int, ActividadWBS>();

            foreach (var act in actividadesOrigen)
            {
                var copia = new ActividadWBS
                {
                    ProyectoId                 = ProyectoId,
                    CronogramaVersionId        = nuevaVersion.Id,
                    CodigoWBS                  = act.CodigoWBS,
                    Nombre                     = act.Nombre,
                    NivelWBS                   = act.NivelWBS,
                    Disciplina                 = act.Disciplina,
                    FechaInicioPlaneada        = act.FechaInicioPlaneada,
                    FechaFinPlaneada           = act.FechaFinPlaneada,
                    AvancePlanificado          = act.AvancePlanificado,
                    AvanceReal                 = act.AvanceReal,
                    Estado                     = act.Estado,
                    Activo                     = act.Activo,
                    Responsable                = act.Responsable,
                    CantidadTotal              = act.CantidadTotal,
                    Unidad                     = act.Unidad,
                    CantidadEjecutadaAcumulada = act.CantidadEjecutadaAcumulada,
                    EsCritica                  = act.EsCritica,
                    FrenteTrabajo              = act.FrenteTrabajo,
                    ActividadPadreId           = null // se mapea en 2ª pasada
                };
                Db.ActividadesWBS.Add(copia);
                mapOldNew[act.Id] = copia;
            }
            await Db.SaveChangesAsync(); // obtiene IDs nuevos

            // 3. 2ª pasada: mapear padres usando los nuevos IDs
            foreach (var act in actividadesOrigen.Where(a => a.ActividadPadreId.HasValue))
            {
                if (mapOldNew.TryGetValue(act.ActividadPadreId!.Value, out var nuevoPadre))
                    mapOldNew[act.Id].ActividadPadreId = nuevoPadre.Id;
            }
            await Db.SaveChangesAsync();

            // 4. Recargar UI
            _versiones           = await Db.CronogramasVersion
                .Where(v => v.ProyectoId == ProyectoId)
                .OrderBy(v => v.NumeroVersion)
                .ToListAsync();
            _versionVigente      = nuevaVersion;
            _versionSeleccionada = nuevaVersion;
            _versionSeleccionadaId = nuevaVersion.Id;
            await CargarActividadesAsync();

            _mostrarModalReprogramacion = false;
        }
        catch (Exception ex)
        {
            _errorReprogramacion = $"Error al crear reprogramación: {ex.InnerException?.Message ?? ex.Message}";
        }
        finally
        {
            _creandoReprogramacion = false;
        }
    }

    // ── Plantilla EPC fotovoltaico ────────────────────────────────────────────

    private async Task CargarPlantillaAsync()
    {
        if (_proyecto is null) return;
        _cargando = true;
        StateHasChanged();

        // Crear versión inicial si no existe
        if (!_versiones.Any())
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var usuario   = authState.User.Identity?.Name ?? "Sistema";
            var inicial = new CronogramaVersion
            {
                ProyectoId    = ProyectoId,
                Nombre        = "Actividades Inicial",
                NumeroVersion = 0,
                EsVigente     = true,
                CreadoPor     = usuario
            };
            Db.CronogramasVersion.Add(inicial);
            await Db.SaveChangesAsync();
            _versiones           = [inicial];
            _versionVigente      = inicial;
            _versionSeleccionada = inicial;
            _versionSeleccionadaId = inicial.Id;
        }

        var inicio = _proyecto.FechaInicioPlaneada;
        var idMap  = new Dictionary<string, int>();

        for (int nivel = 1; nivel <= 4; nivel++)
        {
            var batch    = _plantilla.Where(p => p.Nivel == nivel).ToList();
            var entities = new List<(string Codigo, ActividadWBS Entity)>();

            foreach (var item in batch)
            {
                int? padreId = item.CodigoPadre is not null &&
                               idMap.TryGetValue(item.CodigoPadre, out var pid) ? pid : null;

                var act = new ActividadWBS
                {
                    ProyectoId          = ProyectoId,
                    CronogramaVersionId = _versionSeleccionada!.Id,
                    CodigoWBS           = item.Codigo,
                    Nombre              = item.Nombre,
                    NivelWBS            = item.Nivel,
                    ActividadPadreId    = padreId,
                    FechaInicioPlaneada = inicio.AddDays(item.DiasOffset),
                    FechaFinPlaneada    = inicio.AddDays(item.DiasOffset + Math.Max(item.Duracion, 1) - 1),
                    AvancePlanificado   = 0,
                    AvanceReal          = 0,
                    Estado              = EstadoActividad.Pendiente,
                    Activo              = true
                };
                Db.ActividadesWBS.Add(act);
                entities.Add((item.Codigo, act));
            }

            await Db.SaveChangesAsync();
            foreach (var (codigo, entity) in entities)
                idMap[codigo] = entity.Id;
        }

        await CargarActividadesAsync();
        _cargando = false;
    }

    private async Task ReiniciarPlantillaAsync()
    {
        _ejecutandoReinicio = true;
        StateHasChanged();

        try
        {
            if (_versionSeleccionada is not null)
            {
                var actividades = await Db.ActividadesWBS
                    .Where(a => a.ProyectoId == ProyectoId && a.CronogramaVersionId == _versionSeleccionada.Id)
                    .ToListAsync();
                Db.ActividadesWBS.RemoveRange(actividades);

                Db.CronogramasVersion.Remove(_versionSeleccionada);
                await Db.SaveChangesAsync();
            }

            _actividades.Clear();
            _versiones.Clear();
            _versionSeleccionada = null;
            _versionVigente = null;
            _confirmarReinicio = false;
        }
        finally
        {
            _ejecutandoReinicio = false;
        }
    }

    // ── Importar PDF con IA ─────────────────────────────────────────────────

    private async Task OnExcelSeleccionado(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _procesandoPdf = true;
        _fuenteImport = "Excel";
        _errorPdf = null;
        _actividadesPdf.Clear();
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            using var wb = new ClosedXML.Excel.XLWorkbook(ms);
            var ws = wb.Worksheets.First();
            var lastRow = ws.LastRowUsed()?.RowNumber() ?? 0;
            if (lastRow < 2)
            {
                _errorPdf = "El archivo Excel está vacío o no tiene datos.";
                _procesandoPdf = false;
                _mostrarModalPdf = true;
                return;
            }

            // Detect columns by header keywords
            int colCodigo = 0, colNombre = 0, colDuracion = 0, colNivel = 0;
            var headerRow = ws.Row(1);
            for (int c = 1; c <= ws.LastColumnUsed()?.ColumnNumber(); c++)
            {
                var val = LeerCeldaExcel(ws, 1, c).ToLower();
                if (val.Contains("codigo") || val.Contains("código") || val.Contains("wbs") || val.Contains("id")) colCodigo = c;
                else if (val.Contains("actividad") || val.Contains("nombre") || val.Contains("tarea") || val.Contains("descripci")) colNombre = c;
                else if (val.Contains("duración") || val.Contains("duracion") || val.Contains("días") || val.Contains("dias") || val.Contains("duration")) colDuracion = c;
                else if (val.Contains("nivel") || val.Contains("level")) colNivel = c;
            }

            if (colNombre == 0)
            {
                _errorPdf = "No se encontró una columna de 'Actividad' o 'Nombre' en la primera fila del Excel.";
                _procesandoPdf = false;
                _mostrarModalPdf = true;
                return;
            }

            int contador = 1;
            for (int row = 2; row <= lastRow; row++)
            {
                var nombre = colNombre > 0 ? LeerCeldaExcel(ws, row, colNombre) : "";
                if (string.IsNullOrWhiteSpace(nombre)) continue;

                var codigo = colCodigo > 0 ? LeerCeldaExcel(ws, row, colCodigo) : "";
                if (string.IsNullOrWhiteSpace(codigo)) codigo = $"1.{contador}";

                int nivel = 1;
                if (colNivel > 0)
                {
                    int.TryParse(LeerCeldaExcel(ws, row, colNivel), out nivel);
                    if (nivel < 1) nivel = 1;
                }
                else
                {
                    nivel = codigo.Split('.').Length;
                }

                int duracion = 1;
                if (colDuracion > 0)
                {
                    var durText = LeerCeldaExcel(ws, row, colDuracion);
                    if (double.TryParse(durText, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d))
                        duracion = Math.Max(1, (int)Math.Ceiling(d));
                }

                string? codigoPadre = null;
                var partes = codigo.Split('.');
                if (partes.Length > 1)
                    codigoPadre = string.Join(".", partes[..^1]);

                _actividadesPdf.Add(new ActividadPdfPreview(codigo, nombre.Trim(), nivel, codigoPadre, duracion));
                contador++;
            }

            if (!_actividadesPdf.Any())
                _errorPdf = "No se encontraron actividades en el Excel.";
        }
        catch (Exception ex)
        {
            _errorPdf = $"Error al leer el Excel: {ex.Message}";
        }
        finally
        {
            _procesandoPdf = false;
            _mostrarModalPdf = true;
            StateHasChanged();
        }
    }

    private static string LeerCeldaExcel(ClosedXML.Excel.IXLWorksheet ws, int row, int col)
    {
        try
        {
            var cell = ws.Cell(row, col);
            if (cell.IsEmpty()) return "";
            if (cell.HasFormula) { try { return cell.CachedValue.ToString()?.Trim() ?? ""; } catch { return ""; } }
            if (cell.DataType == ClosedXML.Excel.XLDataType.Number) return cell.GetDouble().ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (cell.DataType == ClosedXML.Excel.XLDataType.DateTime) return cell.GetDateTime().ToString("yyyy-MM-dd");
            if (cell.DataType == ClosedXML.Excel.XLDataType.Boolean) return cell.GetBoolean() ? "1" : "0";
            try { return cell.GetString()?.Trim() ?? ""; }
            catch { try { return cell.CachedValue.ToString()?.Trim() ?? ""; } catch { return ""; } }
        }
        catch { return ""; }
    }

    private async Task OnPdfSeleccionado(InputFileChangeEventArgs e)
    {
        _fuenteImport = "PDF";
        var file = e.File;
        if (file is null || !file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)) return;

        _procesandoPdf = true;
        _errorPdf = null;
        _actividadesPdf.Clear();
        StateHasChanged();

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            var textoExtraido = ExtraerTextoPdf(ms);
            if (string.IsNullOrWhiteSpace(textoExtraido))
            {
                _errorPdf = "No se pudo extraer texto del PDF. Asegúrate de que no sea una imagen escaneada.";
                _procesandoPdf = false;
                _mostrarModalPdf = true;
                return;
            }

            var apiKey = Config["GEMINI_API_KEY"] ?? Environment.GetEnvironmentVariable("GEMINI_API_KEY") ?? "";
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                _errorPdf = "La clave de Gemini (GEMINI_API_KEY) no está configurada. Contacta al administrador.";
                _procesandoPdf = false;
                _mostrarModalPdf = true;
                return;
            }

            _actividadesPdf = await ExtraerActividadesConGeminiAsync(textoExtraido, apiKey);
            if (!_actividadesPdf.Any() && _errorPdf is null)
                _errorPdf = $"Gemini no pudo identificar actividades estructuradas en el PDF. Se extrajeron {textoExtraido.Length} caracteres de texto.";
        }
        catch (Exception ex)
        {
            _errorPdf = $"Error al procesar el PDF: {ex.Message}";
        }
        finally
        {
            _procesandoPdf = false;
            _mostrarModalPdf = true;
            StateHasChanged();
        }
    }

    private static string ExtraerTextoPdf(Stream stream)
    {
        var sb = new System.Text.StringBuilder();
        using var doc = UglyToad.PdfPig.PdfDocument.Open(stream);
        foreach (var page in doc.GetPages())
        {
            sb.AppendLine(page.Text);
        }
        return sb.ToString();
    }

    private async Task<List<ActividadPdfPreview>> ExtraerActividadesConGeminiAsync(string textoPdf, string apiKey)
    {
        var prompt = @"Eres un experto en gestión de proyectos de construcción y energía solar. Analiza el siguiente texto extraído de un PDF de cronograma/WBS de un proyecto y extrae TODAS las actividades que encuentres.

Devuelve SOLO un JSON array (sin texto adicional, sin markdown, sin ```json) con este formato exacto:
[
  {""codigo"": ""1.1"", ""nombre"": ""Nombre de la actividad"", ""nivel"": 1, ""codigoPadre"": null, ""duracion"": 30},
  {""codigo"": ""1.1.1"", ""nombre"": ""Sub-actividad"", ""nivel"": 2, ""codigoPadre"": ""1.1"", ""duracion"": 15}
]

Reglas:
- Si el PDF tiene códigos WBS (1.1, 1.2, 1.2.1, etc.), úsalos tal cual
- Si NO tiene códigos, asígnalos jerárquicamente (1.1, 1.2, 1.2.1, etc.)
- El nivel se determina por la profundidad del código (1.1 = nivel 1, 1.1.1 = nivel 2, etc.)
- codigoPadre es el código del padre inmediato (null para nivel 1)
- Si ves duraciones en días, úsalas. Si no, estima 1 día por defecto
- Extrae la mayor cantidad de actividades posible
- Mantén el orden original del documento

TEXTO DEL PDF:
" + textoPdf;

        if (prompt.Length > 30000)
            prompt = prompt[..30000];

        var url = $"https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key={apiKey}";
        var body = new
        {
            contents = new[] { new { parts = new[] { new { text = prompt } } } },
            generationConfig = new { maxOutputTokens = 8192, temperature = 0.1 }
        };

        using var http = HttpFactory.CreateClient();
        var response = await http.PostAsync(url,
            new StringContent(System.Text.Json.JsonSerializer.Serialize(body), System.Text.Encoding.UTF8, "application/json"));

        var json = await response.Content.ReadAsStringAsync();

        if (!response.IsSuccessStatusCode)
        {
            _errorPdf = $"Error de Gemini ({response.StatusCode}): {json[..Math.Min(json.Length, 300)]}";
            return [];
        }

        try
        {
            var geminiResult = System.Text.Json.JsonDocument.Parse(json);
            var text = geminiResult.RootElement
                .GetProperty("candidates")[0]
                .GetProperty("content")
                .GetProperty("parts")[0]
                .GetProperty("text")
                .GetString() ?? "";

            text = text.Trim();
            if (text.StartsWith("```")) text = text[(text.IndexOf('\n') + 1)..];
            if (text.EndsWith("```")) text = text[..text.LastIndexOf("```")];
            text = text.Trim();

            var items = System.Text.Json.JsonSerializer.Deserialize<List<ActividadPdfJson>>(text,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];

            return items.Select(i => new ActividadPdfPreview(
                i.Codigo?.Trim() ?? "1",
                i.Nombre?.Trim() ?? "Sin nombre",
                Math.Max(1, i.Nivel),
                string.IsNullOrWhiteSpace(i.CodigoPadre) ? null : i.CodigoPadre.Trim(),
                Math.Max(1, i.Duracion)
            )).ToList();
        }
        catch (Exception ex)
        {
            _errorPdf = $"Error al interpretar respuesta de Gemini: {ex.Message}. Respuesta: {json[..Math.Min(json.Length, 200)]}";
            return [];
        }
    }

    private class ActividadPdfJson
    {
        public string? Codigo { get; set; }
        public string? Nombre { get; set; }
        public int Nivel { get; set; }
        public string? CodigoPadre { get; set; }
        public int Duracion { get; set; }
    }

    private async Task ImportarActividadesPdfAsync()
    {
        if (_proyecto is null || !_actividadesPdf.Any()) return;
        _guardandoPdf = true;
        StateHasChanged();

        try
        {
            if (!_versiones.Any())
            {
                var authState = await AuthState.GetAuthenticationStateAsync();
                var usuario = authState.User.Identity?.Name ?? "Sistema";
                var inicial = new CronogramaVersion
                {
                    ProyectoId = ProyectoId,
                    Nombre = "Actividades Inicial",
                    NumeroVersion = 0,
                    EsVigente = true,
                    CreadoPor = usuario
                };
                Db.CronogramasVersion.Add(inicial);
                await Db.SaveChangesAsync();
                _versiones = [inicial];
                _versionVigente = inicial;
                _versionSeleccionada = inicial;
                _versionSeleccionadaId = inicial.Id;
            }

            var inicio = _proyecto.FechaInicioPlaneada;
            var idMap = new Dictionary<string, int>();
            var maxNivel = _actividadesPdf.Max(a => a.Nivel);

            for (int nivel = 1; nivel <= maxNivel; nivel++)
            {
                var batch = _actividadesPdf.Where(a => a.Nivel == nivel).ToList();
                var entities = new List<(string Codigo, ActividadWBS Entity)>();
                int diasAcumulado = 0;

                foreach (var item in batch)
                {
                    int? padreId = item.CodigoPadre is not null && idMap.TryGetValue(item.CodigoPadre, out var pid) ? pid : null;

                    var act = new ActividadWBS
                    {
                        ProyectoId = ProyectoId,
                        CronogramaVersionId = _versionSeleccionada!.Id,
                        CodigoWBS = item.Codigo,
                        Nombre = item.Nombre,
                        NivelWBS = item.Nivel,
                        ActividadPadreId = padreId,
                        FechaInicioPlaneada = inicio.AddDays(diasAcumulado),
                        FechaFinPlaneada = inicio.AddDays(diasAcumulado + Math.Max(item.Duracion, 1) - 1),
                        AvancePlanificado = 0,
                        AvanceReal = 0,
                        Estado = EstadoActividad.Pendiente,
                        Activo = true
                    };
                    Db.ActividadesWBS.Add(act);
                    entities.Add((item.Codigo, act));
                    if (nivel == 1) diasAcumulado += item.Duracion;
                }

                await Db.SaveChangesAsync();
                foreach (var (codigo, entity) in entities)
                    idMap[codigo] = entity.Id;
            }

            await CargarActividadesAsync();
            _mostrarModalPdf = false;
        }
        catch (Exception ex)
        {
            _errorPdf = $"Error al importar: {ex.Message}";
        }
        finally
        {
            _guardandoPdf = false;
        }
    }

    // ── Avance Planificado ────────────────────────────────────────────────────

    private static decimal AvancePlan(ActividadWBS a)
    {
        if (a.FechaInicioPlaneada == _sinFecha || a.FechaFinPlaneada == _sinFecha)
            return 0m;
        var hoy = DateTime.Today;
        var ini = a.FechaInicioPlaneada.Date;
        var fin = a.FechaFinPlaneada.Date;
        if (hoy < ini) return 0m;
        if (hoy >= fin) return 100m;
        var dur = (fin - ini).TotalDays;
        if (dur <= 0) return 100m;
        return Math.Min(100m, Math.Round((decimal)((hoy - ini).TotalDays / dur * 100), 1));
    }

    // ── Desviación ────────────────────────────────────────────────────────────

    private static decimal Desviacion(ActividadWBS a) => a.AvanceReal - AvancePlan(a);

    private static string DesvColor(ActividadWBS a) =>
        Desviacion(a) >= 0 ? "#6ABF4B" : "#dc3545";

    private static string DesvTexto(ActividadWBS a)
    {
        var d = Desviacion(a);
        return (d >= 0 ? "+" : "") + d.ToString("F1") + "%";
    }

    // ── Estado operativo ──────────────────────────────────────────────────────

    private static string EstadoOperativo(ActividadWBS a)
    {
        bool sinFechas = a.FechaInicioPlaneada == _sinFecha || a.FechaFinPlaneada == _sinFecha;
        if (sinFechas) return "SinFechas";
        if (a.AvanceReal >= 100m) return "Finalizada";

        var plan = AvancePlan(a);
        var diff = a.AvanceReal - plan;

        if (a.AvanceReal == 0m && DateTime.Today < a.FechaInicioPlaneada.Date)
            return "Pendiente";
        if (diff >= -5m)  return "EnProgreso";
        if (diff >= -15m) return "Atrasada";
        return "Critica";
    }

    private static string BadgeTexto(ActividadWBS a) => EstadoOperativo(a) switch
    {
        "Finalizada" => "Finalizada",
        "EnProgreso" => "En Progreso",
        "Atrasada"   => "Atrasada",
        "Critica"    => "Crítica",
        "SinFechas"  => "Sin Fechas",
        _            => "Pendiente"
    };

    private static string BadgeFondo(ActividadWBS a) => EstadoOperativo(a) switch
    {
        "Finalizada" => "#6ABF4B",
        "EnProgreso" => "#183963",
        "Atrasada"   => "#ffc107",
        "Critica"    => "#dc3545",
        "SinFechas"  => "#e9ecef",
        _            => "#6c757d"
    };

    private static string BadgeLetra(ActividadWBS a) => EstadoOperativo(a) switch
    {
        "Atrasada"  => "#111921",
        "SinFechas" => "#6c757d",
        _           => "white"
    };

