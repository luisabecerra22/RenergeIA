@page "/proyectos/{ProyectoId:int}/hseq/calidad"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Enums

<PageTitle>Calidad HSEQ — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <PageHeader Titulo="Calidad"
                Icono="bi-patch-check-fill"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq")"
                TextoVolver="HSEQ">
        <Acciones>
            <StatusChip Estado="Saludable" Grande="true" />
        </Acciones>
    </PageHeader>

    <!-- Navegación sub-módulos -->
    <div class="d-flex gap-2 flex-wrap mb-4">
        <span class="btn btn-primary btn-sm">Dashboard</span>
        <a href="/proyectos/@ProyectoId/hseq/calidad/ppis"            class="btn btn-outline-secondary btn-sm">PPIs</a>
        <a href="/proyectos/@ProyectoId/hseq/calidad/calibracion"     class="btn btn-outline-secondary btn-sm">Calibración Equipos</a>
        <a href="/proyectos/@ProyectoId/hseq/calidad/documentos"      class="btn btn-outline-secondary btn-sm">Control Documental</a>
        <a href="/proyectos/@ProyectoId/hseq/calidad/no-conformidades" class="btn btn-outline-secondary btn-sm">No Conformidades</a>
        <a href="/proyectos/@ProyectoId/hseq/calidad/acciones"        class="btn btn-outline-secondary btn-sm">Acciones Correctivas</a>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="PPIs Ejecutados"
                           Valor="16"
                           Icono="bi-clipboard-check"
                           SubTexto="de 23 planeados"
                           Estado="Informativo" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="PPIs Pendientes"
                           Valor="7"
                           Icono="bi-clipboard"
                           SubTexto="requieren ejecución"
                           Estado="En Riesgo" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Liberaciones Aprobadas"
                           Valor="12"
                           Icono="bi-check-circle-fill"
                           SubTexto="este período"
                           Estado="Saludable" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Liberaciones Rechazadas"
                           Valor="2"
                           Icono="bi-x-circle-fill"
                           SubTexto="requieren corrección"
                           Estado="Crítico" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Equipos Vigentes"
                           Valor="14"
                           Icono="bi-tools"
                           SubTexto="de 18 registrados"
                           Estado="Saludable" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Calibración Vencida"
                           Valor="2"
                           Icono="bi-exclamation-triangle-fill"
                           SubTexto="fuera de vigencia"
                           Estado="Crítico" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="No Conformidades"
                           Valor="3"
                           Icono="bi-exclamation-octagon"
                           SubTexto="abiertas pendientes"
                           Estado="Riesgo" />
        </div>
    </div>

    <!-- Tarjetas acceso sub-módulos -->
    <h5 class="fw-bold mb-3" style="color:#183963">Gestión de Calidad</h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg-2">
            <a href="/proyectos/@ProyectoId/hseq/calidad/ppis" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-clipboard-check-fill d-block mb-2" style="font-size:2rem;color:#183963"></i>
                    <div class="fw-semibold small">PPIs</div>
                    <div class="text-muted small">Inspección</div>
                    <span class="badge bg-warning text-dark mt-1">7 pend.</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a href="/proyectos/@ProyectoId/hseq/calidad/calibracion" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-tools d-block mb-2" style="font-size:2rem;color:#183963"></i>
                    <div class="fw-semibold small">Calibración</div>
                    <div class="text-muted small">Equipos</div>
                    <span class="badge bg-danger mt-1">2 vencidos</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a href="/proyectos/@ProyectoId/hseq/calidad/documentos" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-folder2-open d-block mb-2" style="font-size:2rem;color:#183963"></i>
                    <div class="fw-semibold small">Control</div>
                    <div class="text-muted small">Documental</div>
                    <span class="badge bg-danger mt-1">4 vencidos</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a href="/proyectos/@ProyectoId/hseq/calidad/no-conformidades" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-exclamation-octagon d-block mb-2" style="font-size:2rem;color:#fd7e14"></i>
                    <div class="fw-semibold small">No Conform.</div>
                    <div class="text-muted small">NCRs</div>
                    <span class="badge bg-warning text-dark mt-1">3 abiertas</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a href="/proyectos/@ProyectoId/hseq/calidad/acciones" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-arrow-repeat d-block mb-2" style="font-size:2rem;color:#183963"></i>
                    <div class="fw-semibold small">Acciones</div>
                    <div class="text-muted small">Correctivas</div>
                    <span class="badge bg-danger mt-1">2 vencidas</span>
                </div>
            </a>
        </div>
    </div>

    <!-- Gráficas de estado -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header"><strong>Estado Calibración de Equipos</strong></div>
                <div class="card-body">
                    <div class="row g-2 text-center">
                        <div class="col-3">
                            <div class="p-2 rounded" style="background:#d4edda">
                                <div class="fw-bold" style="font-size:1.4rem;color:#6ABF4B">14</div>
                                <small class="text-success">Vigentes</small>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded" style="background:#fff3cd">
                                <div class="fw-bold" style="font-size:1.4rem;color:#fd7e14">2</div>
                                <small class="text-warning">Prox. Venc.</small>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded" style="background:#f8d7da">
                                <div class="fw-bold" style="font-size:1.4rem;color:#dc3545">2</div>
                                <small class="text-danger">Vencidos</small>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded" style="background:#e2e3e5">
                                <div class="fw-bold" style="font-size:1.4rem;color:#6c757d">0</div>
                                <small class="text-muted">Sin Cert.</small>
                            </div>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height:14px;border-radius:7px">
                        <div class="progress-bar" style="width:78%;background:#6ABF4B;border-radius:7px 0 0 7px"></div>
                        <div class="progress-bar" style="width:11%;background:#fd7e14"></div>
                        <div class="progress-bar" style="width:11%;background:#dc3545;border-radius:0 7px 7px 0"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header"><strong>PPIs — Estado Resumen</strong></div>
                <div class="card-body">
                    <div class="row g-2 text-center">
                        <div class="col">
                            <div class="fw-bold" style="font-size:1.4rem;color:#6ABF4B">10</div>
                            <small class="text-muted">Aprobados</small>
                        </div>
                        <div class="col">
                            <div class="fw-bold" style="font-size:1.4rem;color:#183963">6</div>
                            <small class="text-muted">En Proceso</small>
                        </div>
                        <div class="col">
                            <div class="fw-bold" style="font-size:1.4rem;color:#ffc107">7</div>
                            <small class="text-muted">Pendientes</small>
                        </div>
                        <div class="col">
                            <div class="fw-bold" style="font-size:1.4rem;color:#dc3545">2</div>
                            <small class="text-muted">Rechazados</small>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height:14px;border-radius:7px">
                        <div class="progress-bar" style="width:43%;background:#6ABF4B;border-radius:7px 0 0 7px"></div>
                        <div class="progress-bar" style="width:26%;background:#183963"></div>
                        <div class="progress-bar" style="width:22%;background:#ffc107"></div>
                        <div class="progress-bar" style="width:9%;background:#dc3545;border-radius:0 7px 7px 0"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <AIPanel Titulo="Análisis Inteligente — Calidad"
             Subtitulo="@("Calidad · " + DateTime.Now.ToString("MMMM yyyy"))"
             EstadoGeneral="Desempeño de calidad SALUDABLE con alertas menores."
             EsSimulado="true">
        <Hallazgos>
            <ul>
                <li>PPIs ejecutados al 70% — avance sostenido del período.</li>
                <li>2 equipos de medición con calibración vencida requieren atención urgente.</li>
                <li>4 documentos HSEQ con vigencia superada — riesgo de incumplimiento normativo.</li>
            </ul>
        </Hallazgos>
        <Recomendaciones>
            <ul>
                <li>Priorizar recalibración de equipos vencidos antes del cierre del mes.</li>
                <li>Actualizar y re-aprobar los 4 documentos vencidos en control documental.</li>
                <li>Cerrar las 3 NCRs abiertas con acciones correctivas pendientes.</li>
            </ul>
        </Recomendaciones>
    </AIPanel>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) Navigation.NavigateTo("/proyectos");
    }
}
