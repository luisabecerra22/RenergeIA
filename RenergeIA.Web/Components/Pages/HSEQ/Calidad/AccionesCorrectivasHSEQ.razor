@page "/proyectos/{ProyectoId:int}/hseq/calidad/acciones"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>Acciones Correctivas Calidad — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <PageHeader Titulo="Acciones Correctivas — Calidad"
                Icono="bi-arrow-repeat"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/calidad")"
                TextoVolver="Calidad">
    </PageHeader>

    @if (!_acciones.Any())
    {
        <div class="card shadow-sm text-center py-5">
            <i class="bi-arrow-repeat d-block mb-2" style="font-size:3rem;color:#D9D9D6"></i>
            <p class="text-muted mb-2">No hay acciones correctivas registradas.</p>
            <p class="text-muted small">Las acciones correctivas se crean desde las No Conformidades.</p>
            <a href="/proyectos/@ProyectoId/hseq/calidad/no-conformidades" class="btn btn-primary btn-sm">
                Ir a No Conformidades
            </a>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <ExecutiveCard Titulo="Vencidas"
                               Valor="@_acciones.Count(a => a.Estado == EstadoNoConformidad.Abierta && a.FechaCompromiso < DateTime.Today).ToString()"
                               Icono="bi-calendar-x-fill"
                               SubTexto="superaron fecha compromiso"
                               Estado="@(_acciones.Any(a => a.Estado == EstadoNoConformidad.Abierta && a.FechaCompromiso < DateTime.Today) ? "Crítico" : "Saludable")" />
            </div>
            <div class="col-6 col-md-3">
                <ExecutiveCard Titulo="En Proceso"
                               Valor="@_acciones.Count(a => a.Estado == EstadoNoConformidad.EnImplementacion).ToString()"
                               Icono="bi-arrow-repeat"
                               SubTexto="en implementación"
                               Estado="En Riesgo" />
            </div>
            <div class="col-6 col-md-3">
                <ExecutiveCard Titulo="Cerradas"
                               Valor="@_acciones.Count(a => a.Estado == EstadoNoConformidad.Cerrada).ToString()"
                               Icono="bi-check-circle-fill"
                               SubTexto="completadas exitosamente"
                               Estado="Saludable" />
            </div>
            <div class="col-6 col-md-3">
                <ExecutiveCard Titulo="Abiertas"
                               Valor="@_acciones.Count(a => a.Estado == EstadoNoConformidad.Abierta).ToString()"
                               Icono="bi-circle"
                               SubTexto="pendientes de iniciar"
                               Estado="Riesgo" />
            </div>
        </div>

        <SmartTable Columnas="5"
                    MostrarBusqueda="true"
                    PlaceholderBusqueda="Buscar descripción o responsable..."
                    BusquedaCambiada="OnBusquedaAcc"
                    Vacio="!AccionesFiltradas.Any()"
                    MensajeVacio="No hay acciones correctivas registradas.">
            <Encabezados>
                <tr>
                    <th>Descripción</th>
                    <th>Responsable</th>
                    <th class="text-center">Avance</th>
                    <th>F. Compromiso</th>
                    <th class="text-center">Estado</th>
                </tr>
            </Encabezados>
            <Filas>
                @foreach (var a in AccionesFiltradas.OrderBy(x => x.FechaCompromiso))
                {
                    <tr>
                        <td>@a.Descripcion</td>
                        <td class="small">@a.Responsable</td>
                        <td class="text-center">
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height:8px">
                                    <div class="progress-bar @(a.AvancePorcentaje >= 100 ? "bg-success" : a.AvancePorcentaje >= 50 ? "bg-primary" : "bg-warning")"
                                         style="width:@a.AvancePorcentaje%"></div>
                                </div>
                                <small>@a.AvancePorcentaje%</small>
                            </div>
                        </td>
                        <td class="small @(a.FechaCompromiso < DateTime.Today && a.Estado != EstadoNoConformidad.Cerrada ? "text-danger fw-bold" : "")">
                            @a.FechaCompromiso.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-center">
                            <StatusChip Estado="@(a.Estado == EstadoNoConformidad.Cerrada ? "Saludable" : a.Estado == EstadoNoConformidad.EnImplementacion ? "En Riesgo" : "Riesgo")"
                                        Texto="@EnumDisplay.Mostrar(a.Estado)" />
                        </td>
                    </tr>
                }
            </Filas>
        </SmartTable>
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<AccionHSEQ> _acciones = [];

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }

        _acciones = await Db.AccionesHSEQ
            .Include(a => a.HallazgoHSEQ)
            .Where(a => a.HallazgoHSEQ.ProyectoId == ProyectoId && a.HallazgoHSEQ.Division == DivisionHSEQ.Calidad)
            .OrderBy(a => a.FechaCompromiso)
            .ToListAsync();
    }

    private string _busqueda = "";
    private IEnumerable<AccionHSEQ> AccionesFiltradas => _acciones
        .Where(a => string.IsNullOrEmpty(_busqueda) || a.Descripcion.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) || a.Responsable.Contains(_busqueda, StringComparison.OrdinalIgnoreCase));
    private void OnBusquedaAcc(string v) => _busqueda = v;

    private static string BadgeAcc(EstadoNoConformidad e) => e switch
    {
        EstadoNoConformidad.Cerrada          => "bg-success",
        EstadoNoConformidad.EnImplementacion => "bg-primary",
        EstadoNoConformidad.Abierta          => "bg-warning text-dark",
        _                                    => "bg-secondary"
    };
}
