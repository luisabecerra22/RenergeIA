@page "/proyectos/{ProyectoId:int}/hseq/calidad/documentos"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>Control Documental — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <a href="/proyectos/@ProyectoId/hseq/calidad" class="btn btn-sm btn-outline-secondary">&larr; Calidad</a>
        <div class="flex-grow-1">
            <h1 class="h4 mb-0"><i class="bi-folder2-open me-2" style="color:#183963"></i>Control Documental HSEQ</h1>
            <small class="text-muted">@_proyecto.Nombre</small>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="MostrarFormulario">
            <i class="bi-plus-lg me-1"></i>Nuevo Documento
        </button>
    </div>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <strong>@(_editandoId.HasValue ? "Editar Documento" : "Nuevo Documento HSEQ")</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Código *</label>
                            <InputText class="form-control" @bind-Value="_form.Codigo" />
                            <ValidationMessage For="() => _form.Codigo" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="_form.Nombre" />
                            <ValidationMessage For="() => _form.Nombre" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Versión</label>
                            <InputText class="form-control" @bind-Value="_form.Version" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Tipo</label>
                            <InputSelect class="form-select" @bind-Value="_form.Tipo">
                                @foreach (var t in Enum.GetValues<TipoDocumentoHSEQ>())
                                { <option value="@t">@EnumDisplay.Mostrar(t)</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <InputSelect class="form-select" @bind-Value="_form.Estado">
                                @foreach (var e in Enum.GetValues<EstadoDocumentoHSEQ>())
                                { <option value="@e">@EnumDisplay.Mostrar(e)</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Responsable *</label>
                            <InputText class="form-control" @bind-Value="_form.Responsable" />
                            <ValidationMessage For="() => _form.Responsable" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Aprobado Por</label>
                            <InputText class="form-control" @bind-Value="_form.AprobadoPor" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Emisión</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaEmision" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Vencimiento</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaVencimiento" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ubicación SharePoint</label>
                            <InputText class="form-control" @bind-Value="_form.UbicacionSharePoint" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Disciplina</label>
                            <InputText class="form-control" @bind-Value="_form.Disciplina" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Filtros -->
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <input class="form-control form-control-sm" style="max-width:250px" placeholder="Buscar..."
               @bind="_busqueda" @bind:event="oninput" />
        <select class="form-select form-select-sm" style="max-width:160px" @bind="_filtroTipo">
            <option value="">Todos los tipos</option>
            @foreach (var t in Enum.GetValues<TipoDocumentoHSEQ>())
            { <option value="@t">@EnumDisplay.Mostrar(t)</option> }
        </select>
        <select class="form-select form-select-sm" style="max-width:160px" @bind="_filtroEstado">
            <option value="">Todos los estados</option>
            @foreach (var e in Enum.GetValues<EstadoDocumentoHSEQ>())
            { <option value="@e">@EnumDisplay.Mostrar(e)</option> }
        </select>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th class="text-center">Ver.</th>
                        <th>Responsable</th>
                        <th>Vencimiento</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!DocumentosFiltrados.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No hay documentos registrados.</td></tr>
                    }
                    @foreach (var d in DocumentosFiltrados)
                    {
                        <tr>
                            <td class="font-monospace small text-muted">@d.Codigo</td>
                            <td>@d.Nombre</td>
                            <td class="text-muted small">@EnumDisplay.Mostrar(d.Tipo)</td>
                            <td class="text-center text-muted small">@d.Version</td>
                            <td class="small">@d.Responsable</td>
                            <td class="small @(d.FechaVencimiento < DateTime.Today ? "text-danger fw-bold" : "")">
                                @(d.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")
                            </td>
                            <td class="text-center">
                                <span class="badge @BadgeDoc(d.Estado)">@EnumDisplay.Mostrar(d.Estado)</span>
                            </td>
                            <td class="text-center">
                                @if (_confirmandoEliminar == d.Id)
                                {
                                    <span class="me-1 text-danger small">¿Eliminar?</span>
                                    <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(d.Id)">Sí</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => EditarItem(d)"><i class="bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = d.Id"><i class="bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<DocumentoHSEQ> _documentos = [];
    private bool _mostrarFormulario;
    private int? _editandoId;
    private int? _confirmandoEliminar;
    private string _busqueda = "";
    private string _filtroTipo = "";
    private string _filtroEstado = "";
    private FormModel _form = new();

    private IEnumerable<DocumentoHSEQ> DocumentosFiltrados => _documentos
        .Where(d =>
            (string.IsNullOrEmpty(_busqueda) || d.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) || d.Codigo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrEmpty(_filtroTipo) || d.Tipo.ToString() == _filtroTipo)
            && (string.IsNullOrEmpty(_filtroEstado) || d.Estado.ToString() == _filtroEstado));

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        _documentos = await Db.DocumentosHSEQ.Where(d => d.ProyectoId == ProyectoId).OrderByDescending(d => d.FechaEmision).ToListAsync();

    private void MostrarFormulario() { _form = new FormModel { FechaEmision = DateTime.Today }; _editandoId = null; _mostrarFormulario = true; }
    private void CancelarFormulario() { _mostrarFormulario = false; _editandoId = null; }

    private void EditarItem(DocumentoHSEQ d)
    {
        _form = new FormModel
        {
            Codigo             = d.Codigo,
            Nombre             = d.Nombre,
            Tipo               = d.Tipo,
            Version            = d.Version,
            Estado             = d.Estado,
            FechaEmision       = d.FechaEmision,
            FechaVencimiento   = d.FechaVencimiento,
            Responsable        = d.Responsable,
            AprobadoPor        = d.AprobadoPor,
            UbicacionSharePoint = d.UbicacionSharePoint,
            Disciplina         = d.Disciplina
        };
        _editandoId = d.Id;
        _mostrarFormulario = true;
    }

    private async Task GuardarAsync()
    {
        if (_editandoId.HasValue)
        {
            var entidad = await Db.DocumentosHSEQ.FindAsync(_editandoId.Value);
            if (entidad is not null) MapearForm(entidad);
        }
        else
        {
            var entidad = new DocumentoHSEQ { ProyectoId = ProyectoId };
            MapearForm(entidad);
            Db.DocumentosHSEQ.Add(entidad);
        }
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAsync();
    }

    private void MapearForm(DocumentoHSEQ d)
    {
        d.Codigo             = _form.Codigo;
        d.Nombre             = _form.Nombre;
        d.Tipo               = _form.Tipo;
        d.Version            = _form.Version;
        d.Estado             = _form.Estado;
        d.FechaEmision       = _form.FechaEmision;
        d.FechaVencimiento   = _form.FechaVencimiento;
        d.Responsable        = _form.Responsable;
        d.AprobadoPor        = _form.AprobadoPor;
        d.UbicacionSharePoint = _form.UbicacionSharePoint;
        d.Disciplina         = _form.Disciplina;
        d.FechaModificacion  = DateTime.UtcNow;
    }

    private async Task EliminarAsync(int id)
    {
        var entidad = await Db.DocumentosHSEQ.FindAsync(id);
        if (entidad is not null) { Db.DocumentosHSEQ.Remove(entidad); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private static string BadgeDoc(EstadoDocumentoHSEQ estado) => estado switch
    {
        EstadoDocumentoHSEQ.Vigente    => "bg-success",
        EstadoDocumentoHSEQ.EnRevision => "bg-warning text-dark",
        EstadoDocumentoHSEQ.Pendiente  => "bg-secondary",
        EstadoDocumentoHSEQ.Obsoleto   => "bg-dark",
        EstadoDocumentoHSEQ.Vencido    => "bg-danger",
        _                              => "bg-secondary"
    };

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Codigo { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Nombre { get; set; } = "";
        public TipoDocumentoHSEQ Tipo { get; set; } = TipoDocumentoHSEQ.Procedimiento;
        public string Version { get; set; } = "1.0";
        public EstadoDocumentoHSEQ Estado { get; set; } = EstadoDocumentoHSEQ.Vigente;
        public DateTime FechaEmision { get; set; } = DateTime.Today;
        public DateTime? FechaVencimiento { get; set; }
        [System.ComponentModel.DataAnnotations.Required] public string Responsable { get; set; } = "";
        public string? AprobadoPor { get; set; }
        public string? UbicacionSharePoint { get; set; }
        public string? Disciplina { get; set; }
    }
}
