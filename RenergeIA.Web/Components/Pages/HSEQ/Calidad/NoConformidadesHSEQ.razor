@page "/proyectos/{ProyectoId:int}/hseq/calidad/no-conformidades"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>No Conformidades Calidad — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <PageHeader Titulo="No Conformidades — Calidad"
                Icono="bi-exclamation-octagon"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/calidad")"
                TextoVolver="Calidad">
        <Acciones>
            <button class="btn btn-primary btn-sm" @onclick="MostrarFormulario">
                <i class="bi-plus-lg me-1"></i>Nueva NCR
            </button>
        </Acciones>
    </PageHeader>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <strong>@(_editandoId.HasValue ? "Editar NCR" : "Nueva No Conformidad")</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Código *</label>
                            <InputText class="form-control" @bind-Value="_form.Codigo" />
                            <ValidationMessage For="() => _form.Codigo" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Título *</label>
                            <InputText class="form-control" @bind-Value="_form.Titulo" />
                            <ValidationMessage For="() => _form.Titulo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Severidad</label>
                            <InputSelect class="form-select" @bind-Value="_form.Severidad">
                                @foreach (var s in Enum.GetValues<SeveridadNoConformidad>())
                                { <option value="@s">@EnumDisplay.Mostrar(s)</option> }
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción *</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Descripcion" />
                            <ValidationMessage For="() => _form.Descripcion" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Causa</label>
                            <InputText class="form-control" @bind-Value="_form.Causa" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Responsable *</label>
                            <InputText class="form-control" @bind-Value="_form.Responsable" />
                            <ValidationMessage For="() => _form.Responsable" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Fecha Detección</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaDeteccion" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Fecha Compromiso</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaCompromiso" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <InputSelect class="form-select" @bind-Value="_form.Estado">
                                @foreach (var e in Enum.GetValues<EstadoNoConformidad>())
                                { <option value="@e">@EnumDisplay.Mostrar(e)</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ubicación</label>
                            <InputText class="form-control" @bind-Value="_form.Ubicacion" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <FilterBar>
        <select class="form-select form-select-sm" style="max-width:160px" @bind="_filtroEstado">
            <option value="">Todos los estados</option>
            @foreach (var e in Enum.GetValues<EstadoNoConformidad>())
            { <option value="@e">@EnumDisplay.Mostrar(e)</option> }
        </select>
    </FilterBar>

    <SmartTable Columnas="8"
                MostrarBusqueda="true"
                PlaceholderBusqueda="Buscar código o título..."
                BusquedaCambiada="OnBusqueda"
                Vacio="!HallazgosFiltrados.Any()"
                MensajeVacio="No hay no conformidades registradas.">
        <Encabezados>
            <tr>
                <th>Código</th>
                <th>Título</th>
                <th class="text-center">Severidad</th>
                <th>Responsable</th>
                <th>F. Detección</th>
                <th>F. Compromiso</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </Encabezados>
        <Filas>
            @foreach (var h in HallazgosFiltrados)
            {
                <tr>
                    <td class="font-monospace small text-muted">@h.Codigo</td>
                    <td>@h.Titulo</td>
                    <td class="text-center">
                        <StatusChip Estado="@(h.Severidad == SeveridadNoConformidad.Critica ? "Crítico" : h.Severidad == SeveridadNoConformidad.Alta ? "En Riesgo" : "Riesgo")"
                                    Texto="@EnumDisplay.Mostrar(h.Severidad)" />
                    </td>
                    <td class="small">@h.Responsable</td>
                    <td class="small">@h.FechaDeteccion.ToString("dd/MM/yyyy")</td>
                    <td class="small @(h.FechaCompromiso < DateTime.Today && h.Estado != EstadoNoConformidad.Cerrada ? "text-danger fw-semibold" : "")">
                        @(h.FechaCompromiso?.ToString("dd/MM/yyyy") ?? "—")
                    </td>
                    <td class="text-center">
                        <StatusChip Estado="@(h.Estado == EstadoNoConformidad.Cerrada ? "Saludable" : h.Estado == EstadoNoConformidad.Abierta ? "Crítico" : h.Estado == EstadoNoConformidad.EnRevision ? "Riesgo" : "En Riesgo")"
                                    Texto="@EnumDisplay.Mostrar(h.Estado)" />
                    </td>
                    <td class="text-center">
                        @if (_confirmandoEliminar == h.Id)
                        {
                            <span class="me-1 text-danger small">¿Eliminar?</span>
                            <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(h.Id)">Sí</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => EditarItem(h)"><i class="bi-pencil"></i></button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = h.Id"><i class="bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
        </Filas>
    </SmartTable>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<HallazgoHSEQ> _hallazgos = [];
    private bool _mostrarFormulario;
    private int? _editandoId;
    private int? _confirmandoEliminar;
    private string _busqueda = "";
    private string _filtroEstado = "";
    private FormModel _form = new();

    private IEnumerable<HallazgoHSEQ> HallazgosFiltrados => _hallazgos
        .Where(h =>
            (string.IsNullOrEmpty(_busqueda) || h.Titulo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) || h.Codigo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrEmpty(_filtroEstado) || h.Estado.ToString() == _filtroEstado));

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        _hallazgos = await Db.HallazgosHSEQ
            .Where(h => h.ProyectoId == ProyectoId && h.Division == DivisionHSEQ.Calidad)
            .OrderByDescending(h => h.FechaDeteccion).ToListAsync();

    private void MostrarFormulario() { _form = new FormModel { FechaDeteccion = DateTime.Today }; _editandoId = null; _mostrarFormulario = true; }
    private void CancelarFormulario() { _mostrarFormulario = false; _editandoId = null; }

    private void EditarItem(HallazgoHSEQ h)
    {
        _form = new FormModel
        {
            Codigo         = h.Codigo,
            Titulo         = h.Titulo,
            Descripcion    = h.Descripcion,
            Causa          = h.Causa,
            Severidad      = h.Severidad,
            Responsable    = h.Responsable,
            FechaDeteccion = h.FechaDeteccion,
            FechaCompromiso = h.FechaCompromiso,
            Estado         = h.Estado,
            Ubicacion      = h.Ubicacion
        };
        _editandoId = h.Id;
        _mostrarFormulario = true;
    }

    private async Task GuardarAsync()
    {
        if (_editandoId.HasValue)
        {
            var entidad = await Db.HallazgosHSEQ.FindAsync(_editandoId.Value);
            if (entidad is not null) MapearForm(entidad);
        }
        else
        {
            var entidad = new HallazgoHSEQ { ProyectoId = ProyectoId, Division = DivisionHSEQ.Calidad };
            MapearForm(entidad);
            Db.HallazgosHSEQ.Add(entidad);
        }
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAsync();
    }

    private void MapearForm(HallazgoHSEQ h)
    {
        h.Codigo          = _form.Codigo;
        h.Titulo          = _form.Titulo;
        h.Descripcion     = _form.Descripcion;
        h.Causa           = _form.Causa;
        h.Severidad       = _form.Severidad;
        h.Responsable     = _form.Responsable;
        h.FechaDeteccion  = _form.FechaDeteccion;
        h.FechaCompromiso = _form.FechaCompromiso;
        h.Estado          = _form.Estado;
        h.Ubicacion       = _form.Ubicacion;
        h.FechaModificacion = DateTime.UtcNow;
    }

    private async Task EliminarAsync(int id)
    {
        var entidad = await Db.HallazgosHSEQ.FindAsync(id);
        if (entidad is not null) { Db.HallazgosHSEQ.Remove(entidad); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private void OnBusqueda(string v) => _busqueda = v;

    private static string BadgeSev(SeveridadNoConformidad s) => s switch
    {
        SeveridadNoConformidad.Critica => "bg-danger",
        SeveridadNoConformidad.Alta    => "bg-warning text-dark",
        SeveridadNoConformidad.Media   => "bg-info text-dark",
        _                              => "bg-secondary"
    };

    private static string BadgeNcr(EstadoNoConformidad e) => e switch
    {
        EstadoNoConformidad.Cerrada          => "bg-success",
        EstadoNoConformidad.Abierta          => "bg-danger",
        EstadoNoConformidad.EnRevision       => "bg-warning text-dark",
        EstadoNoConformidad.EnImplementacion => "bg-primary",
        _                                    => "bg-secondary"
    };

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Codigo { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Titulo { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Descripcion { get; set; } = "";
        public string? Causa { get; set; }
        public SeveridadNoConformidad Severidad { get; set; } = SeveridadNoConformidad.Media;
        [System.ComponentModel.DataAnnotations.Required] public string Responsable { get; set; } = "";
        public DateTime FechaDeteccion { get; set; } = DateTime.Today;
        public DateTime? FechaCompromiso { get; set; }
        public EstadoNoConformidad Estado { get; set; } = EstadoNoConformidad.Abierta;
        public string? Ubicacion { get; set; }
    }
}
