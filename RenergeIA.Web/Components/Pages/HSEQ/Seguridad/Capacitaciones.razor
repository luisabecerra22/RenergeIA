@page "/proyectos/{ProyectoId:int}/hseq/seguridad/capacitaciones"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>Capacitaciones — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <a href="/proyectos/@ProyectoId/hseq/seguridad" class="btn btn-sm btn-outline-secondary">&larr; Seguridad</a>
        <div class="flex-grow-1">
            <h1 class="h4 mb-0"><i class="bi-mortarboard-fill me-2" style="color:#183963"></i>Capacitaciones SST</h1>
            <small class="text-muted">@_proyecto.Nombre</small>
        </div>
        <button class="btn btn-success btn-sm me-1" @onclick="() => MostrarFormularioPlan()"><i class="bi-calendar-plus me-1"></i>Planificar</button>
        <button class="btn btn-primary btn-sm" @onclick="() => MostrarFormularioEjec()"><i class="bi-plus-lg me-1"></i>Registrar Ejecutada</button>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-primary">
                <div class="fw-bold" style="font-size:1.8rem;color:#183963">@_planificadas.Count</div>
                <div class="text-muted small">Planificadas</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-success">
                <div class="fw-bold" style="font-size:1.8rem;color:#6ABF4B">@_ejecutadas.Count</div>
                <div class="text-muted small">Ejecutadas</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            @{ var cumPct = _planificadas.Count > 0 ? (int)Math.Round(_ejecutadas.Count * 100.0 / _planificadas.Count) : 100; }
            <div class="card shadow-sm p-3 text-center border-start border-4 @(cumPct>=80?"border-success":cumPct>=60?"border-warning":"border-danger")">
                <div class="fw-bold" style="font-size:1.8rem;color:@(cumPct>=80?"#6ABF4B":cumPct>=60?"#ffc107":"#dc3545")">@cumPct%</div>
                <div class="text-muted small">% Cumplimiento</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            @{ var hh = _ejecutadas.Sum(c => c.DuracionHoras * c.NumeroAsistentes); }
            <div class="card shadow-sm p-3 text-center border-start border-4 border-primary">
                <div class="fw-bold" style="font-size:1.8rem;color:#183963">@hh.ToString("N0")h</div>
                <div class="text-muted small">Horas-Hombre</div>
            </div>
        </div>
    </div>

    <!-- Formulario planificada -->
    @if (_mostrarFormPlan)
    {
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-header bg-success text-white d-flex justify-content-between">
                <strong>Planificar Capacitación</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="() => _mostrarFormPlan = false"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_formPlan" OnValidSubmit="GuardarPlanAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="_formPlan.Nombre" />
                            <ValidationMessage For="() => _formPlan.Nombre" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tema *</label>
                            <InputText class="form-control" @bind-Value="_formPlan.Tema" />
                            <ValidationMessage For="() => _formPlan.Tema" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Área</label>
                            <InputText class="form-control" @bind-Value="_formPlan.Area" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Público Objetivo</label>
                            <InputText class="form-control" @bind-Value="_formPlan.PublicoObjetivo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Responsable</label>
                            <InputText class="form-control" @bind-Value="_formPlan.Responsable" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Planificada *</label>
                            <InputDate class="form-control" @bind-Value="_formPlan.FechaPlanificada" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Duración (h)</label>
                            <InputNumber class="form-control" @bind-Value="_formPlan.DuracionEstimadaHoras" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_formPlan.Observaciones" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _mostrarFormPlan = false">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Formulario ejecutada -->
    @if (_mostrarFormEjec)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <strong>Registrar Capacitación Ejecutada</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="() => _mostrarFormEjec = false"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_formEjec" OnValidSubmit="GuardarEjecAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Título *</label>
                            <InputText class="form-control" @bind-Value="_formEjec.Titulo" />
                            <ValidationMessage For="() => _formEjec.Titulo" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tema</label>
                            <InputText class="form-control" @bind-Value="_formEjec.Tema" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Instructor *</label>
                            <InputText class="form-control" @bind-Value="_formEjec.Instructor" />
                            <ValidationMessage For="() => _formEjec.Instructor" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Área</label>
                            <InputText class="form-control" @bind-Value="_formEjec.Area" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Responsable</label>
                            <InputText class="form-control" @bind-Value="_formEjec.Responsable" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha</label>
                            <InputDate class="form-control" @bind-Value="_formEjec.Fecha" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Duración (h)</label>
                            <InputNumber class="form-control" @bind-Value="_formEjec.DuracionHoras" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">N° Asistentes</label>
                            <InputNumber class="form-control" @bind-Value="_formEjec.NumeroAsistentes" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Lugar</label>
                            <InputText class="form-control" @bind-Value="_formEjec.Lugar" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_formEjec.Observaciones" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _mostrarFormEjec = false">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_tabActivo == "plan" ? "active" : "")" @onclick='() => _tabActivo = "plan"'>
                <i class="bi-calendar3 me-1"></i>Planificadas (@_planificadas.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_tabActivo == "ejec" ? "active" : "")" @onclick='() => _tabActivo = "ejec"'>
                <i class="bi-check2-circle me-1"></i>Ejecutadas (@_ejecutadas.Count)
            </button>
        </li>
    </ul>

    @if (_tabActivo == "plan")
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr><th>Nombre</th><th>Tema</th><th>Área</th><th>Responsable</th><th>F. Planificada</th><th class="text-center">Duración</th><th class="text-center">Estado</th><th class="text-center">Acc.</th></tr>
                    </thead>
                    <tbody>
                        @if (!_planificadas.Any())
                        {
                            <tr><td colspan="8" class="text-center text-muted py-4">No hay capacitaciones planificadas.</td></tr>
                        }
                        @foreach (var p in _planificadas.OrderBy(x => x.FechaPlanificada))
                        {
                            <tr>
                                <td class="fw-semibold">@p.Nombre</td>
                                <td class="text-muted">@p.Tema</td>
                                <td>@(p.Area ?? "—")</td>
                                <td>@(p.Responsable ?? "—")</td>
                                <td @class="@(p.FechaPlanificada < DateTime.Today && p.Estado == EstadoPlanTrabajo.Planificada ? "text-danger fw-bold" : "")">
                                    @p.FechaPlanificada.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center text-muted">@p.DuracionEstimadaHoras.ToString("N0")h</td>
                                <td class="text-center"><span class="badge @BadgePlan(p.Estado)">@EnumDisplay.Mostrar(p.Estado)</span></td>
                                <td class="text-center">
                                    @if (_confirmandoEliminarPlan == p.Id)
                                    {
                                        <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarPlanAsync(p.Id)">Sí</button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminarPlan = null">No</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminarPlan = p.Id"><i class="bi-trash"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_tabActivo == "ejec")
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr><th>Título</th><th>Instructor</th><th>Área</th><th>Fecha</th><th class="text-center">Duración</th><th class="text-center">Asistentes</th><th class="text-center">HH</th><th>Lugar</th><th class="text-center">Acc.</th></tr>
                    </thead>
                    <tbody>
                        @if (!_ejecutadas.Any())
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No hay capacitaciones ejecutadas.</td></tr>
                        }
                        @foreach (var c in _ejecutadas.OrderByDescending(x => x.Fecha))
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@c.Titulo</div>
                                    <div class="text-muted" style="font-size:.78rem">@c.Tema</div>
                                </td>
                                <td class="text-muted">@c.Instructor</td>
                                <td>@(c.Area ?? "—")</td>
                                <td>@c.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="text-center text-muted">@c.DuracionHoras.ToString("N0")h</td>
                                <td class="text-center fw-semibold">@c.NumeroAsistentes</td>
                                <td class="text-center text-muted">@((c.DuracionHoras * c.NumeroAsistentes).ToString("N0"))h</td>
                                <td class="text-muted">@(c.Lugar ?? "—")</td>
                                <td class="text-center">
                                    @if (_confirmandoEliminarEjec == c.Id)
                                    {
                                        <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarEjecAsync(c.Id)">Sí</button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminarEjec = null">No</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminarEjec = c.Id"><i class="bi-trash"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<CapacitacionPlanificada> _planificadas = [];
    private List<Capacitacion> _ejecutadas = [];
    private string _tabActivo = "ejec";
    private bool _mostrarFormPlan;
    private bool _mostrarFormEjec;
    private int? _confirmandoEliminarPlan;
    private int? _confirmandoEliminarEjec;
    private FormPlanModel _formPlan = new();
    private FormEjecModel _formEjec = new();

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _planificadas = await Db.CapacitacionesPlanificadas.Where(c => c.ProyectoId == ProyectoId).OrderBy(c => c.FechaPlanificada).ToListAsync();
        _ejecutadas   = await Db.Capacitaciones.Where(c => c.ProyectoId == ProyectoId).OrderByDescending(c => c.Fecha).ToListAsync();
    }

    private void MostrarFormularioPlan() { _formPlan = new FormPlanModel { FechaPlanificada = DateTime.Today }; _mostrarFormPlan = true; _tabActivo = "plan"; }
    private void MostrarFormularioEjec() { _formEjec = new FormEjecModel { Fecha = DateTime.Today }; _mostrarFormEjec = true; _tabActivo = "ejec"; }

    private async Task GuardarPlanAsync()
    {
        Db.CapacitacionesPlanificadas.Add(new CapacitacionPlanificada
        {
            ProyectoId           = ProyectoId,
            Nombre               = _formPlan.Nombre,
            Tema                 = _formPlan.Tema,
            Area                 = _formPlan.Area,
            PublicoObjetivo      = _formPlan.PublicoObjetivo,
            Responsable          = _formPlan.Responsable,
            FechaPlanificada     = _formPlan.FechaPlanificada,
            DuracionEstimadaHoras = _formPlan.DuracionEstimadaHoras,
            Observaciones        = _formPlan.Observaciones
        });
        await Db.SaveChangesAsync();
        _mostrarFormPlan = false;
        await CargarAsync();
    }

    private async Task GuardarEjecAsync()
    {
        Db.Capacitaciones.Add(new Capacitacion
        {
            ProyectoId       = ProyectoId,
            Titulo           = _formEjec.Titulo,
            Tema             = _formEjec.Tema,
            Instructor       = _formEjec.Instructor,
            Area             = _formEjec.Area,
            Responsable      = _formEjec.Responsable,
            Fecha            = _formEjec.Fecha,
            DuracionHoras    = _formEjec.DuracionHoras,
            NumeroAsistentes = _formEjec.NumeroAsistentes,
            Lugar            = _formEjec.Lugar,
            Estado           = EstadoPlanTrabajo.Ejecutada,
            Observaciones    = _formEjec.Observaciones
        });
        await Db.SaveChangesAsync();
        _mostrarFormEjec = false;
        await CargarAsync();
    }

    private async Task EliminarPlanAsync(int id)
    {
        var e = await Db.CapacitacionesPlanificadas.FindAsync(id);
        if (e is not null) { Db.CapacitacionesPlanificadas.Remove(e); await Db.SaveChangesAsync(); }
        _confirmandoEliminarPlan = null;
        await CargarAsync();
    }

    private async Task EliminarEjecAsync(int id)
    {
        var e = await Db.Capacitaciones.FindAsync(id);
        if (e is not null) { Db.Capacitaciones.Remove(e); await Db.SaveChangesAsync(); }
        _confirmandoEliminarEjec = null;
        await CargarAsync();
    }

    private static string BadgePlan(EstadoPlanTrabajo e) => e switch
    {
        EstadoPlanTrabajo.Ejecutada    => "bg-success",
        EstadoPlanTrabajo.Planificada  => "bg-primary",
        EstadoPlanTrabajo.Pendiente    => "bg-warning text-dark",
        EstadoPlanTrabajo.Vencida      => "bg-danger",
        EstadoPlanTrabajo.Cancelada    => "bg-secondary",
        _                              => "bg-secondary"
    };

    private sealed class FormPlanModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Nombre { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Tema { get; set; } = "";
        public string? Area { get; set; }
        public string? PublicoObjetivo { get; set; }
        public string? Responsable { get; set; }
        public DateTime FechaPlanificada { get; set; } = DateTime.Today;
        public decimal DuracionEstimadaHoras { get; set; } = 2;
        public string? Observaciones { get; set; }
    }

    private sealed class FormEjecModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Titulo { get; set; } = "";
        public string Tema { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Instructor { get; set; } = "";
        public string? Area { get; set; }
        public string? Responsable { get; set; }
        public DateTime Fecha { get; set; } = DateTime.Today;
        public decimal DuracionHoras { get; set; } = 2;
        public int NumeroAsistentes { get; set; }
        public string? Lugar { get; set; }
        public string? Observaciones { get; set; }
    }
}
