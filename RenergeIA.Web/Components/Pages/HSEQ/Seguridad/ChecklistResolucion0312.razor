@page "/proyectos/{ProyectoId:int}/hseq/seguridad/resolucion0312"
@page "/proyectos/{ProyectoId:int}/hseq/seguridad/resolucion0312/{AuditoriaId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ChecklistISO9001Service ChecklistSvc
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums
@using RenergeIA.Web.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>
    @if (_modoDetalle)
    { @($"Auditoría Res. 0312 — {_auditoria?.Auditor ?? ""}") }
    else
    { @($"Res. 0312:2019 — {_proyecto?.Nombre ?? ""}") }
</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted p-4">Cargando...</p>
}
else if (!_modoDetalle)
{
    <!-- VISTA LISTADO -->
    <PageHeader Titulo="Resolución 0312:2019 — Estándares Mínimos SG-SST"
                Icono="bi-journal-check"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/seguridad")"
                TextoVolver="Seguridad">
        <Acciones>
            <button type="button" class="btn btn-sm" style="background:#E65100;color:#fff"
                    @onclick="MostrarFormNueva">
                <i class="bi-plus-lg me-1"></i>Nueva Auditoría
            </button>
        </Acciones>
    </PageHeader>

    @if (_mensajeListado is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi-exclamation-triangle-fill me-2"></i>@_mensajeListado
            <button type="button" class="btn-close" @onclick="() => _mensajeListado = null"></button>
        </div>
    }

    @if (_mostrarFormNueva)
    {
        <div class="card shadow-sm mb-4 border-0" style="border-left:4px solid #E65100 !important">
            <div class="card-header text-white d-flex justify-content-between align-items-center"
                 style="background:#E65100">
                <strong><i class="bi-clipboard-plus me-2"></i>Nueva Auditoría — Res. 0312:2019</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormNueva"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_formNueva" OnValidSubmit="CrearAuditoriaAsync" FormName="NuevaAuditoria0312Form">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Auditor / Responsable *</label>
                            <InputText class="form-control" @bind-Value="_formNueva.Auditor"
                                       placeholder="Nombre del auditor..." />
                            <ValidationMessage For="() => _formNueva.Auditor" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Fecha de Auditoría *</label>
                            <InputDate class="form-control" @bind-Value="_formNueva.FechaAuditoria" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Estado inicial</label>
                            <InputSelect class="form-select" @bind-Value="_formNueva.Estado">
                                <option value="@EstadoAuditoria.Borrador">Borrador</option>
                                <option value="@EstadoAuditoria.EnProceso">En Proceso</option>
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Observaciones generales</label>
                            <InputTextArea class="form-control" rows="2"
                                           @bind-Value="_formNueva.Observaciones"
                                           placeholder="Contexto de la autoevaluación de estándares mínimos..." />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-sm text-white" style="background:#E65100"
                                disabled="@_guardando">
                            @if (_guardando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            <i class="bi-check-lg me-1"></i>Crear y Diligenciar Checklist
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormNueva">
                            Cancelar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- KPIs listado -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Total Auditorías"
                           Valor="@_auditorias.Count.ToString()"
                           Icono="bi-journal-check"
                           SubTexto="registradas"
                           Estado="Informativo" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Última Auditoría"
                           Valor="@(_auditorias.Any() ? _auditorias[0].FechaAuditoria.ToString("dd/MM/yy") : "—")"
                           Icono="bi-calendar-check"
                           SubTexto="fecha más reciente"
                           Estado="Informativo" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Puntuación Actual"
                           Valor="@(_auditorias.Any() ? _auditorias[0].PorcentajeCumplimiento.ToString("F1") + " pts" : "—")"
                           Icono="bi-award"
                           SubTexto="escala de 100 puntos"
                           Estado="@EstadoUltimaAuditoria" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Finalizadas"
                           Valor="@_auditorias.Count(a => a.EstadoAuditoria == EstadoAuditoria.Finalizada).ToString()"
                           Icono="bi-patch-check"
                           SubTexto="auditorías completadas"
                           Estado="Informativo" />
        </div>
    </div>

    <SmartTable Columnas="6"
                MostrarBusqueda="true"
                PlaceholderBusqueda="Buscar por auditor..."
                BusquedaCambiada="OnBusquedaListado"
                Vacio="!AuditoriasFiltradas.Any()"
                MensajeVacio="No hay auditorías registradas. Cree la primera con el botón 'Nueva Auditoría'.">
        <Encabezados>
            <tr>
                <th>Fecha</th>
                <th>Auditor</th>
                <th class="text-center">Puntuación</th>
                <th class="text-center">Clasificación</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </Encabezados>
        <Filas>
            @foreach (var a in AuditoriasFiltradas)
            {
                var pts = (double)a.PorcentajeCumplimiento;
                <tr>
                    <td class="text-nowrap">@a.FechaAuditoria.ToString("dd/MM/yyyy")</td>
                    <td>@a.Auditor</td>
                    <td class="text-center fw-bold" style="color:@ColorPts(pts)">
                        @a.PorcentajeCumplimiento.ToString("F2") pts
                    </td>
                    <td class="text-center">
                        <span class="badge" style="background:@ColorPts(pts);font-size:.8rem">
                            @ClasificacionLabel(pts)
                        </span>
                    </td>
                    <td class="text-center">
                        <span class="badge rounded-pill @BadgeEstadoAuditoria(a.EstadoAuditoria)">
                            @LabelEstadoAuditoria(a.EstadoAuditoria)
                        </span>
                    </td>
                    <td class="text-center text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-warning me-1"
                                title="Ver / Editar"
                                @onclick="@(() => Navigation.NavigateTo($"/proyectos/{ProyectoId}/hseq/seguridad/resolucion0312/{a.Id}"))">
                            <i class="bi-pencil-square"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning me-1"
                                title="Exportar Excel"
                                @onclick="() => ExportarExcelListadoAsync(a.Id)">
                            <i class="bi-file-earmark-spreadsheet"></i>
                        </button>
                        @if (_confirmandoEliminar == a.Id)
                        {
                            <span class="text-danger small me-1">¿Eliminar?</span>
                            <button type="button" class="btn btn-sm btn-danger me-1"
                                    @onclick="() => EliminarAsync(a.Id)">Sí</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => _confirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    @onclick="() => _confirmandoEliminar = a.Id">
                                <i class="bi-trash"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </Filas>
    </SmartTable>
}
else
{
    <!-- VISTA DETALLE -->

    @if (_modalVisible)
    {
        <div class="iso-modal-bg" @onclick="CerrarModal">
            <div class="iso-modal" @onclick:stopPropagation>
                <div class="d-flex justify-content-between align-items-start">
                    <p class="iso-modal-title">@_modalTitle</p>
                    <button class="btn-close ms-3 flex-shrink-0" @onclick="CerrarModal" type="button"></button>
                </div>
                <hr class="iso-modal-sep" />
                @if (_modalEsDocs)
                {
                    @if (_modalDocs is { Length: > 0 })
                    {
                        <ul class="mb-0 ps-3">
                            @foreach (var doc in _modalDocs) { <li class="mb-1">@doc</li> }
                        </ul>
                    }
                    else
                    {
                        <p class="mb-0 text-muted fst-italic">@_modalBodyText</p>
                    }
                }
                else
                {
                    <p class="mb-0" style="line-height:1.6">@_modalBodyText</p>
                }
            </div>
        </div>
    }

    <PageHeader Titulo="Resolución 0312:2019"
                Icono="bi-journal-check"
                Subtitulo="@($"{_proyecto.Nombre} — {_auditoria?.Auditor} — {_auditoria?.FechaAuditoria.ToString("dd/MM/yyyy")}")"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/seguridad/resolucion0312")"
                TextoVolver="Listado Auditorías">
        <Acciones>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm text-white" style="background:#E65100"
                        @onclick="() => GuardarAsync(EstadoAuditoria.EnProceso)" disabled="@_guardando">
                    @if (_guardando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="bi-save me-1"></i>Guardar cambios
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        @onclick="() => GuardarAsync(EstadoAuditoria.Borrador)" disabled="@_guardando">
                    <i class="bi-pencil me-1"></i>Borrador
                </button>
                <button type="button" class="btn btn-outline-warning btn-sm"
                        @onclick="FinalizarAsync" disabled="@_guardando">
                    <i class="bi-check-circle me-1"></i>Finalizar
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ImprimirAsync">
                    <i class="bi-printer me-1"></i>PDF
                </button>
                <button type="button" class="btn btn-outline-warning btn-sm"
                        @onclick="() => ExportarExcelAsync(AuditoriaId)">
                    <i class="bi-file-earmark-spreadsheet me-1"></i>Excel
                </button>
            </div>
        </Acciones>
    </PageHeader>

    @if (_mensajeExito is not null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi-check-circle-fill me-2"></i>@_mensajeExito
            <button type="button" class="btn-close" @onclick="() => _mensajeExito = null"></button>
        </div>
    }
    @if (_mensajeError is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi-exclamation-triangle-fill me-2"></i>@_mensajeError
            <button type="button" class="btn-close" @onclick="() => _mensajeError = null"></button>
        </div>
    }

    <!-- Barra de estado -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <span class="badge fs-6 rounded-pill @BadgeEstadoAuditoria(_auditoria!.EstadoAuditoria)">
                    @LabelEstadoAuditoria(_auditoria.EstadoAuditoria)
                </span>
                <span class="text-muted small"><i class="bi-person me-1"></i>@_auditoria.Auditor</span>
                <span class="text-muted small"><i class="bi-calendar me-1"></i>@_auditoria.FechaAuditoria.ToString("dd/MM/yyyy")</span>
                <span class="text-muted small"><i class="bi-journal-check me-1"></i>Res. 0312:2019</span>
                <span class="text-muted small"><i class="bi-people me-1"></i>Empresas +50 trabajadores y/o Riesgo IV-V</span>
            </div>
        </div>
    </div>

    <!-- DASHBOARD PHVA -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#E65100;color:#fff;cursor:pointer"
             @onclick="() => _dashboardVisible = !_dashboardVisible">
            <span><i class="bi-bar-chart-line-fill me-2"></i>Dashboard de Cumplimiento — Res. 0312:2019</span>
            <i class="@(_dashboardVisible ? "bi-chevron-up" : "bi-chevron-down")"></i>
        </div>
        @if (_dashboardVisible)
        {
            <div class="card-body px-3 py-3">

                <!-- Puntuación global -->
                <div class="iso-dash-semaforo mb-3">
                    <div class="d-flex align-items-baseline gap-3 mb-1">
                        <span class="iso-kpi-pct" style="color:@ColorPts(_stats.PuntajeTotal)">
                            @_stats.PuntajeTotal.ToString("F2")
                        </span>
                        <span style="font-size:1.1rem;font-weight:600;color:#6b7785">/ 100 puntos</span>
                        <span class="iso-nivel-badge"
                              style="background:@ColorPtsBg(_stats.PuntajeTotal);color:@ColorPts(_stats.PuntajeTotal)">
                            @ClasificacionLabel(_stats.PuntajeTotal)
                        </span>
                    </div>
                    <div class="small text-muted mb-2" style="font-weight:500">
                        Escala oficial: ≥85 Aceptable · 61–84 Mod. Aceptable · ≤60 Crítico
                    </div>
                    <div class="iso-semaforo-track">
                        <div class="iso-semaforo-fill"
                             style="width:@BarraPct;background:@ColorPts(_stats.PuntajeTotal)"></div>
                    </div>
                    <div class="iso-semaforo-marks">
                        <span>0</span><span>25</span><span>50</span><span>75</span><span>100</span>
                    </div>
                    <div class="iso-legend-row">
                        <span class="iso-legend-item">
                            <span class="iso-legend-dot" style="background:#6ABF48"></span>Cumple (@_stats.TotalCumple)
                        </span>
                        <span class="iso-legend-item">
                            <span class="iso-legend-dot" style="background:#F5B301"></span>En Proceso (@_stats.TotalEnProceso)
                        </span>
                        <span class="iso-legend-item">
                            <span class="iso-legend-dot" style="background:#E53935"></span>No Cumple (@_stats.TotalNoCumple)
                        </span>
                        <span class="iso-legend-item">
                            <span class="iso-legend-dot" style="background:#9CA3AF"></span>Sin Evaluar (@_stats.TotalSinEvaluar)
                        </span>
                    </div>
                </div>

                <!-- Tarjetas PHVA -->
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="iso-kpi-card" style="border-color:#102963">
                            <div class="iso-kpi-icon" style="background:#e8ecf5;color:#102963">
                                <i class="bi-p-circle-fill"></i>
                            </div>
                            <div>
                                <div class="iso-kpi-val" style="color:#102963">
                                    @_stats.PtsPlanear.ToString("F2")
                                </div>
                                <div class="iso-kpi-lbl">PLANEAR</div>
                                <div class="iso-kpi-sub">de 25 puntos</div>
                                <div class="small fw-bold" style="color:#102963">
                                    @(25 > 0 ? (_stats.PtsPlanear / 25 * 100).ToString("F0") : "0")%
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="iso-kpi-card" style="border-color:#1a5c1a">
                            <div class="iso-kpi-icon" style="background:#e8f5e9;color:#1a5c1a">
                                <i class="bi-h-circle-fill"></i>
                            </div>
                            <div>
                                <div class="iso-kpi-val" style="color:#1a5c1a">
                                    @_stats.PtsHacer.ToString("F2")
                                </div>
                                <div class="iso-kpi-lbl">HACER</div>
                                <div class="iso-kpi-sub">de 60 puntos</div>
                                <div class="small fw-bold" style="color:#1a5c1a">
                                    @(_stats.PtsHacer / 60 * 100).ToString("F0")%
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="iso-kpi-card" style="border-color:#7a5a00">
                            <div class="iso-kpi-icon" style="background:#fff8e1;color:#7a5a00">
                                <i class="bi-v-circle-fill"></i>
                            </div>
                            <div>
                                <div class="iso-kpi-val" style="color:#7a5a00">
                                    @_stats.PtsVerificar.ToString("F2")
                                </div>
                                <div class="iso-kpi-lbl">VERIFICAR</div>
                                <div class="iso-kpi-sub">de 5 puntos</div>
                                <div class="small fw-bold" style="color:#7a5a00">
                                    @(_stats.PtsVerificar / 5 * 100).ToString("F0")%
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="iso-kpi-card" style="border-color:#8B0000">
                            <div class="iso-kpi-icon" style="background:#fce4e4;color:#8B0000">
                                <i class="bi-a-circle-fill"></i>
                            </div>
                            <div>
                                <div class="iso-kpi-val" style="color:#8B0000">
                                    @_stats.PtsActuar.ToString("F2")
                                </div>
                                <div class="iso-kpi-lbl">ACTUAR</div>
                                <div class="iso-kpi-sub">de 10 puntos</div>
                                <div class="small fw-bold" style="color:#8B0000">
                                    @(_stats.PtsActuar / 10 * 100).ToString("F0")%
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Gráficas -->
                <div class="row g-3 mb-3">
                    <div class="col-lg-7">
                        <div class="iso-dash-card">
                            <div class="iso-chart-title">Puntuación por Estándar (I–VII)</div>
                            <div class="position-relative" style="min-height:240px">
                                <canvas id="chartClausula"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="iso-dash-card d-flex flex-column">
                            <div class="iso-chart-title">Distribución de Ítems</div>
                            <div class="position-relative flex-grow-1" style="min-height:300px">
                                <canvas id="chartEstados"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="iso-dash-card">
                            <div class="iso-chart-title">Seguimiento de Acciones</div>
                            <div class="position-relative" style="height:200px;max-width:520px;margin:0 auto">
                                <canvas id="chartSeguimiento"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>

    <!-- TABLA DE ESTÁNDARES -->
    <div class="card shadow-sm border-0 iso-checklist-print">
        <div class="card-header" style="background:#E65100;color:#fff">
            <i class="bi-table me-2"></i>Estándares Mínimos Res. 0312:2019 — SG-SST
            <small class="ms-2 opacity-75">(@_items.Count ítems | @_stats.TotalSinEvaluar sin evaluar | @_stats.PuntajeTotal.ToString("F2") / 100 pts)</small>
        </div>
        <div class="card-body p-0">
            <div style="overflow-x:auto">
                <table class="table table-sm table-bordered table-hover mb-0 align-middle" style="min-width:1400px;font-size:.82rem">
                    <thead style="position:sticky;top:0;z-index:2">
                        <tr>
                            <th style="min-width:80px;background:#E65100;color:#fff">Estándar</th>
                            <th style="min-width:280px;background:#E65100;color:#fff">Requisito</th>
                            <th style="min-width:130px;background:#E65100;color:#fff">Cumplimiento</th>
                            <th style="min-width:80px;background:#E65100;color:#fff;text-align:center">Puntos</th>
                            <th style="min-width:160px;background:#E65100;color:#fff">Evidencia</th>
                            <th style="min-width:180px;background:#E65100;color:#fff">Hallazgo</th>
                            <th style="min-width:180px;background:#E65100;color:#fff">Oportunidad de Mejora</th>
                            <th style="min-width:130px;background:#E65100;color:#fff">Responsable</th>
                            <th style="min-width:120px;background:#E65100;color:#fff">Plazo</th>
                            <th style="min-width:120px;background:#E65100;color:#fff">Seguimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            string? phvaActual   = null;
                            string? grupoActual  = null;
                            string? subActual    = null;
                        }
                        @foreach (var item in _items)
                        {
                            var req    = Resolucion0312ChecklistData.GetById(item.NumeroRequisito);
                            var phvaKey = Resolucion0312ChecklistData.GetPhvaKey(item.Clausula);
                            var tituloPhva = req?.TituloPhva ?? "";
                            var tituloGrupo = _titulosGrupo.TryGetValue(item.Clausula, out var tg) ? tg : item.Clausula;
                            var peso = req?.Peso ?? 0m;

                            @if (tituloPhva != phvaActual && !string.IsNullOrEmpty(tituloPhva))
                            {
                                phvaActual  = tituloPhva;
                                grupoActual = null;
                                subActual   = null;
                                <tr style="background:@ColorPhva(phvaKey);color:#fff">
                                    <td colspan="10" class="py-2 px-3 fw-bold" style="font-size:.95rem;letter-spacing:.3px">
                                        @tituloPhva
                                    </td>
                                </tr>
                            }
                            @if (tituloGrupo != grupoActual)
                            {
                                grupoActual = tituloGrupo;
                                subActual   = null;
                                <tr style="background:#111921;color:#fff">
                                    <td colspan="10" class="py-2 px-3 fw-semibold small">
                                        @tituloGrupo
                                    </td>
                                </tr>
                            }
                            @if (item.TituloClausula != subActual)
                            {
                                subActual = item.TituloClausula;
                                <tr style="background:#fff3e0">
                                    <td colspan="10" class="py-2 px-3 fw-bold small" style="color:#E65100">
                                        <i class="bi-bookmark-fill me-2" style="color:#E65100"></i>@item.TituloClausula
                                    </td>
                                </tr>
                            }

                            <tr class="@(item.Estado == EstadoCumplimiento.NoCumple ? "table-danger" : item.Estado == EstadoCumplimiento.EnProceso ? "table-warning" : "")">
                                <td class="text-center">
                                    <span class="fw-bold" style="color:#E65100;font-size:.9rem">@item.NumeroRequisito</span><br>
                                    <span class="badge" style="background:#E65100;font-size:.7rem">@peso.ToString("G4") pts</span>
                                </td>
                                <td class="small">
                                    <div class="d-flex align-items-start gap-1">
                                        <button class="iso-foco flex-shrink-0 mt-1"
                                                title="Ver interpretación"
                                                @onclick="() => AbrirModalInterp(item)"
                                                type="button">💡</button>
                                        <span>@item.DescripcionRequisito</span>
                                    </div>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm @ClaseBadgeSelect(item.Estado)"
                                            value="@((int)item.Estado)"
                                            @onchange="e => OnEstadoChanged(item, e)">
                                        <option value="5">Sin evaluar</option>
                                        <option value="0">✅ Cumple (@peso.ToString("G4") pts)</option>
                                        <option value="4">🔄 En proceso (@(peso/2m).ToString("G4") pts)</option>
                                        <option value="1">❌ No cumple (0 pts)</option>
                                    </select>
                                </td>
                                <td class="text-center fw-bold" style="font-size:.9rem;color:@PuntajeColor(item)">
                                    @item.Puntaje.ToString("G4")
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <button class="iso-foco" title="Ver documentos auditables"
                                                @onclick="() => AbrirModalDocs(item)" type="button">💡</button>
                                        @if (!string.IsNullOrEmpty(item.EvidenciaUrl))
                                        {
                                            <a href="@item.EvidenciaUrl" target="_blank"
                                               class="btn btn-xs btn-outline-warning"
                                               style="font-size:.7rem;padding:1px 6px">
                                                <i class="bi-file-earmark-arrow-down me-1"></i>Ver
                                            </a>
                                            <button class="btn btn-xs btn-outline-danger"
                                                    style="font-size:.7rem;padding:1px 6px"
                                                    @onclick="() => EliminarEvidenciaItem(item)" type="button">
                                                <i class="bi-x"></i>
                                            </button>
                                        }
                                    </div>
                                    <InputFile OnChange="@(async e => await SubirEvidenciaAsync(item, e))"
                                               class="form-control form-control-sm"
                                               accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx"
                                               style="font-size:.7rem" />
                                </td>
                                <td>
                                    <textarea class="form-control form-control-sm" rows="2"
                                              style="resize:vertical;min-height:40px"
                                              placeholder="Hallazgo encontrado..."
                                              value="@item.Hallazgo"
                                              @onchange="e => item.Hallazgo = e.Value?.ToString()">
                                    </textarea>
                                </td>
                                <td>
                                    <textarea class="form-control form-control-sm" rows="2"
                                              style="resize:vertical;min-height:40px"
                                              placeholder="Oportunidad de mejora..."
                                              value="@item.OportunidadMejora"
                                              @onchange="e => item.OportunidadMejora = e.Value?.ToString()">
                                    </textarea>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Responsable..."
                                           value="@item.Responsable"
                                           @onchange="e => item.Responsable = e.Value?.ToString()" />
                                </td>
                                <td>
                                    <input type="date" class="form-control form-control-sm"
                                           value="@(item.Plazo.HasValue ? item.Plazo.Value.ToString("yyyy-MM-dd") : "")"
                                           @onchange="e => OnPlazoChanged(item, e)" />
                                </td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            value="@((int)item.Seguimiento)"
                                            @onchange="e => OnSeguimientoChanged(item, e)">
                                        <option value="0">⏳ Pendiente</option>
                                        <option value="1">🔄 En proceso</option>
                                        <option value="2">✅ Ejecutado</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center bg-light">
            <small class="text-muted">
                @_items.Count ítems —
                @_stats.TotalCumple cumple —
                @_stats.TotalEnProceso en proceso —
                @_stats.TotalNoCumple no cumple —
                @_stats.TotalSinEvaluar sin evaluar —
                <strong>@_stats.PuntajeTotal.ToString("F2") / 100 pts</strong>
            </small>
            <button type="button" class="btn btn-sm text-white" style="background:#E65100"
                    @onclick="() => GuardarAsync(EstadoAuditoria.EnProceso)" disabled="@_guardando">
                <i class="bi-save me-1"></i>Guardar cambios
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId  { get; set; }
    [Parameter] public int AuditoriaId { get; set; }

    private bool _modoDetalle => AuditoriaId > 0;
    private Proyecto? _proyecto;

    private List<ChecklistAuditoria> _auditorias = [];
    private bool _mostrarFormNueva;
    private int? _confirmandoEliminar;
    private string _busquedaListado = "";
    private FormNueva _formNueva = new();

    private ChecklistAuditoria? _auditoria;
    private List<ItemChecklist> _items = [];
    private Res0312Stats _stats = new();
    private bool _dashboardVisible = true;
    private bool _graficosRenderizados;

    private bool _modalVisible;
    private string _modalTitle = "";
    private string _modalBodyText = "";
    private string[]? _modalDocs;
    private bool _modalEsDocs;

    private bool _guardando;
    private string? _mensajeExito;
    private string? _mensajeError;
    private string? _mensajeListado;

    private string BarraPct =>
        (_stats.PuntajeTotal).ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static readonly Dictionary<string, string> _titulosGrupo =
        Resolucion0312ChecklistData.Requisitos
            .GroupBy(r => r.NumGrupo)
            .ToDictionary(g => g.Key, g => g.First().TituloGrupo);

    private string EstadoUltimaAuditoria =>
        _auditorias.Any()
            ? BadgeEstadoPts((double)_auditorias[0].PorcentajeCumplimiento)
            : "Sin datos";

    private IEnumerable<ChecklistAuditoria> AuditoriasFiltradas =>
        _auditorias.Where(a =>
            string.IsNullOrEmpty(_busquedaListado) ||
            a.Auditor.Contains(_busquedaListado, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }

        if (_modoDetalle) await CargarDetalleAsync();
        else await CargarListadoAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_modoDetalle && _dashboardVisible && !_graficosRenderizados && _items.Count > 0)
        {
            _graficosRenderizados = true;
            await RenderizarGraficosAsync();
        }
    }

    private async Task CargarListadoAsync()
    {
        _graficosRenderizados = false;
        _mensajeListado = null;
        _auditorias = await Db.ChecklistsAuditoria
            .Where(c => c.ProyectoId == ProyectoId
                     && c.Division   == DivisionHSEQ.Seguridad
                     && c.NormaISO   == "Res. 0312:2019")
            .OrderByDescending(c => c.FechaAuditoria)
            .ToListAsync();
    }

    private async Task CargarDetalleAsync()
    {
        _graficosRenderizados = false;
        _auditoria = await Db.ChecklistsAuditoria
            .Include(a => a.Items.OrderBy(i => i.Id))
            .FirstOrDefaultAsync(a => a.Id == AuditoriaId && a.ProyectoId == ProyectoId);

        if (_auditoria is null)
        {
            Navigation.NavigateTo($"/proyectos/{ProyectoId}/hseq/seguridad/resolucion0312");
            return;
        }
        _items = _auditoria.Items.ToList();
        RecalcularEstadisticas();
    }

    private void MostrarFormNueva()
    {
        _formNueva = new FormNueva { FechaAuditoria = DateTime.Today };
        _mostrarFormNueva = true;
    }

    private void CancelarFormNueva() => _mostrarFormNueva = false;
    private void OnBusquedaListado(string v) => _busquedaListado = v;

    private async Task CrearAuditoriaAsync()
    {
        _guardando = true;
        try
        {
            var auditoria = new ChecklistAuditoria
            {
                ProyectoId      = ProyectoId,
                Division        = DivisionHSEQ.Seguridad,
                NormaISO        = "Res. 0312:2019",
                Auditor         = _formNueva.Auditor,
                FechaAuditoria  = _formNueva.FechaAuditoria,
                EstadoAuditoria = _formNueva.Estado,
                Observaciones   = _formNueva.Observaciones
            };

            foreach (var req in Resolucion0312ChecklistData.Requisitos)
            {
                auditoria.Items.Add(new ItemChecklist
                {
                    Clausula             = req.NumGrupo,
                    TituloClausula       = req.SubClausula,
                    NumeroRequisito      = req.Id,
                    DescripcionRequisito = req.Req,
                    Estado               = EstadoCumplimiento.SinEvaluar,
                    Puntaje              = 0
                });
            }

            Db.ChecklistsAuditoria.Add(auditoria);
            await Db.SaveChangesAsync();
            Navigation.NavigateTo($"/proyectos/{ProyectoId}/hseq/seguridad/resolucion0312/{auditoria.Id}");
        }
        catch (Exception ex)
        {
            _mensajeError = $"Error al crear: {ex.Message}";
        }
        finally { _guardando = false; }
    }

    private async Task EliminarAsync(int id)
    {
        var ent = await Db.ChecklistsAuditoria.FindAsync(id);
        if (ent is not null) { Db.ChecklistsAuditoria.Remove(ent); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarListadoAsync();
    }

    private void AbrirModalInterp(ItemChecklist item)
    {
        var req = Resolucion0312ChecklistData.GetById(item.NumeroRequisito);
        _modalTitle    = $"💡 Interpretación — Estándar {item.NumeroRequisito}";
        _modalBodyText = req?.Interp ?? "No se encontró interpretación para este estándar.";
        _modalDocs     = null;
        _modalEsDocs   = false;
        _modalVisible  = true;
    }

    private void AbrirModalDocs(ItemChecklist item)
    {
        var req = Resolucion0312ChecklistData.GetById(item.NumeroRequisito);
        _modalTitle    = $"📄 Documentos auditables — {item.NumeroRequisito}";
        _modalDocs     = req?.Docs;
        _modalBodyText = req is null ? "No se encontraron documentos para este estándar." : "";
        _modalEsDocs   = true;
        _modalVisible  = true;
    }

    private void CerrarModal() => _modalVisible = false;

    private void OnEstadoChanged(ItemChecklist item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            item.Estado = (EstadoCumplimiento)v;
            var peso = Resolucion0312ChecklistData.GetPeso(item.NumeroRequisito);
            item.Puntaje = item.Estado switch
            {
                EstadoCumplimiento.Cumple    => peso,
                EstadoCumplimiento.EnProceso => peso / 2m,
                EstadoCumplimiento.Parcial   => peso / 2m,
                _                            => 0m
            };
        }
        RecalcularEstadisticas();
        _graficosRenderizados = false;
    }

    private void OnPlazoChanged(ItemChecklist item, ChangeEventArgs e)
    {
        item.Plazo = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null;
    }

    private void OnSeguimientoChanged(ItemChecklist item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            item.Seguimiento = (EstadoSeguimiento)v;
        RecalcularEstadisticas();
    }

    private void EliminarEvidenciaItem(ItemChecklist item)
    {
        ChecklistSvc.EliminarEvidencia(item.EvidenciaUrl);
        item.EvidenciaUrl = null;
    }

    private async Task SubirEvidenciaAsync(ItemChecklist item, InputFileChangeEventArgs e)
    {
        try
        {
            item.EvidenciaUrl = await ChecklistSvc.GuardarEvidenciaAsync(e.File, ProyectoId);
            _mensajeExito = $"Evidencia '{e.File.Name}' subida correctamente.";
        }
        catch (Exception ex) { _mensajeError = $"Error al subir evidencia: {ex.Message}"; }
    }

    private async Task GuardarAsync(EstadoAuditoria nuevoEstado)
    {
        _guardando = true;
        _mensajeExito = null;
        _mensajeError = null;
        try
        {
            _auditoria!.EstadoAuditoria = nuevoEstado;
            _auditoria.PorcentajeCumplimiento = (decimal)_stats.PuntajeTotal;
            _auditoria.FechaModificacion = DateTime.UtcNow;
            await Db.SaveChangesAsync();
            _mensajeExito = nuevoEstado == EstadoAuditoria.Borrador
                ? "Borrador guardado."
                : "Cambios guardados.";
        }
        catch (Exception ex) { _mensajeError = $"Error: {ex.Message}"; }
        finally { _guardando = false; }
    }

    private async Task FinalizarAsync()
    {
        await GuardarAsync(EstadoAuditoria.Finalizada);
        if (_mensajeError is null) _mensajeExito = "Auditoría finalizada correctamente.";
    }

    private async Task ImprimirAsync() => await JS.InvokeVoidAsync("window.print");

    private async Task ExportarExcelListadoAsync(int id)
    {
        try
        {
            var aud = await Db.ChecklistsAuditoria.Include(a => a.Items).FirstOrDefaultAsync(a => a.Id == id);
            if (aud is null) return;
            var bytes = ChecklistSvc.GenerarCsvExcel(aud);
            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile",
                $"Res0312_{aud.FechaAuditoria:yyyyMMdd}_{aud.Auditor.Replace(" ", "_")}.csv",
                "text/csv;charset=utf-8;", b64);
        }
        catch (Exception ex) { _mensajeListado = $"Error al exportar: {ex.Message}"; }
    }

    private async Task ExportarExcelAsync(int id)
    {
        try
        {
            var aud = await Db.ChecklistsAuditoria.Include(a => a.Items).FirstOrDefaultAsync(a => a.Id == id);
            if (aud is null) return;
            var bytes = ChecklistSvc.GenerarCsvExcel(aud);
            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile",
                $"Res0312_{aud.FechaAuditoria:yyyyMMdd}_{aud.Auditor.Replace(" ", "_")}.csv",
                "text/csv;charset=utf-8;", b64);
        }
        catch (Exception ex) { _mensajeError = $"Error al exportar: {ex.Message}"; }
    }

    private void RecalcularEstadisticas()
    {
        _stats.PuntajeTotal  = (double)_items.Sum(i => (double)i.Puntaje);
        _stats.TotalCumple   = _items.Count(i => i.Estado == EstadoCumplimiento.Cumple);
        _stats.TotalEnProceso= _items.Count(i => i.Estado == EstadoCumplimiento.EnProceso || i.Estado == EstadoCumplimiento.Parcial);
        _stats.TotalNoCumple = _items.Count(i => i.Estado == EstadoCumplimiento.NoCumple);
        _stats.TotalSinEvaluar= _items.Count(i => i.Estado == EstadoCumplimiento.SinEvaluar);

        _stats.PtsPlanear  = (double)_items.Where(i => i.Clausula is "I" or "II").Sum(i => (double)i.Puntaje);
        _stats.PtsHacer    = (double)_items.Where(i => i.Clausula is "III" or "IV" or "V").Sum(i => (double)i.Puntaje);
        _stats.PtsVerificar= (double)_items.Where(i => i.Clausula == "VI").Sum(i => (double)i.Puntaje);
        _stats.PtsActuar   = (double)_items.Where(i => i.Clausula == "VII").Sum(i => (double)i.Puntaje);

        _stats.PorGrupo = _items
            .GroupBy(i => i.Clausula)
            .Select(g => (Grupo: g.Key, Pts: (double)g.Sum(i => (double)i.Puntaje)))
            .OrderBy(x => OrdenGrupo(x.Grupo))
            .ToList();

        _stats.SeguimientoEjecutado = _items.Count(i => i.Seguimiento == EstadoSeguimiento.Ejecutado);
        _stats.SeguimientoEnProceso = _items.Count(i => i.Seguimiento == EstadoSeguimiento.EnProceso);
        _stats.SeguimientoPendiente = _items.Count(i => i.Seguimiento == EstadoSeguimiento.Pendiente);
    }

    private async Task RenderizarGraficosAsync()
    {
        try
        {
            var labels = _stats.PorGrupo.Select(x => x.Grupo).ToArray();
            var data   = _stats.PorGrupo.Select(x => Math.Round(x.Pts, 2)).ToArray();
            await JS.InvokeVoidAsync("renderISO9001Charts",
                Math.Round(_stats.PuntajeTotal, 2),
                labels, data,
                new[] { _stats.TotalCumple, _stats.TotalEnProceso, _stats.TotalNoCumple, _stats.TotalSinEvaluar },
                new[] { _stats.SeguimientoEjecutado, _stats.SeguimientoEnProceso, _stats.SeguimientoPendiente });
        }
        catch { }
    }

    private static int OrdenGrupo(string g) => g switch
    {
        "I" => 1, "II" => 2, "III" => 3, "IV" => 4, "V" => 5, "VI" => 6, "VII" => 7, _ => 8
    };

    private static string ColorPts(double pts) =>
        pts >= 85 ? "#6ABF48" : pts >= 61 ? "#F5B301" : "#E53935";

    private static string ColorPtsBg(double pts) =>
        pts >= 85 ? "#f0f7ea" : pts >= 61 ? "#fffbeb" : "#fef2f2";

    private static string ClasificacionLabel(double pts) =>
        pts >= 85 ? "✅ ACEPTABLE" : pts >= 61 ? "⚠️ MOD. ACEPTABLE" : "🔴 CRÍTICO";

    private static string BadgeEstadoPts(double pts) =>
        pts >= 85 ? "Saludable" : pts >= 61 ? "En Riesgo" : pts > 0 ? "Crítico" : "Sin datos";

    private static string ColorPhva(string key) => key switch
    {
        "planear"   => "#102963",
        "hacer"     => "#1a5c1a",
        "verificar" => "#7a5a00",
        "actuar"    => "#8B0000",
        _           => "#333"
    };

    private string PuntajeColor(ItemChecklist item) => item.Estado switch
    {
        EstadoCumplimiento.Cumple    => "#6ABF48",
        EstadoCumplimiento.EnProceso => "#d97706",
        EstadoCumplimiento.Parcial   => "#d97706",
        EstadoCumplimiento.NoCumple  => "#E53935",
        _                            => "#9CA3AF"
    };

    private static string BadgeEstadoAuditoria(EstadoAuditoria e) => e switch
    {
        EstadoAuditoria.Finalizada => "bg-success",
        EstadoAuditoria.EnProceso  => "bg-warning text-dark",
        _                          => "bg-secondary"
    };

    private static string LabelEstadoAuditoria(EstadoAuditoria e) => e switch
    {
        EstadoAuditoria.Finalizada => "Finalizada",
        EstadoAuditoria.EnProceso  => "En Proceso",
        _                          => "Borrador"
    };

    private static string ClaseBadgeSelect(EstadoCumplimiento e) => e switch
    {
        EstadoCumplimiento.Cumple    => "border-success text-success",
        EstadoCumplimiento.NoCumple  => "border-danger text-danger",
        EstadoCumplimiento.EnProceso => "border-warning text-warning",
        EstadoCumplimiento.Parcial   => "border-warning text-warning",
        _                            => ""
    };

    private sealed class FormNueva
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El auditor es obligatorio")]
        public string Auditor { get; set; } = "";
        public DateTime FechaAuditoria { get; set; } = DateTime.Today;
        public EstadoAuditoria Estado { get; set; } = EstadoAuditoria.Borrador;
        public string? Observaciones { get; set; }
    }

    private sealed class Res0312Stats
    {
        public double PuntajeTotal { get; set; }
        public int TotalCumple { get; set; }
        public int TotalEnProceso { get; set; }
        public int TotalNoCumple { get; set; }
        public int TotalSinEvaluar { get; set; }
        public double PtsPlanear { get; set; }
        public double PtsHacer { get; set; }
        public double PtsVerificar { get; set; }
        public double PtsActuar { get; set; }
        public int SeguimientoEjecutado { get; set; }
        public int SeguimientoEnProceso { get; set; }
        public int SeguimientoPendiente { get; set; }
        public List<(string Grupo, double Pts)> PorGrupo { get; set; } = [];
    }
}
