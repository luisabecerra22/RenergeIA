@page "/proyectos/{ProyectoId:int}/hseq/seguridad/acciones"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>Acciones Correctivas SST — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <a href="/proyectos/@ProyectoId/hseq/seguridad" class="btn btn-sm btn-outline-secondary">&larr; Seguridad</a>
        <div class="flex-grow-1">
            <h1 class="h4 mb-0"><i class="bi-wrench-adjustable-circle me-2" style="color:#183963"></i>Acciones Correctivas SST</h1>
            <small class="text-muted">@_proyecto.Nombre</small>
        </div>
    </div>

    <div class="alert alert-info border-0 shadow-sm mb-4">
        <i class="bi-info-circle me-2"></i>
        Las acciones correctivas se generan desde los hallazgos registrados en <strong>No Conformidades / Inspecciones SST</strong>.
        <a href="/proyectos/@ProyectoId/hseq/seguridad/inspecciones" class="alert-link ms-1">Ir a Inspecciones SST →</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-primary">
                <div class="fw-bold" style="font-size:2rem;color:#183963">@_acciones.Count</div>
                <div class="text-muted small">Total acciones SST</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-success">
                <div class="fw-bold" style="font-size:2rem;color:#6ABF4B">@_acciones.Count(a => a.Estado == EstadoNoConformidad.Cerrada)</div>
                <div class="text-muted small">Acciones cerradas</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-warning">
                <div class="fw-bold" style="font-size:2rem;color:#ffc107">@_acciones.Count(a => a.Estado == EstadoNoConformidad.EnImplementacion)</div>
                <div class="text-muted small">En proceso</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-danger">
                <div class="fw-bold" style="font-size:2rem;color:#dc3545">@_acciones.Count(a => a.FechaCompromiso < DateTime.Today && a.Estado != EstadoNoConformidad.Cerrada)</div>
                <div class="text-muted small">Vencidas</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Descripción</th>
                        <th>Responsable</th>
                        <th>Plazo</th>
                        <th class="text-center">Avance</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_acciones.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4">
                            <i class="bi-check-circle text-success d-block mb-2" style="font-size:2rem"></i>
                            <span class="text-muted">No hay acciones correctivas SST registradas. <a href="/proyectos/@ProyectoId/hseq/seguridad/inspecciones">Ir a Inspecciones SST</a></span>
                        </td></tr>
                    }
                    @foreach (var a in _acciones.OrderBy(x => x.FechaCompromiso))
                    {
                        var vencida = a.FechaCompromiso < DateTime.Today && a.Estado != EstadoNoConformidad.Cerrada;
                        <tr class="@(vencida ? "table-danger" : "")">
                            <td>
                                <div>@a.Descripcion</div>
                                <div class="text-muted small">@a.HallazgoHSEQ?.Titulo</div>
                            </td>
                            <td class="small">@a.Responsable</td>
                            <td class="small @(vencida ? "text-danger fw-bold" : "")">@a.FechaCompromiso.ToString("dd/MM/yyyy")</td>
                            <td class="text-center" style="min-width:120px">
                                <div class="progress" style="height:8px;border-radius:4px">
                                    <div class="progress-bar @(a.AvancePorcentaje >= 100 ? "bg-success" : "bg-primary")" style="width:@a.AvancePorcentaje%"></div>
                                </div>
                                <small class="text-muted">@a.AvancePorcentaje%</small>
                            </td>
                            <td class="text-center">
                                <span class="badge @BadgeAccion(a.Estado)">@EnumDisplay.Mostrar(a.Estado)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<AccionHSEQ> _acciones = [];

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        _acciones = await Db.AccionesHSEQ
            .Include(a => a.HallazgoHSEQ)
            .Where(a => a.HallazgoHSEQ != null && a.HallazgoHSEQ.ProyectoId == ProyectoId && a.HallazgoHSEQ.Division == DivisionHSEQ.Seguridad)
            .OrderBy(a => a.FechaCompromiso)
            .ToListAsync();
    }

    private static string BadgeAccion(EstadoNoConformidad e) => e switch
    {
        EstadoNoConformidad.Cerrada          => "bg-success",
        EstadoNoConformidad.EnImplementacion => "bg-primary",
        EstadoNoConformidad.Abierta          => "bg-warning text-dark",
        _                                    => "bg-secondary"
    };
}
