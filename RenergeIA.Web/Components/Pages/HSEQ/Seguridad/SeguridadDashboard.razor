@page "/proyectos/{ProyectoId:int}/hseq/seguridad"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>Seguridad — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <a href="/proyectos/@ProyectoId/hseq" class="btn btn-sm btn-outline-secondary">&larr; HSEQ</a>
        <div class="flex-grow-1">
            <h1 class="h3 mb-0"><i class="bi-shield-exclamation me-2 text-danger"></i>Dashboard Seguridad — ISO 45001</h1>
            <small class="text-muted">@_proyecto.Nombre &bull; @DateTime.Now.ToString("MMMM yyyy")</small>
        </div>
        @{ var (badgeCss, badgeTxt) = _cumplimientoGeneral >= 80 ? ("bg-success","Cumple") : _cumplimientoGeneral >= 60 ? ("bg-warning text-dark","En Riesgo") : ("bg-danger","Crítico"); }
        <span class="badge @badgeCss fs-6 px-3 py-2">@badgeTxt — @_cumplimientoGeneral%</span>
    </div>

    <NavSeguridad ProyectoId="@ProyectoId" TabActiva="dashboard" />

    <!-- ── Resumen General — Gauges circulares ─────────────────────────────── -->
    <SeccionDash Titulo="Resumen General de Seguridad" Icono="bi-speedometer2">
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 mb-2">
            @foreach (var g in _gauges)
            {
                <div class="col">
                    <GaugeCircular Titulo="@g.Titulo"
                                   ValorCentral="@g.ValorCentral"
                                   SubTexto="@g.SubTexto"
                                   Porcentaje="@g.Porcentaje"
                                   Estado="@g.Estado"
                                   Color="@g.Color" />
                </div>
            }
        </div>
    </SeccionDash>

    <!-- Acceso rápido al Plan de Trabajo -->
    <div class="mb-4">
        <a href="/proyectos/@ProyectoId/hseq/seguridad/plan-trabajo"
           class="btn btn-outline-primary btn-sm">
            <i class="bi-calendar3 me-1"></i>Ver detalle del Plan de Trabajo
        </a>
    </div>

    <!-- ── Actividades vencidas ─────────────────────────────────────────────── -->
    @if (_actividadesVencidas.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-danger text-white d-flex align-items-center gap-2">
                <i class="bi-exclamation-triangle-fill"></i>
                <strong>Actividades Vencidas del Plan de Trabajo (@_actividadesVencidas.Count)</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr><th>Actividad</th><th>Tipo</th><th>Responsable</th><th>F. Planificada</th><th>Estado</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _actividadesVencidas.Take(10))
                        {
                            <tr>
                                <td>@a.Actividad</td>
                                <td class="text-muted">@a.TipoIntervencion</td>
                                <td>@(a.Responsable ?? "—")</td>
                                <td class="text-danger fw-bold">@a.FechaPlanificada.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-danger">Vencida</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    private Proyecto? _proyecto;

    private record Gauge(
        string Titulo,
        string ValorCentral,
        string SubTexto,
        int    Porcentaje,
        string Color,
        string Estado
    );

    private List<Gauge>          _gauges               = [];
    private List<PlanTrabajoHSE> _actividadesVencidas  = [];
    private int  _cumplimientoGeneral;
    // Datos del Plan (para el gauge del dashboard)
    private int _planTotal, _planEjec, _cumPlan;

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        var hoy  = DateTime.Today;
        var mes  = hoy.Month;
        var anio = hoy.Year;

        // ── Plan de Trabajo ──────────────────────────────────────────────────
        var plan  = await Db.PlanesTrabajoHSE.Where(p => p.ProyectoId == ProyectoId).ToListAsync();
        _planTotal = plan.Count;
        _planEjec  = plan.Count(p => p.Estado == EstadoPlanTrabajo.Ejecutada);
        _cumPlan   = _planTotal > 0 ? (int)Math.Round(_planEjec * 100.0 / _planTotal) : 0;
        _actividadesVencidas = plan
            .Where(p => p.FechaPlanificada < hoy && p.Estado != EstadoPlanTrabajo.Ejecutada && p.Estado != EstadoPlanTrabajo.Cancelada)
            .OrderBy(p => p.FechaPlanificada).ToList();

        // ── Inspecciones ─────────────────────────────────────────────────────
        var insp     = await Db.InspeccionesSST.Where(i => i.ProyectoId == ProyectoId).ToListAsync();
        var acciones = await Db.AccionesHSEQ.Include(a => a.HallazgoHSEQ)
            .Where(a => a.HallazgoHSEQ != null
                     && a.HallazgoHSEQ.ProyectoId == ProyectoId
                     && a.HallazgoHSEQ.Division   == DivisionHSEQ.Seguridad)
            .ToListAsync();
        int inspSST      = insp.Count(i => i.Tipo == "Seguridad");
        int inspOTS      = insp.Count(i => i.Tipo == "OTS");
        int inspSTC      = insp.Count(i => i.Tipo == "STC");
        int hallazgos    = Math.Max(0, insp.Sum(i => i.HallazgosEncontrados - i.HallazgosCerrados));
        int accionesVenc = acciones.Count(a => a.Estado != EstadoNoConformidad.Cerrada && a.FechaCompromiso < hoy);

        // ── EPP / Dotación ───────────────────────────────────────────────────
        var epp      = await Db.EntregasEPP.Where(e => e.ProyectoId == ProyectoId).ToListAsync();
        int eppTotal = epp.Count;
        int eppAlDia = epp.Count(e => !e.FechaVencimiento.HasValue || e.FechaVencimiento >= hoy.AddDays(30));
        int cumEPP   = eppTotal > 0 ? (int)Math.Round(eppAlDia * 100.0 / eppTotal) : 0;

        // ── Pausas Activas ───────────────────────────────────────────────────
        var pausas    = await Db.PausasActivas
            .Where(p => p.ProyectoId == ProyectoId && p.Mes == mes && p.Anio == anio).ToListAsync();
        int promPausas = pausas.Any() ? (int)Math.Round(pausas.Average(p => p.CantidadPausas)) : 0;
        int cumPausas  = pausas.Any() ? Math.Min(100, (int)Math.Round(pausas.Average(p => p.CantidadPausas) * 100.0 / 60)) : 0;

        // ── Capacitaciones ───────────────────────────────────────────────────
        var capPlan = await Db.CapacitacionesPlanificadas.Where(c => c.ProyectoId == ProyectoId).ToListAsync();
        var capReal = await Db.Capacitaciones.Where(c => c.ProyectoId == ProyectoId).ToListAsync();
        int capEjec = capReal.Count(c => c.Estado == EstadoPlanTrabajo.Ejecutada);
        int cumCap  = capPlan.Count > 0 ? (int)Math.Round(capEjec * 100.0 / capPlan.Count) : 0;

        // ── ISO 45001 / Incidentes ───────────────────────────────────────────
        var eventos  = await Db.IncidentesAccidentes.Where(i => i.ProyectoId == ProyectoId).ToListAsync();
        var checkISO = await Db.ChecklistsAuditoria
            .Where(c => c.ProyectoId == ProyectoId && c.NormaISO == "ISO 45001:2018").ToListAsync();
        int incidentes = eventos.Count(e => e.Tipo == TipoIncidente.Incidente || e.Tipo == TipoIncidente.CasiAccidente);
        int accidentes = eventos.Count(e => e.Tipo == TipoIncidente.AccidenteLeve || e.Tipo == TipoIncidente.AccidenteGrave || e.Tipo == TipoIncidente.AccidenteFatal);
        int cumISO     = checkISO.Any() ? (int)Math.Round((double)checkISO.Average(c => c.PorcentajeCumplimiento)) : 0;

        // ── Cumplimiento general ─────────────────────────────────────────────
        _cumplimientoGeneral = new[] { _cumPlan, cumCap, cumISO, cumPausas }
            .Where(v => v > 0).DefaultIfEmpty(0).Sum()
            / Math.Max(1, new[] { _cumPlan, cumCap, cumISO, cumPausas }.Count(v => v > 0));

        // ── Construir gauges ─────────────────────────────────────────────────
        _gauges =
        [
            // 1 · Plan de Trabajo
            new(
                "Plan de Trabajo",
                _planTotal > 0 ? $"{_cumPlan}%"  : "—",
                _planTotal > 0 ? $"{_planEjec} de {_planTotal} act." : "sin actividades",
                _cumPlan,
                _planTotal  > 0 ? Cpct(_cumPlan) : "#adb5bd",
                _planTotal  > 0 ? Epct(_cumPlan) : "Informativo"
            ),
            // 2 · Inspecciones SST
            new(
                "Insp. Seguridad",
                inspSST.ToString(),
                inspSST == 1 ? "inspección" : "inspecciones",
                Math.Min(100, inspSST),
                "#183963",
                "Informativo"
            ),
            // 3 · OTS
            new(
                "OTS",
                inspOTS.ToString(),
                inspOTS == 1 ? "observación" : "observaciones",
                Math.Min(100, inspOTS),
                "#183963",
                "Informativo"
            ),
            // 4 · STC
            new(
                "STC",
                inspSTC.ToString(),
                inspSTC == 1 ? "observación" : "observaciones",
                Math.Min(100, inspSTC),
                "#183963",
                "Informativo"
            ),
            // 5 · Hallazgos Abiertos  (0 = bueno → verde lleno)
            new(
                "Hallazgos Abiertos",
                hallazgos.ToString(),
                hallazgos == 0 ? "sin hallazgos" : "por cerrar",
                hallazgos == 0 ? 100 : Math.Max(5, 100 - hallazgos * 4),
                hallazgos == 0 ? "#6ABF4B" : "#dc3545",
                hallazgos == 0 ? "Saludable" : "Crítico"
            ),
            // 6 · Acciones Vencidas  (0 = bueno → verde lleno)
            new(
                "Acciones Vencidas",
                accionesVenc.ToString(),
                accionesVenc == 0 ? "al día" : "vencidas",
                accionesVenc == 0 ? 100 : Math.Max(5, 100 - accionesVenc * 8),
                accionesVenc == 0 ? "#6ABF4B" : "#dc3545",
                accionesVenc == 0 ? "Saludable" : "Crítico"
            ),
            // 7 · EPP / Dotación
            new(
                "EPP / Dotación",
                eppTotal > 0 ? $"{cumEPP}%"  : "—",
                $"{eppAlDia} de {eppTotal} entregas",
                cumEPP,
                eppTotal > 0 ? Cpct(cumEPP) : "#adb5bd",
                eppTotal > 0 ? Epct(cumEPP) : "Informativo"
            ),
            // 8 · Pausas Activas
            new(
                "Pausas Activas",
                pausas.Any() ? $"{cumPausas}%" : "—",
                pausas.Any() ? $"prom. {promPausas} / 60 pausas" : "sin registros",
                cumPausas,
                !pausas.Any() ? "#adb5bd" : cumPausas >= 100 ? "#6ABF4B" : cumPausas >= 70 ? "#ffc107" : "#dc3545",
                !pausas.Any() ? "Informativo" : cumPausas >= 100 ? "Saludable" : cumPausas >= 70 ? "En Riesgo" : "Crítico"
            ),
            // 9 · Capacitaciones
            new(
                "Capacitaciones",
                capPlan.Count > 0 ? $"{cumCap}%"  : "—",
                $"{capEjec} de {capPlan.Count} ejec.",
                cumCap,
                capPlan.Count > 0 ? Cpct(cumCap) : "#adb5bd",
                capPlan.Count > 0 ? Epct(cumCap)  : "Informativo"
            ),
            // 10 · ISO 45001
            new(
                "ISO 45001",
                checkISO.Any() ? $"{cumISO}%" : "—",
                checkISO.Any() ? "cumplimiento" : "sin auditorías",
                cumISO,
                checkISO.Any() ? Cpct(cumISO) : "#adb5bd",
                checkISO.Any() ? Epct(cumISO)  : "Informativo"
            ),
        ];
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static string Cpct(int pct) =>
        pct >= 80 ? "#6ABF4B" : pct >= 60 ? "#ffc107" : "#dc3545";

    private static string Epct(int pct) =>
        pct >= 80 ? "Saludable" : pct >= 60 ? "En Riesgo" : "Crítico";
}
