@page "/proyectos/{ProyectoId:int}/hseq/seguridad/matriz"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums
@using Microsoft.EntityFrameworkCore

<PageTitle>Matriz de Riesgos — @(_proyecto?.Nombre ?? "")</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted p-4">Cargando...</p>
}
else
{
    <PageHeader Titulo="Matriz de Riesgos SST"
                Icono="bi-grid-3x3-gap-fill"
                Subtitulo="@($"{_proyecto!.Nombre} — Identificación, valoración y control de riesgos GTC 45")"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/seguridad")"
                TextoVolver="Seguridad" />

    <NavMatrizRiesgos ProyectoId="@ProyectoId" TabActiva="dashboard" />

    <!-- KPI cards principales -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3 h-100" style="border-left:4px solid #C0392B!important">
                <div class="fw-bold" style="font-size:2rem;color:#C0392B">@_totalRiesgos</div>
                <div class="small text-muted">Riesgos en Matriz</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3 h-100" style="border-left:4px solid #E65100!important">
                <div class="fw-bold" style="font-size:2rem;color:#E65100">@_criticos</div>
                <div class="small text-muted">Críticos / No Aceptables</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3 h-100" style="border-left:4px solid #6ABF48!important">
                <div class="fw-bold" style="font-size:2rem;color:#6ABF48">@_controlados</div>
                <div class="small text-muted">Controlados</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3 h-100" style="border-left:4px solid #183963!important">
                <div class="fw-bold" style="font-size:2rem;color:#183963">@_inspeccionesIA</div>
                <div class="small text-muted">Inspecciones con IA</div>
            </div>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm hover-lift" style="cursor:pointer;transition:.2s"
                 @onclick='() => Navigation.NavigateTo($"/proyectos/{ProyectoId}/hseq/seguridad/matriz/nueva-inspeccion")'>
                <div class="card-body p-4 d-flex align-items-center gap-4">
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:64px;height:64px;background:linear-gradient(135deg,#183963,#2a5298);flex-shrink:0">
                        <i class="bi-cpu-fill text-white fs-2"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 fw-bold" style="color:#183963">Nueva Inspección con IA</h5>
                        <p class="text-muted small mb-0">
                            Fotografía el área de trabajo y obtén identificación automática de peligros con valoración GTC 45.
                        </p>
                    </div>
                    <i class="bi-arrow-right-circle-fill ms-auto fs-4" style="color:#183963;opacity:.4"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm hover-lift" style="cursor:pointer;transition:.2s"
                 @onclick='() => Navigation.NavigateTo($"/proyectos/{ProyectoId}/hseq/seguridad/matriz/iperv")'>
                <div class="card-body p-4 d-flex align-items-center gap-4">
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:64px;height:64px;background:linear-gradient(135deg,#2d6a4f,#40916c);flex-shrink:0">
                        <i class="bi-table text-white fs-2"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 fw-bold" style="color:#2d6a4f">Matriz IPERV</h5>
                        <p class="text-muted small mb-0">
                            Tabla completa de Identificación de Peligros, Evaluación y Valoración de Riesgos.
                        </p>
                    </div>
                    <i class="bi-arrow-right-circle-fill ms-auto fs-4" style="color:#2d6a4f;opacity:.4"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm hover-lift" style="cursor:pointer;transition:.2s"
                 @onclick='() => Navigation.NavigateTo($"/proyectos/{ProyectoId}/hseq/seguridad/matriz/mapa")'>
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <i class="bi-geo-alt-fill fs-2" style="color:#E65100"></i>
                    <div>
                        <div class="fw-bold" style="color:#E65100">Mapa de Riesgos</div>
                        <div class="small text-muted">Visualización por área</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm hover-lift" style="cursor:pointer;transition:.2s"
                 @onclick='() => Navigation.NavigateTo($"/proyectos/{ProyectoId}/hseq/seguridad/matriz/acciones")'>
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <i class="bi-list-check fs-2" style="color:#7B1FA2"></i>
                    <div>
                        <div class="fw-bold" style="color:#7B1FA2">Acciones Correctivas</div>
                        <div class="small text-muted">Gestión y cierre</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm hover-lift" style="cursor:pointer;transition:.2s"
                 @onclick='() => Navigation.NavigateTo($"/proyectos/{ProyectoId}/hseq/seguridad/matriz/biblioteca")'>
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <i class="bi-book-fill fs-2" style="color:#546e7a"></i>
                    <div>
                        <div class="fw-bold" style="color:#546e7a">Biblioteca de Peligros</div>
                        <div class="small text-muted">Solar EPC — GTC 45</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimos riesgos críticos -->
    @if (_ultimosCriticos.Any())
    {
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header fw-bold text-white d-flex align-items-center gap-2" style="background:#C0392B">
                <i class="bi-exclamation-triangle-fill"></i>Últimos Riesgos Críticos
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Área</th>
                            <th>Actividad / Tarea</th>
                            <th>Peligro</th>
                            <th class="text-center">NR</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _ultimosCriticos)
                        {
                            <tr>
                                <td class="fw-semibold">@r.Area</td>
                                <td>@r.Actividad — @r.Tarea</td>
                                <td>@r.DescripcionPeligro[..Math.Min(60, r.DescripcionPeligro.Length)]@(r.DescripcionPeligro.Length > 60 ? "…" : "")</td>
                                <td class="text-center">
                                    <span class="badge" style="background:@ColorNR(r.NR)">@r.NR</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@r.Estado</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    private Proyecto? _proyecto;
    private int _totalRiesgos, _criticos, _controlados, _inspeccionesIA;
    private List<RiesgoIPERV> _ultimosCriticos = [];

    protected override async Task OnParametersSetAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }

        var riesgos = await Db.RiesgosIPERV
            .Where(r => r.ProyectoId == ProyectoId)
            .ToListAsync();

        _totalRiesgos   = riesgos.Count;
        _criticos       = riesgos.Count(r => r.NR >= 2000);
        _controlados    = riesgos.Count(r => r.Estado == EstadoRiesgo.Controlado || r.Estado == EstadoRiesgo.Eliminado);
        _inspeccionesIA = await Db.InspeccionesIA.CountAsync(i => i.ProyectoId == ProyectoId);

        _ultimosCriticos = riesgos
            .Where(r => r.NR >= 2000 && r.Estado == EstadoRiesgo.Activo)
            .OrderByDescending(r => r.NR)
            .Take(5)
            .ToList();
    }

    private static string ColorNR(int nr) => nr switch
    {
        >= 4000 => "#C0392B",
        >= 2000 => "#E65100",
        >= 1000 => "#F39C12",
        >= 200  => "#F1C40F",
        _       => "#27AE60"
    };
}
