@page "/proyectos/{ProyectoId:int}/hseq/seguridad/matriz/iperv"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums
@using Microsoft.EntityFrameworkCore

<PageTitle>Matriz IPERV — @(_proyecto?.Nombre ?? "")</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted p-4">Cargando...</p>
}
else
{
    <PageHeader Titulo="Matriz IPERV"
                Icono="bi-table"
                Subtitulo="@($"{_proyecto!.Nombre} — Identificación de Peligros, Evaluación y Valoración de Riesgos · GTC 45")"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/seguridad/matriz")"
                TextoVolver="Matriz Riesgos" />

    <NavMatrizRiesgos ProyectoId="@ProyectoId" TabActiva="iperv" />

    <!-- Filtros + botón nuevo -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
            <input class="form-control form-control-sm" style="max-width:200px"
                   placeholder="Buscar área / peligro..."
                   @bind="_filtroTexto" @bind:event="oninput" />
            <select class="form-select form-select-sm" style="max-width:160px" @bind="_filtroEstado">
                <option value="">Todos los estados</option>
                @foreach (EstadoRiesgo e in Enum.GetValues<EstadoRiesgo>())
                { <option value="@e">@e</option> }
            </select>
            <select class="form-select form-select-sm" style="max-width:160px" @bind="_filtroNR">
                <option value="">Todos los NR</option>
                <option value="critico">Crítico (≥4000)</option>
                <option value="alto">Alto (2000-3999)</option>
                <option value="importante">Importante (1000-1999)</option>
                <option value="mejorable">Mejorable (200-999)</option>
                <option value="aceptable">Aceptable (&lt;200)</option>
            </select>
            <div class="ms-auto d-flex gap-2">
                <a href="/proyectos/@ProyectoId/hseq/seguridad/matriz/nueva-inspeccion"
                   class="btn btn-sm text-white fw-semibold" style="background:#183963">
                    <i class="bi-plus-circle-fill me-1"></i>Nueva Inspección IA
                </a>
                <button class="btn btn-sm btn-outline-secondary" @onclick="AbrirModalManual">
                    <i class="bi-pencil-fill me-1"></i>Ingresar manualmente
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla IPERV -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0 small align-middle" style="min-width:1400px">
                <thead style="background:#183963;color:#fff;font-size:.72rem;text-transform:uppercase;letter-spacing:.4px">
                    <tr>
                        <th rowspan="2" class="align-middle" style="width:90px">Área</th>
                        <th rowspan="2" class="align-middle">Actividad / Tarea</th>
                        <th rowspan="2" class="align-middle">Peligro</th>
                        <th rowspan="2" class="align-middle">Clasificación</th>
                        <th rowspan="2" class="align-middle">Efectos posibles</th>
                        <th colspan="3" class="text-center" style="border-bottom:1px solid rgba(255,255,255,.2)">Controles existentes</th>
                        <th colspan="4" class="text-center" style="border-bottom:1px solid rgba(255,255,255,.2)">Evaluación sin controles</th>
                        <th colspan="5" class="text-center" style="border-bottom:1px solid rgba(255,255,255,.2)">Medidas de intervención</th>
                        <th rowspan="2" class="text-center align-middle">Resp.</th>
                        <th rowspan="2" class="text-center align-middle">Estado</th>
                        <th rowspan="2" class="text-center align-middle">Fuente</th>
                        <th rowspan="2" class="align-middle"></th>
                    </tr>
                    <tr style="font-size:.68rem">
                        <th>Fuente</th><th>Medio</th><th>Individuo</th>
                        <th class="text-center">ND</th><th class="text-center">NE</th><th class="text-center">NC</th>
                        <th class="text-center">NR</th>
                        <th>Eliminación</th><th>Sustitución</th><th>Ingeniería</th><th>Admvo.</th><th>EPP</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var filas = Filtrados();
                        if (!filas.Any())
                        {
                            <tr><td colspan="20" class="text-center text-muted py-5">
                                No hay riesgos registrados. <a href="/proyectos/@ProyectoId/hseq/seguridad/matriz/nueva-inspeccion" style="color:#183963">Crear inspección con IA</a>
                            </td></tr>
                        }
                        else
                        {
                            foreach (var r in filas)
                            {
                                <tr>
                                    <td class="fw-semibold small">@r.Area</td>
                                    <td><div class="fw-semibold">@r.Actividad</div><div class="text-muted" style="font-size:.7rem">@r.Tarea</div></td>
                                    <td style="max-width:160px">@r.DescripcionPeligro</td>
                                    <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@r.ClasificacionPeligro</span></td>
                                    <td style="max-width:120px" class="text-muted">@r.EfectosPosibles</td>
                                    <td class="text-muted" style="font-size:.7rem">@r.ControlFuente</td>
                                    <td class="text-muted" style="font-size:.7rem">@r.ControlMedio</td>
                                    <td class="text-muted" style="font-size:.7rem">@r.ControlIndividuo</td>
                                    <td class="text-center fw-bold">@r.ND</td>
                                    <td class="text-center fw-bold">@r.NE</td>
                                    <td class="text-center fw-bold">@r.NC</td>
                                    <td class="text-center">
                                        <span class="badge fw-bold px-2 py-1"
                                              style="background:@ColorNR(r.NR);font-size:.8rem">@r.NR</span>
                                        <div style="font-size:.65rem;color:@ColorNR(r.NR);font-weight:700">
                                            @AceptabilidadCorta(r.NR)
                                        </div>
                                    </td>
                                    <td style="font-size:.7rem;max-width:100px">@r.Eliminacion</td>
                                    <td style="font-size:.7rem;max-width:100px">@r.Sustitucion</td>
                                    <td style="font-size:.7rem;max-width:100px">@r.ControlIngenieria</td>
                                    <td style="font-size:.7rem;max-width:100px">@r.ControlAdministrativo</td>
                                    <td style="font-size:.7rem;max-width:80px">@r.EPP</td>
                                    <td class="text-center small">@r.Responsable</td>
                                    <td class="text-center">
                                        <span class="badge" style="background:@ColorEstado(r.Estado)">@r.Estado</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark" style="font-size:.65rem">
                                            @IconoFuente(r.FuenteOrigen) @r.FuenteOrigen
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary py-0 px-1"
                                                @onclick="() => AbrirEdicion(r)"
                                                title="Editar">
                                            <i class="bi-pencil-fill" style="font-size:.7rem"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small py-1 px-3">
            @Filtrados().Count() de @_riesgos.Count riesgos
        </div>
    </div>
}

<!-- Modal edición / ingreso manual -->
@if (_modalVisible)
{
    <div class="modal-backdrop fade show" style="z-index:1040"></div>
    <div class="modal show d-block" style="z-index:1050" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header text-white" style="background:#183963">
                    <h5 class="modal-title">
                        <i class="bi-table me-2"></i>
                        @(_editando?.Id > 0 ? "Editar riesgo" : "Nuevo riesgo manual")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (_editando is not null)
                    {
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Área</label>
                                <input class="form-control form-control-sm" @bind="_editando.Area" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Actividad</label>
                                <input class="form-control form-control-sm" @bind="_editando.Actividad" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Tarea</label>
                                <input class="form-control form-control-sm" @bind="_editando.Tarea" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Descripción del peligro</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.DescripcionPeligro"></textarea>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Clasificación (GTC 45)</label>
                                <input class="form-control form-control-sm" @bind="_editando.ClasificacionPeligro"
                                       placeholder="Locativo, Mecánico..." />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Efectos posibles</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.EfectosPosibles"></textarea>
                            </div>

                            <div class="col-12"><hr class="my-0" /><small class="text-muted fw-bold text-uppercase">Valoración GTC 45</small></div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">ND (Deficiencia)</label>
                                <select class="form-select form-select-sm" @bind="_editando.ND">
                                    <option value="10">10 — Muy Alto (MA)</option>
                                    <option value="6">6 — Alto (A)</option>
                                    <option value="2">2 — Medio (M)</option>
                                    <option value="0">0 — Bajo (B)</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">NE (Exposición)</label>
                                <select class="form-select form-select-sm" @bind="_editando.NE">
                                    <option value="4">4 — Continua (EC)</option>
                                    <option value="3">3 — Frecuente (EF)</option>
                                    <option value="2">2 — Ocasional (EO)</option>
                                    <option value="1">1 — Esporádica (EEsp)</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">NC (Consecuencia)</label>
                                <select class="form-select form-select-sm" @bind="_editando.NC">
                                    <option value="100">100 — Mortal / Catastrófico (M)</option>
                                    <option value="60">60 — Muy Grave (MG)</option>
                                    <option value="25">25 — Grave (G)</option>
                                    <option value="10">10 — Leve (L)</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">NR calculado</label>
                                <div class="form-control form-control-sm d-flex align-items-center gap-2" style="background:#f8f9fa">
                                    <span class="badge fw-bold" style="background:@ColorNR(_editando.ND * _editando.NE * _editando.NC)">
                                        @(_editando.ND * _editando.NE * _editando.NC)
                                    </span>
                                    <small>@AceptabilidadCorta(_editando.ND * _editando.NE * _editando.NC)</small>
                                </div>
                            </div>

                            <div class="col-12"><hr class="my-0" /><small class="text-muted fw-bold text-uppercase">Controles existentes</small></div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Control en la Fuente</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.ControlFuente"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Control en el Medio</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.ControlMedio"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Control sobre el Individuo</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.ControlIndividuo"></textarea>
                            </div>

                            <div class="col-12"><hr class="my-0" /><small class="text-muted fw-bold text-uppercase">Medidas de intervención</small></div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Eliminación</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.Eliminacion"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Sustitución</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.Sustitucion"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Control de Ingeniería</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.ControlIngenieria"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Control Administrativo</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.ControlAdministrativo"></textarea>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">EPP</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editando.EPP"></textarea>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Responsable</label>
                                <input class="form-control form-control-sm" @bind="_editando.Responsable" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Estado</label>
                                <select class="form-select form-select-sm" @bind="_editando.Estado">
                                    @foreach (EstadoRiesgo e in Enum.GetValues<EstadoRiesgo>())
                                    { <option value="@e">@e</option> }
                                </select>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-sm text-white fw-semibold" style="background:#6ABF48"
                            @onclick="GuardarRiesgoAsync">
                        <i class="bi-check-circle-fill me-1"></i>Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    private Proyecto? _proyecto;
    private List<RiesgoIPERV> _riesgos = [];
    private string _filtroTexto = "";
    private string _filtroEstado = "";
    private string _filtroNR = "";
    private bool _modalVisible;
    private RiesgoIPERV? _editando;

    protected override async Task OnParametersSetAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarRiesgosAsync();
    }

    private async Task CargarRiesgosAsync()
    {
        _riesgos = await Db.RiesgosIPERV
            .Where(r => r.ProyectoId == ProyectoId)
            .OrderByDescending(r => r.NR)
            .ToListAsync();
    }

    private IEnumerable<RiesgoIPERV> Filtrados()
    {
        var q = _riesgos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_filtroTexto))
            q = q.Where(r => r.Area.Contains(_filtroTexto, StringComparison.OrdinalIgnoreCase)
                           || r.DescripcionPeligro.Contains(_filtroTexto, StringComparison.OrdinalIgnoreCase)
                           || r.Actividad.Contains(_filtroTexto, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(_filtroEstado) && Enum.TryParse<EstadoRiesgo>(_filtroEstado, out var est))
            q = q.Where(r => r.Estado == est);

        q = _filtroNR switch
        {
            "critico"    => q.Where(r => r.NR >= 4000),
            "alto"       => q.Where(r => r.NR is >= 2000 and < 4000),
            "importante" => q.Where(r => r.NR is >= 1000 and < 2000),
            "mejorable"  => q.Where(r => r.NR is >= 200 and < 1000),
            "aceptable"  => q.Where(r => r.NR < 200),
            _            => q
        };

        return q;
    }

    private void AbrirModalManual()
    {
        _editando = new RiesgoIPERV
        {
            ProyectoId   = ProyectoId,
            FuenteOrigen = FuenteRiesgo.Manual,
            ND = 6, NE = 3, NC = 25
        };
        _modalVisible = true;
    }

    private void AbrirEdicion(RiesgoIPERV r)
    {
        _editando = r;
        _modalVisible = true;
    }

    private void CerrarModal() { _modalVisible = false; _editando = null; }

    private async Task GuardarRiesgoAsync()
    {
        if (_editando is null) return;
        _editando.NP = _editando.ND * _editando.NE;
        _editando.NR = _editando.NP * _editando.NC;
        _editando.Aceptabilidad = AceptabilidadCorta(_editando.NR);

        if (_editando.Id == 0) Db.RiesgosIPERV.Add(_editando);
        await Db.SaveChangesAsync();
        await CargarRiesgosAsync();
        CerrarModal();
    }

    private static string ColorNR(int nr) => nr switch
    {
        >= 4000 => "#C0392B", >= 2000 => "#E65100",
        >= 1000 => "#F39C12", >= 200  => "#F1C40F",
        _       => "#27AE60"
    };

    private static string AceptabilidadCorta(int nr) => nr switch
    {
        >= 4000 => "I — Crítico", >= 2000 => "II — No Aceptable",
        >= 1000 => "III — Mejorable", >= 200 => "IV — Aceptable c/ctrl",
        _       => "V — Aceptable"
    };

    private static string ColorEstado(EstadoRiesgo e) => e switch
    {
        EstadoRiesgo.Activo      => "#C0392B",
        EstadoRiesgo.EnControl   => "#E65100",
        EstadoRiesgo.Controlado  => "#6ABF48",
        EstadoRiesgo.Eliminado   => "#9E9E9E",
        _                        => "#9E9E9E"
    };

    private static string IconoFuente(FuenteRiesgo f) => f switch
    {
        FuenteRiesgo.InspeccionIA => "🤖",
        FuenteRiesgo.Incidente    => "⚠️",
        FuenteRiesgo.Manual       => "✏️",
        _                         => "•"
    };
}
