@page "/proyectos/{ProyectoId:int}/hseq/seguridad/matriz/acciones"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums
@using Microsoft.EntityFrameworkCore

<PageTitle>Acciones Correctivas — @(_proyecto?.Nombre ?? "")</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted p-4">Cargando...</p>
}
else
{
    <PageHeader Titulo="Acciones Correctivas"
                Icono="bi-list-check"
                Subtitulo="@($"{_proyecto!.Nombre} — Seguimiento a controles y cierre de riesgos")"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/seguridad/matriz")"
                TextoVolver="Matriz Riesgos" />

    <NavMatrizRiesgos ProyectoId="@ProyectoId" TabActiva="acciones" />

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3" style="border-left:4px solid #C0392B!important">
                <div class="fw-bold" style="font-size:1.8rem;color:#C0392B">@_pendientes</div>
                <div class="small text-muted">Pendientes</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3" style="border-left:4px solid #E65100!important">
                <div class="fw-bold" style="font-size:1.8rem;color:#E65100">@_enControl</div>
                <div class="small text-muted">En Control</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3" style="border-left:4px solid #6ABF48!important">
                <div class="fw-bold" style="font-size:1.8rem;color:#6ABF48">@_controlados</div>
                <div class="small text-muted">Controlados</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3" style="border-left:4px solid #9E9E9E!important">
                <div class="fw-bold" style="font-size:1.8rem;color:#9E9E9E">@_eliminados</div>
                <div class="small text-muted">Eliminados</div>
            </div>
        </div>
    </div>

    <!-- Filtro -->
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
        <input class="form-control form-control-sm" style="max-width:220px"
               placeholder="Buscar área / peligro / responsable..."
               @bind="_filtro" @bind:event="oninput" />
        <select class="form-select form-select-sm" style="max-width:160px" @bind="_filtroEstado">
            <option value="">Todos los estados</option>
            @foreach (EstadoRiesgo e in Enum.GetValues<EstadoRiesgo>())
            { <option value="@e">@e</option> }
        </select>
        <label class="form-check-label small ms-2">
            <input type="checkbox" class="form-check-input me-1" @bind="_soloConAccion" />
            Solo con acción correctiva
        </label>
    </div>

    <!-- Tabla de acciones -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-sm table-hover small align-middle mb-0">
                <thead style="background:#183963;color:#fff;font-size:.72rem;text-transform:uppercase">
                    <tr>
                        <th>Área / Peligro</th>
                        <th class="text-center">NR</th>
                        <th>Hallazgo</th>
                        <th>Acción correctiva propuesta</th>
                        <th>Responsable</th>
                        <th>Plazo</th>
                        <th class="text-center">Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var filas = RiesgosFiltrados().ToList();
                        if (!filas.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    No hay riesgos con acciones correctivas pendientes.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var r in filas)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@r.Area</div>
                                        <div class="text-muted" style="font-size:.7rem">@r.DescripcionPeligro</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge fw-bold" style="background:@ColorNR(r.NR)">@r.NR</span>
                                    </td>
                                    <td style="max-width:160px;font-size:.72rem">@r.Hallazgo</td>
                                    <td style="max-width:200px;font-size:.72rem">
                                        @if (string.IsNullOrEmpty(r.AccionCorrectiva))
                                        { <span class="text-muted fst-italic">Sin acción definida</span> }
                                        else { @r.AccionCorrectiva }
                                    </td>
                                    <td class="small">@r.Responsable</td>
                                    <td class="small">
                                        @if (r.Plazo.HasValue)
                                        {
                                            var vencido = r.Plazo < DateTime.Today && r.Estado == EstadoRiesgo.Activo;
                                            <span class="@(vencido ? "text-danger fw-bold" : "")">
                                                @r.Plazo.Value.ToString("dd/MM/yy")
                                                @if (vencido) { <i class="bi-exclamation-triangle-fill ms-1"></i> }
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" style="background:@ColorEstado(r.Estado)">@r.Estado</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-1 justify-content-center">
                                            @if (r.Estado == EstadoRiesgo.Activo)
                                            {
                                                <button class="btn btn-sm py-0 px-1"
                                                        style="background:#E65100;color:#fff;font-size:.68rem"
                                                        @onclick="() => CambiarEstado(r, EstadoRiesgo.EnControl)">
                                                    En control
                                                </button>
                                            }
                                            @if (r.Estado == EstadoRiesgo.EnControl)
                                            {
                                                <button class="btn btn-sm py-0 px-1"
                                                        style="background:#6ABF48;color:#fff;font-size:.68rem"
                                                        @onclick="() => CambiarEstado(r, EstadoRiesgo.Controlado)">
                                                    Controlar
                                                </button>
                                            }
                                            @if (r.Estado != EstadoRiesgo.Eliminado)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                        style="font-size:.68rem"
                                                        @onclick="() => CambiarEstado(r, EstadoRiesgo.Eliminado)">
                                                    Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small py-1 px-3">
            @filas.Count riesgos mostrados
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    private Proyecto? _proyecto;
    private List<RiesgoIPERV> _riesgos = [];
    private string _filtro = "";
    private string _filtroEstado = "";
    private bool _soloConAccion;
    private int _pendientes, _enControl, _controlados, _eliminados;

    protected override async Task OnParametersSetAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _riesgos = await Db.RiesgosIPERV
            .Where(r => r.ProyectoId == ProyectoId)
            .OrderByDescending(r => r.NR)
            .ToListAsync();

        _pendientes  = _riesgos.Count(r => r.Estado == EstadoRiesgo.Activo);
        _enControl   = _riesgos.Count(r => r.Estado == EstadoRiesgo.EnControl);
        _controlados = _riesgos.Count(r => r.Estado == EstadoRiesgo.Controlado);
        _eliminados  = _riesgos.Count(r => r.Estado == EstadoRiesgo.Eliminado);
    }

    private IEnumerable<RiesgoIPERV> RiesgosFiltrados()
    {
        var q = _riesgos.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_filtro))
            q = q.Where(r => r.Area.Contains(_filtro, StringComparison.OrdinalIgnoreCase)
                           || r.DescripcionPeligro.Contains(_filtro, StringComparison.OrdinalIgnoreCase)
                           || r.Responsable.Contains(_filtro, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_filtroEstado) && Enum.TryParse<EstadoRiesgo>(_filtroEstado, out var est))
            q = q.Where(r => r.Estado == est);
        if (_soloConAccion)
            q = q.Where(r => !string.IsNullOrEmpty(r.AccionCorrectiva));
        return q;
    }

    private async Task CambiarEstado(RiesgoIPERV r, EstadoRiesgo nuevoEstado)
    {
        r.Estado = nuevoEstado;
        await Db.SaveChangesAsync();
        await CargarAsync();
    }

    private static string ColorNR(int nr) => nr switch
    {
        >= 4000 => "#C0392B", >= 2000 => "#E65100",
        >= 1000 => "#F39C12", >= 200  => "#F1C40F",
        _       => "#27AE60"
    };

    private static string ColorEstado(EstadoRiesgo e) => e switch
    {
        EstadoRiesgo.Activo     => "#C0392B",
        EstadoRiesgo.EnControl  => "#E65100",
        EstadoRiesgo.Controlado => "#6ABF48",
        _                       => "#9E9E9E"
    };
}
