@page "/proyectos/{ProyectoId:int}/hseq/seguridad/matriz/biblioteca"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums
@using RenergeIA.Web.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>Biblioteca de Peligros — @(_proyecto?.Nombre ?? "")</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted p-4">Cargando...</p>
}
else
{
    <PageHeader Titulo="Biblioteca de Peligros y Controles"
                Icono="bi-book-fill"
                Subtitulo="@($"{_proyecto!.Nombre} — Catálogo GTC 45 precargado para Proyectos EPC Solar")"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/seguridad/matriz")"
                TextoVolver="Matriz Riesgos" />

    <NavMatrizRiesgos ProyectoId="@ProyectoId" TabActiva="biblioteca" />

    <!-- Banner de uso -->
    <div class="alert border-0 mb-4 d-flex align-items-center gap-3"
         style="background:#e8ecf5;border-left:4px solid #183963!important">
        <i class="bi-info-circle-fill fs-3" style="color:#183963"></i>
        <div>
            <div class="fw-bold" style="color:#183963">Catálogo precargado de peligros para proyectos EPC solares</div>
            <div class="small text-muted">
                Basado en GTC 45 de ICONTEC. Haga clic en <strong>Agregar a Matriz</strong> para importar un peligro
                directamente a la Matriz IPERV del proyecto activo. También puede usarlo como guía para la inspección con IA.
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
        <input class="form-control form-control-sm" style="max-width:240px"
               placeholder="Buscar área / peligro / clasificación..."
               @bind="_filtro" @bind:event="oninput" />
        <select class="form-select form-select-sm" style="max-width:180px" @bind="_filtroArea">
            <option value="">Todas las áreas</option>
            @foreach (var area in _areas)
            { <option value="@area">@area</option> }
        </select>
        <select class="form-select form-select-sm" style="max-width:180px" @bind="_filtroClasif">
            <option value="">Todas las clasificaciones</option>
            @foreach (var c in _clasificaciones)
            { <option value="@c">@c</option> }
        </select>
        <span class="ms-auto badge bg-secondary">@Filtrados().Count() peligros</span>
    </div>

    <!-- Tarjetas de peligros -->
    <div class="row g-3">
        @foreach (var p in Filtrados())
        {
            var nrColor = ColorNR(p.NivelRiesgoSugerido);
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100" style="border-top:3px solid @nrColor!important">
                    <div class="card-header d-flex justify-content-between align-items-start py-2 px-3"
                         style="background:@nrColor+'14'">
                        <div>
                            <div class="fw-bold small" style="color:@nrColor">@p.Area — @p.Actividad</div>
                            <div class="text-muted" style="font-size:.7rem">@p.Tarea</div>
                        </div>
                        <div class="text-end">
                            <span class="badge fw-bold" style="background:@nrColor">NR ~@p.NivelRiesgoSugerido</span>
                            <div style="font-size:.62rem;color:@nrColor;font-weight:700">@AceptabilidadCorta(p.NivelRiesgoSugerido)</div>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        <!-- Peligro principal -->
                        <div class="mb-2">
                            <span class="badge bg-secondary-subtle text-secondary-emphasis me-1">@p.Clasificacion</span>
                            <span class="fw-semibold small">@p.Peligro</span>
                        </div>
                        <!-- Efectos -->
                        <div class="small text-danger mb-2">
                            <i class="bi-exclamation-triangle-fill me-1"></i>@p.EfectosPosibles
                        </div>

                        <!-- Controles F-M-I en acordeón compacto -->
                        <div class="mb-2">
                            <button class="btn btn-sm btn-outline-secondary w-100 py-0 text-start"
                                    style="font-size:.7rem"
                                    @onclick="() => ToggleDetalle(p)">
                                <i class="bi-shield-fill-check me-1" style="color:#6ABF48"></i>
                                Ver controles y EPP
                                <i class="bi-chevron-@(_detalleVisible.Contains(p) ? "up" : "down") ms-1 float-end"></i>
                            </button>
                            @if (_detalleVisible.Contains(p))
                            {
                                <div class="mt-2 p-2 rounded-2" style="background:#f8f9fa;font-size:.7rem">
                                    <div class="mb-1"><span class="fw-bold" style="color:#183963">Fuente:</span> @p.ControlFuente</div>
                                    <div class="mb-1"><span class="fw-bold" style="color:#183963">Medio:</span> @p.ControlMedio</div>
                                    <div class="mb-1"><span class="fw-bold" style="color:#183963">Individuo:</span> @p.ControlIndividuo</div>
                                    <div class="mb-1"><span class="fw-bold" style="color:#6ABF48">Medidas:</span> @p.MedidasIntervencion</div>
                                    <div class="mb-1"><span class="fw-bold" style="color:#E65100">EPP:</span> @p.EPPRecomendado</div>
                                    <div><span class="fw-bold text-muted">Documentos:</span> @p.DocumentosAsociados</div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="card-footer py-2 px-3 d-flex justify-content-end gap-2">
                        <button class="btn btn-sm text-white fw-semibold"
                                style="background:#183963;font-size:.72rem"
                                @onclick="() => AgregarAMatrizAsync(p)"
                                disabled="@(_agregando == p)">
                            @if (_agregando == p)
                            { <span class="spinner-border spinner-border-sm me-1"></span> }
                            <i class="bi-plus-circle-fill me-1"></i>Agregar a Matriz
                        </button>
                    </div>
                </div>
            </div>
        }
        @if (!Filtrados().Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi-search display-3 d-block mb-2"></i>
                No se encontraron peligros con los filtros aplicados.
            </div>
        }
    </div>
}

<!-- Toast de confirmación -->
@if (_toastVisible)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
        <div class="toast show align-items-center text-white border-0"
             style="background:#6ABF48;min-width:300px">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi-check-circle-fill me-2"></i>@_toastMsg
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        @onclick='() => _toastVisible = false'></button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    private Proyecto? _proyecto;
    private string _filtro = "";
    private string _filtroArea = "";
    private string _filtroClasif = "";
    private HashSet<PeligroBiblioteca> _detalleVisible = [];
    private PeligroBiblioteca? _agregando;
    private bool _toastVisible;
    private string _toastMsg = "";

    private static readonly string[] _areas =
        BibliotecaPeligrosData.Peligros.Select(p => p.Area).Distinct().Order().ToArray();

    private static readonly string[] _clasificaciones =
        BibliotecaPeligrosData.Peligros.Select(p => p.Clasificacion).Distinct().Order().ToArray();

    protected override async Task OnParametersSetAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) Navigation.NavigateTo("/proyectos");
    }

    private IEnumerable<PeligroBiblioteca> Filtrados()
    {
        var q = BibliotecaPeligrosData.Peligros.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_filtro))
            q = q.Where(p =>
                p.Area.Contains(_filtro, StringComparison.OrdinalIgnoreCase) ||
                p.Peligro.Contains(_filtro, StringComparison.OrdinalIgnoreCase) ||
                p.Clasificacion.Contains(_filtro, StringComparison.OrdinalIgnoreCase) ||
                p.Actividad.Contains(_filtro, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_filtroArea))
            q = q.Where(p => p.Area == _filtroArea);
        if (!string.IsNullOrEmpty(_filtroClasif))
            q = q.Where(p => p.Clasificacion == _filtroClasif);
        return q;
    }

    private void ToggleDetalle(PeligroBiblioteca p)
    {
        if (!_detalleVisible.Add(p)) _detalleVisible.Remove(p);
    }

    private async Task AgregarAMatrizAsync(PeligroBiblioteca p)
    {
        _agregando = p;
        try
        {
            var nr = p.NivelRiesgoSugerido;
            // Reconstruir ND/NE/NC aproximados desde NR típico
            var (nd, ne, nc) = EstimarFactores(nr);

            var riesgo = new RiesgoIPERV
            {
                ProyectoId            = ProyectoId,
                FuenteOrigen          = FuenteRiesgo.Manual,
                Area                  = p.Area,
                Actividad             = p.Actividad,
                Tarea                 = p.Tarea,
                DescripcionPeligro    = p.Peligro,
                ClasificacionPeligro  = p.Clasificacion,
                EfectosPosibles       = p.EfectosPosibles,
                ControlFuente         = p.ControlFuente,
                ControlMedio          = p.ControlMedio,
                ControlIndividuo      = p.ControlIndividuo,
                ControlAdministrativo = p.MedidasIntervencion,
                EPP                   = p.EPPRecomendado,
                ND = nd, NE = ne, NP = nd * ne, NC = nc, NR = nd * ne * nc,
                Aceptabilidad         = AceptabilidadCorta(nd * ne * nc),
                Responsable           = "Por definir",
                Estado                = EstadoRiesgo.Activo,
                EstadoValidacion      = EstadoValidacionIA.PendienteValidacion
            };
            Db.RiesgosIPERV.Add(riesgo);
            await Db.SaveChangesAsync();

            _toastMsg     = $"'{p.Peligro}' agregado a la Matriz IPERV";
            _toastVisible = true;
            _ = Task.Delay(4000).ContinueWith(_ => { _toastVisible = false; InvokeAsync(StateHasChanged); });
        }
        finally { _agregando = null; }
    }

    private static (int ND, int NE, int NC) EstimarFactores(int nr) => nr switch
    {
        >= 4000 => (10, 4, 100),
        >= 2000 => (10, 4, 60),
        >= 1000 => (6,  4, 60),
        >= 600  => (6,  4, 25),
        >= 200  => (6,  2, 25),
        >= 100  => (2,  3, 25),
        _       => (2,  2, 10)
    };

    private static string ColorNR(int nr) => nr switch
    {
        >= 4000 => "#C0392B", >= 2000 => "#E65100",
        >= 1000 => "#F39C12", >= 200  => "#F1C40F",
        _       => "#27AE60"
    };

    private static string AceptabilidadCorta(int nr) => nr switch
    {
        >= 4000 => "I — Crítico", >= 2000 => "II — No Aceptable",
        >= 1000 => "III — Mejorable", >= 200 => "IV — Aceptable c/ctrl",
        _       => "V — Aceptable"
    };
}
