@page "/proyectos/{ProyectoId:int}/hseq/seguridad/incidentes"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>Incidentes y Accidentes — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <a href="/proyectos/@ProyectoId/hseq" class="btn btn-sm btn-outline-secondary">&larr; HSEQ</a>
        <div class="flex-grow-1">
            <h1 class="h4 mb-0"><i class="bi-cone-striped me-2" style="color:#fd7e14"></i>Incidentes y Accidentes</h1>
            <small class="text-muted">@_proyecto.Nombre</small>
        </div>
        <button class="btn btn-danger btn-sm" @onclick="MostrarFormulario">
            <i class="bi-plus-lg me-1"></i>Registrar Evento
        </button>
    </div>
    <NavSeguridad ProyectoId="@ProyectoId" TabActiva="incidentes" />

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-danger">
            <div class="card-header bg-danger text-white d-flex justify-content-between">
                <strong>Registro de Incidente / Accidente</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Número *</label>
                            <InputText class="form-control" @bind-Value="_form.Numero" />
                            <ValidationMessage For="() => _form.Numero" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Tipo *</label>
                            <InputSelect class="form-select" @bind-Value="_form.Tipo">
                                @foreach (var t in Enum.GetValues<TipoIncidente>())
                                { <option value="@t">@EnumDisplay.Mostrar(t)</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Gravedad</label>
                            <InputSelect class="form-select" @bind-Value="_form.Gravedad">
                                @foreach (var g in Enum.GetValues<GravedadIncidente>())
                                { <option value="@g">@EnumDisplay.Mostrar(g)</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Evento</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaEvento" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción *</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Descripcion" />
                            <ValidationMessage For="() => _form.Descripcion" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Frente de Trabajo</label>
                            <InputText class="form-control" @bind-Value="_form.FrenteTrabajo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Persona Involucrada *</label>
                            <InputText class="form-control" @bind-Value="_form.PersonaInvolucrada" />
                            <ValidationMessage For="() => _form.PersonaInvolucrada" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Investigado Por</label>
                            <InputText class="form-control" @bind-Value="_form.InvestigadoPor" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Causa Raíz</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.CausaRaiz" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <InputSelect class="form-select" @bind-Value="_form.Estado">
                                @foreach (var e in Enum.GetValues<EstadoNoConformidad>())
                                { <option value="@e">@EnumDisplay.Mostrar(e)</option> }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-danger btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Semáforos -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-success">
                <div style="font-size:2rem;color:#6ABF4B"><i class="bi-circle-fill"></i></div>
                <div class="fw-bold" style="font-size:1.6rem;color:#6ABF4B">@_eventos.Count(e => e.Tipo == TipoIncidente.CasiAccidente)</div>
                <div class="text-muted small">Casi Accidentes</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-warning">
                <div style="font-size:2rem;color:#ffc107"><i class="bi-circle-fill"></i></div>
                <div class="fw-bold" style="font-size:1.6rem;color:#ffc107">@_eventos.Count(e => e.Tipo == TipoIncidente.Incidente)</div>
                <div class="text-muted small">Incidentes</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-danger">
                <div style="font-size:2rem;color:#dc3545"><i class="bi-circle-fill"></i></div>
                <div class="fw-bold" style="font-size:1.6rem;color:#dc3545">@_eventos.Count(e => e.Tipo == TipoIncidente.AccidenteLeve || e.Tipo == TipoIncidente.AccidenteGrave)</div>
                <div class="text-muted small">Accidentes</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-dark">
                <div style="font-size:2rem;color:#343a40"><i class="bi-circle-fill"></i></div>
                <div class="fw-bold" style="font-size:1.6rem;color:#343a40">@_eventos.Count(e => e.Tipo == TipoIncidente.AccidenteFatal)</div>
                <div class="text-muted small">Fatales</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th class="text-center">Tipo</th>
                        <th class="text-center">Gravedad</th>
                        <th>Descripción</th>
                        <th>Persona</th>
                        <th>Fecha</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_eventos.Any())
                    {
                        <tr><td colspan="8" class="text-center py-4">
                            <i class="bi-check-circle text-success d-block mb-2" style="font-size:2rem"></i>
                            <span class="text-muted">Sin incidentes ni accidentes registrados. ¡Excelente!</span>
                        </td></tr>
                    }
                    @foreach (var e in _eventos.OrderByDescending(x => x.FechaEvento))
                    {
                        <tr>
                            <td class="font-monospace small text-muted">@e.Numero</td>
                            <td class="text-center"><span class="badge @BadgeTipo(e.Tipo)">@EnumDisplay.Mostrar(e.Tipo)</span></td>
                            <td class="text-center"><span class="badge @BadgeGrav(e.Gravedad)">@EnumDisplay.Mostrar(e.Gravedad)</span></td>
                            <td style="max-width:200px">@e.Descripcion</td>
                            <td class="small">@e.PersonaInvolucrada</td>
                            <td class="small">@e.FechaEvento.ToString("dd/MM/yyyy")</td>
                            <td class="text-center"><span class="badge @BadgeEst(e.Estado)">@EnumDisplay.Mostrar(e.Estado)</span></td>
                            <td class="text-center">
                                @if (_confirmandoEliminar == e.Id)
                                {
                                    <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(e.Id)">Sí</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = e.Id"><i class="bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<IncidenteAccidente> _eventos = [];
    private bool _mostrarFormulario;
    private int? _confirmandoEliminar;
    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        _eventos = await Db.IncidentesAccidentes.Where(i => i.ProyectoId == ProyectoId).OrderByDescending(i => i.FechaEvento).ToListAsync();

    private void MostrarFormulario() { _form = new FormModel { FechaEvento = DateTime.Today }; _mostrarFormulario = true; }
    private void CancelarFormulario() => _mostrarFormulario = false;

    private async Task GuardarAsync()
    {
        var entidad = new IncidenteAccidente
        {
            ProyectoId         = ProyectoId,
            Numero             = _form.Numero,
            Tipo               = _form.Tipo,
            Gravedad           = _form.Gravedad,
            Descripcion        = _form.Descripcion,
            FrenteTrabajo      = _form.FrenteTrabajo,
            PersonaInvolucrada = _form.PersonaInvolucrada,
            InvestigadoPor     = _form.InvestigadoPor,
            FechaEvento        = _form.FechaEvento,
            CausaRaiz          = _form.CausaRaiz,
            Estado             = _form.Estado
        };
        Db.IncidentesAccidentes.Add(entidad);
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var entidad = await Db.IncidentesAccidentes.FindAsync(id);
        if (entidad is not null) { Db.IncidentesAccidentes.Remove(entidad); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private static string BadgeTipo(TipoIncidente t) => t switch
    {
        TipoIncidente.CasiAccidente  => "bg-success",
        TipoIncidente.Incidente      => "bg-warning text-dark",
        TipoIncidente.AccidenteLeve  => "bg-danger",
        TipoIncidente.AccidenteGrave => "bg-danger",
        TipoIncidente.AccidenteFatal => "bg-dark",
        _                            => "bg-secondary"
    };

    private static string BadgeGrav(GravedadIncidente g) => g switch
    {
        GravedadIncidente.Leve     => "bg-success",
        GravedadIncidente.Moderado => "bg-warning text-dark",
        GravedadIncidente.Grave    => "bg-danger",
        GravedadIncidente.Fatal    => "bg-dark",
        _                          => "bg-secondary"
    };

    private static string BadgeEst(EstadoNoConformidad e) => e switch
    {
        EstadoNoConformidad.Cerrada          => "bg-success",
        EstadoNoConformidad.Abierta          => "bg-danger",
        EstadoNoConformidad.EnImplementacion => "bg-primary",
        _                                    => "bg-secondary"
    };

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Numero { get; set; } = "";
        public TipoIncidente Tipo { get; set; } = TipoIncidente.Incidente;
        public GravedadIncidente Gravedad { get; set; } = GravedadIncidente.Leve;
        [System.ComponentModel.DataAnnotations.Required] public string Descripcion { get; set; } = "";
        public string FrenteTrabajo { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string PersonaInvolucrada { get; set; } = "";
        public string InvestigadoPor { get; set; } = "";
        public DateTime FechaEvento { get; set; } = DateTime.Today;
        public string? CausaRaiz { get; set; }
        public EstadoNoConformidad Estado { get; set; } = EstadoNoConformidad.Abierta;
    }
}
