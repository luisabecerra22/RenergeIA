@page "/proyectos/{ProyectoId:int}/hseq/ambiental/checklist"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>Checklist ISO 14001 — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <PageHeader Titulo="Checklist ISO 14001"
                Icono="bi-tree"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/ambiental")"
                TextoVolver="Ambiental">
        <Acciones>
            <button class="btn btn-success btn-sm" @onclick="MostrarFormulario">
                <i class="bi-plus-lg me-1"></i>Nueva Auditoría
            </button>
        </Acciones>
    </PageHeader>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-header text-white d-flex justify-content-between" style="background:#6ABF4B">
                <strong>Nueva Auditoría ISO 14001</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Auditor *</label>
                            <InputText class="form-control" @bind-Value="_form.Auditor" />
                            <ValidationMessage For="() => _form.Auditor" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha Auditoría</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaAuditoria" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">% Cumplimiento</label>
                            <InputNumber class="form-control" @bind-Value="_form.PorcentajeCumplimiento" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Observaciones" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    var ultimo = _checklists.Any() ? _checklists.OrderByDescending(c => c.FechaAuditoria).First() : null;
    var pctActual = ultimo?.PorcentajeCumplimiento ?? 0;
    var estadoPct = pctActual >= 85 ? "Saludable" : pctActual >= 70 ? "En Riesgo" : pctActual > 0 ? "Crítico" : "Sin datos";
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <ExecutiveCard Titulo="Cumplimiento Actual (ISO 14001)"
                           Valor="@(ultimo is not null ? pctActual.ToString("F0") + "%" : "—")"
                           Icono="bi-patch-check"
                           Estado="@estadoPct" />
        </div>
        <div class="col-md-4">
            <ExecutiveCard Titulo="Auditorías Realizadas"
                           Valor="@_checklists.Count.ToString()"
                           Icono="bi-clipboard-check"
                           Estado="Informativo" />
        </div>
        <div class="col-md-4">
            <ExecutiveCard Titulo="Última Auditoría"
                           Valor="@(_checklists.Any() ? _checklists.Max(c => c.FechaAuditoria).ToString("dd/MM/yyyy") : "—")"
                           Icono="bi-calendar-event"
                           Estado="Informativo" />
        </div>
    </div>

    <SmartTable Columnas="5"
                MostrarBusqueda="true"
                PlaceholderBusqueda="Buscar por auditor..."
                BusquedaCambiada="OnBusqueda"
                Vacio="!ChecklistsFiltrados.Any()"
                MensajeVacio="No hay auditorías ISO 14001 registradas.">
        <Encabezados>
            <tr>
                <th>Fecha</th>
                <th>Auditor</th>
                <th class="text-center">Cumplimiento</th>
                <th>Observaciones</th>
                <th class="text-center">Acciones</th>
            </tr>
        </Encabezados>
        <Filas>
            @foreach (var c in ChecklistsFiltrados)
            {
                <tr>
                    <td>@c.FechaAuditoria.ToString("dd/MM/yyyy")</td>
                    <td>@c.Auditor</td>
                    <td class="text-center">
                        <StatusChip Estado="@(c.PorcentajeCumplimiento >= 85 ? "Saludable" : c.PorcentajeCumplimiento >= 70 ? "En Riesgo" : "Crítico")"
                                    Texto="@(c.PorcentajeCumplimiento.ToString("F0") + "%")" />
                    </td>
                    <td class="text-muted small">@(c.Observaciones ?? "—")</td>
                    <td class="text-center">
                        @if (_confirmandoEliminar == c.Id)
                        {
                            <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(c.Id)">Sí</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = c.Id"><i class="bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
        </Filas>
    </SmartTable>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<ChecklistAuditoria> _checklists = [];
    private bool _mostrarFormulario;
    private int? _confirmandoEliminar;
    private string _busqueda = "";
    private FormModel _form = new();

    private IEnumerable<ChecklistAuditoria> ChecklistsFiltrados => _checklists
        .Where(c => string.IsNullOrEmpty(_busqueda) ||
                    c.Auditor.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(c => c.FechaAuditoria);

    private void OnBusqueda(string v) => _busqueda = v;

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        _checklists = await Db.ChecklistsAuditoria
            .Where(c => c.ProyectoId == ProyectoId && c.Division == DivisionHSEQ.Ambiental)
            .OrderByDescending(c => c.FechaAuditoria).ToListAsync();
    }

    private void MostrarFormulario() { _form = new FormModel { FechaAuditoria = DateTime.Today }; _mostrarFormulario = true; }
    private void CancelarFormulario() => _mostrarFormulario = false;

    private async Task GuardarAsync()
    {
        Db.ChecklistsAuditoria.Add(new ChecklistAuditoria
        {
            ProyectoId             = ProyectoId,
            Division               = DivisionHSEQ.Ambiental,
            NormaISO               = "ISO 14001:2015",
            Auditor                = _form.Auditor,
            FechaAuditoria         = _form.FechaAuditoria,
            PorcentajeCumplimiento = _form.PorcentajeCumplimiento,
            Observaciones          = _form.Observaciones
        });
        await Db.SaveChangesAsync();
        CancelarFormulario();
        _checklists = await Db.ChecklistsAuditoria
            .Where(c => c.ProyectoId == ProyectoId && c.Division == DivisionHSEQ.Ambiental)
            .OrderByDescending(c => c.FechaAuditoria).ToListAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var e = await Db.ChecklistsAuditoria.FindAsync(id);
        if (e is not null) { Db.ChecklistsAuditoria.Remove(e); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        _checklists = await Db.ChecklistsAuditoria
            .Where(c => c.ProyectoId == ProyectoId && c.Division == DivisionHSEQ.Ambiental)
            .OrderByDescending(c => c.FechaAuditoria).ToListAsync();
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Auditor { get; set; } = "";
        public DateTime FechaAuditoria { get; set; } = DateTime.Today;
        public decimal PorcentajeCumplimiento { get; set; }
        public string? Observaciones { get; set; }
    }
}
