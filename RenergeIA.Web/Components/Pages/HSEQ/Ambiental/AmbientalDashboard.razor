@page "/proyectos/{ProyectoId:int}/hseq/ambiental"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation

<PageTitle>Ambiental HSEQ — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <DashboardLayout>

        <!-- ── Nivel 0: Cabecera ── -->
        <PageHeader Titulo="Ambiental — ISO 14001"
                    Icono="bi-tree-fill"
                    Subtitulo="@(_proyecto.Nombre + " · " + DateTime.Now.ToString("dd/MM/yyyy"))"
                    UrlVolver="@($"/proyectos/{ProyectoId}/hseq")"
                    TextoVolver="HSEQ">
            <Acciones>
                <StatusChip Estado="Saludable" Grande="true" />
            </Acciones>
        </PageHeader>

        <!-- ── Nivel 1: Navegación / FilterBar ── -->
        <FilterBar>
            <span class="btn btn-success btn-sm">Dashboard</span>
            <a href="/proyectos/@ProyectoId/hseq/ambiental/checklist"    class="btn btn-outline-secondary btn-sm">Checklist ISO 14001</a>
            <a href="/proyectos/@ProyectoId/hseq/ambiental/inspecciones" class="btn btn-outline-secondary btn-sm">Inspecciones</a>
            <a href="/proyectos/@ProyectoId/hseq/ambiental/residuos"     class="btn btn-outline-secondary btn-sm">Residuos</a>
            <a href="/proyectos/@ProyectoId/hseq/ambiental/aspectos"     class="btn btn-outline-secondary btn-sm">Aspectos e Impactos</a>
            <a href="/proyectos/@ProyectoId/hseq/ambiental/derrames"     class="btn btn-outline-secondary btn-sm">Derrames</a>
            <a href="/proyectos/@ProyectoId/hseq/ambiental/fauna-flora"  class="btn btn-outline-secondary btn-sm">Fauna y Flora</a>
            <a href="/proyectos/@ProyectoId/hseq/ambiental/acciones"     class="btn btn-outline-secondary btn-sm">Acciones Correctivas</a>
        </FilterBar>

        <!-- ── Nivel 2: KPIs ejecutivos ── -->
        <SeccionDash Titulo="Resumen Ejecutivo" Icono="bi-speedometer2">
            <div class="row g-3">
                <div class="col-xl-3 col-md-6">
                    <GaugeKPI Titulo="Cumplimiento ISO 14001"
                              ValorCentral="93%"
                              SubTexto="de requisitos verificados"
                              Porcentaje="93"
                              Estado="Saludable" />
                </div>
                <div class="col-xl-3 col-md-6">
                    <DonutKPI Titulo="Residuos Aprovechables"
                              ValorCentral="75%"
                              SubTextoInterno="aprovechados"
                              Porcentaje="75"
                              Estado="Saludable" />
                </div>
                <div class="col-xl-3 col-md-6">
                    <ExecutiveCard Titulo="Inspecciones Ambientales"
                                   Valor="12"
                                   Icono="bi-binoculars-fill"
                                   SubTexto="realizadas este período"
                                   Estado="Informativo" />
                </div>
                <div class="col-xl-3 col-md-6">
                    <ExecutiveCard Titulo="Hallazgos Abiertos"
                                   Valor="1"
                                   Icono="bi-exclamation-circle"
                                   SubTexto="bajo impacto"
                                   Estado="En Riesgo" />
                </div>
            </div>
        </SeccionDash>

        <!-- ── Nivel 2b: Residuos y control ── -->
        <SeccionDash Titulo="Residuos y Control Ambiental" Icono="bi-recycle">
            <div class="row g-3">
                <div class="col-xl-3 col-md-6">
                    <ExecutiveCard Titulo="Residuos Gestionados"
                                   Valor="2.4t"
                                   Icono="bi-recycle"
                                   SubTexto="total este período"
                                   Estado="Saludable" />
                </div>
                <div class="col-xl-3 col-md-6">
                    <ExecutiveCard Titulo="Residuos Peligrosos"
                                   Valor="0.6t"
                                   Icono="bi-radioactive"
                                   SubTexto="gestionado con empresa certificada"
                                   Estado="En Riesgo" />
                </div>
                <div class="col-xl-3 col-md-6">
                    <ExecutiveCard Titulo="Derrames"
                                   Valor="0"
                                   Icono="bi-droplet-fill"
                                   SubTexto="sin derrames registrados"
                                   Estado="Saludable" />
                </div>
                <div class="col-xl-3 col-md-6">
                    <ExecutiveCard Titulo="Aspectos Controlados"
                                   Valor="15/16"
                                   Icono="bi-check2-all"
                                   SubTexto="de aspectos identificados"
                                   Estado="Saludable" />
                </div>
            </div>
        </SeccionDash>

        <!-- ── Nivel 3: Acceso rápido a sub-módulos ── -->
        <SeccionDash Titulo="Gestión Ambiental" Icono="bi-grid-fill">
            <div class="row g-3">
                <div class="col-6 col-md-4">
                    <a href="/proyectos/@ProyectoId/hseq/ambiental/checklist" class="text-decoration-none">
                        <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                            <i class="bi-list-check d-block mb-2" style="font-size:2rem;color:#6ABF4B"></i>
                            <div class="fw-semibold small">Checklist ISO 14001</div>
                            <StatusChip Estado="Saludable" Texto="93%" />
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a href="/proyectos/@ProyectoId/hseq/ambiental/inspecciones" class="text-decoration-none">
                        <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                            <i class="bi-binoculars-fill d-block mb-2" style="font-size:2rem;color:#6ABF4B"></i>
                            <div class="fw-semibold small">Inspecciones Ambientales</div>
                            <StatusChip Estado="Saludable" Texto="12 realizadas" />
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a href="/proyectos/@ProyectoId/hseq/ambiental/residuos" class="text-decoration-none">
                        <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                            <i class="bi-recycle d-block mb-2" style="font-size:2rem;color:#6ABF4B"></i>
                            <div class="fw-semibold small">Gestión de Residuos</div>
                            <StatusChip Estado="Informativo" Texto="2.4t gestionadas" />
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a href="/proyectos/@ProyectoId/hseq/ambiental/aspectos" class="text-decoration-none">
                        <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                            <i class="bi-diagram-3-fill d-block mb-2" style="font-size:2rem;color:#6ABF4B"></i>
                            <div class="fw-semibold small">Aspectos e Impactos</div>
                            <StatusChip Estado="Saludable" Texto="15/16 controlados" />
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a href="/proyectos/@ProyectoId/hseq/ambiental/derrames" class="text-decoration-none">
                        <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                            <i class="bi-droplet-fill d-block mb-2" style="font-size:2rem;color:#6ABF4B"></i>
                            <div class="fw-semibold small">Derrames</div>
                            <StatusChip Estado="Saludable" Texto="0 registrados" />
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-4">
                    <a href="/proyectos/@ProyectoId/hseq/ambiental/fauna-flora" class="text-decoration-none">
                        <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                            <i class="bi-flower2 d-block mb-2" style="font-size:2rem;color:#6ABF4B"></i>
                            <div class="fw-semibold small">Fauna y Flora</div>
                            <StatusChip Estado="Informativo" Texto="3 registros" />
                        </div>
                    </a>
                </div>
            </div>
        </SeccionDash>

        <!-- ── Nivel 5: Análisis Inteligente IA ── -->
        <AIPanel Titulo="Análisis Inteligente"
                 Subtitulo="@("Ambiental · " + DateTime.Now.ToString("MMMM yyyy"))"
                 EstadoGeneral="Desempeño ambiental SALUDABLE para el período analizado."
                 EsSimulado="true">
            <Hallazgos>
                <ul>
                    <li>Cumplimiento ISO 14001 en 93%, por encima de la meta del 90%.</li>
                    <li>Sin derrames registrados en el período — indicador en cero consecutivo.</li>
                    <li>El 75% de los residuos generados fue aprovechado o reciclado.</li>
                    <li>1 aspecto ambiental pendiente de control en el frente civil.</li>
                </ul>
            </Hallazgos>
            <Recomendaciones>
                <ul>
                    <li>Continuar seguimiento al aspecto ambiental sin controlar antes del cierre del período.</li>
                    <li>Programar la próxima auditoría ISO 14001 antes del 20 de julio.</li>
                    <li>Registrar el informe de residuos peligrosos con la empresa gestora certificada.</li>
                </ul>
            </Recomendaciones>
        </AIPanel>

    </DashboardLayout>
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    private Proyecto? _proyecto;

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) Navigation.NavigateTo("/proyectos");
    }
}
