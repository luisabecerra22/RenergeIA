@page "/proyectos/{ProyectoId:int}/hseq/ambiental/fauna-flora"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ

<PageTitle>Fauna y Flora — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <PageHeader Titulo="Fauna y Flora"
                Icono="bi-bug"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/ambiental")"
                TextoVolver="Ambiental">
        <Acciones>
            <button class="btn btn-success btn-sm" @onclick="MostrarFormulario">
                <i class="bi-plus-lg me-1"></i>Nuevo Registro
            </button>
        </Acciones>
    </PageHeader>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-header text-white d-flex justify-content-between" style="background:#6ABF4B">
                <strong>Registro de Fauna y Flora</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Tipo *</label>
                            <InputSelect class="form-select" @bind-Value="_form.Tipo">
                                <option value="Fauna">Fauna</option>
                                <option value="Flora">Flora</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Especie *</label>
                            <InputText class="form-control" @bind-Value="_form.Especie" placeholder="Nombre común" />
                            <ValidationMessage For="() => _form.Especie" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nombre Científico</label>
                            <InputText class="form-control" @bind-Value="_form.NombreCientifico" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Estado de Conservación</label>
                            <InputText class="form-control" @bind-Value="_form.Estado" placeholder="Ej: VU, EN, LC, CR" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ubicación</label>
                            <InputText class="form-control" @bind-Value="_form.Ubicacion" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha Registro</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaRegistro" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Registrado Por</label>
                            <InputText class="form-control" @bind-Value="_form.RegistradoPor" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Acciones de Manejo</label>
                            <InputText class="form-control" @bind-Value="_form.AccionesManejo" placeholder="Ej: Rescate y relocalización, Protección in situ" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Observaciones" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <FilterBar>
        <select class="form-select form-select-sm" style="max-width:160px" @bind="_filtroTipo">
            <option value="">Fauna + Flora</option>
            <option value="Fauna">Solo Fauna</option>
            <option value="Flora">Solo Flora</option>
        </select>
    </FilterBar>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <ExecutiveCard Titulo="Total Registros"
                           Valor="@_registros.Count.ToString()"
                           Icono="bi-bug"
                           Estado="Informativo" />
        </div>
        <div class="col-md-3">
            <ExecutiveCard Titulo="Fauna"
                           Valor="@_registros.Count(r => r.Tipo == "Fauna").ToString()"
                           Icono="bi-bug"
                           Estado="Informativo" />
        </div>
        <div class="col-md-3">
            <ExecutiveCard Titulo="Flora"
                           Valor="@_registros.Count(r => r.Tipo == "Flora").ToString()"
                           Icono="bi-tree"
                           Estado="Saludable" />
        </div>
        <div class="col-md-3">
            <ExecutiveCard Titulo="Con Estado Especial"
                           Valor="@_registros.Count(r => !string.IsNullOrEmpty(r.Estado) && r.Estado != "LC").ToString()"
                           Icono="bi-exclamation-circle"
                           Estado="@(_registros.Any(r => !string.IsNullOrEmpty(r.Estado) && r.Estado != "LC") ? "En Riesgo" : "Saludable")" />
        </div>
    </div>

    <SmartTable Columnas="7"
                MostrarBusqueda="true"
                PlaceholderBusqueda="Buscar especie..."
                BusquedaCambiada="OnBusqueda"
                Vacio="!RegistrosFiltrados.Any()"
                MensajeVacio="No hay registros de fauna y flora.">
        <Encabezados>
            <tr>
                <th>Tipo</th>
                <th>Especie</th>
                <th>Estado Conservación</th>
                <th>Ubicación</th>
                <th>Registrado Por</th>
                <th>Fecha</th>
                <th class="text-center">Acciones</th>
            </tr>
        </Encabezados>
        <Filas>
            @foreach (var r in RegistrosFiltrados)
            {
                <tr>
                    <td>
                        <span class="badge @(r.Tipo == "Fauna" ? "bg-primary" : "bg-success")">
                            <i class="bi-@(r.Tipo == "Fauna" ? "bug" : "tree") me-1"></i>@r.Tipo
                        </span>
                    </td>
                    <td class="fw-semibold">@r.Especie</td>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(r.Estado))
                        {
                            <span class="badge @(r.Estado == "LC" ? "bg-success" : r.Estado == "VU" ? "bg-warning text-dark" : "bg-danger")">
                                @r.Estado
                            </span>
                        }
                        else { <span class="text-muted">—</span> }
                    </td>
                    <td class="small text-muted">@(string.IsNullOrEmpty(r.Ubicacion) ? "—" : r.Ubicacion)</td>
                    <td class="small">@(string.IsNullOrEmpty(r.RegistradoPor) ? "—" : r.RegistradoPor)</td>
                    <td class="small">@r.FechaRegistro.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        @if (_confirmandoEliminar == r.Id)
                        {
                            <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(r.Id)">Sí</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = r.Id"><i class="bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
        </Filas>
    </SmartTable>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<RegistroFaunaFlora> _registros = [];
    private bool _mostrarFormulario;
    private int? _confirmandoEliminar;
    private string _busqueda = "";
    private string _filtroTipo = "";
    private FormModel _form = new();

    private IEnumerable<RegistroFaunaFlora> RegistrosFiltrados => _registros
        .Where(r =>
            (string.IsNullOrEmpty(_filtroTipo) || r.Tipo == _filtroTipo)
            && (string.IsNullOrEmpty(_busqueda) || r.Especie.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)));

    private void OnBusqueda(string v) => _busqueda = v;

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        _registros = await Db.RegistrosFaunaFlora.Where(r => r.ProyectoId == ProyectoId).OrderByDescending(r => r.FechaRegistro).ToListAsync();

    private void MostrarFormulario() { _form = new FormModel { FechaRegistro = DateTime.Today }; _mostrarFormulario = true; }
    private void CancelarFormulario() => _mostrarFormulario = false;

    private async Task GuardarAsync()
    {
        Db.RegistrosFaunaFlora.Add(new RegistroFaunaFlora
        {
            ProyectoId      = ProyectoId,
            Tipo            = _form.Tipo,
            Especie         = _form.Especie,
            NombreCientifico = _form.NombreCientifico ?? "",
            Estado          = _form.Estado ?? "",
            Ubicacion       = _form.Ubicacion ?? "",
            FechaRegistro   = _form.FechaRegistro,
            RegistradoPor   = _form.RegistradoPor ?? "",
            AccionesManejo  = _form.AccionesManejo,
            Observaciones   = _form.Observaciones
        });
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var r = await Db.RegistrosFaunaFlora.FindAsync(id);
        if (r is not null) { Db.RegistrosFaunaFlora.Remove(r); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private sealed class FormModel
    {
        public string Tipo { get; set; } = "Fauna";
        [System.ComponentModel.DataAnnotations.Required] public string Especie { get; set; } = "";
        public string? NombreCientifico { get; set; }
        public string? Estado { get; set; }
        public string? Ubicacion { get; set; }
        public DateTime FechaRegistro { get; set; } = DateTime.Today;
        public string? RegistradoPor { get; set; }
        public string? AccionesManejo { get; set; }
        public string? Observaciones { get; set; }
    }
}
