@page "/proyectos/{ProyectoId:int}/hseq/ambiental/acciones"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>Acciones Correctivas Ambientales — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <PageHeader Titulo="Acciones Correctivas Ambientales"
                Icono="bi-wrench-adjustable-circle"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/ambiental")"
                TextoVolver="Ambiental" />

    <div class="alert alert-success border-0 shadow-sm mb-4">
        <i class="bi-info-circle me-2"></i>
        Las acciones correctivas ambientales se generan desde los hallazgos en <strong>Inspecciones Ambientales</strong>.
        <a href="/proyectos/@ProyectoId/hseq/ambiental/inspecciones" class="alert-link ms-1">Ir a Inspecciones →</a>
    </div>

    var vencidas = _acciones.Count(a => a.FechaCompromiso < DateTime.Today && a.Estado != EstadoNoConformidad.Cerrada);
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <ExecutiveCard Titulo="Total Acciones"
                           Valor="@_acciones.Count.ToString()"
                           Icono="bi-wrench-adjustable-circle"
                           Estado="Informativo" />
        </div>
        <div class="col-md-3">
            <ExecutiveCard Titulo="Cerradas"
                           Valor="@_acciones.Count(a => a.Estado == EstadoNoConformidad.Cerrada).ToString()"
                           Icono="bi-check-circle"
                           Estado="Saludable" />
        </div>
        <div class="col-md-3">
            <ExecutiveCard Titulo="En Proceso"
                           Valor="@_acciones.Count(a => a.Estado == EstadoNoConformidad.EnImplementacion).ToString()"
                           Icono="bi-arrow-repeat"
                           Estado="En Riesgo" />
        </div>
        <div class="col-md-3">
            <ExecutiveCard Titulo="Vencidas"
                           Valor="@vencidas.ToString()"
                           Icono="bi-calendar-x"
                           Estado="@(vencidas > 0 ? "Crítico" : "Saludable")" />
        </div>
    </div>

    <SmartTable Columnas="5"
                MostrarBusqueda="true"
                PlaceholderBusqueda="Buscar por descripción o responsable..."
                BusquedaCambiada="OnBusqueda"
                Vacio="!AccionesFiltradas.Any()"
                MensajeVacio="No hay acciones correctivas ambientales.">
        <Encabezados>
            <tr>
                <th>Descripción</th>
                <th>Responsable</th>
                <th>Plazo</th>
                <th class="text-center">Avance</th>
                <th class="text-center">Estado</th>
            </tr>
        </Encabezados>
        <Filas>
            @foreach (var a in AccionesFiltradas)
            {
                var esVencida = a.FechaCompromiso < DateTime.Today && a.Estado != EstadoNoConformidad.Cerrada;
                <tr class="@(esVencida ? "table-danger" : "")">
                    <td>
                        <div>@a.Descripcion</div>
                        <div class="text-muted small">@a.HallazgoHSEQ?.Titulo</div>
                    </td>
                    <td class="small">@a.Responsable</td>
                    <td class="small @(esVencida ? "text-danger fw-bold" : "")">@a.FechaCompromiso.ToString("dd/MM/yyyy")</td>
                    <td class="text-center" style="min-width:120px">
                        <div class="progress" style="height:8px;border-radius:4px">
                            <div class="progress-bar bg-success" style="width:@a.AvancePorcentaje%"></div>
                        </div>
                        <small class="text-muted">@a.AvancePorcentaje%</small>
                    </td>
                    <td class="text-center">
                        <StatusChip Estado="@(a.Estado == EstadoNoConformidad.Cerrada ? "Saludable" : a.Estado == EstadoNoConformidad.EnImplementacion ? "En Riesgo" : "Riesgo")"
                                    Texto="@EnumDisplay.Mostrar(a.Estado)" />
                    </td>
                </tr>
            }
        </Filas>
    </SmartTable>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<AccionHSEQ> _acciones = [];
    private string _busqueda = "";

    private IEnumerable<AccionHSEQ> AccionesFiltradas => _acciones
        .Where(a => string.IsNullOrEmpty(_busqueda) ||
                    a.Descripcion.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                    a.Responsable.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
        .OrderBy(a => a.FechaCompromiso);

    private void OnBusqueda(string v) => _busqueda = v;

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        _acciones = await Db.AccionesHSEQ
            .Include(a => a.HallazgoHSEQ)
            .Where(a => a.HallazgoHSEQ != null && a.HallazgoHSEQ.ProyectoId == ProyectoId && a.HallazgoHSEQ.Division == DivisionHSEQ.Ambiental)
            .OrderBy(a => a.FechaCompromiso)
            .ToListAsync();
    }

}
