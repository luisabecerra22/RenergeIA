@page "/proyectos/{ProyectoId:int}/hseq/ambiental/derrames"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>Derrames — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <PageHeader Titulo="Registro de Derrames"
                Icono="bi-droplet-half"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq/ambiental")"
                TextoVolver="Ambiental">
        <Acciones>
            <button class="btn btn-danger btn-sm" @onclick="MostrarFormulario">
                <i class="bi-plus-lg me-1"></i>Registrar Derrame
            </button>
        </Acciones>
    </PageHeader>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-danger">
            <div class="card-header bg-danger text-white d-flex justify-content-between">
                <strong>Nuevo Derrame</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Número *</label>
                            <InputText class="form-control" @bind-Value="_form.Numero" />
                            <ValidationMessage For="() => _form.Numero" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sustancia *</label>
                            <InputText class="form-control" @bind-Value="_form.Sustancia" placeholder="Ej: Aceite hidráulico, Combustible" />
                            <ValidationMessage For="() => _form.Sustancia" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Volumen (L)</label>
                            <InputNumber class="form-control" @bind-Value="_form.VolumenLitros" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Frente de Trabajo</label>
                            <InputText class="form-control" @bind-Value="_form.FrenteTrabajo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Reportado Por *</label>
                            <InputText class="form-control" @bind-Value="_form.ReportadoPor" />
                            <ValidationMessage For="() => _form.ReportadoPor" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha Evento</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaEvento" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Estado</label>
                            <InputSelect class="form-select" @bind-Value="_form.Estado">
                                @foreach (var e in Enum.GetValues<EstadoNoConformidad>())
                                { <option value="@e">@EnumDisplay.Mostrar(e)</option> }
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Causa Raíz</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.CausaRaiz" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Acciones Inmediatas</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.AccionesInmediatas" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-danger btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <ExecutiveCard Titulo="Derrames Registrados"
                           Valor="@_derrames.Count.ToString()"
                           Icono="bi-droplet-half"
                           Estado="@(_derrames.Any() ? "Crítico" : "Saludable")" />
        </div>
        <div class="col-md-4">
            <ExecutiveCard Titulo="Total Litros Derramados"
                           Valor="@_derrames.Sum(d => d.VolumenLitros).ToString("N1")"
                           Icono="bi-droplet"
                           Estado="@(_derrames.Sum(d => d.VolumenLitros) > 0 ? "En Riesgo" : "Saludable")" />
        </div>
        <div class="col-md-4">
            @if (_derrames.Any())
            {
                <ExecutiveCard Titulo="Último Derrame"
                               Valor="@_derrames.Max(d => d.FechaEvento).ToString("dd/MM/yyyy")"
                               Icono="bi-calendar-x"
                               Estado="Crítico" />
            }
            else
            {
                <ExecutiveCard Titulo="Estado Ambiental"
                               Valor="Sin derrames"
                               Icono="bi-check-circle"
                               Estado="Saludable" />
            }
        </div>
    </div>

    <SmartTable Columnas="8"
                MostrarBusqueda="true"
                PlaceholderBusqueda="Buscar por sustancia o reportado por..."
                BusquedaCambiada="OnBusqueda"
                Vacio="!DerramasFiltrados.Any()"
                MensajeVacio="Sin derrames registrados. ¡Excelente desempeño ambiental!">
        <Encabezados>
            <tr>
                <th>Número</th>
                <th>Sustancia</th>
                <th class="text-center">Litros</th>
                <th>Frente</th>
                <th>Reportado Por</th>
                <th>Fecha</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </Encabezados>
        <Filas>
            @foreach (var d in DerramasFiltrados)
            {
                <tr>
                    <td class="font-monospace small text-muted">@d.Numero</td>
                    <td>@d.Sustancia</td>
                    <td class="text-center fw-semibold">@d.VolumenLitros.ToString("N1")</td>
                    <td class="small text-muted">@d.FrenteTrabajo</td>
                    <td class="small">@d.ReportadoPor</td>
                    <td class="small">@d.FechaEvento.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <StatusChip Estado="@(d.Estado == EstadoNoConformidad.Cerrada ? "Saludable" : d.Estado == EstadoNoConformidad.EnImplementacion ? "En Riesgo" : "Crítico")"
                                    Texto="@EnumDisplay.Mostrar(d.Estado)" />
                    </td>
                    <td class="text-center">
                        @if (_confirmandoEliminar == d.Id)
                        {
                            <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(d.Id)">Sí</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = d.Id"><i class="bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
        </Filas>
    </SmartTable>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<Derrame> _derrames = [];
    private bool _mostrarFormulario;
    private int? _confirmandoEliminar;
    private string _busqueda = "";
    private FormModel _form = new();

    private IEnumerable<Derrame> DerramasFiltrados => _derrames
        .Where(d => string.IsNullOrEmpty(_busqueda) ||
                    d.Sustancia.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                    d.ReportadoPor.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(d => d.FechaEvento);

    private void OnBusqueda(string v) => _busqueda = v;

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        _derrames = await Db.Derrames.Where(d => d.ProyectoId == ProyectoId).OrderByDescending(d => d.FechaEvento).ToListAsync();

    private void MostrarFormulario() { _form = new FormModel { FechaEvento = DateTime.Today }; _mostrarFormulario = true; }
    private void CancelarFormulario() => _mostrarFormulario = false;

    private async Task GuardarAsync()
    {
        Db.Derrames.Add(new Derrame
        {
            ProyectoId       = ProyectoId,
            Numero           = _form.Numero,
            Sustancia        = _form.Sustancia,
            VolumenLitros    = _form.VolumenLitros,
            FrenteTrabajo    = _form.FrenteTrabajo ?? "",
            ReportadoPor     = _form.ReportadoPor,
            FechaEvento      = _form.FechaEvento,
            Estado           = _form.Estado,
            CausaRaiz        = _form.CausaRaiz,
            AccionesInmediatas = _form.AccionesInmediatas
        });
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var d = await Db.Derrames.FindAsync(id);
        if (d is not null) { Db.Derrames.Remove(d); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Numero { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Sustancia { get; set; } = "";
        public decimal VolumenLitros { get; set; }
        public string? FrenteTrabajo { get; set; }
        [System.ComponentModel.DataAnnotations.Required] public string ReportadoPor { get; set; } = "";
        public DateTime FechaEvento { get; set; } = DateTime.Today;
        public EstadoNoConformidad Estado { get; set; } = EstadoNoConformidad.Abierta;
        public string? CausaRaiz { get; set; }
        public string? AccionesInmediatas { get; set; }
    }
}
