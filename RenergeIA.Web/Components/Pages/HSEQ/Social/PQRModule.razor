@page "/proyectos/{ProyectoId:int}/hseq/social/pqr"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using RenergeIA.Core.Enums

<PageTitle>PQR — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <a href="/proyectos/@ProyectoId/hseq/social" class="btn btn-sm btn-outline-secondary">&larr; Social</a>
        <div class="flex-grow-1">
            <h1 class="h4 mb-0"><i class="bi-chat-right-text me-2" style="color:#183963"></i>PQR — Peticiones, Quejas y Reclamos</h1>
            <small class="text-muted">@_proyecto.Nombre</small>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="MostrarFormulario">
            <i class="bi-plus-lg me-1"></i>Nueva PQR
        </button>
    </div>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <strong>Nueva PQR</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Número *</label>
                            <InputText class="form-control" @bind-Value="_form.Numero" />
                            <ValidationMessage For="() => _form.Numero" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Tipo</label>
                            <InputSelect class="form-select" @bind-Value="_form.Tipo">
                                @foreach (var t in Enum.GetValues<TipoPQR>())
                                { <option value="@t">@EnumDisplay.Mostrar(t)</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Estado</label>
                            <InputSelect class="form-select" @bind-Value="_form.Estado">
                                @foreach (var e in Enum.GetValues<EstadoPQR>())
                                { <option value="@e">@EnumDisplay.Mostrar(e)</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Comunidad</label>
                            <InputSelect class="form-select" @bind-Value="_form.ComunidadId">
                                <option value="">— Sin comunidad —</option>
                                @foreach (var c in _comunidades)
                                { <option value="@c.Id">@c.Nombre</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Solicitante *</label>
                            <InputText class="form-control" @bind-Value="_form.Solicitante" placeholder="Nombre de quien radica" />
                            <ValidationMessage For="() => _form.Solicitante" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha Radicación</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaRecepcion" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha Límite Respuesta</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaLimiteRespuesta" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción *</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Descripcion" />
                            <ValidationMessage For="() => _form.Descripcion" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Respuesta / Solución</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Respuesta" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Semáforos por tipo -->
    <div class="row g-3 mb-4">
        @foreach (var tipo in Enum.GetValues<TipoPQR>())
        {
            var cnt = _pqrs.Count(p => p.Tipo == tipo);
            <div class="col-6 col-md-2">
                <div class="card shadow-sm p-2 text-center border-start border-4 border-primary">
                    <div class="fw-bold" style="font-size:1.4rem;color:#183963">@cnt</div>
                    <div class="text-muted" style="font-size:0.75rem">@EnumDisplay.Mostrar(tipo)</div>
                </div>
            </div>
        }
        <div class="col-6 col-md-2">
            <div class="card shadow-sm p-2 text-center border-start border-4 border-danger">
                <div class="fw-bold" style="font-size:1.4rem;color:#dc3545">
                    @_pqrs.Count(p => p.FechaLimiteRespuesta < DateTime.Today && p.Estado != EstadoPQR.Cerrada)
                </div>
                <div class="text-muted" style="font-size:0.75rem">Vencidas</div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-3 flex-wrap">
        <input class="form-control form-control-sm" style="max-width:220px" placeholder="Buscar número o radicante..."
               @bind="_busqueda" @bind:event="oninput" />
        <select class="form-select form-select-sm" style="max-width:150px" @bind="_filtroEstado">
            <option value="">Todos los estados</option>
            @foreach (var e in Enum.GetValues<EstadoPQR>())
            { <option value="@e">@EnumDisplay.Mostrar(e)</option> }
        </select>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th class="text-center">Tipo</th>
                        <th>Solicitante</th>
                        <th>F. Radicación</th>
                        <th>F. Límite</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!PQRsFiltrados.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay PQRs registradas.</td></tr>
                    }
                    @foreach (var p in PQRsFiltrados)
                    {
                        var vencida = p.FechaLimiteRespuesta < DateTime.Today && p.Estado != EstadoPQR.Cerrada;
                        <tr class="@(vencida ? "table-warning" : "")">
                            <td class="font-monospace small">@p.Numero</td>
                            <td class="text-center"><span class="badge bg-primary-subtle text-primary-emphasis">@EnumDisplay.Mostrar(p.Tipo)</span></td>
                            <td>@p.Solicitante</td>
                            <td class="small">@p.FechaRecepcion.ToString("dd/MM/yyyy")</td>
                            <td class="small @(vencida ? "text-danger fw-bold" : "")">
                                @p.FechaLimiteRespuesta.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-center"><span class="badge @BadgePQR(p.Estado)">@EnumDisplay.Mostrar(p.Estado)</span></td>
                            <td class="text-center">
                                @if (_confirmandoEliminar == p.Id)
                                {
                                    <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(p.Id)">Sí</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = p.Id"><i class="bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<PQRHseq> _pqrs = [];
    private List<Comunidad> _comunidades = [];
    private bool _mostrarFormulario;
    private int? _confirmandoEliminar;
    private string _busqueda = "";
    private string _filtroEstado = "";
    private FormModel _form = new();

    private IEnumerable<PQRHseq> PQRsFiltrados => _pqrs
        .Where(p =>
            (string.IsNullOrEmpty(_busqueda) || p.Numero.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) || p.Solicitante.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrEmpty(_filtroEstado) || p.Estado.ToString() == _filtroEstado));

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        _comunidades = await Db.Comunidades.Where(c => c.ProyectoId == ProyectoId).OrderBy(c => c.Nombre).ToListAsync();
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        _pqrs = await Db.PQRsHseq.Where(p => p.ProyectoId == ProyectoId).OrderByDescending(p => p.FechaRecepcion).ToListAsync();

    private void MostrarFormulario() { _form = new FormModel(); _mostrarFormulario = true; }
    private void CancelarFormulario() => _mostrarFormulario = false;

    private async Task GuardarAsync()
    {
        Db.PQRsHseq.Add(new PQRHseq
        {
            ProyectoId            = ProyectoId,
            Numero                = _form.Numero,
            Tipo                  = _form.Tipo,
            Estado                = _form.Estado,
            ComunidadId           = _form.ComunidadId == 0 ? null : _form.ComunidadId,
            Solicitante             = _form.Solicitante,
            FechaRecepcion       = _form.FechaRecepcion,
            FechaLimiteRespuesta  = _form.FechaLimiteRespuesta == default ? DateTime.Today.AddDays(15) : _form.FechaLimiteRespuesta,
            Descripcion           = _form.Descripcion,
            Respuesta             = _form.Respuesta
        });
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var p = await Db.PQRsHseq.FindAsync(id);
        if (p is not null) { Db.PQRsHseq.Remove(p); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private static string BadgePQR(EstadoPQR e) => e switch
    {
        EstadoPQR.Cerrada   => "bg-success",
        EstadoPQR.Abierta   => "bg-primary",
        EstadoPQR.EnGestion => "bg-warning text-dark",
        EstadoPQR.Vencida   => "bg-danger",
        _                     => "bg-secondary"
    };

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Numero { get; set; } = "";
        public TipoPQR Tipo { get; set; } = TipoPQR.Queja;
        public EstadoPQR Estado { get; set; } = EstadoPQR.Abierta;
        public int ComunidadId { get; set; }
        [System.ComponentModel.DataAnnotations.Required] public string Solicitante { get; set; } = "";
        public DateTime FechaRecepcion { get; set; } = DateTime.Today;
        public DateTime FechaLimiteRespuesta { get; set; } = DateTime.Today.AddDays(15);
        [System.ComponentModel.DataAnnotations.Required] public string Descripcion { get; set; } = "";
        public string? Respuesta { get; set; }
    }
}
