@page "/proyectos/{ProyectoId:int}/hseq/social/compras-locales"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ

<PageTitle>Compras Locales — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <a href="/proyectos/@ProyectoId/hseq/social" class="btn btn-sm btn-outline-secondary">&larr; Social</a>
        <div class="flex-grow-1">
            <h1 class="h4 mb-0"><i class="bi-cart-check me-2" style="color:#183963"></i>Compras Locales</h1>
            <small class="text-muted">@_proyecto.Nombre</small>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="MostrarFormulario">
            <i class="bi-plus-lg me-1"></i>Registrar Compra
        </button>
    </div>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <strong>Registro de Compra Local</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Proveedor *</label>
                            <InputText class="form-control" @bind-Value="_form.Proveedor" />
                            <ValidationMessage For="() => _form.Proveedor" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Descripción / Bien o Servicio *</label>
                            <InputText class="form-control" @bind-Value="_form.Descripcion" />
                            <ValidationMessage For="() => _form.Descripcion" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Municipio *</label>
                            <InputText class="form-control" @bind-Value="_form.Municipio" />
                            <ValidationMessage For="() => _form.Municipio" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Valor COP</label>
                            <InputNumber class="form-control" @bind-Value="_form.ValorCOP" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha</label>
                            <InputDate class="form-control" @bind-Value="_form.Fecha" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">N° Factura</label>
                            <InputText class="form-control" @bind-Value="_form.NumeroFactura" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_form.EsLocal" id="esLocalComp" />
                                <label class="form-check-label" for="esLocalComp">Proveedor local</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Observaciones" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-primary">
                <div class="fw-bold" style="font-size:1.8rem;color:#183963">@_compras.Count</div>
                <div class="text-muted small">Total compras</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-success">
                <div class="fw-bold" style="font-size:1.8rem;color:#6ABF4B">@_compras.Count(c => c.EsLocal)</div>
                <div class="text-muted small">A proveedores locales</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-primary">
                <div class="fw-bold" style="font-size:1.3rem;color:#183963">$@_compras.Sum(c => c.ValorCOP).ToString("N0")</div>
                <div class="text-muted small">Total compras</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-success">
                <div class="fw-bold" style="font-size:1.3rem;color:#6ABF4B">$@_compras.Where(c => c.EsLocal).Sum(c => c.ValorCOP).ToString("N0")</div>
                <div class="text-muted small">Total compras locales</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Proveedor</th>
                        <th>Descripción</th>
                        <th>Municipio</th>
                        <th class="text-center">Valor COP</th>
                        <th>Fecha</th>
                        <th>Factura</th>
                        <th class="text-center">Tipo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_compras.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No hay compras locales registradas.</td></tr>
                    }
                    @foreach (var c in _compras.OrderByDescending(x => x.Fecha))
                    {
                        <tr>
                            <td class="fw-semibold">@c.Proveedor</td>
                            <td class="small">@c.Descripcion</td>
                            <td class="small text-muted">@c.Municipio</td>
                            <td class="text-center fw-semibold">$@c.ValorCOP.ToString("N0")</td>
                            <td class="small">@c.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="small text-muted">@(c.NumeroFactura ?? "—")</td>
                            <td class="text-center">
                                @if (c.EsLocal)
                                { <span class="badge bg-success">Local</span> }
                                else
                                { <span class="badge bg-secondary">Foráneo</span> }
                            </td>
                            <td class="text-center">
                                @if (_confirmandoEliminar == c.Id)
                                {
                                    <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(c.Id)">Sí</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = c.Id"><i class="bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<CompraLocal> _compras = [];
    private bool _mostrarFormulario;
    private int? _confirmandoEliminar;
    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        _compras = await Db.ComprasLocales.Where(c => c.ProyectoId == ProyectoId).OrderByDescending(c => c.Fecha).ToListAsync();

    private void MostrarFormulario() { _form = new FormModel { Fecha = DateTime.Today, EsLocal = true }; _mostrarFormulario = true; }
    private void CancelarFormulario() => _mostrarFormulario = false;

    private async Task GuardarAsync()
    {
        Db.ComprasLocales.Add(new CompraLocal
        {
            ProyectoId    = ProyectoId,
            Proveedor     = _form.Proveedor,
            Descripcion   = _form.Descripcion,
            Municipio     = _form.Municipio,
            ValorCOP      = _form.ValorCOP,
            Fecha         = _form.Fecha,
            NumeroFactura = _form.NumeroFactura,
            EsLocal       = _form.EsLocal,
            Observaciones = _form.Observaciones
        });
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var c = await Db.ComprasLocales.FindAsync(id);
        if (c is not null) { Db.ComprasLocales.Remove(c); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Proveedor { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Descripcion { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Municipio { get; set; } = "";
        public decimal ValorCOP { get; set; }
        public DateTime Fecha { get; set; } = DateTime.Today;
        public string? NumeroFactura { get; set; }
        public bool EsLocal { get; set; } = true;
        public string? Observaciones { get; set; }
    }
}
