@page "/proyectos/{ProyectoId:int}/hseq/social/actas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ

<PageTitle>Actas y Evidencias — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <a href="/proyectos/@ProyectoId/hseq/social" class="btn btn-sm btn-outline-secondary">&larr; Social</a>
        <div class="flex-grow-1">
            <h1 class="h4 mb-0"><i class="bi-file-earmark-text me-2" style="color:#183963"></i>Actas y Evidencias Sociales</h1>
            <small class="text-muted">@_proyecto.Nombre</small>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="MostrarFormulario">
            <i class="bi-plus-lg me-1"></i>Nueva Acta
        </button>
    </div>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <strong>Registro de Acta / Evidencia</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Tipo de Documento *</label>
                            <InputSelect class="form-select" @bind-Value="_form.Tipo">
                                <option value="Acta de Reunión">Acta de Reunión</option>
                                <option value="Acta de Compromiso">Acta de Compromiso</option>
                                <option value="Registro Fotográfico">Registro Fotográfico</option>
                                <option value="Lista de Asistencia">Lista de Asistencia</option>
                                <option value="Certificación">Certificación</option>
                                <option value="Otro">Otro</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha</label>
                            <InputDate class="form-control" @bind-Value="_form.Fecha" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Comunidad / Parte</label>
                            <InputText class="form-control" @bind-Value="_form.ComunidadOParte" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Título *</label>
                            <InputText class="form-control" @bind-Value="_form.Titulo" />
                            <ValidationMessage For="() => _form.Titulo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Responsable Elaboración</label>
                            <InputText class="form-control" @bind-Value="_form.ResponsableElaboracion" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Descripción *</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Descripcion" />
                            <ValidationMessage For="() => _form.Descripcion" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Firmantes</label>
                            <InputText class="form-control" @bind-Value="_form.Firmantes" placeholder="Nombres separados por coma" />
                        </div>
                        <div class="col-md-10">
                            <label class="form-label">URL Archivo (SharePoint / Drive)</label>
                            <InputText class="form-control" @bind-Value="_form.ArchivoUrl" placeholder="https://..." />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="d-flex gap-2 mb-3">
        <input class="form-control form-control-sm" style="max-width:250px" placeholder="Buscar título..."
               @bind="_busqueda" @bind:event="oninput" />
        <select class="form-select form-select-sm" style="max-width:180px" @bind="_filtroTipo">
            <option value="">Todos los tipos</option>
            <option value="Acta de Reunión">Acta de Reunión</option>
            <option value="Acta de Compromiso">Acta de Compromiso</option>
            <option value="Registro Fotográfico">Registro Fotográfico</option>
            <option value="Lista de Asistencia">Lista de Asistencia</option>
            <option value="Certificación">Certificación</option>
            <option value="Otro">Otro</option>
        </select>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tipo</th>
                        <th>Título</th>
                        <th>Comunidad / Parte</th>
                        <th>Fecha</th>
                        <th>Elaborado Por</th>
                        <th class="text-center">Archivo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!ActasFiltradas.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay actas ni evidencias registradas.</td></tr>
                    }
                    @foreach (var a in ActasFiltradas)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@a.Tipo</span></td>
                            <td>@a.Titulo</td>
                            <td class="small text-muted">@(a.ComunidadOParte ?? "—")</td>
                            <td class="small">@a.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="small">@(a.ResponsableElaboracion ?? "—")</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(a.ArchivoUrl))
                                { <a href="@a.ArchivoUrl" target="_blank" class="btn btn-outline-primary btn-sm"><i class="bi-link-45deg"></i></a> }
                                else
                                { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-center">
                                @if (_confirmandoEliminar == a.Id)
                                {
                                    <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(a.Id)">Sí</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = a.Id"><i class="bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<ActaEvidencia> _actas = [];
    private bool _mostrarFormulario;
    private int? _confirmandoEliminar;
    private string _busqueda = "";
    private string _filtroTipo = "";
    private FormModel _form = new();

    private IEnumerable<ActaEvidencia> ActasFiltradas => _actas
        .Where(a =>
            (string.IsNullOrEmpty(_filtroTipo) || a.Tipo == _filtroTipo)
            && (string.IsNullOrEmpty(_busqueda) || a.Titulo.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        _actas = await Db.ActasEvidencias.Where(a => a.ProyectoId == ProyectoId).OrderByDescending(a => a.Fecha).ToListAsync();

    private void MostrarFormulario() { _form = new FormModel { Fecha = DateTime.Today }; _mostrarFormulario = true; }
    private void CancelarFormulario() => _mostrarFormulario = false;

    private async Task GuardarAsync()
    {
        Db.ActasEvidencias.Add(new ActaEvidencia
        {
            ProyectoId              = ProyectoId,
            Tipo                    = _form.Tipo,
            Titulo                  = _form.Titulo,
            Fecha                   = _form.Fecha,
            ComunidadOParte         = _form.ComunidadOParte,
            Descripcion             = _form.Descripcion,
            ResponsableElaboracion  = _form.ResponsableElaboracion,
            Firmantes               = _form.Firmantes,
            ArchivoUrl              = _form.ArchivoUrl
        });
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var a = await Db.ActasEvidencias.FindAsync(id);
        if (a is not null) { Db.ActasEvidencias.Remove(a); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private sealed class FormModel
    {
        public string Tipo { get; set; } = "Acta de Reunión";
        [System.ComponentModel.DataAnnotations.Required] public string Titulo { get; set; } = "";
        public DateTime Fecha { get; set; } = DateTime.Today;
        public string? ComunidadOParte { get; set; }
        [System.ComponentModel.DataAnnotations.Required] public string Descripcion { get; set; } = "";
        public string? ResponsableElaboracion { get; set; }
        public string? Firmantes { get; set; }
        public string? ArchivoUrl { get; set; }
    }
}
