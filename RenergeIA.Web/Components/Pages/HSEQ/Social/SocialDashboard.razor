@page "/proyectos/{ProyectoId:int}/hseq/social"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Enums

<PageTitle>Social HSEQ — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <PageHeader Titulo="Social"
                Icono="bi-people-fill"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}/hseq")"
                TextoVolver="HSEQ">
        <Acciones>
            <StatusChip Estado="Crítico" Grande="true" />
        </Acciones>
    </PageHeader>

    <!-- Navegación -->
    <div class="d-flex gap-2 flex-wrap mb-4">
        <span class="btn btn-sm" style="background:#fd7e14;color:white">Dashboard</span>
        <a href="/proyectos/@ProyectoId/hseq/social/comunidades"          class="btn btn-outline-secondary btn-sm">Comunidades</a>
        <a href="/proyectos/@ProyectoId/hseq/social/reuniones"            class="btn btn-outline-secondary btn-sm">Reuniones Comunitarias</a>
        <a href="/proyectos/@ProyectoId/hseq/social/pqr"                  class="btn btn-outline-secondary btn-sm">PQR / Quejas / Reclamos</a>
        <a href="/proyectos/@ProyectoId/hseq/social/compromisos"          class="btn btn-outline-secondary btn-sm">Compromisos Sociales</a>
        <a href="/proyectos/@ProyectoId/hseq/social/contratacion-local"   class="btn btn-outline-secondary btn-sm">Contratación Local</a>
        <a href="/proyectos/@ProyectoId/hseq/social/compras-locales"      class="btn btn-outline-secondary btn-sm">Compras Locales</a>
        <a href="/proyectos/@ProyectoId/hseq/social/actas"                class="btn btn-outline-secondary btn-sm">Actas y Evidencias</a>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Cumplimiento Social"
                           Valor="61%"
                           Icono="bi-people-fill"
                           SubTexto="general del período"
                           Estado="Crítico" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Reuniones Comunitarias"
                           Valor="8"
                           Icono="bi-chat-square-text-fill"
                           SubTexto="realizadas este período"
                           Estado="Informativo" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="PQRs Recibidas"
                           Valor="11"
                           Icono="bi-envelope-exclamation"
                           SubTexto="total acumulado"
                           Estado="Riesgo" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="PQRs Cerradas"
                           Valor="7"
                           Icono="bi-envelope-check"
                           SubTexto="con respuesta definitiva"
                           Estado="Saludable" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="PQRs Abiertas"
                           Valor="4"
                           Icono="bi-envelope-open"
                           SubTexto="pendientes de respuesta"
                           Estado="Crítico" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Compromisos Cumplidos"
                           Valor="9"
                           Icono="bi-check-circle-fill"
                           SubTexto="de 15 totales"
                           Estado="Saludable" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Compromisos Vencidos"
                           Valor="3"
                           Icono="bi-exclamation-circle-fill"
                           SubTexto="superaron fecha compromiso"
                           Estado="Crítico" />
        </div>
        <div class="col-6 col-md-3">
            <ExecutiveCard Titulo="Contratación Local"
                           Valor="28"
                           Icono="bi-person-fill-check"
                           SubTexto="trabajadores locales activos"
                           Estado="Saludable" />
        </div>
    </div>

    <!-- Acceso sub-módulos -->
    <h5 class="fw-bold mb-3" style="color:#183963">Gestión Social</h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a href="/proyectos/@ProyectoId/hseq/social/comunidades" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-house-heart-fill d-block mb-2" style="font-size:2rem;color:#fd7e14"></i>
                    <div class="fw-semibold small">Comunidades</div>
                    <span class="badge bg-primary mt-1">4 registradas</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/proyectos/@ProyectoId/hseq/social/reuniones" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-chat-square-text-fill d-block mb-2" style="font-size:2rem;color:#fd7e14"></i>
                    <div class="fw-semibold small">Reuniones Comunitarias</div>
                    <span class="badge bg-primary mt-1">8 realizadas</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/proyectos/@ProyectoId/hseq/social/pqr" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-envelope-exclamation d-block mb-2" style="font-size:2rem;color:#dc3545"></i>
                    <div class="fw-semibold small">PQR / Quejas</div>
                    <span class="badge bg-danger mt-1">4 abiertas</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/proyectos/@ProyectoId/hseq/social/compromisos" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-hand-thumbs-up-fill d-block mb-2" style="font-size:2rem;color:#dc3545"></i>
                    <div class="fw-semibold small">Compromisos Sociales</div>
                    <span class="badge bg-danger mt-1">3 vencidos</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/proyectos/@ProyectoId/hseq/social/contratacion-local" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-person-fill-check d-block mb-2" style="font-size:2rem;color:#fd7e14"></i>
                    <div class="fw-semibold small">Contratación Local</div>
                    <span class="badge bg-primary mt-1">28 activos</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/proyectos/@ProyectoId/hseq/social/compras-locales" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-cart-fill d-block mb-2" style="font-size:2rem;color:#fd7e14"></i>
                    <div class="fw-semibold small">Compras Locales</div>
                    <span class="badge bg-success mt-1">$45M COP</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/proyectos/@ProyectoId/hseq/social/actas" class="text-decoration-none">
                <div class="card shadow-sm h-100 text-center p-3 hseq-card-hover">
                    <i class="bi-file-earmark-text-fill d-block mb-2" style="font-size:2rem;color:#fd7e14"></i>
                    <div class="fw-semibold small">Actas y Evidencias</div>
                    <span class="badge bg-primary mt-1">16 actas</span>
                </div>
            </a>
        </div>
    </div>

    <!-- PQR resumen -->
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Estado PQRs</strong>
            <a href="/proyectos/@ProyectoId/hseq/social/pqr" class="btn btn-sm btn-outline-primary">Ver todas</a>
        </div>
        <div class="card-body">
            <div class="row g-3 text-center mb-3">
                <div class="col-3">
                    <div class="fw-bold" style="font-size:1.5rem;color:#dc3545">4</div>
                    <small class="text-muted">Abiertas</small>
                </div>
                <div class="col-3">
                    <div class="fw-bold" style="font-size:1.5rem;color:#fd7e14">0</div>
                    <small class="text-muted">En Gestión</small>
                </div>
                <div class="col-3">
                    <div class="fw-bold" style="font-size:1.5rem;color:#6ABF4B">7</div>
                    <small class="text-muted">Cerradas</small>
                </div>
                <div class="col-3">
                    <div class="fw-bold" style="font-size:1.5rem;color:#adb5bd">0</div>
                    <small class="text-muted">Vencidas</small>
                </div>
            </div>
            <div class="progress" style="height:14px;border-radius:7px">
                <div class="progress-bar" style="width:36%;background:#dc3545;border-radius:7px 0 0 7px"></div>
                <div class="progress-bar" style="width:64%;background:#6ABF4B;border-radius:0 7px 7px 0"></div>
            </div>
        </div>
    </div>

    <AIPanel Titulo="Análisis Inteligente — Social"
             Subtitulo="@("Social · " + DateTime.Now.ToString("MMMM yyyy"))"
             EstadoGeneral="Desempeño social CRÍTICO — requiere acción urgente."
             EsSimulado="true">
        <Hallazgos>
            <ul>
                <li>61% de cumplimiento social — por debajo del umbral aceptable del 75%.</li>
                <li>3 compromisos sociales vencidos con comunidades del área de influencia.</li>
                <li>4 PQRs abiertas sin respuesta definitiva, riesgo de escalamiento comunitario.</li>
            </ul>
        </Hallazgos>
        <Alertas>
            <ul>
                <li>Compromisos vencidos pueden generar bloqueos o conflictos con comunidades afectadas.</li>
                <li>Las PQRs sin respuesta superan el tiempo máximo recomendado de 15 días hábiles.</li>
            </ul>
        </Alertas>
        <Recomendaciones>
            <ul>
                <li>Convocar reunión urgente con comunidades afectadas para gestionar compromisos vencidos.</li>
                <li>Cerrar las 4 PQRs abiertas con respuesta formal documentada esta semana.</li>
                <li>Revisar el plan de gestión social y actualizar el cronograma de compromisos.</li>
            </ul>
        </Recomendaciones>
    </AIPanel>
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    private Proyecto? _proyecto;

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) Navigation.NavigateTo("/proyectos");
    }
}
