@page "/proyectos/{ProyectoId:int}/hseq/social/contratacion-local"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ

<PageTitle>Contratación Local — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null) { <p class="text-muted">Cargando...</p> }
else
{
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <a href="/proyectos/@ProyectoId/hseq/social" class="btn btn-sm btn-outline-secondary">&larr; Social</a>
        <div class="flex-grow-1">
            <h1 class="h4 mb-0"><i class="bi-person-badge me-2" style="color:#183963"></i>Contratación Local</h1>
            <small class="text-muted">@_proyecto.Nombre</small>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="MostrarFormulario">
            <i class="bi-plus-lg me-1"></i>Registrar Contratación
        </button>
    </div>

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <strong>Registro de Contratación Local</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Nombre Persona *</label>
                            <InputText class="form-control" @bind-Value="_form.NombrePersona" />
                            <ValidationMessage For="() => _form.NombrePersona" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Cargo / Servicio *</label>
                            <InputText class="form-control" @bind-Value="_form.Cargo" />
                            <ValidationMessage For="() => _form.Cargo" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Municipio *</label>
                            <InputText class="form-control" @bind-Value="_form.Municipio" />
                            <ValidationMessage For="() => _form.Municipio" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Empresa</label>
                            <InputText class="form-control" @bind-Value="_form.Empresa" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Ingreso</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaIngreso" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha Retiro</label>
                            <InputDate class="form-control" @bind-Value="_form.FechaRetiro" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_form.EsLocal" id="esLocal" />
                                <label class="form-check-label" for="esLocal">Es local</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Observaciones" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-primary">
                <div class="fw-bold" style="font-size:1.8rem;color:#183963">@_contrataciones.Count</div>
                <div class="text-muted small">Total contrataciones</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-success">
                <div class="fw-bold" style="font-size:1.8rem;color:#6ABF4B">@_contrataciones.Count(c => c.EsLocal)</div>
                <div class="text-muted small">Mano de obra local</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-success">
                <div class="fw-bold" style="font-size:1.6rem;color:#6ABF4B">
                    @(_contrataciones.Any() ? (_contrataciones.Count(c => c.EsLocal) * 100.0 / _contrataciones.Count).ToString("F0") + "%" : "—")
                </div>
                <div class="text-muted small">% Local</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-primary">
                <div class="fw-bold" style="font-size:1.8rem;color:#183963">@_contrataciones.Count(c => !c.FechaRetiro.HasValue)</div>
                <div class="text-muted small">Activos actualmente</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Cargo / Servicio</th>
                        <th>Municipio</th>
                        <th>F. Ingreso</th>
                        <th>F. Retiro</th>
                        <th class="text-center">Tipo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_contrataciones.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No hay contrataciones registradas.</td></tr>
                    }
                    @foreach (var c in _contrataciones.OrderByDescending(x => x.FechaIngreso))
                    {
                        <tr>
                            <td class="fw-semibold">@c.NombrePersona</td>
                            <td class="small">@c.Cargo</td>
                            <td class="small text-muted">@c.Municipio</td>
                            <td class="small">@c.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td class="small">@(c.FechaRetiro?.ToString("dd/MM/yyyy") ?? "Activo")</td>
                            <td class="text-center">
                                @if (c.EsLocal)
                                { <span class="badge bg-success">Local</span> }
                                else
                                { <span class="badge bg-secondary">Foráneo</span> }
                            </td>
                            <td class="text-center">
                                @if (_confirmandoEliminar == c.Id)
                                {
                                    <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(c.Id)">Sí</button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = c.Id"><i class="bi-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private List<RenergeIA.Core.Entities.HSEQ.ContratacionLocal> _contrataciones = [];
    private bool _mostrarFormulario;
    private int? _confirmandoEliminar;
    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync() =>
        _contrataciones = await Db.ContratacionesLocales.Where(c => c.ProyectoId == ProyectoId).OrderByDescending(c => c.FechaIngreso).ToListAsync();

    private void MostrarFormulario() { _form = new FormModel { FechaIngreso = DateTime.Today, EsLocal = true }; _mostrarFormulario = true; }
    private void CancelarFormulario() => _mostrarFormulario = false;

    private async Task GuardarAsync()
    {
        Db.ContratacionesLocales.Add(new RenergeIA.Core.Entities.HSEQ.ContratacionLocal
        {
            ProyectoId    = ProyectoId,
            NombrePersona = _form.NombrePersona,
            Cargo         = _form.Cargo,
            Municipio     = _form.Municipio,
            Empresa       = _form.Empresa ?? "",
            Documento     = "",
            FechaIngreso  = _form.FechaIngreso,
            FechaRetiro   = _form.FechaRetiro,
            EsLocal       = _form.EsLocal,
            Observaciones = _form.Observaciones
        });
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAsync();
    }

    private async Task EliminarAsync(int id)
    {
        var c = await Db.ContratacionesLocales.FindAsync(id);
        if (c is not null) { Db.ContratacionesLocales.Remove(c); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string NombrePersona { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Cargo { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Municipio { get; set; } = "";
        public string? Empresa { get; set; }
        public DateTime FechaIngreso { get; set; } = DateTime.Today;
        public DateTime? FechaRetiro { get; set; }
        public bool EsLocal { get; set; } = true;
        public string? Observaciones { get; set; }
    }
}
