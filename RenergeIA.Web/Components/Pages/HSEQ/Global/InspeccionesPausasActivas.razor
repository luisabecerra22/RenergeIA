@page "/hseq/inspecciones/pausas-activas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@using RenergeIA.Core.Entities.HSEQ
@using ClosedXML.Excel

<PageTitle>Pausas Activas — HSEQ Corporativo</PageTitle>

<div class="container-fluid px-4 py-3">
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <a href="hseq/dashboard" class="btn btn-sm btn-outline-secondary">&larr; HSEQ</a>
        <div class="flex-grow-1">
            <h4 class="fw-bold mb-0" style="color:#183963">
                <i class="bi-stopwatch me-2"></i>Pausas Activas
            </h4>
            <small class="text-muted">HSEQ Corporativo &bull; Meta: @META pausas / trabajador / mes</small>
        </div>
        <button class="btn btn-success btn-sm me-1" @onclick="() => _mostrarCarga = !_mostrarCarga">
            <i class="bi-file-earmark-excel me-1"></i>Cargar Excel
        </button>
        <button class="btn btn-outline-primary btn-sm" @onclick="MostrarFormulario">
            <i class="bi-plus-lg me-1"></i>Registro manual
        </button>
    </div>

    <!-- Carga de Excel -->
    @if (_mostrarCarga)
    {
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <strong><i class="bi-file-earmark-excel me-2"></i>Cargar reporte Flokzu (RPA)</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="() => { _mostrarCarga = false; _msgCarga = null; }"></button>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Período — Mes *</label>
                        <select class="form-select" @bind="_mesCarga">
                            @for (int m = 1; m <= 12; m++)
                            { <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option> }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Año *</label>
                        <InputNumber class="form-control" @bind-Value="_anioCarga" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">Archivo Excel (.xlsx)</label>
                        <InputFile class="form-control" OnChange="OnArchivoSeleccionado" accept=".xlsx,.xls" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-success w-100" @onclick="ProcesarExcelAsync" disabled="@(_archivoStream is null || _procesando)">
                            @if (_procesando)
                            { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Procesar
                        </button>
                    </div>
                </div>
                <div class="mt-2">
                    <small class="text-muted">
                        <i class="bi-info-circle me-1"></i>Se lee la columna <strong>Nombre (RPA)</strong> y <strong>Departamento (RPA)</strong>.
                        Cada fila = 1 pausa activa. Se agrupan por persona y se calcula el total del período.
                    </small>
                </div>
                @if (_msgCarga is not null)
                {
                    <div class="alert @(_msgCargaExito ? "alert-success" : "alert-danger") mt-3 mb-0 py-2">
                        <i class="@(_msgCargaExito ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-1"></i>
                        @_msgCarga
                    </div>
                }
            </div>
        </div>
    }

    <!-- Filtros -->
    <div class="d-flex gap-2 mb-4 flex-wrap align-items-center mt-3">
        <label class="form-label mb-0 fw-semibold">Mes:</label>
        <select class="form-select form-select-sm" style="max-width:140px" @bind="_mesFiltro" @bind:after="CargarAsync">
            @for (int m = 1; m <= 12; m++)
            { <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option> }
        </select>
        <label class="form-label mb-0 fw-semibold">Año:</label>
        <InputNumber class="form-control form-control-sm" style="max-width:90px" @bind-Value="_anioFiltro" />
        <label class="form-label mb-0 fw-semibold">Área:</label>
        <select class="form-select form-select-sm" style="max-width:220px" @bind="_areaFiltro" @bind:after="CargarAsync">
            <option value="">Todas</option>
            @foreach (var a in _areasDisponibles)
            { <option value="@a">@a</option> }
        </select>
        <button class="btn btn-outline-secondary btn-sm" @onclick="CargarAsync">Aplicar</button>
    </div>

    <!-- Resumen -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-primary">
                <div class="fw-bold" style="font-size:1.8rem;color:#183963">@_pausas.Select(p => p.Trabajador).Distinct().Count()</div>
                <div class="text-muted small">Trabajadores con registro</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm p-3 text-center border-start border-4 border-success">
                <div class="fw-bold" style="font-size:1.8rem;color:#6ABF4B">@_pausas.Sum(p => p.CantidadPausas)</div>
                <div class="text-muted small">Total pausas registradas</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            @{ var prom = _pausas.Any() ? (int)Math.Round(_pausas.Average(p => p.CantidadPausas)) : 0; }
            <div class="card shadow-sm p-3 text-center border-start border-4 border-warning">
                <div class="fw-bold" style="font-size:1.8rem;color:#ffc107">@prom</div>
                <div class="text-muted small">Promedio pausas / persona</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            @{ var cumPct = _pausas.Any() ? Math.Min(100, (int)Math.Round(_pausas.Average(p => p.CantidadPausas) * 100.0 / META)) : 0; }
            <div class="card shadow-sm p-3 text-center border-start border-4 @(cumPct>=100?"border-success":cumPct>=70?"border-warning":"border-danger")">
                <div class="fw-bold" style="font-size:1.8rem;color:@(cumPct>=100?"#6ABF4B":cumPct>=70?"#ffc107":"#dc3545")">@cumPct%</div>
                <div class="text-muted small">% Cumplimiento meta (@META)</div>
            </div>
        </div>
    </div>

    <!-- Dashboard cumplimiento por departamento -->
    @if (_pausas.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-2">
                <span class="fw-bold" style="color:#183963"><i class="bi-bar-chart-fill me-2"></i>Cumplimiento por departamento</span>
            </div>
            <div class="card-body p-3">
                @foreach (var grupo in _pausas.GroupBy(p => p.Area).OrderByDescending(g => g.Average(p => p.CantidadPausas) * 100.0 / META))
                {
                    var cumDepto = Math.Min(100, (int)Math.Round(grupo.Average(p => p.CantidadPausas) * 100.0 / META));
                    var personas = grupo.Select(p => p.Trabajador).Distinct().Count();
                    var totalDepto = grupo.Sum(p => p.CantidadPausas);
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold small">@grupo.Key</span>
                            <span class="small text-muted">@totalDepto pausas &bull; @personas personas</span>
                        </div>
                        <div class="progress" style="height:22px;border-radius:6px">
                            <div class="progress-bar @(cumDepto>=100?"bg-success":cumDepto>=70?"":cumDepto>=40?"bg-warning":"bg-danger")"
                                 style="width:@cumDepto%;@(cumDepto>=70 && cumDepto<100?"background:linear-gradient(90deg,#183963,#6ABF4B);":"")border-radius:6px"
                                 role="progressbar">
                                <span class="fw-bold small">@cumDepto%</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (_mostrarFormulario)
    {
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white d-flex justify-content-between">
                <strong>@(_editandoId.HasValue ? "Editar Registro" : "Registro Manual de Pausas")</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="CancelarFormulario"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Trabajador *</label>
                            <InputText class="form-control" @bind-Value="_form.Trabajador" />
                            <ValidationMessage For="() => _form.Trabajador" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Correo / Documento *</label>
                            <InputText class="form-control" @bind-Value="_form.Documento" />
                            <ValidationMessage For="() => _form.Documento" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Departamento *</label>
                            <InputText class="form-control" @bind-Value="_form.Area" />
                            <ValidationMessage For="() => _form.Area" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Cargo</label>
                            <InputText class="form-control" @bind-Value="_form.Cargo" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Mes *</label>
                            <InputSelect class="form-select" @bind-Value="_form.Mes">
                                @for (int m = 1; m <= 12; m++)
                                { <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Año *</label>
                            <InputNumber class="form-control" @bind-Value="_form.Anio" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">N° Pausas *</label>
                            <InputNumber class="form-control" @bind-Value="_form.CantidadPausas" />
                            <div class="form-text">Meta: @META/mes</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Responsable Registro *</label>
                            <InputText class="form-control" @bind-Value="_form.ResponsableRegistro" />
                            <ValidationMessage For="() => _form.ResponsableRegistro" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Observaciones" />
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Tabla agrupada por departamento -->
    @if (_pausas.Any())
    {
        @foreach (var grupo in _pausas.GroupBy(p => p.Area).OrderBy(g => g.Key))
        {
            var grupoList = grupo.ToList();
            var cumGrupo = Math.Min(100, (int)Math.Round(grupoList.Average(p => p.CantidadPausas) * 100.0 / META));
            var totalGrupo = grupoList.Sum(p => p.CantidadPausas);
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                    <span class="fw-bold" style="color:#183963">
                        <i class="bi-building me-2"></i>@grupo.Key
                        <span class="badge bg-secondary ms-2">@grupoList.Count personas</span>
                    </span>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="text-muted small">@totalGrupo pausas totales</span>
                        <span class="badge @(cumGrupo>=100?"bg-success":cumGrupo>=70?"bg-warning":"bg-danger") fs-6">@cumGrupo%</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Trabajador</th>
                                <th>Correo</th>
                                <th class="text-center">Pausas realizadas</th>
                                <th class="text-center">Meta (@META)</th>
                                <th class="text-center">% Cumplimiento</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in grupoList.OrderBy(p => p.Trabajador))
                            {
                                var pct = Math.Min(100, (int)Math.Round(p.CantidadPausas * 100.0 / META));
                                var cumple = p.CantidadPausas >= META;
                                <tr>
                                    <td class="fw-semibold">@p.Trabajador</td>
                                    <td class="text-muted">@p.Documento</td>
                                    <td class="text-center fw-bold @(cumple?"text-success":pct>=70?"text-warning":"text-danger")">@p.CantidadPausas</td>
                                    <td class="text-center">@META</td>
                                    <td class="text-center" style="min-width:130px">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:10px;border-radius:5px">
                                                <div class="progress-bar @(cumple?"bg-success":pct>=70?"bg-warning":"bg-danger")" style="width:@pct%"></div>
                                            </div>
                                            <span class="fw-bold small @(cumple?"text-success":pct>=70?"text-warning":"text-danger")">@pct%</span>
                                            @if (cumple) { <i class="bi-check-circle-fill text-success"></i> }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (_confirmandoEliminar == p.Id)
                                        {
                                            <button class="btn btn-danger btn-sm me-1" @onclick="() => EliminarAsync(p.Id)">Sí</button>
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => _confirmandoEliminar = null">No</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => EditarItem(p)" title="Editar"><i class="bi-pencil"></i></button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => _confirmandoEliminar = p.Id" title="Eliminar"><i class="bi-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi-file-earmark-excel" style="font-size:3rem;opacity:.3"></i>
                <p class="mt-2 mb-1">No hay registros de pausas activas para este período.</p>
                <p class="small">Carga un reporte Excel de Flokzu para generar los datos automáticamente.</p>
            </div>
        </div>
    }
</div>

@code {
    private const int META = 40;

    private List<PausaActiva> _pausas = [];
    private List<string> _areasDisponibles = [];
    private bool _mostrarFormulario;
    private bool _mostrarCarga;
    private int? _editandoId;
    private int? _confirmandoEliminar;
    private int _mesFiltro = DateTime.Today.Month;
    private int _anioFiltro = DateTime.Today.Year;
    private string _areaFiltro = "";
    private FormModel _form = new();

    // Carga Excel
    private int _mesCarga = DateTime.Today.Month;
    private int _anioCarga = DateTime.Today.Year;
    private MemoryStream? _archivoStream;
    private bool _procesando;
    private string? _msgCarga;
    private bool _msgCargaExito;

    protected override async Task OnInitializedAsync()
    {
        await CargarAreasAsync();
        await CargarAsync();
    }

    private async Task CargarAreasAsync()
    {
        _areasDisponibles = await Db.PausasActivas
            .Select(p => p.Area)
            .Distinct()
            .OrderBy(a => a)
            .ToListAsync();
    }

    private async Task CargarAsync()
    {
        var query = Db.PausasActivas
            .Where(p => p.Mes == _mesFiltro && p.Anio == _anioFiltro);

        if (!string.IsNullOrEmpty(_areaFiltro))
            query = query.Where(p => p.Area == _areaFiltro);

        _pausas = await query.ToListAsync();
    }

    // ── Carga Excel ──────────────────────────────────────────────

    private async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        _msgCarga = null;
        _archivoStream?.Dispose();
        _archivoStream = new MemoryStream();
        await e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(_archivoStream);
        _archivoStream.Position = 0;
    }

    private async Task ProcesarExcelAsync()
    {
        if (_archivoStream is null) return;
        _procesando = true;
        _msgCarga = null;
        StateHasChanged();

        try
        {
            _archivoStream.Position = 0;
            using var workbook = new XLWorkbook(_archivoStream);
            var ws = workbook.Worksheets.First();
            var lastRow = ws.LastRowUsed()?.RowNumber() ?? 0;

            if (lastRow < 3)
            {
                _msgCarga = "El archivo no contiene datos (se esperan datos desde la fila 3).";
                _msgCargaExito = false;
                return;
            }

            // Detectar columnas por nombre en fila 2 (headers)
            int colNombre = 0, colDepto = 0, colCorreo = 0;
            var headerRow = ws.Row(2);
            for (int c = 1; c <= ws.LastColumnUsed()?.ColumnNumber(); c++)
            {
                var header = headerRow.Cell(c).GetString().Trim();
                if (header.Contains("Nombre", StringComparison.OrdinalIgnoreCase) && header.Contains("RPA", StringComparison.OrdinalIgnoreCase))
                    colNombre = c;
                else if (header.Contains("Departamento", StringComparison.OrdinalIgnoreCase) && header.Contains("RPA", StringComparison.OrdinalIgnoreCase))
                    colDepto = c;
                else if (header.Contains("Correo", StringComparison.OrdinalIgnoreCase) && header.Contains("RPA", StringComparison.OrdinalIgnoreCase))
                    colCorreo = c;
            }

            if (colNombre == 0 || colDepto == 0)
            {
                _msgCarga = "No se encontraron las columnas 'Nombre (RPA)' y/o 'Departamento (RPA)' en la fila 2.";
                _msgCargaExito = false;
                return;
            }

            // Leer filas y agrupar por persona
            var registros = new Dictionary<string, (string Nombre, string Depto, string Correo, int Conteo)>();

            for (int r = 3; r <= lastRow; r++)
            {
                var nombre = ws.Row(r).Cell(colNombre).GetString().Trim();
                var depto = ws.Row(r).Cell(colDepto).GetString().Trim();
                var correo = colCorreo > 0 ? ws.Row(r).Cell(colCorreo).GetString().Trim() : "";

                if (string.IsNullOrWhiteSpace(nombre)) continue;

                var key = nombre.ToUpperInvariant();
                if (registros.TryGetValue(key, out var existing))
                    registros[key] = (nombre, depto, correo, existing.Conteo + 1);
                else
                    registros[key] = (nombre, depto, correo, 1);
            }

            if (registros.Count == 0)
            {
                _msgCarga = "No se encontraron registros válidos en el archivo.";
                _msgCargaExito = false;
                return;
            }

            // Eliminar registros anteriores del mismo período (reemplazar)
            var anteriores = await Db.PausasActivas
                .Where(p => p.Mes == _mesCarga && p.Anio == _anioCarga && p.ProyectoId == null)
                .ToListAsync();
            if (anteriores.Any())
                Db.PausasActivas.RemoveRange(anteriores);

            // Insertar nuevos registros agrupados
            foreach (var (_, data) in registros)
            {
                Db.PausasActivas.Add(new PausaActiva
                {
                    ProyectoId          = null,
                    Trabajador          = data.Nombre,
                    Documento           = data.Correo,
                    Area                = data.Depto,
                    Cargo               = "",
                    Mes                 = _mesCarga,
                    Anio                = _anioCarga,
                    CantidadPausas      = data.Conteo,
                    ResponsableRegistro = "Carga Excel",
                    Observaciones       = $"Importado desde Flokzu RPA",
                    FechaModificacion   = DateTime.UtcNow
                });
            }

            await Db.SaveChangesAsync();

            _mesFiltro = _mesCarga;
            _anioFiltro = _anioCarga;
            _areaFiltro = "";
            await CargarAreasAsync();
            await CargarAsync();

            var totalPausas = registros.Values.Sum(r => r.Conteo);
            _msgCarga = $"Cargados {registros.Count} trabajadores con {totalPausas} pausas activas en total para {new DateTime(2000, _mesCarga, 1):MMMM} {_anioCarga}.";
            _msgCargaExito = true;
        }
        catch (Exception ex)
        {
            _msgCarga = $"Error al procesar el archivo: {ex.Message}";
            _msgCargaExito = false;
        }
        finally
        {
            _procesando = false;
        }
    }

    // ── Registro manual ──────────────────────────────────────────

    private void MostrarFormulario()
    {
        _form = new FormModel { Mes = _mesFiltro, Anio = _anioFiltro };
        _editandoId = null; _mostrarFormulario = true;
    }
    private void CancelarFormulario() { _mostrarFormulario = false; _editandoId = null; }

    private void EditarItem(PausaActiva p)
    {
        _form = new FormModel
        {
            Trabajador          = p.Trabajador,
            Documento           = p.Documento,
            Area                = p.Area,
            Cargo               = p.Cargo,
            Mes                 = p.Mes,
            Anio                = p.Anio,
            CantidadPausas      = p.CantidadPausas,
            ResponsableRegistro = p.ResponsableRegistro,
            Observaciones       = p.Observaciones
        };
        _editandoId = p.Id; _mostrarFormulario = true;
    }

    private async Task GuardarAsync()
    {
        if (_editandoId.HasValue)
        {
            var e = await Db.PausasActivas.FindAsync(_editandoId.Value);
            if (e is not null) MapearForm(e);
        }
        else
        {
            var e = new PausaActiva { ProyectoId = null };
            MapearForm(e);
            Db.PausasActivas.Add(e);
        }
        await Db.SaveChangesAsync();
        CancelarFormulario();
        await CargarAreasAsync();
        await CargarAsync();
    }

    private void MapearForm(PausaActiva e)
    {
        e.Trabajador          = _form.Trabajador;
        e.Documento           = _form.Documento;
        e.Area                = _form.Area;
        e.Cargo               = _form.Cargo;
        e.Mes                 = _form.Mes;
        e.Anio                = _form.Anio;
        e.CantidadPausas      = _form.CantidadPausas;
        e.ResponsableRegistro = _form.ResponsableRegistro;
        e.Observaciones       = _form.Observaciones;
        e.FechaModificacion   = DateTime.UtcNow;
    }

    private async Task EliminarAsync(int id)
    {
        var e = await Db.PausasActivas.FindAsync(id);
        if (e is not null) { Db.PausasActivas.Remove(e); await Db.SaveChangesAsync(); }
        _confirmandoEliminar = null;
        await CargarAsync();
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required] public string Trabajador { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Documento { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Area { get; set; } = "";
        public string Cargo { get; set; } = "";
