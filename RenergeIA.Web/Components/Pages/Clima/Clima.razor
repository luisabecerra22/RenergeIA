@page "/proyectos/{ProyectoId:int}/clima"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS
@implements IAsyncDisposable

@using System.Text.Json
@using System.Globalization

<PageTitle>Clima — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-4">
        <a href="/proyectos/@ProyectoId" class="btn btn-sm btn-outline-secondary">&larr; Volver</a>
        <h1 class="h3 mb-0">
            <i class="bi-cloud-sun me-2 text-info"></i>Clima — @_proyecto.Nombre
        </h1>
        <span class="badge bg-info text-white ms-2">
            <i class="bi-thermometer-sun me-1"></i>Open-Meteo · Sin clave API
        </span>
    </div>

    <!-- A. Datos de ubicación -->
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="bi-geo-alt-fill text-primary"></i>
            <strong>Ubicación exacta del proyecto</strong>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label d-flex align-items-center gap-2">
                        País
                        @if (_geocodificando)
                        {
                            <span class="spinner-border spinner-border-sm text-info" role="status"></span>
                            <span class="text-muted small">Detectando...</span>
                        }
                    </label>
                    <input class="form-control" @bind="_form.Pais" placeholder="Ej: Colombia" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Departamento / Estado</label>
                    <input class="form-control" @bind="_form.Departamento" placeholder="Ej: Cundinamarca" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Municipio / Ciudad</label>
                    <input class="form-control" @bind="_form.Municipio" placeholder="Ej: Bogotá" />
                </div>
                <div class="col-12">
                    <label class="form-label">Dirección o referencia</label>
                    <input class="form-control" @bind="_form.Direccion" placeholder="Ej: Km 10 vía Bogotá-Cali, vereda El Triunfo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Latitud <span class="text-danger">*</span>
                        <span class="text-muted fw-normal small">(−90 a 90)</span>
                    </label>
                    <input type="number" class="form-control @(_latitudInvalida ? "is-invalid" : "")"
                           step="0.000001" min="-90" max="90"
                           value="@(_form.Latitud?.ToString("F6", CultureInfo.InvariantCulture))"
                           @onchange="OnLatitudChange"
                           placeholder="Ej: 4.710989" />
                    @if (_latitudInvalida)
                    {
                        <div class="invalid-feedback">Debe estar entre −90 y 90.</div>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Longitud <span class="text-danger">*</span>
                        <span class="text-muted fw-normal small">(−180 a 180)</span>
                    </label>
                    <input type="number" class="form-control @(_longitudInvalida ? "is-invalid" : "")"
                           step="0.000001" min="-180" max="180"
                           value="@(_form.Longitud?.ToString("F6", CultureInfo.InvariantCulture))"
                           @onchange="OnLongitudChange"
                           placeholder="Ej: -74.072092" />
                    @if (_longitudInvalida)
                    {
                        <div class="invalid-feedback">Debe estar entre −180 y 180.</div>
                    }
                </div>
                @if (_form.Latitud.HasValue && _form.Longitud.HasValue)
                {
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="alert alert-success py-2 mb-0 w-100 small">
                            <i class="bi-pin-map-fill me-1"></i>
                            Marcador fijado en:
                            <strong>@_form.Latitud.Value.ToString("F6", CultureInfo.InvariantCulture)</strong>,
                            <strong>@_form.Longitud.Value.ToString("F6", CultureInfo.InvariantCulture)</strong>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- B. Mapa interactivo -->
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="bi-map text-primary"></i>
            <strong>Mapa interactivo</strong>
            <span class="text-muted small ms-1">
                — Navega hasta la ubicación del proyecto y haz <strong>clic</strong> para fijar el punto exacto
            </span>
        </div>
        <div class="card-body p-0">
            <div id="leaflet-map" style="height:430px;width:100%;border-radius:0 0 0.375rem 0.375rem;"></div>
        </div>
    </div>

    <!-- C. Confirmar ubicación -->
    <div class="card shadow-sm mb-3">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <button class="btn btn-success px-4" @onclick="ConfirmarUbicacionAsync" disabled="@_guardando">
                @if (_guardando)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                else
                {
                    <i class="bi-check-circle-fill me-1"></i>
                }
                Confirmar ubicación
            </button>
            @if (_mensajeUbicacion is not null)
            {
                <span class="text-success fw-semibold">
                    <i class="bi-check2-circle me-1"></i>@_mensajeUbicacion
                </span>
            }
            @if (_errorUbicacion is not null)
            {
                <span class="text-danger">
                    <i class="bi-x-circle me-1"></i>@_errorUbicacion
                </span>
            }
        </div>
    </div>

    <!-- D. Consultar clima y pronóstico (Open-Meteo) -->
    <div class="card shadow-sm mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="bi-cloud-download text-info"></i>
            <strong>Consultar clima y pronóstico</strong>
            <span class="badge bg-success ms-auto">Gratis · Sin clave · Open-Meteo</span>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3 small">
                <i class="bi-info-circle me-1"></i>
                Una vez confirmada la ubicación, consulta el clima actual y el pronóstico de los próximos 16 días.
                El dato climático actual se guarda automáticamente en el historial.
            </p>
            <button class="btn btn-info text-white px-4"
                    @onclick="ConsultarClimaAsync"
                    disabled="@(_buscandoClima || !_ubicacionConfirmada)">
                @if (_buscandoClima)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Consultando...</span>
                }
                else
                {
                    <i class="bi-cloud-sun me-1"></i>
                    <span>Consultar clima y pronóstico</span>
                }
            </button>
            @if (!_ubicacionConfirmada)
            {
                <div class="text-muted small mt-2">
                    <i class="bi-lock me-1"></i>Primero confirma la ubicación para habilitar esta acción.
                </div>
            }
            @if (_errorClima is not null)
            {
                <div class="alert alert-danger mt-3 py-2 mb-0">
                    <i class="bi-exclamation-triangle me-1"></i>@_errorClima
                </div>
            }
            @if (_mensajeClima is not null)
            {
                <div class="alert alert-success mt-3 py-2 mb-0">
                    <i class="bi-check2-circle me-1"></i>@_mensajeClima
                </div>
            }
        </div>
    </div>

    @if (_climaActual is not null)
    {
        <!-- E. Clima actual -->
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi-thermometer-sun text-info"></i>
                <strong>Condiciones actuales</strong>
                @if (_horaConsulta is not null)
                {
                    <span class="text-muted small ms-auto">
                        Actualizado: @_horaConsulta
                    </span>
                }
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-auto text-center">
                        <i class="@IconoWMO(_climaActual.WmoCode)" style="font-size:3.5rem;"></i>
                        <div class="fw-semibold mt-1">@DescripcionWMO(_climaActual.WmoCode)</div>
                    </div>
                    <div class="col">
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <div class="card border-primary text-center py-3">
                                    <div class="fw-bold fs-3 text-primary">
                                        @_climaActual.Temperatura.ToString("F1", CultureInfo.InvariantCulture)°C
                                    </div>
                                    <div class="text-muted small">Temperatura</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="card border-secondary text-center py-3">
                                    <div class="fw-bold fs-3 text-secondary">
                                        @_climaActual.TemperaturaAparente.ToString("F1", CultureInfo.InvariantCulture)°C
                                    </div>
                                    <div class="text-muted small">Sensación</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="card border-info text-center py-3">
                                    <div class="fw-bold fs-3 text-info">@_climaActual.Humedad%</div>
                                    <div class="text-muted small">Humedad</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="card border-secondary text-center py-3">
                                    <div class="fw-bold fs-3 text-secondary">
                                        @_climaActual.VientoKmh.ToString("F0", CultureInfo.InvariantCulture)
                                    </div>
                                    <div class="text-muted small">Viento (km/h)</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="card border-primary text-center py-2">
                                    <div class="fw-bold fs-4 text-primary">
                                        @_climaActual.PrecipMm.ToString("F1", CultureInfo.InvariantCulture) mm
                                    </div>
                                    <div class="text-muted small">Precipitación</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- F. Pronóstico 7 días -->
        @if (_pronostico.Count > 0)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi-calendar-week text-primary"></i>
                    <strong>Pronóstico — próximos 7 días</strong>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 overflow-auto pb-1">
                        @foreach (var d in _pronostico.Take(7))
                        {
                            var esPrimero = d == _pronostico[0];
                            <div class="card text-center @(esPrimero ? "border-primary border-2" : "")"
                                 style="min-width:120px;">
                                <div class="card-header py-1 @(esPrimero ? "bg-primary text-white" : "bg-light") small fw-bold">
                                    @if (esPrimero)
                                    {
                                        <span>Hoy</span>
                                    }
                                    else
                                    {
                                        <span>@DiaSemana(d.Fecha)</span>
                                    }
                                    <br />
                                    <span class="fw-normal">@d.Fecha.Day @MesCorto(d.Fecha.Month)</span>
                                </div>
                                <div class="card-body px-2 py-3">
                                    <i class="@IconoWMO(d.WmoCode)" style="font-size:2rem;"></i>
                                    <div class="small text-muted mt-1" style="font-size:0.72rem;">
                                        @DescripcionWMO(d.WmoCode)
                                    </div>
                                    <div class="mt-2">
                                        <span class="fw-bold text-danger">@d.TempMax.ToString("F0", CultureInfo.InvariantCulture)°</span>
                                        <span class="text-muted mx-1">/</span>
                                        <span class="text-primary">@d.TempMin.ToString("F0", CultureInfo.InvariantCulture)°</span>
                                    </div>
                                    <div class="small mt-1">
                                        <i class="bi-droplet-fill text-primary" style="font-size:0.75rem;"></i>
                                        @d.PrecipProbabilidad%
                                    </div>
                                    @if (d.PrecipSum > 0)
                                    {
                                        <div class="small text-muted">
                                            @d.PrecipSum.ToString("F1", CultureInfo.InvariantCulture) mm
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="text-muted small mt-2">
                        <i class="bi-info-circle me-1"></i>
                        Temp. máx <span class="text-danger fw-bold">rojo</span> / mín <span class="text-primary fw-bold">azul</span>.
                        <i class="bi-droplet-fill text-primary ms-2"></i> = probabilidad de precipitación.
                    </div>
                </div>
            </div>

            <!-- G. Pronóstico extendido 16 días -->
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi-calendar-month text-secondary"></i>
                    <strong>Pronóstico extendido — 16 días</strong>
                    <span class="badge bg-secondary ms-auto">Open-Meteo · Modelo GFS/ECMWF</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Condición</th>
                                <th class="text-center">Máx (°C)</th>
                                <th class="text-center">Mín (°C)</th>
                                <th class="text-center">Prob. lluvia</th>
                                <th class="text-center">Precip. (mm)</th>
                                <th class="text-center">Viento máx (km/h)</th>
                                <th class="text-center">Apto obra</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _pronostico)
                            {
                                var aptitud = AptitudObra(d);
                                <tr class="@(d == _pronostico[0] ? "table-primary" : "")">
                                    <td class="text-nowrap fw-semibold">
                                        @if (d == _pronostico[0])
                                        {
                                            <span class="badge bg-primary me-1">Hoy</span>
                                        }
                                        @DiaSemana(d.Fecha) @d.Fecha.Day/@d.Fecha.Month
                                    </td>
                                    <td>
                                        <i class="@IconoWMO(d.WmoCode) me-1"></i>
                                        @DescripcionWMO(d.WmoCode)
                                    </td>
                                    <td class="text-center fw-bold text-danger">
                                        @d.TempMax.ToString("F1", CultureInfo.InvariantCulture)
                                    </td>
                                    <td class="text-center text-primary">
                                        @d.TempMin.ToString("F1", CultureInfo.InvariantCulture)
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @BadgeProbabilidad(d.PrecipProbabilidad)">
                                            @d.PrecipProbabilidad%
                                        </span>
                                    </td>
                                    <td class="text-center @(d.PrecipSum > 5 ? "text-primary fw-bold" : "")">
                                        @d.PrecipSum.ToString("F1", CultureInfo.InvariantCulture)
                                    </td>
                                    <td class="text-center @(d.VientoMax > 40 ? "text-danger fw-bold" : "")">
                                        @d.VientoMax.ToString("F0", CultureInfo.InvariantCulture)
                                    </td>
                                    <td class="text-center">
                                        @if (aptitud == "apto")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi-check-circle me-1"></i>Sí
                                            </span>
                                        }
                                        else if (aptitud == "precaucion")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi-exclamation-triangle me-1"></i>Con precauciones
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi-x-circle me-1"></i>No · Revisar actividades
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-muted small">
                    <i class="bi-info-circle me-1"></i>
                    <span class="badge bg-success me-1">Sí</span> prob. lluvia &lt; 60% ·
                    <span class="badge bg-warning text-dark me-1">Con precauciones</span> entre 60% y 84% ·
                    <span class="badge bg-danger me-1">No · Revisar actividades</span> ≥ 85%.
                    Los pronósticos a más de 7 días tienen mayor incertidumbre.
                </div>
            </div>
        }

        <!-- G2. Ventana Operacional — Próximos 3 días (cruce WBS + Clima) -->
        @if (_alertasOperacionales.Count > 0)
        {
            <div class="card shadow-sm mb-3 border-0">
                <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#183963 0%,#1e4d7a 100%);color:#fff">
                    <i class="bi-shield-exclamation" style="font-size:1.2rem"></i>
                    <strong>Alerta Meteorológica Operacional</strong>
                    <span class="badge bg-warning text-dark ms-auto">
                        <i class="bi-calendar3 me-1"></i>Próximos 3 días
                    </span>
                </div>
                <div class="card-body p-0">
                    @foreach (var grupo in _alertasOperacionales.GroupBy(a => a.Fecha))
                    {
                        var pronosticoDia = _pronostico.FirstOrDefault(p => p.Fecha == grupo.Key);
                        <div class="border-bottom">
                            <div class="px-3 py-2 d-flex align-items-center gap-2" style="background:#f0f3f8">
                                <i class="bi-calendar-event text-primary"></i>
                                <strong style="color:#183963">
                                    @if (grupo.Key == DateOnly.FromDateTime(DateTime.Today))
                                    {
                                        <span class="badge bg-primary me-1">HOY</span>
                                    }
                                    else if (grupo.Key == DateOnly.FromDateTime(DateTime.Today.AddDays(1)))
                                    {
                                        <span class="badge bg-info text-white me-1">MAÑANA</span>
                                    }
                                    @DiaSemana(grupo.Key) @grupo.Key.Day/@grupo.Key.Month/@grupo.Key.Year
                                </strong>
                                @if (pronosticoDia is not null)
                                {
                                    <span class="ms-auto d-flex align-items-center gap-2 small">
                                        <i class="@IconoWMO(pronosticoDia.WmoCode)"></i>
                                        @DescripcionWMO(pronosticoDia.WmoCode)
                                        <span class="text-danger fw-bold">@pronosticoDia.TempMax.ToString("F0")°</span>/<span class="text-primary">@pronosticoDia.TempMin.ToString("F0")°</span>
                                        <i class="bi-droplet-fill text-primary"></i>@pronosticoDia.PrecipProbabilidad%
                                        <i class="bi-wind"></i>@pronosticoDia.VientoMax.ToString("F0") km/h
                                    </span>
                                }
                            </div>
                            @foreach (var alerta in grupo)
                            {
                                var (bgColor, borderColor, textColor, iconoRiesgo) = alerta.NivelRiesgo switch
                                {
                                    "alto"  => ("#fde8e8", "#dc3545", "#dc3545", "bi-x-octagon-fill"),
                                    "medio" => ("#fff8e1", "#fd7e14", "#fd7e14", "bi-exclamation-triangle-fill"),
                                    _       => ("#e8f5e2", "#6ABF4B", "#6ABF4B", "bi-check-circle-fill")
                                };
                                <div class="px-3 py-2 d-flex align-items-start gap-3" style="background:@bgColor;border-left:4px solid @borderColor">
                                    <div class="text-center" style="min-width:36px">
                                        <span style="font-size:1.4rem">@EnumDisplay.IconoDisciplina(alerta.Disciplina)</span>
                                        <div style="font-size:.6rem;color:@textColor;font-weight:600">@EnumDisplay.Mostrar(alerta.Disciplina)</div>
                                    </div>
                                    <div class="flex-fill">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-semibold" style="color:#183963;font-size:.85rem">@alerta.Actividad</span>
                                            <span class="badge" style="background:@borderColor;color:#fff;font-size:.65rem">
                                                <i class="@iconoRiesgo me-1"></i>Riesgo @alerta.NivelRiesgo.ToUpper()
                                            </span>
                                        </div>
                                        <div class="small text-muted">
                                            <i class="bi-person me-1"></i>@(alerta.Responsable ?? "Sin asignar")
                                            · WBS: @alerta.CodigoWBS
                                        </div>
                                        @if (!string.IsNullOrEmpty(alerta.Recomendacion))
                                        {
                                            <div class="mt-1 small" style="color:@textColor">
                                                <i class="bi-lightbulb me-1"></i><strong>Recomendación:</strong> @alerta.Recomendacion
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="card-footer small text-muted" style="background:#f8f9fa">
                    <i class="bi-info-circle me-1"></i>
                    Las alertas se generan cruzando el pronóstico climático con las actividades del WBS programadas para los próximos 3 días,
                    evaluando la sensibilidad de cada disciplina a las condiciones meteorológicas.
                </div>
            </div>
        }
        else if (_actividadesProximas.Count > 0 && _pronostico.Count > 0)
        {
            <div class="card shadow-sm mb-3 border-0">
                <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#6ABF4B 0%,#5aa83e 100%);color:#fff">
                    <i class="bi-shield-check" style="font-size:1.2rem"></i>
                    <strong>Sin alertas operacionales</strong>
                </div>
                <div class="card-body text-center py-3">
                    <i class="bi-check-circle text-success" style="font-size:2rem"></i>
                    <p class="text-muted mb-0 mt-2 small">
                        Las condiciones climáticas de los próximos 3 días son favorables para las
                        <strong>@_actividadesProximas.Count actividad@(_actividadesProximas.Count != 1 ? "es" : "")</strong> programadas.
                    </p>
                </div>
            </div>
        }
    }

    <!-- H. Historial climático -->
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="bi-clock-history text-secondary"></i>
            <strong>Historial climático del proyecto</strong>
            <span class="badge bg-secondary ms-auto">@_historial.Count registros</span>
        </div>
        @if (_historial.Count == 0)
        {
            <div class="card-body">
                <p class="text-muted mb-0">
                    <i class="bi-info-circle me-1"></i>
                    Aún no hay registros climáticos para este proyecto. Consulta el clima actual para crear el primero.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha y hora</th>
                            <th>Condición</th>
                            <th class="text-center">Temp. (°C)</th>
                            <th class="text-center">Humedad (%)</th>
                            <th class="text-center">Viento (km/h)</th>
                            <th class="text-center">Precip. (mm)</th>
                            <th>Fuente</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _historial)
                        {
                            <tr>
                                <td class="text-nowrap">@r.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <i class="@IconoWMO(CondicionAWmo(r.Condicion)) me-1"></i>
                                    <span class="badge @BadgeClima(r.Condicion)">
                                        @EnumDisplay.Mostrar(r.Condicion)
                                    </span>
                                </td>
                                <td class="text-center">
                                    @(r.TemperaturaMaxima?.ToString("F1", CultureInfo.InvariantCulture) ?? "—")
                                </td>
                                <td class="text-center">@(r.HumedadRelativa?.ToString("F0") ?? "—")</td>
                                <td class="text-center">
                                    @(r.VelocidadViento?.ToString("F1", CultureInfo.InvariantCulture) ?? "—")
                                </td>
                                <td class="text-center">
                                    @(r.PrecipitacionMm?.ToString("F1", CultureInfo.InvariantCulture) ?? "—")
                                </td>
                                <td class="text-muted small">
                                    @(r.Observaciones?.Split('|').FirstOrDefault()?.Trim() ?? "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto?             _proyecto;
    private UbicacionForm         _form             = new();
    private bool                  _guardando;
    private bool                  _buscandoClima;
    private bool                  _geocodificando;
    private bool                  _ubicacionConfirmada;
    private bool                  _latitudInvalida;
    private bool                  _longitudInvalida;
    private string?               _mensajeUbicacion;
    private string?               _errorUbicacion;
    private string?               _mensajeClima;
    private string?               _errorClima;
    private string?               _horaConsulta;
    private List<RegistroClima>   _historial        = [];
    private ClimaActualDto?       _climaActual;
    private List<PronosticoDiarioDto> _pronostico   = [];
    private List<ActividadWBS>    _actividadesProximas = [];
    private List<AlertaOperacional> _alertasOperacionales = [];

    private DotNetObjectReference<Clima>? _dotNetRef;
    private bool _mapaInicializado;

    // ── Ciclo de vida ──────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) return;

        _form = new UbicacionForm
        {
            Pais         = _proyecto.Pais,
            Departamento = _proyecto.Departamento ?? string.Empty,
            Municipio    = _proyecto.Municipio    ?? string.Empty,
            Direccion    = _proyecto.Ubicacion,
            Latitud      = _proyecto.Latitud,
            Longitud     = _proyecto.Longitud
        };

        _ubicacionConfirmada = _proyecto.Latitud.HasValue && _proyecto.Longitud.HasValue;

        _historial = await Db.RegistrosClima
            .Where(r => r.ProyectoId == ProyectoId)
            .OrderByDescending(r => r.Fecha)
            .Take(100)
            .ToListAsync();

        await CargarActividadesProximasAsync();
    }

    private async Task CargarActividadesProximasAsync()
    {
        var hoy = DateTime.Today;
        var en3Dias = hoy.AddDays(3);

        var versionVigente = await Db.Set<CronogramaVersion>()
            .Where(v => v.ProyectoId == ProyectoId && v.EsVigente)
            .Select(v => v.Id)
            .FirstOrDefaultAsync();

        if (versionVigente == 0) return;

        _actividadesProximas = await Db.ActividadesWBS
            .Where(a => a.ProyectoId == ProyectoId
                     && a.CronogramaVersionId == versionVigente
                     && a.Activo
                     && a.Estado != EstadoActividad.Completada
                     && a.FechaInicioPlaneada < en3Dias
                     && a.FechaFinPlaneada >= hoy)
            .OrderBy(a => a.FechaInicioPlaneada)
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_mapaInicializado && _proyecto is not null)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("leafletMap.init",
                "leaflet-map",
                _form.Latitud.HasValue  ? (object)(double)_form.Latitud.Value  : null,
                _form.Longitud.HasValue ? (object)(double)_form.Longitud.Value : null,
                _dotNetRef);
            _mapaInicializado = true;
        }
    }

    // ── Callback del mapa (JS → C#) ───────────────────────────────────────────

    [JSInvokable]
    public async Task OnMapClick(double lat, double lng)
    {
        _form.Latitud  = (decimal)Math.Round(lat, 6);
        _form.Longitud = (decimal)Math.Round(lng, 6);
        _latitudInvalida  = false;
        _longitudInvalida = false;
        _mensajeUbicacion = null;
        _errorUbicacion   = null;
        await InvokeAsync(StateHasChanged);
        await GeocodeReversoAsync(_form.Latitud.Value, _form.Longitud.Value);
    }

    // ── Inputs manuales ───────────────────────────────────────────────────────

    private async Task OnLatitudChange(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString() ?? string.Empty;
        if (decimal.TryParse(texto, NumberStyles.Any, CultureInfo.InvariantCulture, out var val))
        {
            _latitudInvalida = val < -90m || val > 90m;
            if (!_latitudInvalida)
            {
                _form.Latitud = val;
                if (_mapaInicializado && _form.Longitud.HasValue)
                    await JS.InvokeVoidAsync("leafletMap.setMarker", (double)val, (double)_form.Longitud.Value);
                if (_form.Longitud.HasValue)
                    await GeocodeReversoAsync(val, _form.Longitud.Value);
            }
        }
        else
        {
            _form.Latitud    = null;
            _latitudInvalida = false;
        }
    }

    private async Task OnLongitudChange(ChangeEventArgs e)
    {
        var texto = e.Value?.ToString() ?? string.Empty;
        if (decimal.TryParse(texto, NumberStyles.Any, CultureInfo.InvariantCulture, out var val))
        {
            _longitudInvalida = val < -180m || val > 180m;
            if (!_longitudInvalida)
            {
                _form.Longitud = val;
                if (_mapaInicializado && _form.Latitud.HasValue)
                    await JS.InvokeVoidAsync("leafletMap.setMarker", (double)_form.Latitud.Value, (double)val);
                if (_form.Latitud.HasValue)
                    await GeocodeReversoAsync(_form.Latitud.Value, val);
            }
        }
        else
        {
            _form.Longitud    = null;
            _longitudInvalida = false;
        }
    }

    // ── Geocodificación inversa (Nominatim / OpenStreetMap) ───────────────────

    private async Task GeocodeReversoAsync(decimal lat, decimal lng)
    {
        _geocodificando = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var latStr = lat.ToString("F6", CultureInfo.InvariantCulture);
            var lngStr = lng.ToString("F6", CultureInfo.InvariantCulture);
            var url    = $"https://nominatim.openstreetmap.org/reverse?lat={latStr}&lon={lngStr}&format=json&accept-language=es";

            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("User-Agent", "RenergeIA/1.0 (internal-app)");

            var client   = HttpFactory.CreateClient();
            var response = await client.SendAsync(request);
            if (!response.IsSuccessStatusCode) return;

            var json = await response.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(json);

            if (!doc.RootElement.TryGetProperty("address", out var addr)) return;

            if (addr.TryGetProperty("country", out var country))
            {
                var pais = country.GetString();
                if (!string.IsNullOrEmpty(pais)) _form.Pais = pais;
            }

            if (addr.TryGetProperty("state", out var state))
            {
                var depto = state.GetString();
                if (!string.IsNullOrEmpty(depto)) _form.Departamento = depto;
            }

            // Municipio: intentar varios campos en orden de preferencia
            foreach (var key in new[] { "city", "town", "village", "municipality", "county", "suburb" })
            {
                if (addr.TryGetProperty(key, out var val))
                {
                    var mun = val.GetString();
                    if (!string.IsNullOrEmpty(mun))
                    {
                        _form.Municipio = mun;
                        break;
                    }
                }
            }
        }
        catch { /* Geocodificación silenciosa: si falla, el usuario puede llenar manualmente */ }
        finally
        {
            _geocodificando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Confirmar ubicación ───────────────────────────────────────────────────

    private async Task ConfirmarUbicacionAsync()
    {
        _mensajeUbicacion = null;
        _errorUbicacion   = null;

        if (!_form.Latitud.HasValue || !_form.Longitud.HasValue)
        {
            _errorUbicacion = "Latitud y longitud son obligatorias. Haz clic en el mapa o escríbelas manualmente.";
            return;
        }
        if (_form.Latitud < -90m || _form.Latitud > 90m)
        {
            _errorUbicacion = "La latitud debe estar entre −90 y 90.";
            return;
        }
        if (_form.Longitud < -180m || _form.Longitud > 180m)
        {
            _errorUbicacion = "La longitud debe estar entre −180 y 180.";
            return;
        }

        _guardando = true;
        try
        {
            var proy = await Db.Proyectos.FindAsync(ProyectoId);
            if (proy is null) { _errorUbicacion = "Proyecto no encontrado."; return; }

            proy.Pais              = _form.Pais;
            proy.Departamento      = _form.Departamento;
            proy.Municipio         = _form.Municipio;
            proy.Ubicacion         = _form.Direccion;
            proy.Latitud           = _form.Latitud;
            proy.Longitud          = _form.Longitud;
            proy.FechaModificacion = DateTime.UtcNow;
            await Db.SaveChangesAsync();

            _proyecto            = proy;
            _ubicacionConfirmada = true;
            _mensajeUbicacion    = "Ubicación climática confirmada correctamente.";
        }
        catch (Exception ex)
        {
            _errorUbicacion = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }

    // ── Consultar clima + pronóstico (Open-Meteo, sin clave) ─────────────────

    private async Task ConsultarClimaAsync()
    {
        _errorClima   = null;
        _mensajeClima = null;
        _climaActual  = null;
        _pronostico.Clear();

        if (!_form.Latitud.HasValue || !_form.Longitud.HasValue)
        {
            _errorClima = "Confirma la ubicación primero.";
            return;
        }

        _buscandoClima = true;
        try
        {
            var lat = _form.Latitud.Value.ToString("F6", CultureInfo.InvariantCulture);
            var lon = _form.Longitud.Value.ToString("F6", CultureInfo.InvariantCulture);

            var url = $"https://api.open-meteo.com/v1/forecast" +
                      $"?latitude={lat}&longitude={lon}" +
                      $"&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,rain,weather_code,wind_speed_10m" +
                      $"&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,wind_speed_10m_max" +
                      $"&timezone=auto&forecast_days=16";

            var client   = HttpFactory.CreateClient();
            var response = await client.GetAsync(url);
            var json     = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                _errorClima = $"Open-Meteo respondió {(int)response.StatusCode}. Intenta de nuevo en un momento.";
                return;
            }

            using var doc = JsonDocument.Parse(json);

            // ── Clima actual ──────────────────────────────────────────────────
            var cur  = doc.RootElement.GetProperty("current");
            var temp = cur.GetProperty("temperature_2m").GetDecimal();
            var sens = cur.GetProperty("apparent_temperature").GetDecimal();
            var hum  = cur.GetProperty("relative_humidity_2m").GetDecimal();
            var wind = cur.GetProperty("wind_speed_10m").GetDecimal();
            var prec = cur.GetProperty("precipitation").GetDecimal();
            var wmo  = cur.GetProperty("weather_code").GetInt32();

            _climaActual  = new ClimaActualDto(temp, sens, hum, wind, prec, wmo);
            _horaConsulta = DateTime.Now.ToString("HH:mm dd/MM/yyyy");

            // Guardar en historial
            var condicion = MapearCondicion(wmo);
            var registro  = new RegistroClima
            {
                ProyectoId        = ProyectoId,
                Fecha             = DateTime.Now,
                Condicion         = condicion,
                TemperaturaMaxima = temp,
                TemperaturaMinima = temp,
                HumedadRelativa   = hum,
                VelocidadViento   = wind,
                PrecipitacionMm   = prec,
                AfectoActividades = false,
                Observaciones     = $"Open-Meteo | {DescripcionWMO(wmo)}"
            };
            Db.RegistrosClima.Add(registro);
            await Db.SaveChangesAsync();
            _historial.Insert(0, registro);

            // ── Pronóstico diario 16 días ────────────────────────────────────
            var daily      = doc.RootElement.GetProperty("daily");
            var fechas     = daily.GetProperty("time");
            var wmos       = daily.GetProperty("weather_code");
            var tMax       = daily.GetProperty("temperature_2m_max");
            var tMin       = daily.GetProperty("temperature_2m_min");
            var precipSum  = daily.GetProperty("precipitation_sum");
            var precipProb = daily.GetProperty("precipitation_probability_max");
            var windMax    = daily.GetProperty("wind_speed_10m_max");

            for (int i = 0; i < fechas.GetArrayLength(); i++)
            {
                _pronostico.Add(new PronosticoDiarioDto(
                    Fecha:             DateOnly.Parse(fechas[i].GetString()!),
                    WmoCode:           wmos[i].GetInt32(),
                    TempMax:           tMax[i].ValueKind == JsonValueKind.Null ? 0m : tMax[i].GetDecimal(),
                    TempMin:           tMin[i].ValueKind == JsonValueKind.Null ? 0m : tMin[i].GetDecimal(),
                    PrecipSum:         precipSum[i].ValueKind == JsonValueKind.Null ? 0m : precipSum[i].GetDecimal(),
                    PrecipProbabilidad: precipProb[i].ValueKind == JsonValueKind.Null ? 0 : precipProb[i].GetInt32(),
                    VientoMax:         windMax[i].ValueKind == JsonValueKind.Null ? 0m : windMax[i].GetDecimal()
                ));
            }

            _mensajeClima = $"Clima y pronóstico de 16 días obtenidos correctamente ({DateTime.Now:HH:mm}).";

            GenerarAlertasOperacionales();
        }
        catch (Exception ex)
        {
            _errorClima = $"Error al consultar Open-Meteo: {ex.Message}";
        }
        finally
        {
            _buscandoClima = false;
        }
    }

    // ── Alertas operacionales (cruce WBS + Clima por Disciplina) ────────────

    private void GenerarAlertasOperacionales()
    {
        _alertasOperacionales.Clear();
        if (_actividadesProximas.Count == 0 || _pronostico.Count == 0) return;

        var hoy = DateOnly.FromDateTime(DateTime.Today);

        foreach (var act in _actividadesProximas)
        {
            var disciplina = act.Disciplina ?? Disciplina.General;

            for (int d = 0; d < 3 && d < _pronostico.Count; d++)
            {
                var dia = _pronostico[d];
                if (dia.Fecha < hoy) continue;

                var fechaIni = DateOnly.FromDateTime(act.FechaInicioPlaneada);
                var fechaFin = DateOnly.FromDateTime(act.FechaFinPlaneada);
                if (dia.Fecha < fechaIni || dia.Fecha > fechaFin) continue;

                var (nivel, recomendacion) = EvaluarRiesgoActividad(act.Nombre, disciplina, dia);

                if (nivel != "bajo")
                {
                    _alertasOperacionales.Add(new AlertaOperacional(
                        Fecha:         dia.Fecha,
                        Actividad:     act.Nombre,
                        CodigoWBS:     act.CodigoWBS,
                        Responsable:   act.Responsable,
                        Disciplina:    disciplina,
                        NivelRiesgo:   nivel,
                        Recomendacion: recomendacion
                    ));
                }
            }
        }

        _alertasOperacionales = _alertasOperacionales
            .OrderBy(a => a.Fecha)
            .ThenByDescending(a => a.NivelRiesgo == "alto" ? 0 : 1)
            .ToList();
    }

    private static (string Nivel, string Recomendacion) EvaluarRiesgoActividad(
        string nombreActividad, Disciplina disciplina, PronosticoDiarioDto dia)
    {
        var lluvia = dia.PrecipProbabilidad;
        var viento = dia.VientoMax;
        var precip = dia.PrecipSum;
        var tormenta = dia.WmoCode is 95 or 96 or 99;
        var nombre = nombreActividad.ToLowerInvariant();

        var tipo = ClasificarActividad(nombre);

        return tipo switch
        {
            "vaciado" => tormenta || lluvia >= 75 || precip > 12
                ? ("alto", "Suspender vaciado de concreto. La lluvia afecta la relación agua/cemento y debilita la mezcla. Reprogramar para día seco.")
                : lluvia >= 45 || precip > 3
                    ? ("medio", "Riesgo de lluvia durante fraguado. Programar vaciado en las primeras horas. Tener plástico listo para cubrir y bomba de achique preparada.")
                    : ("bajo", ""),

            "excavacion" => tormenta || lluvia >= 70 || precip > 15
                ? ("alto", "Suspender excavaciones. Riesgo de inundación, derrumbe de taludes y atrapamiento. Revisar entibados existentes.")
                : lluvia >= 45 || precip > 5
                    ? ("medio", "Precaución en zanjas abiertas. Verificar bombeo de achique, estabilidad de taludes y señalización. Uso de botas pantaneras.")
                    : ("bajo", ""),

            "vias" => tormenta || lluvia >= 80
                ? ("alto", "Suspender extendido y compactación de material granular. La saturación impide alcanzar densidad requerida.")
                : lluvia >= 50 || precip > 8
                    ? ("medio", "Material granular puede saturarse. Verificar humedad óptima antes de compactar. Cubrir acopios. Uso de impermeable.")
                    : ("bajo", ""),

            "cimentacion" => tormenta || lluvia >= 75 || precip > 10
                ? ("alto", "Suspender trabajos de cimentación. Riesgo de acumulación de agua en excavación y afectación de concreto de limpieza.")
                : lluvia >= 50 || precip > 4
                    ? ("medio", "Proteger acero de refuerzo expuesto. Verificar nivel freático. Tener bombeo listo. Cubrir formaletas.")
                    : ("bajo", ""),

            "estructura" => tormenta || viento > 45 || (lluvia >= 75 && viento > 30)
                ? ("alto", "Suspender montaje estructural. Viento y/o tormenta hacen inseguro el izaje de elementos pesados.")
                : lluvia >= 50 || viento > 30
                    ? ("medio", "Precaución en soldadura y montaje. Proteger uniones sin pintar. Verificar estabilidad de arriostramientos temporales.")
                    : ("bajo", ""),

            "tendido_cable" => tormenta
                ? ("alto", "Suspender tendido de cables. Riesgo de descarga atmosférica sobre conductores expuestos. Alejar personal del tendido.")
                : lluvia >= 50 || precip > 5
                    ? ("medio", "Proteger puntas de cables con capuchones. Evitar tendido sobre terreno encharcado. Usar guantes dieléctricos secos.")
                    : ("bajo", ""),

            "conexionado" => tormenta
                ? ("alto", "Suspender conexionado eléctrico. Riesgo de descarga atmosférica y cortocircuito por humedad en bornes.")
                : lluvia >= 40 || precip > 2
                    ? ("medio", "No realizar conexionado con humedad. Secar completamente bornes y terminales antes de conectar. Usar EPP dieléctrico seco.")
                    : ("bajo", ""),

            "tableros" => tormenta
                ? ("alto", "Suspender trabajo en tableros eléctricos. Riesgo de descarga y cortocircuito por ingreso de agua.")
                : lluvia >= 40 || precip > 2
                    ? ("medio", "Mantener tableros cerrados al máximo. Trabajar con carpas de protección. No energizar con humedad presente.")
                    : ("bajo", ""),

            "pruebas_electricas" => tormenta || lluvia >= 30
                ? ("alto", "Suspender pruebas eléctricas (megado, hi-pot, aislamiento). Los resultados son inválidos con humedad y hay riesgo de descarga.")
                : lluvia >= 20 || precip > 1
                    ? ("medio", "Humedad relativa alta puede afectar resultados de megado. Verificar condiciones antes de iniciar. Documentar humedad ambiente.")
                    : ("bajo", ""),

            "malla_tierra" => tormenta
                ? ("alto", "Suspender instalación de malla a tierra. Riesgo extremo de descarga atmosférica sobre sistema de puesta a tierra.")
                : lluvia >= 50 || precip > 5
                    ? ("medio", "Terreno húmedo facilita la instalación pero dificulta soldadura exotérmica. Proteger puntos de soldadura cadweld. Verificar resistividad post-lluvia.")
                    : ("bajo", ""),

            "izaje" => tormenta || viento > 40
                ? ("alto", "Suspender izaje. Vientos superan límite seguro de operación de grúa. Asegurar cargas suspendidas.")
                : viento > 25 || lluvia >= 60
                    ? ("medio", "Reducir radio de operación de grúa. Asignar vigía de viento. Verificar estabilidad de apoyos. Usar vientos de guía.")
                    : ("bajo", ""),

            "soldadura" => lluvia >= 60 || viento > 35 || tormenta
                ? ("alto", "Suspender soldadura en campo abierto. Viento dispersa gas protector y lluvia contamina la junta. Riesgo de defectos.")
                : lluvia >= 40 || viento > 20
                    ? ("medio", "Instalar pantallas cortaviento. Proteger juntas recién soldadas de la lluvia. Verificar precalentamiento en piezas húmedas.")
                    : ("bajo", ""),

            "montaje" => tormenta || viento > 45
                ? ("alto", "Suspender montaje mecánico en altura. Condiciones de viento y/o tormenta hacen insegura la maniobra.")
                : lluvia >= 60 || viento > 30
                    ? ("medio", "Precaución en maniobras con carga. Superficies resbaladizas en altura. Verificar anclajes temporales y líneas de vida.")
                    : ("bajo", ""),

            "pintura" => lluvia >= 40 || precip > 2 || tormenta
                ? ("alto", "Suspender pintura y recubrimiento. La humedad impide adherencia y causa defectos. Humedad relativa debe ser <85%.")
                : lluvia >= 25
                    ? ("medio", "Medir humedad relativa y punto de rocío antes de aplicar. Proteger áreas recién pintadas con plástico.")
                    : ("bajo", ""),

            "commissioning" => tormenta || viento > 50
                ? ("alto", "Posponer pruebas de arranque. Condiciones inseguras para operación de equipos rotativos y pruebas con fluidos.")
                : lluvia >= 60 || viento > 35
                    ? ("medio", "Monitorear condiciones. Tener plan de paro de emergencia. Proteger instrumentación y sensores expuestos.")
                    : ("bajo", ""),

            "liberacion" => tormenta
                ? ("medio", "Tormenta prevista. Reprogramar inspecciones de campo. Priorizar revisión documental en oficina.")
                : lluvia >= 70
                    ? ("medio", "Lluvia puede impedir acceso a frentes de trabajo para inspección. Coordinar ventanas de tiempo seco.")
                    : ("bajo", ""),

            _ => EvaluarRiesgoPorDisciplinaGenerica(disciplina, dia, tormenta, lluvia, viento, precip)
        };
    }

    private static string ClasificarActividad(string nombre)
    {
        if (nombre.Contains("vaciado") || nombre.Contains("fundición") || nombre.Contains("fundicion")
            || nombre.Contains("concreto") || nombre.Contains("hormigón") || nombre.Contains("hormigon"))
            return "vaciado";

        if (nombre.Contains("excavaci") || nombre.Contains("zanja") || nombre.Contains("movimiento de tierra"))
            return "excavacion";

        if (nombre.Contains("vía") || nombre.Contains("via") || nombre.Contains("vias")
            || nombre.Contains("sub-base") || nombre.Contains("subbase") || nombre.Contains("base granular")
            || nombre.Contains("afirmado") || nombre.Contains("compactac"))
            return "vias";

        if (nombre.Contains("cimentaci") || nombre.Contains("pedestal") || nombre.Contains("zapata")
            || nombre.Contains("dado") || nombre.Contains("placa de"))
            return "cimentacion";

        if (nombre.Contains("estructura") && !nombre.Contains("electri"))
            return "estructura";

        if (nombre.Contains("malla") && nombre.Contains("tierra"))
            return "malla_tierra";

        if (nombre.Contains("tendido") || nombre.Contains("tirado") || (nombre.Contains("cable") && !nombre.Contains("conexion")))
            return "tendido_cable";

        if (nombre.Contains("conexion") || nombre.Contains("conexión") || nombre.Contains("empalme")
            || nombre.Contains("acometida"))
            return "conexionado";

        if (nombre.Contains("tablero") || nombre.Contains("ccm") || nombre.Contains("mcc")
            || nombre.Contains("subestaci") || nombre.Contains("celda"))
            return "tableros";

        if (nombre.Contains("prueba") && (nombre.Contains("electri") || nombre.Contains("megado")
            || nombre.Contains("aislamiento") || nombre.Contains("hi-pot") || nombre.Contains("hipot")))
            return "pruebas_electricas";

        if (nombre.Contains("izaje") || nombre.Contains("grúa") || nombre.Contains("grua")
            || nombre.Contains("maniobra"))
            return "izaje";

        if (nombre.Contains("soldadura") || nombre.Contains("soldar"))
            return "soldadura";

        if (nombre.Contains("montaje") || nombre.Contains("instalaci"))
            return "montaje";

        if (nombre.Contains("pintura") || nombre.Contains("recubrimiento") || nombre.Contains("sandblast")
            || nombre.Contains("galvaniz"))
            return "pintura";

        if (nombre.Contains("commissioning") || nombre.Contains("arranque") || nombre.Contains("puesta en marcha"))
            return "commissioning";

        if (nombre.Contains("liberaci") || nombre.Contains("inspecci") || nombre.Contains("punch"))
            return "liberacion";

        return "general";
    }

    private static (string, string) EvaluarRiesgoPorDisciplinaGenerica(
        Disciplina disciplina, PronosticoDiarioDto dia,
        bool tormenta, int lluvia, decimal viento, decimal precip)
    {
        return disciplina switch
        {
            Disciplina.Civil => tormenta || lluvia >= 80
                ? ("alto", "Suspender actividades civiles en campo. Condiciones adversas para trabajos al aire libre.")
                : lluvia >= 50 || precip > 5
                    ? ("medio", "Precaución en actividades civiles. Proteger materiales y frentes de trabajo. Uso de impermeable y botas pantaneras.")
                    : ("bajo", ""),

            Disciplina.Electrica => tormenta
                ? ("alto", "Suspender trabajos eléctricos en campo. Riesgo de descarga atmosférica.")
                : lluvia >= 50 || precip > 3
                    ? ("medio", "Proteger componentes eléctricos de la humedad. Usar EPP dieléctrico seco.")
                    : ("bajo", ""),

            Disciplina.Mecanica => tormenta || viento > 50
                ? ("alto", "Suspender trabajos mecánicos en altura y maniobras con carga. Viento excesivo.")
                : lluvia >= 60 || viento > 35
                    ? ("medio", "Precaución en trabajos mecánicos al aire libre. Verificar anclajes y proteger equipos.")
                    : ("bajo", ""),

            Disciplina.HotCommissioning => tormenta || viento > 50
                ? ("alto", "Posponer pruebas. Condiciones inseguras para commissioning.")
                : lluvia >= 60 || viento > 40
                    ? ("medio", "Monitorear condiciones. Tener plan de contingencia listo.")
                    : ("bajo", ""),

            _ => tormenta
                ? ("medio", "Tormenta eléctrica prevista. Limitar desplazamientos a campo. Priorizar trabajo en oficina.")
                : ("bajo", "")
        };
    }

    // ── Lógica de "Apto para obra" ────────────────────────────────────────────

    // "apto" < 60% · "precaucion" 60-84% · "no" ≥ 85%
    private static string AptitudObra(PronosticoDiarioDto d) => d.PrecipProbabilidad switch
    {
        < 60 => "apto",
        < 85 => "precaucion",
        _    => "no"
    };

