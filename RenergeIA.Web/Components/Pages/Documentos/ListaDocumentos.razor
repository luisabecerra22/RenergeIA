    private void MostrarMensaje(string msg, bool error)
    {
        _mensaje = msg;
        _mensajeError = error;
    }

    // ── Helpers visuales ────────────────────────────────────────────────────

    private static string FechaCorta(DateTime? f) => f?.ToString("dd/MM/yyyy") ?? "—";

    private static string BadgeEstado(EstadoDocumento e) => e switch
    {
        EstadoDocumento.PendienteEmitir       => "bg-secondary",
        EstadoDocumento.PendienteValidacion   => "bg-primary",
        EstadoDocumento.ValidadoConComentarios => "bg-warning text-dark",
        EstadoDocumento.Validado              => "bg-success",
        EstadoDocumento.Informativos          => "bg-info text-dark",
        EstadoDocumento.NoValidado            => "bg-danger",
        _                                     => "bg-secondary"
    };

    private static string ColorEstadoHex(EstadoDocumento e) => e switch
    {
        EstadoDocumento.PendienteEmitir       => "#6c757d",
        EstadoDocumento.PendienteValidacion   => "#0d6efd",
        EstadoDocumento.ValidadoConComentarios => "#ffc107",
        EstadoDocumento.Validado              => "#6ABF4B",
        EstadoDocumento.Informativos          => "#0dcaf0",
        EstadoDocumento.NoValidado            => "#dc3545",
        _                                     => "#6c757d"
    };

    private static string ColorArea(AreaDocumento a) => a switch
    {
        AreaDocumento.Civil     => "#0d6efd",
        AreaDocumento.Mecanico  => "#6ABF4B",
        AreaDocumento.Electrico => "#fd7e14",
        AreaDocumento.General   => "#6c757d",
        _                      => "#6c757d"
    };

    private static string ColorRetraso(int? dias) => dias switch
    {
        null => "",
        <= 15 => "text-success",
        <= 30 => "text-warning fw-bold",
        _ => "text-danger fw-bold"
    };

    private static string IconoCategoria(CategoriaDocumento c) => c switch
    {
        CategoriaDocumento.Procedimientos => "bi-journal-text",
        CategoriaDocumento.HSE            => "bi-shield-check",
        CategoriaDocumento.Ingenieria     => "bi-rulers",
        _                                 => "bi-file-earmark"
    };

    // ── Modelo de edición ───────────────────────────────────────────────────

    private sealed class EditModel
    {
        public string? CodigoCliente { get; set; }
        public string Codigo { get; set; } = "";
        public string Titulo { get; set; } = "";
        public EstadoDocumento Estado { get; set; }
        public string Version { get; set; } = "0";
        public DateTime? FechaEmision { get; set; }
        public DateTime? FechaEntrega1 { get; set; }
        public DateTime? FechaDevolucion1 { get; set; }
        public DateTime? FechaEntrega2 { get; set; }
        public DateTime? FechaDevolucion2 { get; set; }
        public DateTime? FechaEntrega3 { get; set; }
        public DateTime? FechaDevolucion3 { get; set; }
        public DateTime? FechaValidacion { get; set; }
        public int Fase { get; set; } = 1;
        public AreaDocumento Area { get; set; }
        public string? Transmittal { get; set; }
        public string? Observaciones { get; set; }
        public string? Responsable { get; set; }
    }
