@page "/proyectos/{ProyectoId:int}/histogramas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject HistogramaService HistSvc
@inject IJSRuntime JS

<PageTitle>Histogramas — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
        <a href="/proyectos/@ProyectoId" class="btn btn-sm btn-outline-secondary">&larr; Volver</a>
        <div class="flex-grow-1">
            <h1 class="h3 mb-0">Histogramas de Recursos — @_proyecto.Nombre</h1>
            <small style="color:#111921">
                Plantilla de referencia:
                <span class="badge" style="background:#183963">@HistogramaService.NombrePlantilla(_proyecto.CapacidadKWp)</span>
                <span style="color:#111921">(@((_proyecto.CapacidadKWp / 1000m).ToString("F1")) MW instalados)</span>
            </small>
        </div>
        <button class="btn btn-success btn-sm" @onclick="CargarPlantillaAsync">
            ↻ Recargar plantilla @HistogramaService.NombrePlantilla(_proyecto.CapacidadKWp)
        </button>
    </div>

    <!-- Selectores de mes y año inicial -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-2 d-flex align-items-center gap-3 flex-wrap">
            <label class="form-label mb-0 fw-semibold text-nowrap" style="color:#183963">
                Mes inicial:
            </label>
            <select class="form-select form-select-sm" style="width:160px"
                    value="@_proyecto.MesInicialHistograma"
                    @onchange="CambiarMesInicialAsync">
                @for (int m = 1; m <= 12; m++)
                {
                    var mes = m;
                    <option value="@mes" selected="@(mes == _proyecto.MesInicialHistograma)">
                        @NombreMesLargo(mes)
                    </option>
                }
            </select>

            <label class="form-label mb-0 fw-semibold text-nowrap" style="color:#183963">
                Año inicial:
            </label>
            <select class="form-select form-select-sm" style="width:90px"
                    value="@_proyecto.AnioInicialHistograma"
                    @onchange="CambiarAnioInicialAsync">
                @for (int a = 2025; a <= 2055; a++)
                {
                    var anio = a;
                    <option value="@anio" selected="@(anio == _proyecto.AnioInicialHistograma)">@anio</option>
                }
            </select>

            <small style="color:#111921">
                Período:
                <strong>@NombreMesLargo(_proyecto.MesInicialHistograma) @_proyecto.AnioInicialHistograma</strong>
                →
                <strong>@NombreMesLargo(MesEnPosicion(12)) @AnoEnPosicion(12)</strong>
            </small>
        </div>
    </div>

    <!-- Pestañas principales: Personal / Equipos -->
    <ul class="nav nav-tabs mb-0">
        <li class="nav-item">
            <button class="nav-link @(_tabActiva == TipoHistograma.Personal ? "active" : "")"
                    @onclick="() => CambiarTabAsync(TipoHistograma.Personal)">
                Personal
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_tabActiva == TipoHistograma.Equipos ? "active" : "")"
                    @onclick="() => CambiarTabAsync(TipoHistograma.Equipos)">
                Equipos
            </button>
        </li>
    </ul>

    <!-- Sub-pestañas: Planificado / Real / Comparativo -->
    <div class="border border-top-0 rounded-bottom p-3 mb-4 bg-white">
        <ul class="nav nav-pills mb-3">
            <li class="nav-item">
                <button class="nav-link @(_subTab == "Planificado" ? "active" : "")"
                        style="@(_subTab == "Planificado" ? "background:#183963" : "")"
                        @onclick='() => CambiarSubTab("Planificado")'>
                    Planificado
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_subTab == "Real" ? "active" : "")"
                        style="@(_subTab == "Real" ? "background:#183963" : "")"
                        @onclick='() => CambiarSubTab("Real")'>
                    Real
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_subTab == "Comparativo" ? "active" : "")"
                        style="@(_subTab == "Comparativo" ? "background:#183963" : "")"
                        @onclick='() => CambiarSubTab("Comparativo")'>
                    Comparativo
                </button>
            </li>
        </ul>

        <!-- ══════════════════ SUB-TAB: PLANIFICADO ══════════════════ -->
        @if (_subTab == "Planificado")
        {
            @if (_plantillaActual is null || !_plantillaActual.Items.Any())
            {
                <div class="card shadow-sm text-center py-5">
                    <p style="color:#111921" class="mb-1">
                        No hay datos de histograma para @(_tabActiva == TipoHistograma.Personal ? "Personal" : "Equipos").
                    </p>
                    <p style="color:#111921" class="small mb-3">
                        La plantilla <strong>@HistogramaService.NombrePlantilla(_proyecto.CapacidadKWp)</strong>
                        se asigna automáticamente al crear el proyecto.
                    </p>
                    <button class="btn btn-success" @onclick="CargarPlantillaAsync">
                        Cargar plantilla @HistogramaService.NombrePlantilla(_proyecto.CapacidadKWp)
                    </button>
                </div>
            }
            else
            {
                <!-- Tarjetas de totales por mes -->
                <div class="row g-2 mb-4">
                    @for (int pos = 1; pos <= 12; pos++)
                    {
                        var posicion = pos;
                        var total    = _items.Sum(i => ValorMes(i, posicion));
                        var unidad   = _tabActiva == TipoHistograma.Personal ? "pers." : "equip.";
                        var esHoy    = EsPosicionActual(posicion);
                        <div class="col-6 col-md-2 col-lg-1">
                            <div class="card shadow-sm text-center p-2 @(esHoy ? "border-2" : "")"
                                 style="@(esHoy ? "border-color:#6ABF4B !important;background:#f6fff2" : "")">
                                <div style="font-size:0.6rem;color:@(esHoy ? "#6ABF4B" : "#111921");font-weight:@(esHoy ? "700" : "400")">
                                    @NombreMesCorto(MesEnPosicion(posicion)).ToUpper()
                                </div>
                                <div style="font-size:0.55rem;color:@(esHoy ? "#6ABF4B" : "#6c757d")">
                                    @AnoEnPosicion(posicion)
                                </div>
                                <div class="fw-bold" style="font-size:1.1rem;color:@(esHoy ? "#6ABF4B" : "inherit")">@total</div>
                                <div style="font-size:0.6rem;color:#111921">@unidad</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Gráfico + KPI -->
                <div class="row g-3 mb-4 align-items-stretch">
                    <div class="col-lg-9">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <canvas id="histogramaChart" height="140"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="card shadow-sm h-100" style="border-left:4px solid #183963">
                            <div class="card-body d-flex flex-column justify-content-center text-center p-3">
                                <div class="text-uppercase fw-semibold mb-3"
                                     style="color:#111921;font-size:0.75rem;letter-spacing:0.05em;line-height:1.4">
                                    @(_tabActiva == TipoHistograma.Personal ? "Personal requerido" : "Equipos requeridos")<br>a corte de hoy
                                </div>
                                @if (KpiEstado == "activo")
                                {
                                    <div style="font-size:3.5rem;font-weight:700;color:#6ABF4B;line-height:1">
                                        @KpiTotal
                                    </div>
                                    <div style="color:#111921;font-size:0.9rem;margin-top:4px">
                                        @(_tabActiva == TipoHistograma.Personal
                                            ? (KpiTotal == 1 ? "persona" : "personas")
                                            : (KpiTotal == 1 ? "equipo" : "equipos"))
                                    </div>
                                    <div style="color:#111921;font-size:0.75rem;margin-top:6px">
                                        @NombreMesLargo(MesEnPosicion(KpiPosicion)) @AnoEnPosicion(KpiPosicion) — Mes @KpiPosicion
                                    </div>
                                }
                                else if (KpiEstado == "no_iniciado")
                                {
                                    <div style="font-size:1rem;font-weight:600;color:#ffc107">
                                        Histograma no iniciado
                                    </div>
                                    <div style="color:#111921;font-size:0.75rem;margin-top:6px">
                                        Inicia en @NombreMesLargo(_proyecto.MesInicialHistograma) @_proyecto.AnioInicialHistograma
                                    </div>
                                }
                                else if (KpiEstado == "finalizado")
                                {
                                    <div style="font-size:1rem;font-weight:600;color:#6ABF4B">
                                        Histograma finalizado
                                    </div>
                                    <div style="color:#111921;font-size:0.75rem;margin-top:6px">
                                        Duración de 12 meses completada
                                    </div>
                                }
                                else
                                {
                                    <div style="color:#111921;font-size:0.85rem">Sin datos</div>
                                }
                                <div class="mt-3 pt-2" style="border-top:1px solid #dee2e6;font-size:0.7rem;color:#111921">
                                    Según histograma planificado
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla editable planificado -->
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Distribución mensual — @(_tabActiva == TipoHistograma.Personal ? "Personal" : "Equipos") Planificado</strong>
                        <button class="btn btn-sm btn-primary" @onclick="GuardarPlanificadoAsync">Guardar cambios</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Cargo / Equipo</th>
                                    @for (int pos = 1; pos <= 12; pos++)
                                    {
                                        var p = pos;
                                        var esHoyTh = EsPosicionActual(p);
                                        <th class="text-center" style="width:70px;@(esHoyTh ? "background:#4a6741 !important" : "")">
                                            @NombreMesCorto(MesEnPosicion(p))<br>
                                            <span style="font-size:0.65em;font-weight:400;opacity:0.85">@AnoEnPosicion(p)</span>
                                        </th>
                                    }
                                    <th class="text-center">Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _items)
                                {
                                    var total = ValoresTotales(item);
                                    <tr>
                                        <td><input class="form-control form-control-sm" @bind="item.Nombre" style="min-width:160px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes1"  min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes2"  min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes3"  min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes4"  min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes5"  min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes6"  min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes7"  min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes8"  min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes9"  min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes10" min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes11" min="0" style="width:58px" /></td>
                                        <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes12" min="0" style="width:58px" /></td>
                                        <td class="text-center fw-bold">@total</td>
                                        <td><button class="btn btn-sm btn-outline-danger" @onclick="() => _items.Remove(item)">✕</button></td>
                                    </tr>
                                }
                                <tr class="table-light fw-bold">
                                    <td>TOTAL</td>
                                    @for (int pos = 1; pos <= 12; pos++) { var p = pos;
                                        <td class="text-center">@_items.Sum(i => ValorMes(i, p))</td>
                                    }
                                    <td class="text-center">@_items.Sum(i => ValoresTotales(i))</td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="AgregarFilaPlanificado">+ Agregar fila</button>
                    </div>
                </div>
            }
        }

        <!-- ══════════════════ SUB-TAB: REAL ══════════════════ -->
        @if (_subTab == "Real")
        {
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <span style="color:#111921;font-size:0.9rem">
                    Ingresa los valores reales ejecutados por mes para cada @(_tabActiva == TipoHistograma.Personal ? "cargo" : "equipo").
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopiarNombresDelPlanificado">
                    Copiar nombres del planificado
                </button>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Distribución mensual — @(_tabActiva == TipoHistograma.Personal ? "Personal" : "Equipos") Real</strong>
                    <button class="btn btn-sm btn-primary" @onclick="GuardarRealAsync">Guardar cambios</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Cargo / Equipo</th>
                                @for (int pos = 1; pos <= 12; pos++)
                                {
                                    var p = pos;
                                    var esHoyTh = EsPosicionActual(p);
                                    <th class="text-center" style="width:70px;@(esHoyTh ? "background:#4a6741 !important" : "")">
                                        @NombreMesCorto(MesEnPosicion(p))<br>
                                        <span style="font-size:0.65em;font-weight:400;opacity:0.85">@AnoEnPosicion(p)</span>
                                    </th>
                                }
                                <th class="text-center">Total</th>
                                <th style="min-width:140px">Observaciones</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _itemsReal)
                            {
                                var totalR = ValoresTotalesReal(item);
                                <tr>
                                    <td><input class="form-control form-control-sm" @bind="item.Nombre" style="min-width:160px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes1"  min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes2"  min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes3"  min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes4"  min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes5"  min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes6"  min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes7"  min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes8"  min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes9"  min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes10" min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes11" min="0" style="width:58px" /></td>
                                    <td><input type="number" class="form-control form-control-sm text-center" @bind="item.Mes12" min="0" style="width:58px" /></td>
                                    <td class="text-center fw-bold">@totalR</td>
                                    <td><input class="form-control form-control-sm" @bind="item.Observaciones" placeholder="Opcional" /></td>
                                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => _itemsReal.Remove(item)">✕</button></td>
                                </tr>
                            }
                            <tr class="table-light fw-bold">
                                <td>TOTAL</td>
                                @for (int pos = 1; pos <= 12; pos++) { var p = pos;
                                    <td class="text-center">@_itemsReal.Sum(i => ValorMesReal(i, p))</td>
                                }
                                <td class="text-center">@_itemsReal.Sum(i => ValoresTotalesReal(i))</td>
                                <td></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="AgregarFilaReal">+ Agregar fila</button>
                </div>
            </div>
        }

        <!-- ══════════════════ SUB-TAB: COMPARATIVO ══════════════════ -->
        @if (_subTab == "Comparativo")
        {
            @if (_comparativo is null)
            {
                <p style="color:#111921">Cargando comparativo...</p>
            }
            else
            {
                <!-- Tarjetas resumen -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-4 col-lg">
                        <div class="card shadow-sm text-center p-3">
                            <div style="font-size:0.7rem;color:#111921;text-transform:uppercase;font-weight:700">Total Planificado</div>
                            <div style="font-size:1.8rem;font-weight:700;color:#183963">@_comparativo.TotalPlanificado.ToString("F0")</div>
                            <div style="font-size:0.7rem;color:#111921">@(_tabActiva == TipoHistograma.Personal ? "personas-mes" : "equipos-mes")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div class="card shadow-sm text-center p-3">
                            <div style="font-size:0.7rem;color:#111921;text-transform:uppercase;font-weight:700">Total Real</div>
                            <div style="font-size:1.8rem;font-weight:700;color:#6ABF4B">@_comparativo.TotalReal.ToString("F0")</div>
                            <div style="font-size:0.7rem;color:#111921">@(_tabActiva == TipoHistograma.Personal ? "personas-mes" : "equipos-mes")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div class="card shadow-sm text-center p-3">
                            <div style="font-size:0.7rem;color:#111921;text-transform:uppercase;font-weight:700">Diferencia Acumulada</div>
                            <div style="font-size:1.8rem;font-weight:700;color:@DifColor">
                                @((_comparativo.DiferenciaAcumulada >= 0 ? "+" : "") + _comparativo.DiferenciaAcumulada.ToString("F0"))
                            </div>
                            <div style="font-size:0.7rem;color:#111921">real vs planificado</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div class="card shadow-sm text-center p-3">
                            <div style="font-size:0.7rem;color:#111921;text-transform:uppercase;font-weight:700">% Desviación Global</div>
                            <div style="font-size:1.8rem;font-weight:700;color:@DifColor">
                                @((_comparativo.PctDesviacionGlobal >= 0 ? "+" : "") + _comparativo.PctDesviacionGlobal.ToString("F1"))%
                            </div>
                            <div style="font-size:0.7rem;color:#111921">acumulado</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg">
                        <div class="card shadow-sm text-center p-3">
                            <div style="font-size:0.7rem;color:#111921;text-transform:uppercase;font-weight:700">Mes Mayor Desviación</div>
                            <div style="font-size:1.4rem;font-weight:700;color:#183963">@_comparativo.MesMayorDesviacion</div>
                            <div style="font-size:0.7rem;color:#111921">en valor absoluto</div>
                        </div>
                    </div>
                </div>

                <!-- Dos gráficas -->
                <div class="row g-3 mb-4">
                    <div class="col-lg-6">
                        <div class="card shadow-sm">
                            <div class="card-header">
                                <strong>Planificado vs Real</strong>
                            </div>
                            <div class="card-body">
                                <canvas id="comparativoChart" height="180"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card shadow-sm">
                            <div class="card-header">
                                <strong>% Desviación por mes</strong>
                                <small style="color:#111921;font-size:0.75rem;margin-left:8px">
                                    Rojo = sobreuso · Verde = ahorro
                                </small>
                            </div>
                            <div class="card-body">
                                <canvas id="desviacionChart" height="180"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla detalle comparativo -->
                <div class="card shadow-sm">
                    <div class="card-header">
                        <strong>Detalle mensual</strong>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Mes</th>
                                    <th class="text-center">Planificado</th>
                                    <th class="text-center">Real</th>
                                    <th class="text-center">Diferencia</th>
                                    <th class="text-center">% Desviación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < 12; i++)
                                {
                                    var idx  = i;
                                    var dif  = _comparativo.Diferencias[idx];
                                    var pct  = _comparativo.PctDesviacion[idx];
                                    var col  = dif > 0 ? "#dc3545" : dif < 0 ? "#6ABF4B" : "#111921";
                                    var pref = dif > 0 ? "+" : "";
                                    <tr>
                                        <td class="fw-semibold">@_comparativo.Labels[idx]</td>
                                        <td class="text-center">@_comparativo.Planificados[idx].ToString("F0")</td>
                                        <td class="text-center">@_comparativo.Reales[idx].ToString("F0")</td>
                                        <td class="text-center fw-bold" style="color:@col">@(pref + dif.ToString("F0"))</td>
                                        <td class="text-center fw-bold" style="color:@col">@(pref + pct.ToString("F1"))%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(_mensajeGuardado))
        {
            <div class="alert alert-success mt-3 py-2">@_mensajeGuardado</div>
        }
    </div>
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private TipoHistograma _tabActiva = TipoHistograma.Personal;
    private string _subTab = "Planificado";

    // Planificado
    private PlantillaHistograma? _plantillaActual;
    private List<ItemHistograma>  _items         = [];
    private List<ItemHistograma>  _itemsPersonal = [];

    // Real
    private HistogramaReal?          _histogramaReal = null;
    private List<ItemHistogramaReal> _itemsReal      = [];

    // Comparativo
    private ComparativoHistogramaVM? _comparativo;

    private string? _mensajeGuardado;
    private bool _necesitaDibujar;
    private bool _necesitaDibujarComparativo;

    // ── Nombres de mes ─────────────────────────────────────────────────────────

    private static readonly string[] _nombresMesLargo =
        ["Enero","Febrero","Marzo","Abril","Mayo","Junio",
         "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];

    private static readonly string[] _nombresMesCorto =
        ["Ene","Feb","Mar","Abr","May","Jun",
         "Jul","Ago","Sep","Oct","Nov","Dic"];

    // Devuelve el número de mes calendario (1-12) para la posición 1-12 del histograma
    private int MesEnPosicion(int posicion) =>
        (_proyecto!.MesInicialHistograma - 1 + posicion - 1) % 12 + 1;

    // Devuelve el año calendario para la posición 1-12 del histograma
    private int AnoEnPosicion(int posicion)
    {
        int offset = _proyecto!.MesInicialHistograma - 1 + posicion - 1;
        return _proyecto.AnioInicialHistograma + offset / 12;
    }

    // Etiqueta corta para el eje X de las gráficas: "Jun 25", "Ene 26"
    private string EtiquetaGrafica(int posicion) =>
        NombreMesCorto(MesEnPosicion(posicion)) + " " + (AnoEnPosicion(posicion) % 100).ToString("D2");

    private static string NombreMesLargo(int mes) => _nombresMesLargo[mes - 1];
    private static string NombreMesCorto(int mes) => _nombresMesCorto[mes - 1];

    // ── KPI — calculado como propiedad para evitar RZ1010 ─────────────────────

    private string  KpiEstado   => ComputeKpi().Estado;
    private int     KpiPosicion => ComputeKpi().Posicion;
    private decimal KpiTotal    => ComputeKpi().Total;

    private (string Estado, int Posicion, decimal Total) ComputeKpi()
    {
        var src = _tabActiva == TipoHistograma.Personal ? _itemsPersonal : _items;
        if (_proyecto is null || !src.Any()) return ("sin_datos", 0, 0);

        // Usa el año configurado por el usuario, no FechaInicioPlaneada
        var histStart = new DateTime(_proyecto.AnioInicialHistograma,
                                     _proyecto.MesInicialHistograma, 1);
        var hoy = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        if (hoy < histStart)              return ("no_iniciado", 0, 0);
        if (hoy >= histStart.AddMonths(12)) return ("finalizado", 0, 0);

        int pos   = (hoy.Year - histStart.Year) * 12 + (hoy.Month - histStart.Month) + 1;
        decimal t = src.Sum(i => ValorMes(i, pos));
        return ("activo", pos, t);
    }

    // Indica si la posición 1-12 corresponde al mes/año actual en el calendario
    private bool EsPosicionActual(int posicion)
    {
        if (_proyecto is null) return false;
        var histStart = new DateTime(_proyecto.AnioInicialHistograma,
                                     _proyecto.MesInicialHistograma, 1);
        var hoy = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        if (hoy < histStart || hoy >= histStart.AddMonths(12)) return false;
        int posHoy = (hoy.Year - histStart.Year) * 12 + (hoy.Month - histStart.Month) + 1;
        return posicion == posHoy;
    }

    private string DifColor => _comparativo?.DiferenciaAcumulada > 0 ? "#dc3545"
                             : _comparativo?.DiferenciaAcumulada < 0 ? "#6ABF4B"
                             : "#111921";

    // ── Ciclo de vida ──────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        // Garantizar valores válidos si el campo nuevo llega en 0
        if (_proyecto is not null && _proyecto.AnioInicialHistograma < 2025)
            _proyecto.AnioInicialHistograma = 2025;
        await CargarTabAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_necesitaDibujar)
        {
            _necesitaDibujar = false;
            await DibujarGraficaAsync();
        }
        if (_necesitaDibujarComparativo)
        {
            _necesitaDibujarComparativo = false;
            await DibujarComparativoAsync();
        }
    }

    // ── Acciones ───────────────────────────────────────────────────────────────

    private async Task CambiarMesInicialAsync(ChangeEventArgs e)
    {
        if (_proyecto is null) return;
        if (!int.TryParse(e.Value?.ToString(), out var mes)) return;

        _proyecto.MesInicialHistograma = mes;
        var p = await Db.Proyectos.FindAsync(ProyectoId);
        if (p is not null) { p.MesInicialHistograma = mes; await Db.SaveChangesAsync(); }

        if (_subTab == "Planificado") _necesitaDibujar = _items.Any();
        if (_subTab == "Comparativo") await CargarComparativoAsync();
    }

    private async Task CambiarAnioInicialAsync(ChangeEventArgs e)
    {
        if (_proyecto is null) return;
        if (!int.TryParse(e.Value?.ToString(), out var anio)) return;

        _proyecto.AnioInicialHistograma = anio;
        var p = await Db.Proyectos.FindAsync(ProyectoId);
        if (p is not null) { p.AnioInicialHistograma = anio; await Db.SaveChangesAsync(); }

        if (_subTab == "Planificado") _necesitaDibujar = _items.Any();
        if (_subTab == "Comparativo") await CargarComparativoAsync();
    }

    private async Task CambiarTabAsync(TipoHistograma tipo)
    {
        _tabActiva = tipo;
        _mensajeGuardado = null;
        _comparativo = null;
        await CargarTabAsync();
    }

    private async Task CambiarSubTab(string subTab)
    {
        _subTab = subTab;
        _mensajeGuardado = null;
        if (subTab == "Real")             await CargarRealAsync();
        else if (subTab == "Comparativo") await CargarComparativoAsync();
        else                              _necesitaDibujar = _items.Any();
    }

    private async Task CargarTabAsync()
    {
        _plantillaActual = await HistSvc.ObtenerAsync(ProyectoId, _tabActiva);
        _items = _plantillaActual?.Items.ToList() ?? [];

        if (_tabActiva == TipoHistograma.Personal)
            _itemsPersonal = [.._items];
        else if (!_itemsPersonal.Any())
        {
            var pP = await HistSvc.ObtenerAsync(ProyectoId, TipoHistograma.Personal);
            _itemsPersonal = pP?.Items.ToList() ?? [];
        }

        if (_subTab == "Real")             await CargarRealAsync();
        else if (_subTab == "Comparativo") await CargarComparativoAsync();
        else                               _necesitaDibujar = _items.Any();
    }

    private async Task CargarRealAsync()
    {
        _histogramaReal = await HistSvc.ObtenerRealAsync(ProyectoId, _tabActiva);
        _itemsReal = _histogramaReal?.Items.ToList() ?? [];
    }

    private async Task CargarComparativoAsync()
    {
        _comparativo = await HistSvc.ObtenerComparativoAsync(
            ProyectoId, _tabActiva,
            _proyecto!.MesInicialHistograma,
            _proyecto.AnioInicialHistograma);
        _necesitaDibujarComparativo = true;
    }

    private async Task CargarPlantillaAsync()
    {
        if (_proyecto is null) return;
        var itemsP = HistogramaService.PlantillaPersonalPorCapacidad(_proyecto.CapacidadKWp);
        var itemsE = HistogramaService.PlantillaEquiposPorCapacidad(_proyecto.CapacidadKWp);

        await HistSvc.CrearOActualizarAsync(ProyectoId, TipoHistograma.Personal, itemsP);
        await HistSvc.CrearOActualizarAsync(ProyectoId, TipoHistograma.Equipos, itemsE);

        await CargarTabAsync();
        if (_tabActiva != TipoHistograma.Personal)
        {
            var pP = await HistSvc.ObtenerAsync(ProyectoId, TipoHistograma.Personal);
            _itemsPersonal = pP?.Items.ToList() ?? [];
        }

        _mensajeGuardado = $"Plantilla {HistogramaService.NombrePlantilla(_proyecto.CapacidadKWp)} cargada exitosamente.";
    }

    private async Task GuardarPlanificadoAsync()
    {
        await HistSvc.CrearOActualizarAsync(ProyectoId, _tabActiva, _items);
        await CargarTabAsync();
        _mensajeGuardado = "Histograma planificado guardado.";
    }

    private async Task GuardarRealAsync()
    {
        await HistSvc.CrearOActualizarRealAsync(ProyectoId, _tabActiva, _itemsReal);
        await CargarRealAsync();
        _mensajeGuardado = "Histograma real guardado.";
    }

    private void AgregarFilaPlanificado() =>
        _items.Add(new ItemHistograma { Nombre = "Nuevo cargo/equipo" });

    private void AgregarFilaReal() =>
        _itemsReal.Add(new ItemHistogramaReal { Nombre = "Nuevo cargo/equipo" });

    private void CopiarNombresDelPlanificado()
    {
        if (!_items.Any()) return;
        var existentes = _itemsReal.Select(i => i.Nombre).ToHashSet();
        foreach (var item in _items.Where(i => !existentes.Contains(i.Nombre)))
            _itemsReal.Add(new ItemHistogramaReal { Nombre = item.Nombre });
    }

    // ── Gráficas ───────────────────────────────────────────────────────────────

    private async Task DibujarGraficaAsync()
    {
        if (_items.Count == 0 || _proyecto is null) return;

        // Etiquetas con mes y año corto: "Jun 25", "Ene 26"
        var labels  = Enumerable.Range(1, 12).Select(p => EtiquetaGrafica(p)).ToArray();
        var totales = Enumerable.Range(1, 12).Select(p => (double)_items.Sum(i => ValorMes(i, p))).ToArray();

        await JS.InvokeVoidAsync("renderHistograma", "histogramaChart", labels, totales,
            _tabActiva == TipoHistograma.Personal ? "Personal en sitio" : "Equipos en sitio");
    }

    private async Task DibujarComparativoAsync()
    {
        if (_comparativo is null) return;

        await JS.InvokeVoidAsync("renderHistogramaComparativo",
            "comparativoChart", _comparativo.Labels,
            _comparativo.Planificados, _comparativo.Reales);

        await JS.InvokeVoidAsync("renderDesviacion",
            "desviacionChart", _comparativo.Labels, _comparativo.PctDesviacion);
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static decimal ValorMes(ItemHistograma i, int pos) => pos switch
    {
        1  => i.Mes1,  2  => i.Mes2,  3  => i.Mes3,  4  => i.Mes4,
        5  => i.Mes5,  6  => i.Mes6,  7  => i.Mes7,  8  => i.Mes8,
        9  => i.Mes9,  10 => i.Mes10, 11 => i.Mes11, 12 => i.Mes12,
        _  => 0
    };

    private static decimal ValorMesReal(ItemHistogramaReal i, int pos) => pos switch
    {
        1  => i.Mes1,  2  => i.Mes2,  3  => i.Mes3,  4  => i.Mes4,
        5  => i.Mes5,  6  => i.Mes6,  7  => i.Mes7,  8  => i.Mes8,
        9  => i.Mes9,  10 => i.Mes10, 11 => i.Mes11, 12 => i.Mes12,
        _  => 0
    };

    private static decimal ValoresTotales(ItemHistograma i) =>
        i.Mes1 + i.Mes2 + i.Mes3 + i.Mes4 + i.Mes5 + i.Mes6 +
        i.Mes7 + i.Mes8 + i.Mes9 + i.Mes10 + i.Mes11 + i.Mes12;

    private static decimal ValoresTotalesReal(ItemHistogramaReal i) =>
        i.Mes1 + i.Mes2 + i.Mes3 + i.Mes4 + i.Mes5 + i.Mes6 +
        i.Mes7 + i.Mes8 + i.Mes9 + i.Mes10 + i.Mes11 + i.Mes12;
}
