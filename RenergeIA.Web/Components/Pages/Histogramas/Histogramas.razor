    private async Task DibujarGraficaAsync()
    {
        if (_items.Count == 0 || _proyecto is null) return;

        // Etiquetas con mes y año corto: "Jun 25", "Ene 26"
        var labels  = Enumerable.Range(1, 12).Select(p => EtiquetaGrafica(p)).ToArray();
        var totales = Enumerable.Range(1, 12).Select(p => (double)_items.Sum(i => ValorMes(i, p))).ToArray();

        await JS.InvokeVoidAsync("renderHistograma", "histogramaChart", labels, totales,
            _tabActiva == TipoHistograma.Personal ? "Personal en sitio" : "Equipos en sitio");
    }

    private async Task DibujarComparativoAsync()
    {
        if (_comparativo is null) return;

        await JS.InvokeVoidAsync("renderHistogramaComparativo",
            "comparativoChart", _comparativo.Labels,
            _comparativo.Planificados, _comparativo.Reales);

        await JS.InvokeVoidAsync("renderDesviacion",
            "desviacionChart", _comparativo.Labels, _comparativo.PctDesviacion);
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static decimal ValorMes(ItemHistograma i, int pos) => pos switch
    {
        1  => i.Mes1,  2  => i.Mes2,  3  => i.Mes3,  4  => i.Mes4,
        5  => i.Mes5,  6  => i.Mes6,  7  => i.Mes7,  8  => i.Mes8,
        9  => i.Mes9,  10 => i.Mes10, 11 => i.Mes11, 12 => i.Mes12,
        _  => 0
    };

    private static decimal ValorMesReal(ItemHistogramaReal i, int pos) => pos switch
    {
        1  => i.Mes1,  2  => i.Mes2,  3  => i.Mes3,  4  => i.Mes4,
        5  => i.Mes5,  6  => i.Mes6,  7  => i.Mes7,  8  => i.Mes8,
        9  => i.Mes9,  10 => i.Mes10, 11 => i.Mes11, 12 => i.Mes12,
        _  => 0
    };

    private static decimal ValoresTotales(ItemHistograma i) =>
        i.Mes1 + i.Mes2 + i.Mes3 + i.Mes4 + i.Mes5 + i.Mes6 +
        i.Mes7 + i.Mes8 + i.Mes9 + i.Mes10 + i.Mes11 + i.Mes12;

    private static decimal ValoresTotalesReal(ItemHistogramaReal i) =>
        i.Mes1 + i.Mes2 + i.Mes3 + i.Mes4 + i.Mes5 + i.Mes6 +
        i.Mes7 + i.Mes8 + i.Mes9 + i.Mes10 + i.Mes11 + i.Mes12;
}
