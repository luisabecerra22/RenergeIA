@page "/proyectos/{ProyectoId:int}/alertas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject RenergeIADbContext Db
@inject NavigationManager Navigation
@inject DocumentoService DocSvc
@using RenergeIA.Core.Enums
@using System.ComponentModel.DataAnnotations
@using ClosedXML.Excel

<PageTitle>Alertas — @(_proyecto?.Nombre ?? "Proyecto")</PageTitle>

@if (_proyecto is null)
{
    <p class="text-muted">Cargando...</p>
}
else
{
    <PageHeader Titulo="Alertas y Control de Documentos"
                Icono="bi-bell-fill"
                Subtitulo="@_proyecto.Nombre"
                UrlVolver="@($"/proyectos/{ProyectoId}")"
                TextoVolver="Proyecto" />

    <div class="btn-group mb-4" role="group">
        <button class="btn btn-sm @(_tab == "alertas" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _tab = "alertas"'>
            <i class="bi-bell me-1"></i>Alertas
        </button>
        <button class="btn btn-sm @(_tab == "proveedores" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _tab = "proveedores"'>
            <i class="bi-building me-1"></i>Proveedores
        </button>
        <button class="btn btn-sm @(_tab == "recursos" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _tab = "recursos"'>
            <i class="bi-truck me-1"></i>Recursos
        </button>
        <button class="btn btn-sm @(_tab == "personal" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _tab = "personal"'>
            <i class="bi-people me-1"></i>Personal
        </button>
        <button class="btn btn-sm @(_tab == "dashboard" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _tab = "dashboard"'>
            <i class="bi-graph-up me-1"></i>Dashboard
        </button>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <label class="btn btn-sm btn-outline-primary mb-0" title="Importar desde el Excel de Control de Ingreso">
            <i class="bi-upload me-1"></i>Importar Excel
            <InputFile OnChange="ImportarExcelAsync" accept=".xlsx,.xls" style="display:none" />
        </label>
    </div>

    @if (!string.IsNullOrEmpty(_mensaje))
    {
        <div class="alert @(_mensajeEsError ? "alert-danger" : "alert-success") alert-dismissible py-2 mb-3">
            @_mensaje
            <button type="button" class="btn-close btn-sm" @onclick="() => _mensaje = null"></button>
        </div>
    }

    @if (_tab == "alertas")
    {
        <div class="row row-cols-2 row-cols-md-5 g-3 mb-4">
            @foreach (var (sem, titulo) in ResumenSemaforos)
            {
                var (_, bg, fg) = ControlIngresoService.EstiloSemaforo(sem);
                var count = _documentosVencimiento.Count(d => ControlIngresoService.CalcularSemaforo(d.FechaVencimiento) == sem);
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100" style="background:@bg;color:@fg;border-radius:14px">
                        <div class="fw-bold fs-4">@count</div>
                        <div class="small">@titulo</div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="btn-group btn-group-sm" role="group">
                <button class="btn @(_vistaAlertas == "matriz" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _vistaAlertas = "matriz"'>
                    <i class="bi-table me-1"></i>Matriz
                </button>
                <button class="btn @(_vistaAlertas == "lista" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _vistaAlertas = "lista"'>
                    <i class="bi-list-ul me-1"></i>Lista
                </button>
            </div>
            <input class="form-control form-control-sm" style="max-width:280px"
                   placeholder="Buscar por nombre, placa o documento..."
                   value="@_busquedaAlertas" @oninput="e => _busquedaAlertas = e.Value?.ToString() ?? string.Empty" />
        </div>

        @if (_vistaAlertas == "matriz")
        {
            <div class="card shadow-sm border-0">
                <div class="card-header text-white fw-semibold" style="background:#183963">
                    Cumplimiento por Recurso (como en el Excel de Control de Ingreso)
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0" style="font-size:.78rem">
                        <thead style="background:#f1f3f5">
                            <tr>
                                <th>Proveedor</th>
                                <th>Tipo</th>
                                <th>Recurso</th>
                                <th>Placa</th>
                                <th>Conductor</th>
                                @foreach (var t in TiposMatrizEquipo) { <th class="text-center">@t.Nombre</th> }
                                @foreach (var t in TiposMatrizPersona) { <th class="text-center">@t.Nombre</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in RecursosFiltradosMatriz)
                            {
                                <tr>
                                    <td class="small">@(r.Proveedor?.Nombre ?? "—")</td>
                                    <td><span class="badge bg-secondary" style="font-size:.68rem">@EnumDisplay.Mostrar(r.Tipo)</span></td>
                                    <td class="fw-semibold">@r.Descripcion</td>
                                    <td><span class="badge bg-light text-dark border">@(r.PlacaSerial ?? "—")</span></td>
                                    <td class="small">@(r.ConductorOperador?.Nombre ?? "—")</td>
                                    @foreach (var t in TiposMatrizEquipo)
                                    {
                                        <td class="text-center">@CeldaMatriz(BuscarDocumento(t.Id, recurso: r))</td>
                                    }
                                    @foreach (var t in TiposMatrizPersona)
                                    {
                                        <td class="text-center">@CeldaMatriz(r.ConductorOperador is null ? null : BuscarDocumento(t.Id, persona: r.ConductorOperador))</td>
                                    }
                                </tr>
                            }
                            @if (!RecursosFiltradosMatriz.Any())
                            {
                                <tr><td colspan="@(5 + TiposMatrizEquipo.Count + TiposMatrizPersona.Count)" class="text-center text-muted py-4">No hay recursos que coincidan.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead style="background:#f1f3f5">
                            <tr>
                                <th>Categoría</th>
                                <th>Dueño</th>
                                <th>Documento</th>
                                <th class="text-center">Vencimiento</th>
                                <th class="text-center">Días</th>
                                <th class="text-center">Estado</th>
                                <th>Responsable</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in DocumentosVencimientoFiltrados.OrderBy(d => d.FechaVencimiento))
                            {
                                var sem = ControlIngresoService.CalcularSemaforo(d.FechaVencimiento);
                                var (texto, bg, fg) = ControlIngresoService.EstiloSemaforo(sem);
                                var dias = d.FechaVencimiento.HasValue ? (d.FechaVencimiento.Value.Date - DateTime.Today).Days : (int?)null;
                                <tr>
                                    <td><span class="badge bg-secondary">@d.TipoDocumentoControl.Categoria</span></td>
                                    <td class="fw-semibold">@NombreDueno(d)</td>
                                    <td>@d.TipoDocumentoControl.Nombre</td>
                                    <td class="text-center small">@(d.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td class="text-center small">@(dias?.ToString() ?? "—")</td>
                                    <td class="text-center">
                                        <span class="badge" style="background:@bg;color:@fg">@texto</span>
                                    </td>
                                    <td class="small text-muted">@(d.ResponsableNombre ?? "—")</td>
                                </tr>
                            }
                            @if (!DocumentosVencimientoFiltrados.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">No hay documentos que coincidan.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else if (_tab == "proveedores")
    {
        <div class="d-flex justify-content-end mb-2">
            <button class="btn btn-primary btn-sm" @onclick='() => { _formProveedor = new(); _editandoProveedorId = null; _mostrarFormProveedor = true; }'>
                <i class="bi-plus-lg me-1"></i>Nuevo Proveedor
            </button>
        </div>
        @if (_mostrarFormProveedor)
        {
            <div class="card shadow-sm mb-3 border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between">
                    <strong>@(_editandoProveedorId.HasValue ? "Editar Proveedor" : "Nuevo Proveedor")</strong>
                    <button class="btn-close btn-close-white btn-sm" @onclick="() => _mostrarFormProveedor = false"></button>
                </div>
                <div class="card-body">
                    <EditForm Model="_formProveedor" OnValidSubmit="GuardarProveedorAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small">Nombre *</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_formProveedor.Nombre" />
                                <ValidationMessage For="() => _formProveedor.Nombre" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">NIT</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_formProveedor.NIT" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="_formProveedor.EsRenergeia" id="chkRenergeia" />
                                    <label class="form-check-label small" for="chkRenergeia">Es Renergeia</label>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _mostrarFormProveedor = false">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <table class="table table-sm table-hover align-middle mb-0">
            <thead style="background:#f1f3f5"><tr><th>Nombre</th><th>NIT</th><th class="text-center">Documentos</th><th class="text-center">Acciones</th></tr></thead>
            <tbody>
                @foreach (var p in _proveedores)
                {
                    <tr>
                        <td class="fw-semibold">@p.Nombre @(p.EsRenergeia ? "(Renergeia)" : "")</td>
                        <td class="text-muted small">@(p.NIT ?? "—")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirDocumentos(CategoriaDocumentoControl.Proveedor, p.Id, p.Nombre)">
                                📄 @_documentos.Count(d => d.ProveedorId == p.Id)
                            </button>
                        </td>
                        <td class="text-center">
                            <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => EditarProveedor(p)"><i class="bi-pencil"></i></button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarProveedorAsync(p.Id)"><i class="bi-trash"></i></button>
                        </td>
                    </tr>
                }
                @if (!_proveedores.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">No hay proveedores registrados.</td></tr> }
            </tbody>
        </table>
    }
    else if (_tab == "recursos")
    {
        <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
            <input class="form-control form-control-sm" style="max-width:320px"
                   placeholder="Buscar por descripción, placa o tipo..."
                   value="@_busquedaRecursos" @oninput="e => _busquedaRecursos = e.Value?.ToString() ?? string.Empty" />
            <button class="btn btn-primary btn-sm" @onclick='() => { _formRecurso = new(); _editandoRecursoId = null; _mostrarFormRecurso = true; }'>
                <i class="bi-plus-lg me-1"></i>Nuevo Recurso
            </button>
        </div>
        @if (_mostrarFormRecurso)
        {
            <div class="card shadow-sm mb-3 border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between">
                    <strong>@(_editandoRecursoId.HasValue ? "Editar Recurso" : "Nuevo Recurso")</strong>
                    <button class="btn-close btn-close-white btn-sm" @onclick="() => _mostrarFormRecurso = false"></button>
                </div>
                <div class="card-body">
                    <EditForm Model="_formRecurso" OnValidSubmit="GuardarRecursoAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-2">
                            <div class="col-md-2">
                                <label class="form-label small">Tipo *</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_formRecurso.Tipo">
                                    @foreach (var t in Enum.GetValues<TipoRecurso>())
                                    {
                                        <option value="@t">@EnumDisplay.Mostrar(t)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Descripción *</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_formRecurso.Descripcion" />
                                <ValidationMessage For="() => _formRecurso.Descripcion" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Placa / Serial</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_formRecurso.PlacaSerial" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Proveedor</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_formRecurso.ProveedorId">
                                    <option value="">— Ninguno —</option>
                                    @foreach (var p in _proveedores)
                                    {
                                        <option value="@p.Id">@p.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small">Conductor / Operador</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_formRecurso.ConductorOperadorId">
                                    <option value="">— Ninguno —</option>
                                    @foreach (var per in _personas)
                                    {
                                        <option value="@per.Id">@per.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Inicio Contrato</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="_formRecurso.FechaInicioContrato" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Fin Contrato</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="_formRecurso.FechaFinContrato" />
                            </div>
                        </div>
                        <div class="mt-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _mostrarFormRecurso = false">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <table class="table table-sm table-hover align-middle mb-0">
            <thead style="background:#f1f3f5">
                <tr><th>Tipo</th><th>Descripción</th><th>Placa/Serial</th><th>Proveedor</th><th>Conductor</th><th class="text-center">Estado</th><th class="text-center">Documentos</th><th class="text-center">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var r in RecursosFiltrados)
                {
                    var estadoGeneral = ControlIngresoService.EstadoGeneral(r);
                    var (egBg, egFg) = ControlIngresoService.EstiloEstadoGeneral(estadoGeneral);
                    <tr>
                        <td><span class="badge bg-secondary">@EnumDisplay.Mostrar(r.Tipo)</span></td>
                        <td class="fw-semibold">@r.Descripcion</td>
                        <td class="small"><span class="badge bg-light text-dark border">@(r.PlacaSerial ?? "—")</span></td>
                        <td class="small">@(r.Proveedor?.Nombre ?? "—")</td>
                        <td class="small">@(r.ConductorOperador?.Nombre ?? "—")</td>
                        <td class="text-center">
                            <button class="btn btn-sm" style="background:@egBg;color:@egFg;font-size:.7rem" @onclick="() => AbrirEtapas(r)">
                                @estadoGeneral
                            </button>
                        </td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirDocumentos(CategoriaDocumentoControl.Equipo, r.Id, NombreConPlaca(r))">
                                📄 @_documentos.Count(d => d.RecursoEquipoId == r.Id)
                            </button>
                        </td>
                        <td class="text-center">
                            <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => EditarRecurso(r)"><i class="bi-pencil"></i></button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarRecursoAsync(r.Id)"><i class="bi-trash"></i></button>
                        </td>
                    </tr>
                }
                @if (!RecursosFiltrados.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">No hay recursos que coincidan.</td></tr> }
            </tbody>
        </table>

        @if (_recursoEtapasSeleccionado is not null)
        {
            <div class="card mt-3 border-primary shadow-sm">
                <div class="card-header text-white d-flex justify-content-between align-items-center" style="background:#183963">
                    <strong>Etapas — @NombreConPlaca(_recursoEtapasSeleccionado)</strong>
                    <button class="btn-close btn-close-white btn-sm" @onclick="() => _recursoEtapasSeleccionado = null"></button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead style="background:#f1f3f5">
                                <tr>
                                    <th>Etapa</th>
                                    <th class="text-center">Estado</th>
                                    <th>Responsable</th>
                                    <th class="text-center">Fecha aprobación</th>
                                    <th>Comentarios</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var etapa in _recursoEtapasSeleccionado.Etapas.OrderBy(e => Array.IndexOf(ControlIngresoService.EtapasOrdenadas, e.Etapa)))
                                {
                                    var (bg, fg) = ControlIngresoService.EstiloEstadoEtapa(etapa.Estado);
                                    <tr>
                                        <td class="small fw-semibold">@EnumDisplay.Mostrar(etapa.Etapa)</td>
                                        <td class="text-center" style="min-width:150px">
                                            <select class="form-select form-select-sm" style="background:@bg;color:@fg"
                                                    value="@etapa.Estado" @onchange="e => CambiarEstadoEtapa(etapa, e.Value?.ToString())">
                                                @foreach (var est in Enum.GetValues<EstadoEtapa>())
                                                {
                                                    <option value="@est">@EnumDisplay.Mostrar(est)</option>
                                                }
                                            </select>
                                        </td>
                                        <td style="min-width:150px">
                                            <input class="form-control form-control-sm" value="@etapa.ResponsableNombre"
                                                   @onchange="e => CambiarCampoEtapa(etapa, r => r.ResponsableNombre = e.Value?.ToString())" />
                                        </td>
                                        <td class="text-center" style="min-width:150px">
                                            <input type="date" class="form-control form-control-sm"
                                                   value="@(etapa.FechaAprobacion?.ToString("yyyy-MM-dd"))"
                                                   @onchange="e => CambiarFechaEtapa(etapa, e.Value?.ToString())" />
                                        </td>
                                        <td style="min-width:200px">
                                            <input class="form-control form-control-sm" value="@etapa.DetalleComentarios"
                                                   @onchange="e => CambiarCampoEtapa(etapa, r => r.DetalleComentarios = e.Value?.ToString())" />
                                        </td>
                                        <td></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else if (_tab == "personal")
    {
        <div class="d-flex justify-content-end mb-2">
            <button class="btn btn-primary btn-sm" @onclick='() => { _formPersona = new(); _editandoPersonaId = null; _mostrarFormPersona = true; }'>
                <i class="bi-plus-lg me-1"></i>Nueva Persona
            </button>
        </div>
        @if (_mostrarFormPersona)
        {
            <div class="card shadow-sm mb-3 border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between">
                    <strong>@(_editandoPersonaId.HasValue ? "Editar Persona" : "Nueva Persona")</strong>
                    <button class="btn-close btn-close-white btn-sm" @onclick="() => _mostrarFormPersona = false"></button>
                </div>
                <div class="card-body">
                    <EditForm Model="_formPersona" OnValidSubmit="GuardarPersonaAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small">Nombre *</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_formPersona.Nombre" />
                                <ValidationMessage For="() => _formPersona.Nombre" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Cédula</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_formPersona.Cedula" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Rol</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_formPersona.Rol" placeholder="Conductor..." />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Proveedor</label>
                                <InputSelect class="form-select form-select-sm" @bind-Value="_formPersona.ProveedorId">
                                    <option value="">— Ninguno —</option>
                                    @foreach (var p in _proveedores)
                                    {
                                        <option value="@p.Id">@p.Nombre</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mt-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _mostrarFormPersona = false">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <table class="table table-sm table-hover align-middle mb-0">
            <thead style="background:#f1f3f5"><tr><th>Nombre</th><th>Cédula</th><th>Rol</th><th>Proveedor</th><th class="text-center">Documentos</th><th class="text-center">Acciones</th></tr></thead>
            <tbody>
                @foreach (var per in _personas)
                {
                    <tr>
                        <td class="fw-semibold">@per.Nombre</td>
                        <td class="text-muted small">@(per.Cedula ?? "—")</td>
                        <td class="small">@(per.Rol ?? "—")</td>
                        <td class="small">@(per.Proveedor?.Nombre ?? "—")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirDocumentos(CategoriaDocumentoControl.Persona, per.Id, per.Nombre)">
                                📄 @_documentos.Count(d => d.PersonaExternaId == per.Id)
                            </button>
                        </td>
                        <td class="text-center">
                            <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => EditarPersona(per)"><i class="bi-pencil"></i></button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarPersonaAsync(per.Id)"><i class="bi-trash"></i></button>
                        </td>
                    </tr>
                }
                @if (!_personas.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">No hay personal registrado.</td></tr> }
            </tbody>
        </table>
    }
    else if (_tab == "dashboard")
    {
        <div class="row row-cols-2 row-cols-md-5 g-3 mb-4">
            <div class="col">
                <div class="card border-0 shadow-sm text-center p-3 h-100" style="background:#183963;color:#fff;border-radius:14px">
                    <div class="fw-bold fs-4">@_recursos.Count</div>
                    <div class="small">Recursos en seguimiento</div>
                </div>
            </div>
            @foreach (var estado in new[] { "Aprobado", "En proceso", "Con comentarios", "Pendiente" })
            {
                var (bg, fg) = ControlIngresoService.EstiloEstadoGeneral(estado);
                var count = _recursos.Count(r => ControlIngresoService.EstadoGeneral(r) == estado);
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100" style="background:@bg;color:@fg;border-radius:14px">
                        <div class="fw-bold fs-4">@count</div>
                        <div class="small">@estado</div>
                    </div>
                </div>
            }
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header text-white fw-semibold" style="background:#183963">
                Tiempos promedio por etapa (días desde ingreso al sistema hasta aprobación)
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead style="background:#f1f3f5">
                        <tr>
                            <th>Etapa</th>
                            <th class="text-center">Promedio (días)</th>
                            <th class="text-center">Máximo</th>
                            <th class="text-center">Mínimo</th>
                            <th class="text-center"># Aprobadas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var etapa in ControlIngresoService.EtapasOrdenadas)
                        {
                            var dias = DiasAprobacionPorEtapa(etapa);
                            <tr style="@(etapa == EtapaCuelloDeBotella ? "background:#fde8e8" : "")">
                                <td class="fw-semibold">
                                    @EnumDisplay.Mostrar(etapa)
                                    @if (etapa == EtapaCuelloDeBotella)
                                    {
                                        <span class="badge bg-danger ms-1" style="font-size:.65rem">Cuello de botella</span>
                                    }
                                </td>
                                <td class="text-center">@(dias.Count > 0 ? dias.Average().ToString("F1") : "—")</td>
                                <td class="text-center">@(dias.Count > 0 ? dias.Max().ToString("F0") : "—")</td>
                                <td class="text-center">@(dias.Count > 0 ? dias.Min().ToString("F0") : "—")</td>
                                <td class="text-center">@dias.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header text-white fw-semibold" style="background:#183963">
                Distribución de estados por etapa
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead style="background:#f1f3f5">
                        <tr>
                            <th>Etapa</th>
                            @foreach (var est in Enum.GetValues<EstadoEtapa>()) { <th class="text-center">@EnumDisplay.Mostrar(est)</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var etapa in ControlIngresoService.EtapasOrdenadas)
                        {
                            var etapasDeTipo = _recursos.SelectMany(r => r.Etapas).Where(e => e.Etapa == etapa).ToList();
                            <tr>
                                <td class="fw-semibold">@EnumDisplay.Mostrar(etapa)</td>
                                @foreach (var est in Enum.GetValues<EstadoEtapa>())
                                {
                                    <td class="text-center">@etapasDeTipo.Count(e => e.Estado == est)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_duenoSeleccionado is not null)
    {
        <div class="card mt-3 border-primary shadow-sm">
            <div class="card-header text-white d-flex justify-content-between align-items-center" style="background:#183963">
                <strong>Documentos — @_duenoSeleccionado.Value.Nombre</strong>
                <button class="btn-close btn-close-white btn-sm" @onclick="() => _duenoSeleccionado = null"></button>
            </div>
            <div class="card-body">
                <EditForm Model="_formDocumento" OnValidSubmit="GuardarDocumentoAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small">Tipo de documento *</label>
                            <InputSelect class="form-select form-select-sm" @bind-Value="_formDocumento.TipoDocumentoControlId">
                                <option value="0">— Seleccionar —</option>
                                @foreach (var t in _tiposDocumento.Where(t => t.Categoria == _duenoSeleccionado.Value.Categoria))
                                {
                                    <option value="@t.Id">@t.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Fecha vencimiento</label>
                            <InputDate class="form-control form-control-sm" @bind-Value="_formDocumento.FechaVencimiento" />
                        </div>
                        <div class="col-md-2">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_formDocumento.Entregado" id="chkEntregado" />
                                <label class="form-check-label small" for="chkEntregado">Entregado</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Archivo (opcional)</label>
                            <InputFile OnChange="SeleccionarArchivo" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary btn-sm w-100">+ Agregar</button>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Responsable (nombre)</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_formDocumento.ResponsableNombre" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Responsable (correo)</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_formDocumento.ResponsableEmail" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">Observaciones</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_formDocumento.Observaciones" />
                        </div>
                    </div>
                </EditForm>

                <hr />
                <table class="table table-sm mb-0">
                    <thead><tr><th>Documento</th><th>Vencimiento</th><th class="text-center">Estado</th><th>Archivo</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var d in DocumentosDelDuenoActual.OrderByDescending(d => d.FechaCreacion))
                        {
                            var sem = ControlIngresoService.CalcularSemaforo(d.FechaVencimiento);
                            var (texto, bg, fg) = ControlIngresoService.EstiloSemaforo(sem);
                            <tr style="@(d.Vigente ? "" : "opacity:0.55")">
                                <td class="small">@d.TipoDocumentoControl.Nombre @(!d.Vigente ? "(histórico)" : "")</td>
                                <td class="small">@(d.FechaVencimiento?.ToString("dd/MM/yyyy") ?? (d.Entregado ? "Entregado" : "—"))</td>
                                <td class="text-center">
                                    @if (d.FechaVencimiento.HasValue)
                                    {
                                        <span class="badge" style="background:@bg;color:@fg;font-size:.68rem">@texto</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" style="font-size:.68rem">@(d.Entregado ? "Entregado" : "Pendiente")</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (!string.IsNullOrEmpty(d.RutaArchivo))
                                    {
                                        <a href="/@d.RutaArchivo" target="_blank"><i class="bi-file-earmark-arrow-down"></i> @d.NombreArchivo</a>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarDocumentoAsync(d.Id)"><i class="bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                        @if (!DocumentosDelDuenoActual.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">Sin documentos registrados.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int ProyectoId { get; set; }

    private Proyecto? _proyecto;
    private string _tab = "alertas";
    private string _vistaAlertas = "matriz";
    private string _busquedaRecursos = string.Empty;
    private string _busquedaAlertas = string.Empty;
    private string? _mensaje;
    private bool _mensajeEsError;

    private List<Proveedor> _proveedores = [];
    private List<RecursoEquipo> _recursos = [];
    private List<PersonaExterna> _personas = [];
    private List<TipoDocumentoControl> _tiposDocumento = [];
    private List<DocumentoControl> _documentos = [];
    private List<DocumentoControl> _documentosVencimiento => _documentos.Where(d => d.Vigente && d.FechaVencimiento.HasValue).ToList();

    private static readonly (SemaforoVencimiento, string)[] ResumenSemaforos =
    [
        (SemaforoVencimiento.Vigente, "Vigentes"),
        (SemaforoVencimiento.Amarillo, "Vence en 21-30 días"),
        (SemaforoVencimiento.Naranja, "Vence en 10-20 días"),
        (SemaforoVencimiento.Rojo, "Vence en <10 días"),
        (SemaforoVencimiento.Vencido, "Vencidos"),
    ];

    private bool _mostrarFormProveedor;
    private int? _editandoProveedorId;
    private FormProveedorModel _formProveedor = new();

    private bool _mostrarFormRecurso;
    private int? _editandoRecursoId;
    private FormRecursoModel _formRecurso = new();

    private bool _mostrarFormPersona;
    private int? _editandoPersonaId;
    private FormPersonaModel _formPersona = new();

    private (CategoriaDocumentoControl Categoria, int Id, string Nombre)? _duenoSeleccionado;
    private FormDocumentoModel _formDocumento = new();
    private IBrowserFile? _archivoSeleccionado;

    private IEnumerable<DocumentoControl> DocumentosDelDuenoActual
    {
        get
        {
            if (_duenoSeleccionado is null) return [];
            var (categoria, id, _) = _duenoSeleccionado.Value;
            return categoria switch
            {
                CategoriaDocumentoControl.Persona => _documentos.Where(d => d.PersonaExternaId == id),
                CategoriaDocumentoControl.Equipo => _documentos.Where(d => d.RecursoEquipoId == id),
                _ => _documentos.Where(d => d.ProveedorId == id)
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _proyecto = await Db.Proyectos.FindAsync(ProyectoId);
        if (_proyecto is null) { Navigation.NavigateTo("/proyectos"); return; }
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _proveedores = await Db.Proveedores.Where(p => p.ProyectoId == ProyectoId).OrderBy(p => p.Nombre).ToListAsync();
        _recursos = await Db.RecursosEquipo.Include(r => r.Proveedor).Include(r => r.ConductorOperador).Include(r => r.Etapas)
            .Where(r => r.ProyectoId == ProyectoId).OrderBy(r => r.Descripcion).ToListAsync();
        _personas = await Db.PersonasExternas.Include(p => p.Proveedor)
            .Where(p => p.ProyectoId == ProyectoId).OrderBy(p => p.Nombre).ToListAsync();
        _tiposDocumento = await Db.TiposDocumentoControl.Where(t => t.Activo).OrderBy(t => t.Nombre).ToListAsync();
        _documentos = await Db.DocumentosControl.Include(d => d.TipoDocumentoControl)
            .Where(d => d.ProyectoId == ProyectoId).ToListAsync();

        if (_duenoSeleccionado is not null && !DuenoExiste(_duenoSeleccionado.Value))
            _duenoSeleccionado = null;
    }

    private bool DuenoExiste((CategoriaDocumentoControl Categoria, int Id, string Nombre) dueno) => dueno.Categoria switch
    {
        CategoriaDocumentoControl.Persona => _personas.Any(p => p.Id == dueno.Id),
        CategoriaDocumentoControl.Equipo => _recursos.Any(r => r.Id == dueno.Id),
        _ => _proveedores.Any(p => p.Id == dueno.Id)
    };

    private void MostrarMensaje(string mensaje, bool esError) { _mensaje = mensaje; _mensajeEsError = esError; }

    private string NombreDueno(DocumentoControl d)
    {
        if (d.PersonaExternaId.HasValue) return _personas.FirstOrDefault(p => p.Id == d.PersonaExternaId)?.Nombre ?? "—";
        if (d.RecursoEquipoId.HasValue)
        {
            var r = _recursos.FirstOrDefault(r => r.Id == d.RecursoEquipoId);
            return r is null ? "—" : NombreConPlaca(r);
        }
        if (d.ProveedorId.HasValue) return _proveedores.FirstOrDefault(p => p.Id == d.ProveedorId)?.Nombre ?? "—";
        return "—";
    }

    private static string NombreConPlaca(RecursoEquipo r) =>
        string.IsNullOrEmpty(r.PlacaSerial) ? r.Descripcion : $"{r.Descripcion} ({r.PlacaSerial})";

    private List<TipoDocumentoControl> TiposMatrizEquipo =>
        _tiposDocumento.Where(t => t.Categoria == CategoriaDocumentoControl.Equipo && t.RequiereVencimiento)
                       .OrderBy(t => t.Nombre).ToList();

    private List<TipoDocumentoControl> TiposMatrizPersona =>
        _tiposDocumento.Where(t => t.Categoria == CategoriaDocumentoControl.Persona && t.RequiereVencimiento)
                       .OrderBy(t => t.Nombre).ToList();

    private DocumentoControl? BuscarDocumento(int tipoDocumentoControlId, RecursoEquipo? recurso = null, PersonaExterna? persona = null) =>
        _documentos.FirstOrDefault(d => d.Vigente && d.TipoDocumentoControlId == tipoDocumentoControlId &&
            (recurso is not null ? d.RecursoEquipoId == recurso.Id : d.PersonaExternaId == persona!.Id));

    private MarkupString CeldaMatriz(DocumentoControl? d)
    {
        if (d is null || !d.FechaVencimiento.HasValue)
            return new MarkupString("<span class=\"text-muted\">—</span>");
        var sem = ControlIngresoService.CalcularSemaforo(d.FechaVencimiento);
        var (_, bg, fg) = ControlIngresoService.EstiloSemaforo(sem);
        var fecha = d.FechaVencimiento.Value.ToString("dd/MM/yy");
        return new MarkupString(
            $"<span class=\"badge\" style=\"background:{bg};color:{fg};font-size:.68rem\">{fecha}</span>");
    }

    private IEnumerable<RecursoEquipo> FiltrarRecursos(string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return _recursos;
        var q = query.Trim();
        return _recursos.Where(r =>
            r.Descripcion.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            (r.PlacaSerial ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
            EnumDisplay.Mostrar(r.Tipo).Contains(q, StringComparison.OrdinalIgnoreCase) ||
            (r.Proveedor?.Nombre ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
            (r.ConductorOperador?.Nombre ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<RecursoEquipo> RecursosFiltrados => FiltrarRecursos(_busquedaRecursos);

    private IEnumerable<RecursoEquipo> RecursosFiltradosMatriz => FiltrarRecursos(_busquedaAlertas);

    private IEnumerable<DocumentoControl> DocumentosVencimientoFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_busquedaAlertas)) return _documentosVencimiento;
            var q = _busquedaAlertas.Trim();
            return _documentosVencimiento.Where(d =>
                NombreDueno(d).Contains(q, StringComparison.OrdinalIgnoreCase) ||
                d.TipoDocumentoControl.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    // ── Proveedores ──────────────────────────────────────────────────────
    private void EditarProveedor(Proveedor p)
    {
        _formProveedor = new FormProveedorModel { Nombre = p.Nombre, NIT = p.NIT, EsRenergeia = p.EsRenergeia };
        _editandoProveedorId = p.Id;
        _mostrarFormProveedor = true;
    }

    private async Task GuardarProveedorAsync()
    {
        if (_editandoProveedorId.HasValue)
        {
            var entidad = await Db.Proveedores.FindAsync(_editandoProveedorId.Value);
            if (entidad is not null)
            {
                entidad.Nombre = _formProveedor.Nombre;
                entidad.NIT = _formProveedor.NIT;
                entidad.EsRenergeia = _formProveedor.EsRenergeia;
                entidad.FechaModificacion = DateTime.UtcNow;
            }
        }
        else
        {
            Db.Proveedores.Add(new Proveedor
            {
                ProyectoId = ProyectoId,
                Nombre = _formProveedor.Nombre,
                NIT = _formProveedor.NIT,
                EsRenergeia = _formProveedor.EsRenergeia
            });
        }
        await Db.SaveChangesAsync();
        _mostrarFormProveedor = false;
        await CargarAsync();
    }

    private async Task EliminarProveedorAsync(int id)
    {
        var docs = Db.DocumentosControl.Where(d => d.ProveedorId == id);
        Db.DocumentosControl.RemoveRange(docs);
        var entidad = await Db.Proveedores.FindAsync(id);
        if (entidad is not null) Db.Proveedores.Remove(entidad);
        await Db.SaveChangesAsync();
        await CargarAsync();
    }

    // ── Recursos ─────────────────────────────────────────────────────────
    private void EditarRecurso(RecursoEquipo r)
    {
        _formRecurso = new FormRecursoModel
        {
            Tipo = r.Tipo,
            Descripcion = r.Descripcion,
            PlacaSerial = r.PlacaSerial,
            ProveedorId = r.ProveedorId,
            ConductorOperadorId = r.ConductorOperadorId,
            FechaInicioContrato = r.FechaInicioContrato,
            FechaFinContrato = r.FechaFinContrato
        };
        _editandoRecursoId = r.Id;
        _mostrarFormRecurso = true;
    }

    private async Task GuardarRecursoAsync()
    {
        if (_editandoRecursoId.HasValue)
        {
            var entidad = await Db.RecursosEquipo.FindAsync(_editandoRecursoId.Value);
            if (entidad is not null) MapearRecurso(entidad);
        }
        else
        {
            var entidad = new RecursoEquipo { ProyectoId = ProyectoId };
            MapearRecurso(entidad);
            Db.RecursosEquipo.Add(entidad);
            foreach (var etapa in ControlIngresoService.CrearEtapasIniciales(entidad))
                Db.EtapasRevision.Add(etapa);
        }
        await Db.SaveChangesAsync();
        _mostrarFormRecurso = false;
        await CargarAsync();
    }

    private void MapearRecurso(RecursoEquipo r)
    {
        r.Tipo = _formRecurso.Tipo;
        r.Descripcion = _formRecurso.Descripcion;
        r.PlacaSerial = _formRecurso.PlacaSerial;
        r.ProveedorId = _formRecurso.ProveedorId;
        r.ConductorOperadorId = _formRecurso.ConductorOperadorId;
        r.FechaInicioContrato = _formRecurso.FechaInicioContrato;
        r.FechaFinContrato = _formRecurso.FechaFinContrato;
        r.FechaModificacion = DateTime.UtcNow;
    }

    private async Task EliminarRecursoAsync(int id)
    {
        var docs = Db.DocumentosControl.Where(d => d.RecursoEquipoId == id);
        Db.DocumentosControl.RemoveRange(docs);
        var etapas = Db.EtapasRevision.Where(e => e.RecursoEquipoId == id);
        Db.EtapasRevision.RemoveRange(etapas);
        var entidad = await Db.RecursosEquipo.FindAsync(id);
        if (entidad is not null) Db.RecursosEquipo.Remove(entidad);
        await Db.SaveChangesAsync();
        if (_recursoEtapasSeleccionado?.Id == id) _recursoEtapasSeleccionado = null;
        await CargarAsync();
    }

    // ── Etapas de revisión ───────────────────────────────────────────────
    private RecursoEquipo? _recursoEtapasSeleccionado;

    private void AbrirEtapas(RecursoEquipo r) => _recursoEtapasSeleccionado = r;

    // ── Dashboard (Fase 3) ───────────────────────────────────────────────
    private List<double> DiasAprobacionPorEtapa(EtapaProceso etapa) =>
        _recursos.SelectMany(r => r.Etapas)
                 .Where(e => e.Etapa == etapa && e.Estado == EstadoEtapa.Aprobado && e.FechaAprobacion.HasValue)
                 .Select(e => (e.FechaAprobacion!.Value.Date - e.FechaCreacion.Date).TotalDays)
                 .Select(d => Math.Max(0, d))
                 .ToList();

    private EtapaProceso? EtapaCuelloDeBotella
    {
        get
        {
            EtapaProceso? peor = null;
            var peorPromedio = -1.0;
            foreach (var etapa in ControlIngresoService.EtapasOrdenadas)
            {
                var dias = DiasAprobacionPorEtapa(etapa);
                if (dias.Count == 0) continue;
                var promedio = dias.Average();
                if (promedio > peorPromedio) { peorPromedio = promedio; peor = etapa; }
            }
            return peor;
        }
    }

    private async Task CambiarEstadoEtapa(EtapaRevision etapa, string? valor)
    {
        if (!Enum.TryParse<EstadoEtapa>(valor, out var nuevoEstado)) return;
        var entidad = await Db.EtapasRevision.FindAsync(etapa.Id);
        if (entidad is null) return;
        entidad.Estado = nuevoEstado;
        entidad.FechaAprobacion = nuevoEstado == EstadoEtapa.Aprobado ? (entidad.FechaAprobacion ?? DateTime.UtcNow) : entidad.FechaAprobacion;
        entidad.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await CargarAsync();
        if (_recursoEtapasSeleccionado is not null)
            _recursoEtapasSeleccionado = _recursos.FirstOrDefault(r => r.Id == _recursoEtapasSeleccionado.Id);
    }

    private async Task CambiarCampoEtapa(EtapaRevision etapa, Action<EtapaRevision> setter)
    {
        var entidad = await Db.EtapasRevision.FindAsync(etapa.Id);
        if (entidad is null) return;
        setter(entidad);
        entidad.FechaModificacion = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await CargarAsync();
        if (_recursoEtapasSeleccionado is not null)
            _recursoEtapasSeleccionado = _recursos.FirstOrDefault(r => r.Id == _recursoEtapasSeleccionado.Id);
    }

    private async Task CambiarFechaEtapa(EtapaRevision etapa, string? valor)
    {
        DateTime? fecha = DateTime.TryParse(valor, out var f) ? f : null;
        await CambiarCampoEtapa(etapa, e => e.FechaAprobacion = fecha);
    }

    // ── Personal ─────────────────────────────────────────────────────────
    private void EditarPersona(PersonaExterna p)
    {
        _formPersona = new FormPersonaModel { Nombre = p.Nombre, Cedula = p.Cedula, Rol = p.Rol, ProveedorId = p.ProveedorId };
        _editandoPersonaId = p.Id;
        _mostrarFormPersona = true;
    }

    private async Task GuardarPersonaAsync()
    {
        if (_editandoPersonaId.HasValue)
        {
            var entidad = await Db.PersonasExternas.FindAsync(_editandoPersonaId.Value);
            if (entidad is not null)
            {
                entidad.Nombre = _formPersona.Nombre;
                entidad.Cedula = _formPersona.Cedula;
                entidad.Rol = _formPersona.Rol;
                entidad.ProveedorId = _formPersona.ProveedorId;
                entidad.FechaModificacion = DateTime.UtcNow;
            }
        }
        else
        {
            Db.PersonasExternas.Add(new PersonaExterna
            {
                ProyectoId = ProyectoId,
                Nombre = _formPersona.Nombre,
                Cedula = _formPersona.Cedula,
                Rol = _formPersona.Rol,
                ProveedorId = _formPersona.ProveedorId
            });
        }
        await Db.SaveChangesAsync();
        _mostrarFormPersona = false;
        await CargarAsync();
    }

    private async Task EliminarPersonaAsync(int id)
    {
        var docs = Db.DocumentosControl.Where(d => d.PersonaExternaId == id);
        Db.DocumentosControl.RemoveRange(docs);
        var entidad = await Db.PersonasExternas.FindAsync(id);
        if (entidad is not null) Db.PersonasExternas.Remove(entidad);
        await Db.SaveChangesAsync();
        await CargarAsync();
    }

    // ── Documentos ───────────────────────────────────────────────────────
    private void AbrirDocumentos(CategoriaDocumentoControl categoria, int id, string nombre)
    {
        _duenoSeleccionado = (categoria, id, nombre);
        _formDocumento = new FormDocumentoModel();
        _archivoSeleccionado = null;
    }

    private void SeleccionarArchivo(InputFileChangeEventArgs e) => _archivoSeleccionado = e.File;

    private async Task GuardarDocumentoAsync()
    {
        if (_duenoSeleccionado is null || _formDocumento.TipoDocumentoControlId == 0)
        {
            MostrarMensaje("Selecciona un tipo de documento.", true);
            return;
        }

        var (categoria, id, _) = _duenoSeleccionado.Value;

        // Marcar como histórico cualquier documento vigente del mismo tipo para este dueño
        var anteriores = _documentos.Where(d =>
            d.TipoDocumentoControlId == _formDocumento.TipoDocumentoControlId && d.Vigente &&
            ((categoria == CategoriaDocumentoControl.Persona && d.PersonaExternaId == id) ||
             (categoria == CategoriaDocumentoControl.Equipo && d.RecursoEquipoId == id) ||
             (categoria == CategoriaDocumentoControl.Proveedor && d.ProveedorId == id)));
        foreach (var anterior in anteriores)
        {
            var entidadAnterior = await Db.DocumentosControl.FindAsync(anterior.Id);
            if (entidadAnterior is not null) entidadAnterior.Vigente = false;
        }

        var nuevo = new DocumentoControl
        {
            ProyectoId = ProyectoId,
            TipoDocumentoControlId = _formDocumento.TipoDocumentoControlId,
            FechaVencimiento = _formDocumento.FechaVencimiento,
            Entregado = _formDocumento.Entregado || _formDocumento.FechaVencimiento.HasValue,
            ResponsableNombre = _formDocumento.ResponsableNombre,
            ResponsableEmail = _formDocumento.ResponsableEmail,
            Observaciones = _formDocumento.Observaciones,
            PersonaExternaId = categoria == CategoriaDocumentoControl.Persona ? id : null,
            RecursoEquipoId = categoria == CategoriaDocumentoControl.Equipo ? id : null,
            ProveedorId = categoria == CategoriaDocumentoControl.Proveedor ? id : null
        };
        Db.DocumentosControl.Add(nuevo);
        await Db.SaveChangesAsync();

        if (_archivoSeleccionado is not null)
        {
            await using var stream = _archivoSeleccionado.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var (ruta, error) = await DocSvc.GuardarArchivoAsync(
                stream, _archivoSeleccionado.Name, _archivoSeleccionado.Size, ProyectoId, nuevo.Id, "v1");
            if (ruta is not null)
            {
                nuevo.RutaArchivo = ruta;
                nuevo.NombreArchivo = _archivoSeleccionado.Name;
                await Db.SaveChangesAsync();
            }
            else
            {
                MostrarMensaje($"Documento guardado, pero el archivo no se pudo subir: {error}", true);
            }
        }

        _formDocumento = new FormDocumentoModel();
        _archivoSeleccionado = null;
        await CargarAsync();
    }

    private async Task EliminarDocumentoAsync(int id)
    {
        var entidad = await Db.DocumentosControl.FindAsync(id);
        if (entidad is not null) Db.DocumentosControl.Remove(entidad);
        await Db.SaveChangesAsync();
        await CargarAsync();
    }

    // ── Importar desde Excel (Control de Ingreso) ───────────────────────────

    private async Task ImportarExcelAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            using var ms = new System.IO.MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;

            using var workbook = new XLWorkbook(ms);
            var ws = workbook.Worksheets.Contains("REGISTRO") ? workbook.Worksheet("REGISTRO") : workbook.Worksheets.First();
            var lastRow = ws.LastRowUsed()?.RowNumber() ?? 0;
            var lastCol = ws.LastColumnUsed()?.ColumnNumber() ?? 0;
            if (lastRow < 2) { MostrarMensaje("El archivo no tiene filas de datos.", true); return; }

            var col = new Dictionary<string, int>();
            int headerRow = 0;
            for (int r = 1; r <= Math.Min(6, lastRow) && headerRow == 0; r++)
            {
                var mapaFila = new Dictionary<string, int>();
                for (int c = 1; c <= lastCol; c++)
                {
                    var h = NormalizarTexto(ws.Cell(r, c).GetString());
                    if (h.Length == 0) continue;
                    if (h.Contains("nombre conductor")) mapaFila["conductor"] = c;
                    else if (h.Contains("cedula conductor")) mapaFila["cedula"] = c;
                    else if (h == "nombre") mapaFila["proveedor"] = c;
                    else if (h == "nit") mapaFila["nit"] = c;
                    else if (h.Contains("tipo de recurso")) mapaFila["tiporecurso"] = c;
                    else if (h.Contains("descripcion del equipo")) mapaFila["descripcion"] = c;
                    else if (h.Contains("placa")) mapaFila["placa"] = c;
                    else if (h.Contains("fecha inicio contrato")) mapaFila["fechainicio"] = c;
                    else if (h.Contains("fecha fin contrato")) mapaFila["fechafin"] = c;
                    else if (h.Contains("venc. soat")) mapaFila["soat"] = c;
                    else if (h.Contains("venc. rtm")) mapaFila["rtm"] = c;
                    else if (h.Contains("venc. licencia")) mapaFila["licencia"] = c;
                    else if (h.Contains("venc. poliza rc")) mapaFila["polizarc"] = c;
                    else if (h.Contains("venc. poliza todo riesgo")) mapaFila["polizatr"] = c;
                    else if (h.Contains("venc. arl")) mapaFila["arl"] = c;
                    else if (h.Contains("venc. examen medico")) mapaFila["examenmedico"] = c;
                    else if (h.Contains("revision de seguridad social")) mapaFila["segsocial"] = c;
                }
                if (mapaFila.ContainsKey("tiporecurso") && mapaFila.ContainsKey("descripcion"))
                {
                    headerRow = r;
                    col = mapaFila;
                }
            }

            if (headerRow == 0)
            {
                MostrarMensaje("No se reconoce el formato del archivo. Debe tener las columnas del Control de Ingreso (Tipo de Recurso, Descripción del Equipo, etc.).", true);
                return;
            }

            var proveedoresPorNombre = _proveedores.ToDictionary(p => NormalizarTexto(p.Nombre), p => p);
            var personasPorCedula = _personas.Where(p => !string.IsNullOrEmpty(p.Cedula)).ToDictionary(p => p.Cedula!, p => p);
            var personasPorNombre = _personas.ToDictionary(p => NormalizarTexto(p.Nombre), p => p, StringComparer.Ordinal);
            var recursosPorPlaca = _recursos.Where(r => !string.IsNullOrEmpty(r.PlacaSerial)).ToDictionary(r => NormalizarTexto(r.PlacaSerial!), r => r);
            var tiposPorNombre = _tiposDocumento.ToDictionary(t => t.Nombre, t => t);

            int recursosCreados = 0, personasCreadas = 0, proveedoresCreados = 0, documentosCreados = 0, filasOmitidas = 0;

            for (int row = headerRow + 1; row <= lastRow; row++)
            {
                var nombreProveedor = LeerTexto(ws, row, col, "proveedor");
                var descripcion = LeerTexto(ws, row, col, "descripcion");
                var placa = LeerTexto(ws, row, col, "placa");

                if (string.IsNullOrEmpty(nombreProveedor) || (string.IsNullOrEmpty(descripcion) && string.IsNullOrEmpty(placa)))
                {
                    filasOmitidas++;
                    continue;
                }

                var keyProveedor = NormalizarTexto(nombreProveedor);
                if (!proveedoresPorNombre.TryGetValue(keyProveedor, out var proveedor))
                {
                    proveedor = new Proveedor
                    {
                        ProyectoId = ProyectoId,
                        Nombre = nombreProveedor,
                        NIT = LeerTexto(ws, row, col, "nit"),
                        EsRenergeia = keyProveedor.Contains("renergeia")
                    };
                    Db.Proveedores.Add(proveedor);
                    proveedoresPorNombre[keyProveedor] = proveedor;
                    proveedoresCreados++;
                }

                var tipoTexto = NormalizarTexto(LeerTexto(ws, row, col, "tiporecurso") ?? "");
                var tipoRecurso = tipoTexto switch
                {
                    var t when t.Contains("vehiculo") => TipoRecurso.Vehiculo,
                    var t when t.Contains("maquinaria") => TipoRecurso.Maquinaria,
                    var t when t.Contains("herramienta") => TipoRecurso.Herramienta,
                    _ => TipoRecurso.Equipo
                };

                RecursoEquipo? recurso = null;
                var keyPlaca = NormalizarTexto(placa ?? "");
                if (!string.IsNullOrEmpty(keyPlaca) && recursosPorPlaca.TryGetValue(keyPlaca, out var existente))
                    recurso = existente;

                var recursoEsNuevo = recurso is null;
                if (recurso is null)
                {
                    recurso = new RecursoEquipo
                    {
                        ProyectoId = ProyectoId,
                        Tipo = tipoRecurso,
                        Descripcion = string.IsNullOrEmpty(descripcion) ? placa ?? "Recurso sin descripción" : descripcion,
                        PlacaSerial = placa,
                        Proveedor = proveedor,
                        FechaInicioContrato = LeerFechaCol(ws, row, col, "fechainicio"),
                        FechaFinContrato = LeerFechaCol(ws, row, col, "fechafin")
                    };
                    Db.RecursosEquipo.Add(recurso);
                    if (!string.IsNullOrEmpty(keyPlaca)) recursosPorPlaca[keyPlaca] = recurso;
                    recursosCreados++;
                }

                PersonaExterna? conductor = null;
                var nombreConductor = LeerTexto(ws, row, col, "conductor");
                if (!string.IsNullOrEmpty(nombreConductor) && !NormalizarTexto(nombreConductor).Contains("no aplica"))
                {
                    var cedula = LeerTexto(ws, row, col, "cedula");
                    var keyPersona = NormalizarTexto(nombreConductor);
                    if (!string.IsNullOrEmpty(cedula) && personasPorCedula.TryGetValue(cedula, out var porCedula))
                        conductor = porCedula;
                    else if (personasPorNombre.TryGetValue(keyPersona, out var porNombre))
                        conductor = porNombre;

                    if (conductor is null)
                    {
                        conductor = new PersonaExterna
                        {
                            ProyectoId = ProyectoId,
                            Nombre = nombreConductor,
                            Cedula = cedula,
                            Rol = "Conductor / Operador",
                            Proveedor = proveedor
                        };
                        Db.PersonasExternas.Add(conductor);
                        if (!string.IsNullOrEmpty(cedula)) personasPorCedula[cedula] = conductor;
                        personasPorNombre[keyPersona] = conductor;
                        personasCreadas++;
                    }
                    recurso.ConductorOperador = conductor;
                }

                if (recursoEsNuevo)
                    foreach (var etapa in ControlIngresoService.CrearEtapasIniciales(recurso))
                        Db.EtapasRevision.Add(etapa);

                documentosCreados += CrearDocumentoSiHayFecha(ws, row, col, "soat", "SOAT", tiposPorNombre, recurso: recurso);
                documentosCreados += CrearDocumentoSiHayFecha(ws, row, col, "rtm", "RTM (Revisión Técnico-Mecánica)", tiposPorNombre, recurso: recurso);
                documentosCreados += CrearDocumentoSiHayFecha(ws, row, col, "polizarc", "Póliza Responsabilidad Civil", tiposPorNombre, recurso: recurso);
                documentosCreados += CrearDocumentoSiHayFecha(ws, row, col, "polizatr", "Póliza Todo Riesgo", tiposPorNombre, recurso: recurso);
                if (conductor is not null)
                {
                    documentosCreados += CrearDocumentoSiHayFecha(ws, row, col, "licencia", "Licencia de Conducción", tiposPorNombre, persona: conductor);
                    documentosCreados += CrearDocumentoSiHayFecha(ws, row, col, "arl", "ARL", tiposPorNombre, persona: conductor);
                    documentosCreados += CrearDocumentoSiHayFecha(ws, row, col, "examenmedico", "Examen Médico Ocupacional", tiposPorNombre, persona: conductor);
                    documentosCreados += CrearDocumentoSiHayFecha(ws, row, col, "segsocial", "Seguridad Social", tiposPorNombre, persona: conductor);
                }
            }

            await Db.SaveChangesAsync();
            await CargarAsync();

            MostrarMensaje($"Importado: {proveedoresCreados} proveedores, {recursosCreados} recursos, {personasCreadas} personas y {documentosCreados} documentos nuevos. {filasOmitidas} filas omitidas (sin proveedor o equipo).", false);
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al importar: {ex.Message}", true);
        }
    }

    private int CrearDocumentoSiHayFecha(
        IXLWorksheet ws, int row, Dictionary<string, int> col, string clave, string nombreTipoDoc,
        Dictionary<string, TipoDocumentoControl> tiposPorNombre,
        RecursoEquipo? recurso = null, PersonaExterna? persona = null)
    {
        var fecha = LeerFechaCol(ws, row, col, clave);
        if (fecha is null) return 0;
        if (!tiposPorNombre.TryGetValue(nombreTipoDoc, out var tipo)) return 0;

        Db.DocumentosControl.Add(new DocumentoControl
        {
            ProyectoId = ProyectoId,
            TipoDocumentoControlId = tipo.Id,
            TipoDocumentoControl = tipo,
            FechaVencimiento = fecha,
            Entregado = true,
            Vigente = true,
            RecursoEquipo = recurso,
            PersonaExterna = persona
        });
        return 1;
    }

    private static string? LeerTexto(IXLWorksheet ws, int row, Dictionary<string, int> col, string clave)
    {
        if (!col.TryGetValue(clave, out var c) || c == 0) return null;
        var v = ws.Cell(row, c).GetString().Trim();
        return string.IsNullOrEmpty(v) ? null : v;
    }

    private static DateTime? LeerFechaCol(IXLWorksheet ws, int row, Dictionary<string, int> col, string clave)
    {
        if (!col.TryGetValue(clave, out var c) || c == 0) return null;
        return LeerFecha(ws.Cell(row, c));
    }

    private static DateTime? LeerFecha(IXLCell? celda)
    {
        if (celda is null || celda.IsEmpty()) return null;
        if (celda.DataType == XLDataType.DateTime) return celda.GetDateTime();

        var texto = celda.GetString().Trim();
        if (string.IsNullOrEmpty(texto) || texto.Equals("NO APLICA", StringComparison.OrdinalIgnoreCase)) return null;

        if (DateTime.TryParse(texto, System.Globalization.CultureInfo.GetCultureInfo("es-CO"),
            System.Globalization.DateTimeStyles.None, out var fecha))
            return fecha;
        if (DateTime.TryParse(texto, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out fecha))
            return fecha;
        return null;
    }

    private static string NormalizarTexto(string texto) =>
        texto.ToLowerInvariant()
             .Replace("á", "a").Replace("é", "e").Replace("í", "i").Replace("ó", "o").Replace("ú", "u")
             .Trim();

