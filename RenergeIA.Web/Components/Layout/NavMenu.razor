@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">RenergeIA</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <!-- ── Inicio ──────────────────────────────────────── -->
        <div class="nav-section-item">
            <NavLink class="nav-top-link" href="" Match="NavLinkMatch.All">
                <i class="bi-house-door-fill nav-top-icon"></i>
                <span>Inicio</span>
            </NavLink>
        </div>

        <!-- ── Proyectos ─────────────────────────────────── -->
        <div class="nav-section-item">
            <div class="nav-top-link-row">
                <NavLink class="nav-top-link" href="proyectos">
                    <i class="bi-folder-fill nav-top-icon"></i>
                    <span>Proyectos</span>
                </NavLink>
                <button class="nav-chevron-btn"
                        @onclick="ToggleSeccionProyectos"
                        @onclick:stopPropagation="true">
                    <i class="@(_proyectosExpandido ? "bi-chevron-down" : "bi-chevron-right")"></i>
                </button>
            </div>
        </div>

        @if (_proyectosExpandido)
        {
            <div class="nav-projects-container">
                @if (_error)
                {
                    <p class="nav-msg-error">No se pudieron cargar proyectos</p>
                }
                else if (!_proyectos.Any())
                {
                    <p class="nav-msg-empty">Sin proyectos</p>
                }
                else
                {
                    @foreach (var p in _proyectos)
                    {
                        <div class="nav-project-block">

                            <div class="nav-project-header @(ProyectoActualId == p.Id ? "nav-project-active" : "")">
                                <a href="proyectos/@p.Id"
                                   class="nav-project-link"
                                   @onclick:stopPropagation="true">
                                    <i class="bi-folder2-open nav-project-icon"></i>
                                    <span class="nav-project-name">@p.Nombre</span>
                                </a>
                                <button class="nav-project-toggle"
                                        @onclick="() => ToggleProyecto(p.Id)"
                                        @onclick:stopPropagation="true"
                                        title="Expandir / contraer">
                                    <i class="@(_expandidos.Contains(p.Id) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                </button>
                            </div>

                            @if (_expandidos.Contains(p.Id))
                            {
                                <div class="nav-modules-list">
                                    @foreach (var mod in _modulos)
                                    {
                                        @if (mod.Proximamente)
                                        {
                                            <span class="nav-module-item nav-module-disabled">
                                                <i class="@mod.Icono nav-module-icon"></i>
                                                <span>@mod.Nombre</span>
                                                <span class="nav-badge-pronto">pronto</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <a href="proyectos/@p.Id/@mod.Ruta"
                                               class="nav-module-item @(ModuloActivo(p.Id, mod.Ruta) ? "nav-module-active" : "")">
                                                <i class="@mod.Icono nav-module-icon"></i>
                                                <span>@mod.Nombre</span>
                                            </a>
                                        }
                                    }
                                </div>
                            }

                        </div>
                    }
                }
            </div>
        }

        <!-- ── HSEQ (Corporativo) ──────────────────────────────── -->
        <div class="nav-section-item">
            <div class="nav-top-link-row">
                <a href="hseq/dashboard"
                   class="nav-top-link @(EsRutaHseqGlobal ? "active" : "")">
                    <i class="bi-shield-check nav-top-icon"></i>
                    <span>HSEQ</span>
                </a>
                <button class="nav-chevron-btn"
                        @onclick="ToggleHseq"
                        @onclick:stopPropagation="true">
                    <i class="@(_hseqExpandido ? "bi-chevron-down" : "bi-chevron-right")"></i>
                </button>
            </div>
        </div>

        @if (_hseqExpandido)
        {
            <div class="nav-hseq-container">
                <a href="hseq/dashboard"
                   class="nav-hseq-item @(HseqSubActivo("dashboard") ? "nav-hseq-active" : "")">
                    <i class="bi-speedometer2 nav-module-icon"></i>
                    <span>Dashboard HSEQ</span>
                </a>

                <div class="nav-hseq-item nav-hseq-group @(_auditoriasExpandido ? "nav-hseq-active" : "")"
                     @onclick="ToggleAuditorias">
                    <i class="bi-clipboard-check nav-module-icon"></i>
                    <span style="flex:1">Auditorías</span>
                    <i class="@(_auditoriasExpandido ? "bi-chevron-down" : "bi-chevron-right") nav-chevron-small"></i>
                </div>

                @if (_auditoriasExpandido)
                {
                    <div class="nav-hseq-sub">
                        <a href="hseq/auditorias/norma/iso9001"
                           class="nav-hseq-subitem @(HseqSubActivo("auditorias/norma/iso9001") ? "nav-hseq-active" : "")">
                            <i class="bi-patch-check-fill nav-module-icon"></i><span>ISO 9001</span>
                        </a>
                        <a href="hseq/auditorias/norma/iso14001"
                           class="nav-hseq-subitem @(HseqSubActivo("auditorias/norma/iso14001") ? "nav-hseq-active" : "")">
                            <i class="bi-tree-fill nav-module-icon"></i><span>ISO 14001</span>
                        </a>
                        <a href="hseq/auditorias/norma/iso45001"
                           class="nav-hseq-subitem @(HseqSubActivo("auditorias/norma/iso45001") ? "nav-hseq-active" : "")">
                            <i class="bi-shield-fill-check nav-module-icon"></i><span>ISO 45001</span>
                        </a>
                        <a href="hseq/auditorias/norma/decreto1072"
                           class="nav-hseq-subitem @(HseqSubActivo("auditorias/norma/decreto1072") ? "nav-hseq-active" : "")">
                            <i class="bi-file-earmark-text-fill nav-module-icon"></i><span>Decreto 1072</span>
                        </a>
                        <a href="hseq/auditorias/norma/resolucion0312"
                           class="nav-hseq-subitem @(HseqSubActivo("auditorias/norma/resolucion0312") ? "nav-hseq-active" : "")">
                            <i class="bi-file-earmark-ruled-fill nav-module-icon"></i><span>Resolución 0312</span>
                        </a>
                        <a href="hseq/auditorias/norma/cliente"
                           class="nav-hseq-subitem @(HseqSubActivo("auditorias/norma/cliente") ? "nav-hseq-active" : "")">
                            <i class="bi-person-check-fill nav-module-icon"></i><span>Aud. Cliente</span>
                        </a>
                        <a href="hseq/auditorias/norma/interventoria"
                           class="nav-hseq-subitem @(HseqSubActivo("auditorias/norma/interventoria") ? "nav-hseq-active" : "")">
                            <i class="bi-building-check nav-module-icon"></i><span>Aud. Interventoría</span>
                        </a>
                        <a href="hseq/auditorias/historial"
                           class="nav-hseq-subitem @(HseqSubActivo("auditorias/historial") ? "nav-hseq-active" : "")">
                            <i class="bi-clock-history nav-module-icon"></i><span>Historial</span>
                        </a>
                    </div>
                }

                <div class="nav-hseq-item nav-hseq-group @(_inspeccionesExpandido ? "nav-hseq-active" : "")"
                     @onclick="ToggleInspecciones">
                    <i class="bi-clipboard2-check nav-module-icon"></i>
                    <span style="flex:1">Inspecciones</span>
                    <i class="@(_inspeccionesExpandido ? "bi-chevron-down" : "bi-chevron-right") nav-chevron-small"></i>
                </div>

                @if (_inspeccionesExpandido)
                {
                    <div class="nav-hseq-sub">
                        <a href="hseq/inspecciones/stc"
                           class="nav-hseq-subitem @(HseqSubActivo("inspecciones/stc") ? "nav-hseq-active" : "")">
                            <i class="bi-house-check nav-module-icon"></i><span>STC</span>
                        </a>
                        <a href="hseq/inspecciones/ots"
                           class="nav-hseq-subitem @(HseqSubActivo("inspecciones/ots") ? "nav-hseq-active" : "")">
                            <i class="bi-eye nav-module-icon"></i><span>OTS</span>
                        </a>
                        <a href="hseq/inspecciones/pausas-activas"
                           class="nav-hseq-subitem @(HseqSubActivo("inspecciones/pausas-activas") ? "nav-hseq-active" : "")">
                            <i class="bi-stopwatch nav-module-icon"></i><span>Pausas Activas</span>
                        </a>
                        <a href="hseq/inspecciones/consolidado"
                           class="nav-hseq-subitem @(HseqSubActivo("inspecciones/consolidado") ? "nav-hseq-active" : "")">
                            <i class="bi-file-earmark-bar-graph nav-module-icon"></i><span>Consolidado Anual</span>
                        </a>
                    </div>
                }
            </div>
        }

    </nav>
</div>

@code {
    private record ProyectoNavItem(int Id, string Nombre);
    private record Modulo(string Nombre, string Ruta, string Icono, bool Proximamente = false);

    private static readonly Modulo[] _modulos =
    [
        new("Dashboard",         "dashboard",        "bi-speedometer2"),
        new("Informe Diario",    "informes",         "bi-journal-text"),
        new("WBS / Actividades", "wbs",              "bi-diagram-3"),
        new("Documentos",        "documentos",       "bi-folder2-open"),
        new("Costos",            "costos",           "bi-currency-dollar"),
        new("HSEQ",              "hseq",             "bi-shield-check"),
        new("No Conformidades",  "no-conformidades", "bi-exclamation-octagon"),
        new("Restricciones",     "restricciones",    "bi-shield-x"),
        new("Histogramas",       "histogramas",      "bi-bar-chart-steps"),
        new("Clima",             "clima",            "bi-cloud-sun"),
        new("Alertas",           "alertas",          "bi-bell",       true),
    ];

    private List<ProyectoNavItem> _proyectos = [];
    private readonly HashSet<int>  _expandidos = [];
    private bool _proyectosExpandido = true;
    private bool _hseqExpandido      = false;
    private bool _auditoriasExpandido  = false;
    private bool _inspeccionesExpandido = false;
    private bool _error = false;

    // ── Detección de ruta activa ─────────────────────────────────────────────

    private bool EsRutaHseqGlobal =>
        new Uri(Nav.Uri).AbsolutePath.StartsWith("/hseq", StringComparison.OrdinalIgnoreCase);

    private bool HseqSubActivo(string subPath)
    {
        var actual   = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        var expected = $"/hseq/{subPath}";
        return actual.Equals(expected, StringComparison.OrdinalIgnoreCase)
            || actual.StartsWith(expected + "/", StringComparison.OrdinalIgnoreCase);
    }

    private int? ProyectoActualId
    {
        get
        {
            var segs = new Uri(Nav.Uri).AbsolutePath
                           .Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segs.Length >= 2 && segs[0] == "proyectos" &&
                   int.TryParse(segs[1], out var id) ? id : null;
        }
    }

    private bool ModuloActivo(int proyectoId, string ruta)
    {
        var expected = $"/proyectos/{proyectoId}/{ruta}";
        var actual   = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return actual == expected || actual.StartsWith(expected + "/");
    }

    // ── Ciclo de vida ────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnUriChanged;
        await CargarProyectosAsync();
        var id = ProyectoActualId;
        if (id.HasValue) _expandidos.Add(id.Value);
        AutoExpandirHseq();
    }

    private void AutoExpandirHseq()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        if (path.StartsWith("/hseq", StringComparison.OrdinalIgnoreCase))
        {
            _hseqExpandido = true;
            if (path.StartsWith("/hseq/auditorias", StringComparison.OrdinalIgnoreCase))
                _auditoriasExpandido = true;
            if (path.StartsWith("/hseq/inspecciones", StringComparison.OrdinalIgnoreCase))
                _inspeccionesExpandido = true;
        }
    }

    private async Task CargarProyectosAsync()
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var db = scope.ServiceProvider.GetRequiredService<RenergeIADbContext>();
            _proyectos = await db.Proyectos
                .AsNoTracking()
                .OrderBy(p => p.Nombre)
                .Select(p => new ProyectoNavItem(p.Id, p.Nombre))
                .ToListAsync();
        }
        catch
        {
            _error = true;
        }
    }

    private void OnUriChanged(object? sender, LocationChangedEventArgs e)
    {
        var id = ProyectoActualId;
        if (id.HasValue) _expandidos.Add(id.Value);
        AutoExpandirHseq();
        InvokeAsync(StateHasChanged);
    }

    // ── Acciones ─────────────────────────────────────────────────────────────

    private void ToggleSeccionProyectos() =>
        _proyectosExpandido = !_proyectosExpandido;

    private void ToggleHseq() => _hseqExpandido = !_hseqExpandido;

    private void ToggleAuditorias() => _auditoriasExpandido = !_auditoriasExpandido;
    private void ToggleInspecciones() => _inspeccionesExpandido = !_inspeccionesExpandido;

    private void ToggleProyecto(int id)
    {
        if (!_expandidos.Remove(id)) _expandidos.Add(id);
    }

    public void Dispose() =>
        Nav.LocationChanged -= OnUriChanged;
}
