<div class="rn-donut-card h-100">
    <div class="rn-donut-ring" style="--rn-donut-pct:@_pct;--rn-donut-clr:@_color">
        <div class="rn-donut-inner">
            <div class="rn-donut-value" style="color:@_color">@ValorCentral</div>
            @if (!string.IsNullOrEmpty(SubTextoInterno))
            {
                <div class="rn-donut-sub-inner">@SubTextoInterno</div>
            }
        </div>
    </div>
    <div class="rn-donut-title">@Titulo</div>
    <span class="rn-badge rn-badge-@_slug">@Estado</span>
</div>

@code {
    [Parameter] public string  Titulo          { get; set; } = "";
    [Parameter] public string  ValorCentral    { get; set; } = "0";
    [Parameter] public string  SubTextoInterno { get; set; } = "";
    [Parameter] public int     Porcentaje      { get; set; }
    [Parameter] public string  Estado          { get; set; } = "Informativo";
    [Parameter] public string? Color           { get; set; }

    private int    _pct   = 0;
    private string _color = "#183963";
    private string _slug  = "informativo";

    protected override void OnParametersSet()
    {
        _pct = Math.Clamp(Porcentaje, 0, 100);
        _color = Color ?? Estado switch
        {
            "Saludable" => "#6ABF4B",
            "En Riesgo" => "#ffc107",
            "Riesgo"    => "#fd7e14",
            "Crítico"   => "#dc3545",
            _           => "#183963"
        };
        _slug = Estado switch
        {
            "Saludable" => "saludable",
            "En Riesgo" => "en-riesgo",
            "Riesgo"    => "riesgo",
            "Crítico"   => "critico",
            _           => "informativo"
        };
    }
}
