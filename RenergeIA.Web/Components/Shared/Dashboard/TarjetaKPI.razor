<div class="rn-kpi-card h-100">
    @if (!string.IsNullOrEmpty(Icono))
    {
        <div class="rn-kpi-icon" style="color:@_color">
            <i class="bi @Icono"></i>
        </div>
    }
    <div class="rn-kpi-value" style="color:@_color">@Valor</div>
    <div class="rn-kpi-title">@Titulo</div>
    @if (!string.IsNullOrEmpty(SubTexto))
    {
        <div class="rn-kpi-sub">@SubTexto</div>
    }
    <span class="rn-badge rn-badge-@_slug mt-1">@Estado</span>
</div>

@code {
    [Parameter] public string  Titulo   { get; set; } = "";
    [Parameter] public string  Valor    { get; set; } = "0";
    [Parameter] public string  Icono    { get; set; } = "";
    [Parameter] public string  SubTexto { get; set; } = "";
    [Parameter] public string  Estado   { get; set; } = "Informativo";
    [Parameter] public string? Color    { get; set; }

    private string _color = "#183963";
    private string _slug  = "informativo";

    protected override void OnParametersSet()
    {
        _color = Color ?? Estado switch
        {
            "Saludable" => "#6ABF4B",
            "En Riesgo" => "#ffc107",
            "Riesgo"    => "#fd7e14",
            "Crítico"   => "#dc3545",
            _           => "#183963"
        };

        _slug = Estado switch
        {
            "Saludable" => "saludable",
            "En Riesgo" => "en-riesgo",
            "Riesgo"    => "riesgo",
            "Crítico"   => "critico",
            _           => "informativo"
        };
    }
}
